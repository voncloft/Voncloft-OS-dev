# description : qca - KDE dependency
# depends : cyrus-sasl kde-deps-installer openssl qt6

name=qca
version=2.3.12
release=1

source="$name-$version.tar.xz::https://download.kde.org/stable/${name}/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "qca-$version"
    plasma-package-installer -DBUILD_WITH_QT6=ON -DBUILD_TESTS=OFF
    cd build
    make DESTDIR="$PKG" install
}
