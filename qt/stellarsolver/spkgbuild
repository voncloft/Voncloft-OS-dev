# description : stellarsolver
# depends : cfitsio extra-cmake-modules gsl kde-deps-installer qt6 wcslib

name=stellarsolver
version=2.8
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/rlancaste/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    cd "stellarsolver-${version}"
    plasma-package-installer \
        -DBUILD_TESTER=OFF \
        -DBUILD_DEMOS=OFF \
        -DBUILD_TESTS=OFF \
        -DUSE_QT5=OFF
    cd build
    make DESTDIR="$PKG" install
}
