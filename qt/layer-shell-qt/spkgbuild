# description : qt comonents for kde
# depends : extra-cmake-modules kde-deps-installer libxkbcommon pkgconf qt6 wayland wayland-protocols

name=layer-shell-qt
version=6.8.1
release=2

source="https://download.kde.org/stable/plasma/$version/layer-shell-qt-$version.tar.xz"
options="!checksum"

build() {
    cd "layer-shell-qt-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
