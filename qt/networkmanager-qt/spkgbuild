# description : Core components for the kde desktop
# depends : extra-cmake-modules glib kde-deps-installer networkmanager qt6

name=networkmanager-qt
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/networkmanager-qt-$version.tar.xz"
options="!checksum"

build() {
    cd "networkmanager-qt-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
