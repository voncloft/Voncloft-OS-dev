# description : qtkeychain - KDE dependency
# depends : kde-deps-installer libsecret qt6

name=qtkeychain
version=0.17.0
release=1

source="$name-$version.tar.gz::https://github.com/frankosterfeld/qtkeychain/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
    cd "qtkeychain-$version"
    plasma-package-installer -DBUILD_WITH_QT6=ON -DBUILD_TEST_APPLICATION=OFF
    cd build
    make DESTDIR="$PKG" install
}
