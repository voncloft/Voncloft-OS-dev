# description : qcoro - KDE dependency
# depends : kde-deps-installer qt6

name=qcoro
version=0.13.0
release=1

source="$name-$version.tar.gz::https://github.com/danvratil/qcoro/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
    cd "qcoro-$version"
    plasma-package-installer -DUSE_QT_VERSION=6 -DQCORO_BUILD_EXAMPLES=OFF -DBUILD_SHARED_LIBS=ON
    cd build
    make DESTDIR="$PKG" install
}
