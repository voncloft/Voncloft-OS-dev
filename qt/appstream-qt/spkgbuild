# description : appstream-qt - KDE dependency
# depends : bash-completion curl glib gperf libfyaml libxml2 libxmlb meson ninja qt6 wayland zstd

name=appstream-qt
version=1.2.1
release=1

_name=AppStream
source="$name-$version.tar.xz::https://www.freedesktop.org/software/appstream/releases/${_name}-$version.tar.xz"
options="!checksum"

build() {
    cd "AppStream-$version"
    meson setup build --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var --buildtype=release -Dqt=true -Dstemming=false -Dsystemd=false -Dcompose=false -Dgir=false -Dvapi=false -Ddocs=false -Dapidocs=false -Dinstall-docs=false -Dman=false
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
