# description : libdbusmenu-qt
# depends : qt6

name=libdbusmenu-qt
version=0.9.3+16.04.20160218
release=16.04.20160218

source="https://archive.ubuntu.com/ubuntu/pool/main/libd/libdbusmenu-qt/libdbusmenu-qt_0.9.3+16.04.20160218.orig.tar.gz"
build()
{
	cd "$SRC"/libdbusmenu-qt*/
	mkdir build &&
	cd    build &&

	cmake -DCMAKE_INSTALL_PREFIX=/usr \
	      -DCMAKE_BUILD_TYPE=Release  \
	            -DWITH_DOC=OFF              \
	                  -Wno-dev .. &&
	                  make
	make DESTDIR=$PKG install
}
