# description	: An advanced BitTorrent client programmed in C++, based on Qt toolkit and libtorrent (no gui)
# depends	: libtorrent boost qt6

name=qbittorrent-nox
version=5.3.0
release=1
_name=qbittorrent
source="https://downloads.sourceforge.net/project/${_name}/${_name}/${_name}-${version}/${_name}-${version}.tar.xz"

build() {
	cd "$SRC"/qbittorrent*/

	export QBT_ADD_CONFIG='nostrip'

	./configure --prefix=/usr --disable-gui
	make
	make INSTALL_ROOT=$PKG install
}
