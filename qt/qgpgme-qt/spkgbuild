# description : qgpgme-qt - KDE dependency
# depends : gpgme gpgmepp kde-deps-installer libgpg-error qt6

name=qgpgme-qt
version=2.2.0
release=1

source="$name-$version.tar.xz::https://gnupg.org/ftp/gcrypt/qgpgme/qgpgme-$version.tar.xz"
options="!checksum"

build() {
    cd "qgpgme-$version"
    plasma-package-installer -DBUILD_WITH_QT5=OFF -DBUILD_WITH_QT6=ON
    cd build
    make DESTDIR="$PKG" install
}
