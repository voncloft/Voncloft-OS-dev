# description : Polkit-Qt
# depends : extra-cmake-modules glib kde-deps-installer pkgconf polkit qt6

name=polkit-qt
version=0.201.1
release=2

_name=polkit-qt-1
source="https://download.kde.org/stable/${_name}/${_name}-$version.tar.xz"
options="!checksum"

build() {
    cd "polkit-qt-1-$version"
    plasma-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
