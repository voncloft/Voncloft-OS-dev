# description : mauiman
# depends : extra-cmake-modules kde-deps-installer qt6

name=mauiman
version=4.0.2
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/maui/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "mauiman-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
