# description : mauikit-texteditor
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n mauikit qt6 syntax-highlighting

name=mauikit-texteditor
version=4.0.2
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/maui/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "mauikit-texteditor-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
