# description : SignOn daemon and Qt client library for online accounts
# depends : qt6 sqlite

name=signond
version=8.60.git20260406141555.ga08b05b79100bfd535100b8341df4e8bf1441802
release=1
_commit=${version##*.g}

source="$name-$_commit.tar.gz::https://gitlab.com/accounts-sso/${name}/-/archive/$_commit/$name-$_commit.tar.gz"
options="!checksum"

build() {
	cd $name-$_commit
	qmake6 PREFIX=/usr LIBDIR=/usr/lib
	make
	make INSTALL_ROOT="$PKG" install
}
