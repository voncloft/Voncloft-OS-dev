# description : SignOn daemon and Qt client library for online accounts
# depends : qt6 sqlite

name=signond
version=8.60+20231124
release=1
_commit=c8ad9824

source="$name-$_commit.tar.gz::https://gitlab.com/accounts-sso/signond/-/archive/$_commit/$name-$_commit.tar.gz"
options="!checksum"

build() {
	cd $name-$_commit
	qmake6 PREFIX=/usr LIBDIR=/usr/lib
	make
	make INSTALL_ROOT="$PKG" install
}
