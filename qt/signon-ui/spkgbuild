# description : SignOn UI helpers for online account authentication
# depends : libaccounts-qt qt6 signond

name=signon-ui
version=0.17+git20231016.geef943f0edf3beee8ecb85d4a9dae3656002fc24
release=1
_commit=${version##*.g}

source="$name-$version.tar.gz::https://gitlab.com/accounts-sso/$name/-/archive/$_commit/$name-$_commit.tar.gz"
options="!checksum"

build() {
	cd $name-$_commit
	sed -i -e "/tests/d" signon-ui.pro
	qmake6 PREFIX=/usr LIBDIR=/usr/lib
	make
	make INSTALL_ROOT="$PKG" install
}
