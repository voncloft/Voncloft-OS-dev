# description : This package is a Qt-style wrapper for PulseAudio-17
# depends : extra-cmake-modules kde-deps-installer pkgconf pulseaudio qt6

name=pulseaudio-qt
version=1.9.0
release=2

source="https://download.kde.org/stable/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "pulseaudio-qt-$version"
    plasma-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
