# description : libalkimia
# depends : extra-cmake-modules gmp kcodecs kcompletion kconfig kcoreaddons kde-deps-installer ki18n kio knewstuff ktextwidgets kwidgetsaddons kxmlgui qt6

name=libalkimia
version=8.2.1
release=2
options="!checksum"
_name=alkimia
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${_name}/${version}/${_name}-${version}.tar.xz"

build() {
    cd "alkimia-${version}"
    plasma-package-installer \
        -DBUILD_WITH_QT6=ON \
        -DBUILD_APPLETS=OFF \
        -DBUILD_WITH_WEBENGINE=OFF
    cd build
    make DESTDIR="$PKG" install
}
