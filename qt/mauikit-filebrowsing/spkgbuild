# description : mauikit-filebrowsing
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n kio mauikit qt6

name=mauikit-filebrowsing
version=4.0.2
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/maui/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "mauikit-filebrowsing-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
