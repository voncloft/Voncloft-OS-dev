# description : Qt integrated development environment
# depends : qt6 cmake ninja llvm python

name=qtcreator
version=20.0.2
release=1
_name=qt-creator-opensource-src
source="https://download.qt.io/official_releases/qtcreator/${version%.*}/$version/${_name}-$version.tar.xz"

build() {
    cd "$_name-$version"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_PREFIX_PATH=/usr \
        -DCMAKE_INSTALL_RPATH=/usr/lib/qtcreator \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DBUILD_EXECUTABLE_CMDBRIDGE=OFF \
        -DIDE_INSTALL_PREFIX=/usr \
        -DWITH_DOCS=OFF \
        -DBUILD_QBS=OFF \
        -DWITH_TESTS=OFF
    cmake --build build --parallel "${NINJAJOBS:-$(nproc)}"
    DESTDIR="$PKG" cmake --install build
}
