# description : packagekit-qt - KDE dependency
# depends : kde-deps-installer packagekit-interfaces qt6
# note : Qt bindings only; scratchpkg has no PackageKit backend.

name=packagekit-qt
version=1.1.4
release=2

_name=PackageKit-Qt
source="$name-$version.tar.gz::https://github.com/PackageKit/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
    cd "PackageKit-Qt-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
