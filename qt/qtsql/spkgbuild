# description	: Cross-platform application framework that is widely used for developing application
# depends : qt6 mariadb

name=qtsql
version=5.15.19
release=1

_name=qt-everywhere-src
source="https://download.qt.io/archive/qt/${version%.*}/$version/single/${_name}-$version.tar.xz"
options="!checksum"

build() {
	cd qt-everywhere-src-$version/qtbase/src/plugins/sqldrivers
	qmake -- MYSQL_PREFIX=/usr
	make sub-mysql
	make DESTDIR=$PKG install


}
