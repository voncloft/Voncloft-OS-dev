# description : mauikit
# depends : extra-cmake-modules git kcoreaddons kde-deps-installer ki18n knotifications kwindowsystem libxcb mauiman qt6 xcb-util-wm

name=mauikit
version=4.0.2
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/maui/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "mauikit-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
