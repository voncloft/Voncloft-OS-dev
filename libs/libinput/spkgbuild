# description : libinput - KDE dependency
# depends : libevdev meson mtdev ninja pkgconf udev

name=libinput
version=1.32.0
release=2

source="$name-$version.tar.gz::https://gitlab.freedesktop.org/libinput/libinput/-/archive/$version/libinput-$version.tar.gz"
options="!checksum"

build() {
    cd "libinput-$version"
    meson setup build --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var --buildtype=release -Ddebug-gui=false -Dtests=false -Dlibwacom=false -Ddocumentation=false -Dudev-dir=/usr/lib/udev
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
