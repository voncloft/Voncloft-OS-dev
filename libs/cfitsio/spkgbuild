# description : cfitsio
# depends : bzip2 cmake curl make zlib

name=cfitsio
version=4.7.0
release=2
options="!checksum"
source="cfitsio-4.7.0.tar.gz::https://github.com/HEASARC/cfitsio/archive/refs/tags/cfitsio-4.7.0.tar.gz"

build() {
    cd "cfitsio-cfitsio-4.7.0"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DTESTS=OFF \
        -DUSE_PTHREADS=ON \
        -DUSE_BZIP2=ON
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
