# description	: Library which provides a simple foundation for reading DVDs

name=libdvdread
version=7.1.1
release=4
source="https://download.videolan.org/pub/videolan/$name/$version/$name-$version.tar.xz"

build() {
    cd "$name-$version"
    meson setup build --prefix=/usr --libdir=/usr/lib --buildtype=release --default-library=shared
    meson compile -C build
    DESTDIR="$PKG" meson install -C build
}
