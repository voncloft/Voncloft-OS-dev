# description	: Collection of libraries providing APIs to netlink protocol based Linux kernel interfaces

name=libnl
version=3.12.0
verzion=$(echo $version | tr '.' '_')
release=1
source="https://github.com/thom311/${name}/releases/download/libnl3_12_0/${name}-${version}.tar.gz"

build() {
	cd $name-$version

  	./configure --prefix=/usr     \
	            --sysconfdir=/etc \
	            --disable-static
	make
	make DESTDIR=$PKG install
}
