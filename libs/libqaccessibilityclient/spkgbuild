# description : libqaccessibilityclient - KDE independent component
# depends : extra-cmake-modules kde-deps-installer qt6

name=libqaccessibilityclient
version=0.6.0
release=2

source="https://download.kde.org/stable/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "libqaccessibilityclient-$version"
    plasma-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
