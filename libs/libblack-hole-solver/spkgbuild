# description : solvers for solitaire
# depends : glibc cmake python

name=libblack-hole-solver
version=1.14.0
release=1

_name=black-hole-solver
source="https://fc-solve.shlomifish.org/downloads/fc-solve/${_name}-${version}.tar.xz"
options="!checksum"

build() {
	cd "$SRC"/black-hole-solver*/
	mkdir build
	cd build
	cmake .. \
	-DCMAKE_INSTALL_PREFIX=/usr \
    	-DBUILD_STATIC_LIBRARY=OFF

	make
	make DESTDIR=$PKG install
}
