# description	: X11 client-side library
# depends	: libxcb xtrans

name=libx11
version=1.8.14
release=1
_name=libX11
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libX11-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static \
                --enable-legacy
	make
	make DESTDIR=$PKG install


}
