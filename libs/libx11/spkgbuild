# description : X11 client-side library
# depends     : libxcb xtrans

name=libx11
version=1.8.14
release=3
_name=libX11
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
    # 64-bit build.
    cd libX11-$version

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --enable-legacy
    make
    make DESTDIR=$PKG install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --enable-legacy
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
