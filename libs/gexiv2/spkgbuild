# description	: GObject-based wrapper around the Exiv2 library
# depends	: exiv2 vala meson

name=gexiv2
version=0.16.2
release=1
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	cd $name-$version

	mkdir build
	cd    build
	
	meson --prefix=/usr
	ninja
	DESTDIR=$PKG ninja install
}
