# Both independently released components belong to the same Scratch package.
source="https://download.gnome.org/sources/glib/cache.json"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import json, pathlib, re, urllib.request

def stable(metadata, project):
    versions = []
    for version, files in metadata[1][project].items():
        if not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', version):
            continue
        parts = tuple(map(int, version.split('.')))
        if parts[1] % 2 or 'tar.xz' not in files:
            continue
        versions.append(version)
    if not versions:
        raise SystemExit('No stable source archive found for ' + project)
    return max(versions, key=lambda version: tuple(map(int, version.split('.'))))

glib = stable(json.loads(pathlib.Path('index.html').read_text()), 'glib')
url = 'https://download.gnome.org/sources/gobject-introspection/cache.json'
with urllib.request.urlopen(url, timeout=30) as response:
    introspection = stable(json.load(response), 'gobject-introspection')
print(glib + '+' + introspection)
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
