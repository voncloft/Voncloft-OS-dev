# depends     : libxslt pcre2 python-docutils libffi zlib meson ninja pkgconf python python-mako python-markdown util-linux flex bison
# description : GLib libraries and GObject Introspection
name=glib
# GLib and GObject Introspection are updated together in this package.
version=2.90.2+1.86.0
release=2
_glib_version=${version%%+*}
_gi_version=${version##*+}
_gi_name=gobject-introspection
options="!checksum"
#KEEP_WORK=yes
source="https://download.gnome.org/sources/${name}/${_glib_version%.*}/${name}-${_glib_version}.tar.xz
        https://download.gnome.org/sources/${_gi_name}/${_gi_version%.*}/${_gi_name}-${_gi_version}.tar.xz"
noextract="${_gi_name}-${_gi_version}.tar.xz"

build() {
    # 64-bit build.
    local saved_PATH="${PATH-}"
    local saved_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
    local saved_XDG_DATA_DIRS="${XDG_DATA_DIRS-}"
    local saved_GI_TYPELIB_PATH="${GI_TYPELIB_PATH-}"

    cd "$name-$_glib_version"

    # Keep the existing /usr/lib layout; the first pass bootstraps introspection.
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dtests=false \
        -Dintrospection=disabled \
        -Dglib_debug=disabled \
        -Dman-pages=enabled \
        -Dsysprof=disabled
    ninja -C build
    DESTDIR="$PKG" ninja -C build install

    # PKG_CONFIG_PATH only locates .pc files; it does not relocate their /usr
    # paths into DESTDIR. Relocate private copies for bootstrap consumers only.
    # The packaged .pc files keep their final /usr prefix.
    mkdir -p "$SRC/glib-bootstrap-pc"
    for pc in "$PKG"/usr/lib/pkgconfig/*.pc; do
        sed "s|^prefix=/usr\$|prefix=$PKG/usr|" "$pc" \
            > "$SRC/glib-bootstrap-pc/${pc##*/}"
    done
    export PKG_CONFIG_PATH="$SRC/glib-bootstrap-pc${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export LD_LIBRARY_PATH="$PKG/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export PATH="$PKG/usr/bin:$PATH"
    export XDG_DATA_DIRS="$PKG/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    export GI_TYPELIB_PATH="$PKG/usr/lib/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
    test "$(pkg-config --variable=libdir glib-2.0)" = "$PKG/usr/lib"
    test -f "$PKG/usr/lib/glib-2.0/include/glibconfig.h"

    tar -xf "$SRC/${_gi_name}-${_gi_version}.tar.xz" -C build
    meson setup build/gi-build "build/${_gi_name}-${_gi_version}" \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dtests=false
    ninja -C build/gi-build
    DESTDIR="$PKG" ninja -C build/gi-build install

    # Make the newly built scanner and introspection library available to GLib.
    for pc in "$PKG"/usr/lib/pkgconfig/*.pc; do
        sed "s|^prefix=/usr\$|prefix=$PKG/usr|" "$pc" \
            > "$SRC/glib-bootstrap-pc/${pc##*/}"
    done
    test "$(pkg-config --variable=g_ir_scanner gobject-introspection-1.0)" = "$PKG/usr/bin/g-ir-scanner"
    # Meson caches pkg_config_path at initial setup, so update it explicitly.
    meson setup build \
        --reconfigure \
        -Dintrospection=enabled \
        -Dpkg_config_path="$PKG_CONFIG_PATH"
    ninja -C build
    DESTDIR="$PKG" ninja -C build install

    # 32-bit build.
    mkdir -p build32
    cd build32

    export PATH="$saved_PATH"
    export LD_LIBRARY_PATH="$saved_LD_LIBRARY_PATH"
    export XDG_DATA_DIRS="$saved_XDG_DATA_DIRS"
    export GI_TYPELIB_PATH="$saved_GI_TYPELIB_PATH"
    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dtests=false \
        -Dintrospection=disabled \
        -Dglib_debug=disabled \
        -Dman-pages=disabled \
        -Dsysprof=disabled
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
