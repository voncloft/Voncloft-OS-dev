# description	: X11 Resource extension library
# depends	: libx11 libxext 

name=libxres
version=1.2.3
release=1
_name=libXres
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXres-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}

