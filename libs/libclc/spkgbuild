# description : implementation of library reqs for opencl
# depends : spirv-llvm-translator

name=libclc
version=23.1.4
release=1

_name=llvm-project
source="https://github.com/llvm/${_name}/releases/download/llvmorg-$version/${name}-$version.src.tar.xz"
options="!checksum"

build()
{
	cd *
	mkdir build 
	cd    build 

#cmake .. -DCMAKE_INSTALL_PREFIX=/usr -DLLVM_DIR=/usr/lib/cmake/llvm -G Ninja
	
cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -G Ninja ..
	ninja
	DESTDIR=$PKG ninja install
}
