# description : cxx-rust-cssparser - KDE independent component
# depends : corrosion extra-cmake-modules kde-deps-installer qt6

name=cxx-rust-cssparser
version=1.1.0
release=1

source="https://download.kde.org/stable/cxx-rust-cssparser/cxx-rust-cssparser-$version.tar.xz"
options="!checksum"

build() {
    cd "cxx-rust-cssparser-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
