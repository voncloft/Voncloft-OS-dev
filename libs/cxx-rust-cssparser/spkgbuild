# description : cxx-rust-cssparser - KDE independent component
# depends : corrosion extra-cmake-modules kde-deps-installer qt6 rust

name=cxx-rust-cssparser
version=1.1.0
release=2

source="https://download.kde.org/stable/cxx-rust-cssparser/cxx-rust-cssparser-$version.tar.xz"
options="!checksum"

build() {
    cd "cxx-rust-cssparser-$version"
    # Rust is installed under /opt; sudo does not preserve that PATH entry.
    export PATH="/opt/rustc/bin:$PATH"
    rustc --version
    cargo --version
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
