# description : The GL Vendor-Neutral Dispatch library
# depends     : libxext libx11 meson ninja

name=libglvnd
version=1.7.0
release=2
source="https://github.com/NVIDIA/${name}/archive/v$version/$name-v$version.tar.gz"

build() {
    # 64-bit build.
    cd libglvnd-$version

    mkdir build
    cd build

    meson .. \
        --prefix=/usr
    ninja
    DESTDIR=$PKG ninja install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
