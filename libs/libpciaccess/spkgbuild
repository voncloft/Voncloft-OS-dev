# description	: X11 PCI access library

name=libpciaccess
version=0.19
release=2
source="http://ftp.x.org/pub/individual/lib/${name}-$version.tar.xz"

build() {
	cd libpciaccess-$version

	      mkdir build
      cd    build
        meson setup --prefix=/usr --buildtype=release ..
        ninja
        DESTDIR=$PKG ninja install
}
