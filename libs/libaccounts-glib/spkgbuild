# description : glib based library for accessing online accounts database
# depends : dbus-glib libxml2 sqlite glib

name=libaccounts-glib
version=1.27
release=3

source="https://gitlab.com/accounts-sso/${name}/-/archive/VERSION_$version/libaccounts-glib-VERSION_$version.tar.gz"

build() {
	meson $name-VERSION_$version build \
    -Dprefix=/usr
  meson compile -C build
meson install -C build --destdir $PKG
}
