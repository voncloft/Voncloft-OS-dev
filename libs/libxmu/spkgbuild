# description	: X11 miscellaneous micro-utility library
# depends	: libx11 libxt libxext 

name=libxmu
version=1.3.1
release=1
_name=libXmu
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXmu-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
