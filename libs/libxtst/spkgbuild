# description	: X11 Testing -- Resource extension library
# depends	: libx11 libxext libxi 

name=libxtst
version=1.2.6
release=1
_name=libXtst
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXtst-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}

