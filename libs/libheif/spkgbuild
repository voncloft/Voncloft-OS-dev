# description : libheif
# depends : cmake dav1d libaom libjpeg-turbo libpng libwebp make x265

name=libheif
version=1.23.7
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/strukturag/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    cd "$name-$version"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DWITH_EXAMPLES=OFF \
        -DWITH_GDK_PIXBUF=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
