# description	: X11 Inter-Client Exchange library
# depends	: xorgproto xtrans

name=libice
version=1.1.2
release=1
_name=libICE
source="https://www.x.org/archive//individual/lib/${_name}-$version.tar.xz"

build() {
	cd libICE-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
