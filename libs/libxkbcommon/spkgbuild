# description	: keymap compiler and support library
# depends	: xkeyboard-config libxcb wayland-protocols wayland

name=libxkbcommon
version=1.13.2
release=1
source="${name}-${version}.tar.gz::https://github.com/xkbcommon/${name}/archive/refs/tags/xkbcommon-${version}.tar.gz"

build() {
	cd "$name-xkbcommon-$version"

	mkdir build
	cd build

	meson --prefix=/usr \
	      -Denable-docs=false
	ninja
	DESTDIR=$PKG ninja install
}
