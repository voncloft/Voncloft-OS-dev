# description	: X11 Screen Saver extension client library
# depends	: libx11 libxext xorgproto

name=libxscrnsaver
version=1.2.5
release=1
source="https://www.x.org/pub/individual/lib/libXScrnSaver-1.2.5.tar.gz"

build() {
	cd libXScrnSaver-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
