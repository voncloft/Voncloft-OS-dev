# description	: X11 Xinerama extension library
# depends	: libx11 libxext 

name=libxinerama
version=1.1.6
release=1
_name=libXinerama
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXinerama-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install

}
