# description : minizip-ng
# depends : bzip2 cmake make openssl xz zlib zstd

name=minizip-ng
version=4.2.2
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/zlib-ng/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    cd "minizip-ng-${version}"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DMZ_COMPAT=OFF \
        -DMZ_FETCH_LIBS=OFF \
        -DMZ_LIBBSD=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
