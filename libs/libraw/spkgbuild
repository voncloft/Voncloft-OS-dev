# description   : Libraw is a library for reading RAW files obtained from digital cameras (CRW/CR2, NEF, RAF, DNG, and others)
# depends       : libjpeg-turbo jasper lcms2

name=libraw
version=0.22.3
release=4
_name=LibRaw
source="${name}-${version}.tar.gz::https://github.com/LibRaw/${_name}/archive/refs/tags/${version}.tar.gz"

options="!checksum"

build() {
        cd "$SRC"/LibRaw*/
        autoreconf --install --force
        ./configure --prefix=/usr    \
--enable-jpeg    \
--enable-jasper  \
--enable-lcms    \
--disable-static \
--docdir=/usr/share/doc/libraw-$version
make
make DESTDIR=$PKG install
}
