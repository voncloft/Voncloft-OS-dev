# description   : Libraw is a library for reading RAW files obtained from digital cameras (CRW/CR2, NEF, RAF, DNG, and others)
# depends       : libjpeg-turbo jasper lcms2

name=libraw
version=0.22.3    
release=1
source="https://github.com/LibRaw/LibRaw/archive/refs/tags/0.22.3.tar.gz"

options="!checksum"

build() {
        cd "$SRC"/LibRaw*/
        ./configure --prefix=/usr    \
--enable-jpeg    \
--enable-jasper  \
--enable-lcms    \
--disable-static \
--docdir=/usr/share/doc/libraw-0.21.4 
make
make DESTDIR=$PKG install
}
