# description : XML parsing library and utilities
# depends : icu python readline doxygen

name=libxml2
version=2.15.4
release=3
_name=${name%-32}
source="https://download.gnome.org/sources/${_name}/${version%.*}/${_name}-${version}.tar.xz"

build() {
    cd "$_name-$version"
    ./configure --prefix=/usr --sysconfdir=/etc --disable-static \
        --with-history --with-icu --with-schematron --libdir=/usr/lib \
        --docdir=/usr/share/doc/$_name-$version --with-python PYTHON=/usr/bin/python3
    make
    make DESTDIR="$PKG" install
    rm -f "$PKG/usr/lib/libxml2.la"
}
