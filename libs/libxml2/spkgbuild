# description : XML parsing library and utilities
# depends     : icu python readline doxygen zlib xz

name=libxml2
version=2.15.4
release=4
_name=${name%-32}
source="https://download.gnome.org/sources/${_name}/${version%.*}/${_name}-${version}.tar.xz"

build() {
    # 64-bit build.
    cd "$_name-$version"
    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --with-history \
        --with-icu \
        --with-schematron \
        --libdir=/usr/lib \
        --docdir=/usr/share/doc/$_name-$version \
        --with-python \
        PYTHON=/usr/bin/python3
    make
    make DESTDIR="$PKG" install
    rm -f "$PKG/usr/lib/libxml2.la"

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --sysconfdir=/etc \
        --disable-static \
        --with-history \
        --with-icu \
        --with-schematron \
        --without-python
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
