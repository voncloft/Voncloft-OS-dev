# description : javascript interpreter and libraries version 78
# depends : autoconf icu rustc which gcc

name=js78
version=78.15.0
release=1

_name=firefox
source="https://archive.mozilla.org/pub/${_name}/releases/${version}esr/source/${_name}-${version}esr.source.tar.xz"
options="!checksum"

build() {
	cd "${_name}-${version}"
	mkdir obj
	cd obj
	CC=gcc CXX=g++ \
	../js/src/configure --prefix=/usr            \
                    --with-intl-api          \
                    --with-system-zlib       \
                    --with-system-icu        \
                    --disable-jemalloc       \
                    --disable-debug-symbols  \
                    --enable-readline

	make
	make DESTDIR=$PKG install
}
