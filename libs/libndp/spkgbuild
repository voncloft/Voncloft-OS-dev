# description	: Wrapper for IPv6 Neighbor Discovery Protocol

# depends : autoconf automake libtool

name=libndp
version=1.9
release=1
source="$name-$version.tar.gz::https://github.com/jpirko/$name/archive/refs/tags/v$version.tar.gz"

build() {
	cd $name-$version

	autoreconf -fiv
	./configure --prefix=/usr        \
	            --sysconfdir=/etc    \
	            --localstatedir=/var \
	            --disable-static
	make
	make DESTDIR=$PKG install
}
