# description : libnova
# depends : make

name=libnova
version=0.15.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://downloads.sourceforge.net/project/${name}/${name}/v%20${version}/${name}-${version}.tar.gz"

build() {
    cd "libnova-${version}"
    export CFLAGS="$CFLAGS -std=gnu17"
    ./configure --prefix=/usr --libdir=/usr/lib64 --disable-static
    make
    make DESTDIR="$PKG" install
}
