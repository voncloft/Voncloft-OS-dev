# description	: Library used by some applications for USB device access

name=libusb
version=1.0.30
release=1
source="https://github.com/libusb/${name}/releases/download/v$version/${name}-$version.tar.bz2"

build() {
	cd $name-$version
	export LIBS="-liconv"
	sed -i "s/^PROJECT_LOGO/#&/" doc/doxygen.cfg.in
	./configure \
  --prefix=/usr \
  --disable-static \
  CFLAGS="-I/usr/include" \
  LDFLAGS="-L/usr/lib" \
  LIBS="-liconv"
	make -j1
	make DESTDIR=$PKG install
}
