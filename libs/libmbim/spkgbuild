# description : libmbim - KDE dependency
# depends : glib help2man libgudev meson ninja python

name=libmbim
version=1.34.0
release=1

source="$name-$version.tar.gz::https://gitlab.freedesktop.org/mobile-broadband/libmbim/-/archive/$version/libmbim-$version.tar.gz"
options="!checksum"

build() {
    cd "libmbim-$version"
    meson setup build --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var --buildtype=release -Dgtk_doc=false -Dintrospection=false
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
