# description : Math library for computer graphics and image processing
# depends : cmake

name=imath
version=3.2.3
release=1

_name=Imath
source="$name-$version.tar.gz::https://github.com/AcademySoftwareFoundation/${_name}/releases/download/v$version/${_name}-$version.tar.gz"
options="!checksum"

build() {
    cmake -S "$_name-$version" -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DPYTHON=OFF \
        -DPYBIND11=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
