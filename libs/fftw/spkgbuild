# description	: A library for computing the discrete Fourier transform (DFT)
# depends	: bash

name=fftw
version=3.3.11
release=1
source="https://www.fftw.org/fftw-3.3.11.tar.gz"
options="!checksum"

build() {
	cd "$SRC"/fftw*/

	./configure --prefix=/usr    \
            --enable-shared  \
            --disable-static \
            --enable-threads \
            --enable-sse2    \
            --enable-avx
	make
	make DESTDIR=$PKG install

	make clean
	./configure --prefix=/usr    \
            --enable-shared  \
            --disable-static \
            --enable-threads \
            --enable-sse2    \
            --enable-avx     \
            --enable-float
	make
	make DESTDIR=$PKG install

	make clean
	./configure --prefix=/usr    \
            --enable-shared  \
            --disable-static \
            --enable-threads \
            --enable-long-double
       make 
       make DESTDIR=$PKG install


}
