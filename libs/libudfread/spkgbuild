# description : libbluray component
# depends : glibc

name=libudfread
version=1.2.0
release=1

source="https://code.videolan.org/videolan/${name}/-/archive/${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
	cd "$SRC"/libudfread*/
	mkdir -pv build
	./bootstrap
	cd build
		../configure \
    		--prefix=/usr \
    		--disable-static

  make

  make DESTDIR=$PKG install
}
