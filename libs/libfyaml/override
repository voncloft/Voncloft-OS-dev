# Select stable numeric tags; GitHub's latest release may be a beta.
source="https://api.github.com/repos/pantoniou/libfyaml/git/matching-refs/tags/v"
url=$source
get_generic() {
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import json,pathlib,re
refs=json.loads(pathlib.Path('index.html').read_text())
versions=[r['ref'].removeprefix('refs/tags/v') for r in refs if re.fullmatch(r'refs/tags/v[0-9]+(?:\.[0-9]+)+',r['ref'])]
if not versions: raise SystemExit('No stable libfyaml release')
print(max(versions,key=lambda v:tuple(map(int,v.split('.')))))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
