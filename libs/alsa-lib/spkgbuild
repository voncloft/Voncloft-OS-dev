# description	: ALSA library used by programs (including ALSA Utilities) requiring access to the ALSA sound interface

name=alsa-lib
version=1.2.16.1
release=2
source="https://www.alsa-project.org/files/pub/lib/${name}-$version.tar.bz2"
options="!checksum"
build() {
    cd "$name-$version"
    ./configure --prefix=/usr --disable-static
    make
    make DESTDIR="$PKG" install

    make distclean
    CC="gcc -m32" CXX="g++ -m32" \
        PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig \
        ./configure --prefix=/usr --libdir=/usr/lib32 --disable-static
    make
    make DESTDIR="$PWD/DESTDIR" install
    install -dm755 "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
}
