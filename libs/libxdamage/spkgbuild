# description	: X11 damaged region extension library
# depends	: libxfixes libx11 

name=libxdamage
version=1.1.7
release=1
source="https://www.x.org/pub/individual/lib/libXdamage-1.1.7.tar.gz"

build() {
	cd libXdamage-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
