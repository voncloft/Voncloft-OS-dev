# description : libunibreak
# depends : make

name=libunibreak
version=8.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/adah1972/${name}/releases/download/libunibreak_8_0/${name}-${version}.tar.gz"

build() {
    cd "libunibreak-${version}"
    ./configure --prefix=/usr --libdir=/usr/lib64 --disable-static
    make
    make DESTDIR="$PKG" install
}
