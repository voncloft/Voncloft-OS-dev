# description : TPM 2.0 software stack with ESAPI, FAPI and device transports
# depends : openssl curl json-c util-linux libusb acl

name=tpm2-tss
version=4.2.2s
release=1
source="https://github.com/tpm2-software/$name/releases/download/$version/$name-$version.tar.gz"
backup="etc/tpm2-tss/fapi-config.json
        etc/tpm2-tss/fapi-profiles/P_ECCP256SHA256-high-range.json
        etc/tpm2-tss/fapi-profiles/P_ECCP256SHA256-legacy.json
        etc/tpm2-tss/fapi-profiles/P_ECCP256SHA256-low-range.json
        etc/tpm2-tss/fapi-profiles/P_ECCP256SHA256.json
        etc/tpm2-tss/fapi-profiles/P_ECCP384SHA384.json
        etc/tpm2-tss/fapi-profiles/P_RSA2048SHA256-high-range.json
        etc/tpm2-tss/fapi-profiles/P_RSA2048SHA256-legacy.json
        etc/tpm2-tss/fapi-profiles/P_RSA2048SHA256-low-range.json
        etc/tpm2-tss/fapi-profiles/P_RSA2048SHA256.json
        etc/tpm2-tss/fapi-profiles/P_RSA3072SHA384.json"

build() {
    cd "$name-$version"
    ./configure --prefix=/usr --libdir=/usr/lib64 --sysconfdir=/etc \
        --localstatedir=/var --with-runstatedir=/run \
        --with-udevrulesdir=/lib/udev/rules.d --with-udevrulesprefix=60- \
        --with-sysusersdir=no --with-tmpfilesdir=no \
        --disable-static --disable-doxygen-doc
    make
    make DESTDIR="$PKG" install
    # SysV uses the standard device permissions without systemd device tags.
    sed -i 's/TAG+="systemd", //g' "$PKG"/lib/udev/rules.d/60-*-udev.rules
}
