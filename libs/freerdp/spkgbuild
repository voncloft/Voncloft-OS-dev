# description : freerdp - KDE dependency
# depends : alsa-lib cairo cmake ffmpeg icu jansson kde-deps-installer libusb libx11 libxcursor libxdamage libxext libxfixes libxi libxinerama libxkbcommon libxrandr libxrender libxtst openssl pkgconf pulseaudio udev wayland zlib

name=freerdp
version=3.32.2
release=2

_name=FreeRDP
source="$name-$version.tar.gz::https://github.com/FreeRDP/${_name}/releases/download/$version/${name}-$version.tar.gz"
options="!checksum"

build() {
    cd "freerdp-$version"
    plasma-package-installer -DWITH_SERVER=ON -DWITH_SAMPLE=OFF -DWITH_FUSE=OFF -DWITH_PCSC=OFF -DWITH_CLIENT_SDL=OFF -DWITH_CUPS=OFF -DWITH_KRB5=OFF -DWITH_FFMPEG=ON -DWITH_MANPAGES=OFF
    cd build
    make DESTDIR="$PKG" install
}
