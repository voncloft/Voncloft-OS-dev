# description : zug
# depends : cmake make

name=zug
version=0.1.2
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/arximboldi/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cd "zug-${version}"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -Dzug_BUILD_TESTS=OFF \
        -Dzug_BUILD_EXAMPLES=OFF \
        -Dzug_BUILD_DOCS=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
