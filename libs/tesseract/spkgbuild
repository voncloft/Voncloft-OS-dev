# description : tesseract - KDE dependency
# depends : curl icu kde-deps-installer leptonica libarchive

name=tesseract
version=5.5.4
release=2

source="$name-$version.tar.gz::https://github.com/tesseract-ocr/${name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
    cd "tesseract-$version"
    # Tesseract appends /tessdata; without this prefix OCR scans the current directory.
    plasma-package-installer -DTESSDATA_PREFIX=/usr/share \
        -DBUILD_SHARED_LIBS=ON -DBUILD_TRAINING_TOOLS=OFF -DBUILD_TESTS=OFF
    cd build
    make DESTDIR="$PKG" install
}
