# description : x present extension library
# depends : libxfixes libxrandr

name=libxpresent
version=1.0.2
release=3

_name=libXpresent
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"
options="!checksum"

build() {
	cd "${_name}-${version}"
	./configure --prefix=/usr --libdir=/usr/lib64 --disable-dependency-tracking
	sed -i -e '/\$CC/s/-shared/\0 -Wl,--as-needed/' libtool
	make
	make DESTDIR="$PKG" install
}
