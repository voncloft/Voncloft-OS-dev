# Read the current stable release from official upstream metadata.
source="https://dist.libuv.org/dist/"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re
versions=re.findall(r'href="v([0-9]+\.[0-9]+\.[0-9]+)/"',pathlib.Path('index.html').read_text())
if not versions: raise SystemExit('No stable libuv release found')
print(max(versions,key=lambda v:tuple(map(int,v.split('.')))))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
