# description : libgphoto2 - KDE dependency
# depends : libexif libjpeg-turbo libtool libusb make pkgconf

name=libgphoto2
version=2.5.34
release=2

source="$name-$version.tar.xz::https://github.com/gphoto/libgphoto2/releases/download/v$version/libgphoto2-$version.tar.xz"
options="!checksum"

build() {
    cd "libgphoto2-$version"
    ./configure --prefix=/usr --libdir=/usr/lib64 --sysconfdir=/etc --localstatedir=/var --disable-static
    make
    make DESTDIR="$PKG" install
}
