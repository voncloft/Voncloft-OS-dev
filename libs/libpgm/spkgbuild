# description : implementation of pgm
# depends : glibc

name=libpgm
version=5.3.128
release=1
_pkgver="${version//./-}"
_name=openpgm
source="https://github.com/steve-o/${_name}/archive/release-${_pkgver}.tar.gz"
options="!checksum"

build() {
	cd "$SRC"/openpgm-release*/openpgm/pgm
	#cd opengpm-release-$_pkgver/openpgm/pgm
	2to3 -wn version_generator.py
	cp openpgm-5.2.pc.in openpgm-5.3.pc.in
	./bootstrap.sh
	./configure --prefix=/usr
	make
	make prefix=$PKG/usr install
}
