# description : Low-level cryptographic library that is designed to fit easily in many contexts
# depends     : gmp

name=nettle
version=4.0
release=2
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.gz"

build() {
    # 64-bit build.
    cd $name-$version

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib64 \
        --disable-static
    make
    make DESTDIR=$PKG install

    chmod 755 "$PKG/usr/lib64/libhogweed.so" "$PKG/usr/lib64/libnettle.so"

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --disable-static
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
