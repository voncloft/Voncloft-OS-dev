# description	: X11 miscellaneous 'fixes' extension library
# depends	: libx11 

name=libxfixes
version=6.0.2
release=1
_name=libXfixes
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXfixes-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}

