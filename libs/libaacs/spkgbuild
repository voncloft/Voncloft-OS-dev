# description : advanced access content system
# depends : libgcrypt

name=libaacs
version=0.12.0
release=1

source="https://download.videolan.org/pub/videolan/${name}/${version}/${name}-${version}.tar.bz2"
options="!checksum"

build() {
	cd "$SRC"/libaacs*/
	./bootstrap
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
