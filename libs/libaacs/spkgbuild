# description : advanced access content system
# depends : libgcrypt

name=libaacs
version=0.12.0
release=1

source="https://download.videolan.org/pub/videolan/libaacs/0.12.0/libaacs-0.12.0.tar.bz2"
options="!checksum"

build() {
	cd "$SRC"/libaacs*/
	./bootstrap
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
