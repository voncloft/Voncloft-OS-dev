# description : library for learning linear classifiers for large scale applications

name=liblinear
version=250
release=2

source="https://github.com/cjlin1/${name}/archive/v${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
	cd "$name-$version"
	make lib
	_shver=$(awk '$1 == "SHVER" && $2 == "=" { print $3; exit }' Makefile)
	test -n "$_shver"
	install -Dm644 linear.h "$PKG/usr/include/linear.h"
	install -Dm755 "liblinear.so.$_shver" "$PKG/usr/lib/liblinear.so.$_shver"
	ln -sf "liblinear.so.$_shver" "$PKG/usr/lib/liblinear.so"
}
