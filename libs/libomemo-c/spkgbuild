# description : libomemo-c
# depends : cmake make

name=libomemo-c
version=0.5.1
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/dino/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    cd "libomemo-c-${version}"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DLIB_SUFFIX=64 \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
