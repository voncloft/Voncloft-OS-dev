# description : broker-less messaging library
# depends : glibc wolfssl cmake git ninja

name=nng
version=2.1.0
release=6

source="${name}-${version}.tar.gz::https://github.com/nanomsg/${name}/archive/refs/tags/v$version.tar.gz"

build()
{
cd "$name-$version"
mkdir build
cd build
cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON \
    -DNNG_ENABLE_TLS=ON \
    -DNNG_TLS_ENGINE=wolf \
    -DNNG_ENABLE_DOC=OFF 

make

make DESTDIR=$PKG install
}
