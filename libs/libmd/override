# Track all stable source archives on the official release server.
source="https://libbsd.freedesktop.org/releases/"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re
project='libmd'
versions=re.findall(r'href="'+re.escape(project)+r'-([0-9]+(?:\.[0-9]+)*)\.tar\.xz"',pathlib.Path('index.html').read_text())
if not versions: raise SystemExit('No stable source archives found')
print(max(versions,key=lambda v:tuple(map(int,v.split('.')))))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
