# description	: library for CD-ROM and CD image access
# depends	: ncurses libiconv

name=libcdio
version=2.1.0
release=2
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.bz2"

build() {
    cd "$SRC/$name-$version"

    # Avoid exporting libtool-only -R flags in libcdio.pc.
    ./configure --prefix=/usr --disable-static --disable-rpath
    make
    make DESTDIR="$PKG" install
}
