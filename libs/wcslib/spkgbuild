# description : wcslib
# depends : cfitsio make

name=wcslib
version=8.10
release=2
options="!checksum"
source="${name}-${version}.tar.bz2::https://www.atnf.csiro.au/computing/software/wcs/wcslib-releases/${name}-${version}.tar.bz2"

build() {
    cd "wcslib-${version}"
    ./configure --prefix=/usr --libdir=/usr/lib64 --disable-fortran --without-pgplot
    make
    make DESTDIR="$PKG" install
}
