# description	: Contains a library which implements the VDPAU library
# depends	: meson

name=libvdpau
version=1.5
release=1
source="https://gitlab.freedesktop.org/vdpau/${name}/-/archive/$version/${name}-$version.tar.gz"

build() {
	cd $name-$version

  	mkdir build
	cd build

	meson --prefix=/usr
	ninja
	DESTDIR=$PKG ninja install
}
