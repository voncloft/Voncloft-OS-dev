# description   : The libavif package contains a library used for encoding and decoding AVIF files
# depends       : libaom gdk-pixbuf

name=libavif
version=1.4.2
release=1
source=" https://github.com/AOMediaCodec/${name}/archive/v$version/${name}-$version.tar.gz"
options="!checksum"

build() {
        cd $name-$version
        mkdir build 
cd    build 
cmake -D CMAKE_INSTALL_PREFIX=/usr \
-D CMAKE_BUILD_TYPE=Release  \
-D AVIF_CODEC_AOM=SYSTEM     \
-D AVIF_BUILD_GDK_PIXBUF=ON  \
-D AVIF_LIBYUV=OFF           \
-G Ninja .. 
ninja

DESTDIR=$PKG ninja install
}
