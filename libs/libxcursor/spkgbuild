# description	: X cursor management library
# depends	: libxrender libxfixes libx11 

name=libxcursor
version=1.2.3
release=1
_name=libXcursor
source="http://ftp.x.org/pub/individual/lib/${_name}-$version.tar.xz"

build() {
	cd libXcursor-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
