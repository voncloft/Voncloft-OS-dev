# description	: X11 miscellaneous extensions library
# depends	: libx11 

name=libxext
version=1.3.7
release=1
_name=libXext
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXext-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
