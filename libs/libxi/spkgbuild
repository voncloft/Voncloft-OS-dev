# description	: X11 Input extension library
# depends	: libx11 libxext libxfixes

name=libxi
version=1.8.4
release=1
_name=libXi
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXi-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
