# depends : glib help2man libgudev libmbim libmnl meson ninja python
# description : libqmi - KDE dependency

name=libqmi
version=1.38.0
release=1

source="$name-$version.tar.gz::https://gitlab.freedesktop.org/mobile-broadband/libqmi/-/archive/$version/libqmi-$version.tar.gz"
options="!checksum"

build() {
    cd "libqmi-$version"
    meson setup build --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var --buildtype=release -Dgtk_doc=false -Dintrospection=false -Dqrtr=false
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
