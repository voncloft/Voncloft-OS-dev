# description	: X11 XFree86 video mode extension library
# depends	: libx11 libxext 

name=libxxf86vm
version=1.1.7
release=1
_name=libXxf86vm
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXxf86vm-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}

