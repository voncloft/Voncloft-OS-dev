# description : X11 client-side library
# depends     : libxau libxdmcp xcb-proto

name=libxcb
version=1.17.0
release=2
source="https://xorg.freedesktop.org/archive/individual/xcb/${name}-$version.tar.xz"

build() {
    # 64-bit build.
    cd $name-$version
    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static
    LC_ALL=en_US.UTF-8 make
    make DESTDIR=$PKG install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
