# description	: X11 Font Services Library
# depends	: xorgproto xtrans

name=libfs
version=1.0.10
release=1
_name=libFS
source="http://ftp.x.org/pub/individual/lib/${_name}-$version.tar.xz"

build() {
	cd libFS-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
