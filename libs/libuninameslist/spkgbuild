# description	: Large, sparse array mapping each unicode code point to the annotation data for it

name=libuninameslist
version=20260918
release=1
source="https://github.com/fontforge/libuninameslist/releases/download/20260918/libuninameslist-dist-20260918.tar.gz"

build() {
	cd $name-$version

	autoreconf -i
	automake --foreign -Wall

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
