# description : libdrm - KDE dependency
# depends : libpciaccess meson ninja pkgconf udev

name=libdrm
version=2.4.134
release=2

source="$name-$version.tar.xz::https://dri.freedesktop.org/libdrm/libdrm-$version.tar.xz"
options="!checksum"

build() {
    cd "libdrm-$version"
    meson setup build --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var --buildtype=release -Dudev=true -Dvalgrind=disabled -Dtests=false
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
