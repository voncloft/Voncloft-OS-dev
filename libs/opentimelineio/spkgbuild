# description : opentimelineio - KDE dependency
# depends : imath kde-deps-installer rapidjson

name=opentimelineio
version=0.18.1
release=1

_name=OpenTimelineIO
source="$name-$version.tar.gz::https://github.com/AcademySoftwareFoundation/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
    cd "OpenTimelineIO-$version"
    plasma-package-installer -DOTIO_PYTHON_INSTALL=OFF -DOTIO_FIND_IMATH=ON -DOTIO_FIND_RAPIDJSON=ON -DOTIO_AUTOMATIC_SUBMODULES=OFF -DOTIO_DEPENDENCIES_INSTALL=OFF
    cd build
    make DESTDIR="$PKG" install
}
