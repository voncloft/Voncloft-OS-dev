# description	: C library for encoding, decoding and manipulating JSON data

name=jansson
version=2.15.1
release=1
source="https://github.com/akheron/${name}/releases/download/v$version/$name-$version.tar.bz2"

build() {
	cd $name-$version

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}

