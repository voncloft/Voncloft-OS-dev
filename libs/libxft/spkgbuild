# description	: FreeType-based font drawing library for X
# depends	: fontconfig freetype2 libxrender libx11 

name=libxft
version=2.3.9
release=1
_name=libXft
source="http://ftp.x.org/pub/individual/lib/${_name}-$version.tar.xz"

build() {
	cd libXft-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
