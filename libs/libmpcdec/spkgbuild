# description	: MusePack decoding library
# depends	: libcue libreplaygain

name=libmpcdec
version=1.2.6
release=1
source="http://files.musepack.net/source/${name}-$version.tar.bz2"

build() {
	cd "$SRC"/libmpcdec*/
	./configure \
		--prefix=/usr \
		--disable-static
	make
	make DESTDIR=$PKG install
}

