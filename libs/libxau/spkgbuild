# description	: X11 authorisation library
# depends	: xorgproto

name=libxau
version=1.0.12
release=1
_name=libXau
source="https://www.x.org/pub/individual/lib/${_name}-$version.tar.xz"

build() {
	cd libXau-$version

	./configure --prefix=/usr --sysconfdir=/etc \
    		--localstatedir=/var --disable-static
	make
	make DESTDIR=$PKG install
}
