# description : libplacebo
# depends : glslang lcms2 libepoxy meson ninja python python-glad python-jinja vulkan-headers vulkan-loader xxhash

name=libplacebo
version=7.387.0
release=2
options="!checksum"
source="libplacebo-7.387.0.tar.gz::https://github.com/haasn/libplacebo/archive/refs/tags/v7.387.0.tar.gz"

build() {
    cd "libplacebo-7.387.0"
    meson setup build --prefix=/usr --libdir=lib64 --buildtype=release \
        --wrap-mode=nofallback -Ddemos=false -Dtests=false \
        -Dopengl=enabled -Dvulkan=enabled -Dglslang=enabled
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
