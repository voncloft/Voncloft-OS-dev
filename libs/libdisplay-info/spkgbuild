# depends : hwdata meson ninja python
# description : libdisplay-info - KDE dependency

name=libdisplay-info
version=0.4.0
release=1

source="$name-$version.tar.xz::https://gitlab.freedesktop.org/emersion/libdisplay-info/-/releases/$version/downloads/libdisplay-info-$version.tar.xz"
options="!checksum"

build() {
    cd "libdisplay-info-$version"
    meson setup build --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var --buildtype=release 
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
