# description   : The libei package contains a set of libraries for handling emulated inputs
# depends       : elogind

name=libei
version=1.6.0    
release=1
source="https://gitlab.freedesktop.org/libinput/${name}/-/archive/${version}/${name}-${version}.tar.bz2"

options="!checksum"

build() {
    cd $name-$version
    
    mkdir build 
    cd    build 
    meson setup --prefix=/usr --buildtype=release -D tests=disabled 
    ninja
    DESTDIR=$PKG ninja install
}
