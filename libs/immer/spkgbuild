# description : immer
# depends : boost cmake make

name=immer
version=0.9.1
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/arximboldi/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cd "immer-${version}"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -Dimmer_BUILD_TESTS=OFF \
        -Dimmer_BUILD_EXAMPLES=OFF \
        -Dimmer_BUILD_DOCS=OFF \
        -Dimmer_BUILD_EXTRAS=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
