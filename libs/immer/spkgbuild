# description : immer
# depends : boost cmake make

name=immer
version=0.9.1
release=2
options="!checksum"
source="immer-0.9.1.tar.gz::https://github.com/arximboldi/immer/archive/refs/tags/v0.9.1.tar.gz"

build() {
    cd "immer-0.9.1"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -Dimmer_BUILD_TESTS=OFF \
        -Dimmer_BUILD_EXAMPLES=OFF \
        -Dimmer_BUILD_DOCS=OFF \
        -Dimmer_BUILD_EXTRAS=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
