# description	: X11 font rasterisation library
# depends	: zlib libfontenc freetype2 xtrans

name=libxfont2
version=2.0.9
release=1
source="https://www.x.org/pub/individual/lib/libXfont2-2.0.9.tar.gz"

build() {
	cd libXfont2-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static \
		--disable-devel-docs
	make
	make DESTDIR=$PKG install
}
