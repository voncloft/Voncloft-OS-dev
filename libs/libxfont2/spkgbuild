# description : X11 font rasterisation library
# depends     : zlib libfontenc freetype2 xtrans

name=libxfont2
version=2.0.9
release=3
_name=libXfont2
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
    # 64-bit build.
    cd libXfont2-$version

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --disable-devel-docs
    make
    make DESTDIR=$PKG install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --disable-devel-docs
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
