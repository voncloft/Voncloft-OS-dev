# description : libvncserver - KDE dependency
# depends : kde-deps-installer libgcrypt libjpeg-turbo libpng libxcb lzo openssl zlib

name=libvncserver
version=0.9.15
release=1

source="$name-$version.tar.gz::https://github.com/LibVNC/libvncserver/archive/refs/tags/LibVNCServer-$version.tar.gz"
options="!checksum"

build() {
    cd "libvncserver-LibVNCServer-$version"
    plasma-package-installer -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_SHARED_LIBS=ON -DWITH_EXAMPLES=OFF -DWITH_TESTS=OFF -DWITH_SYSTEMD=OFF
    cd build
    make DESTDIR="$PKG" install
}
