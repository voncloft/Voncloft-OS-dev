# description	: Small and modern C++ library, offering some basic functionality to build high-performing, platform-independent programs
# depends	: nettle gnutls

name=libfilezilla
version=0.58.0
release=1
source="https://dl3.cdn.filezilla-project.org/libfilezilla/libfilezilla-${version}.tar.xz?h=N5JB4C8bYI_0FLSAp63cGw&x=1793098558"

build() {
	cd $name-$version
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install
}
