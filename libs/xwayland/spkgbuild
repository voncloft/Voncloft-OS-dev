# description : The Xwayland package is an Xorg server running on top of the wayland server. It has been separated from the main Xorg server package. It allows running X clients inside a wayland session.
# depends : libxcvt pixman wayland-protocols xorg-fonts libepoxy libtirpc mesa xorg-libraries

name=xwayland
version=24.1.14
release=1

source="https://www.x.org/pub/individual/xserver/${name}-$version.tar.xz"

build() {
	cd $name-$version

	mkdir build 
	cd    build 

	meson --prefix=/usr         \
      	--buildtype=release           \
      	-Dxkb_output_dir=/var/lib/xkb \
      	..
     	ninja || return 1
     	DESTDIR="$PKG" ninja install || return 1
        # Common server documentation is owned by xorg-server.
        rm -v "$PKG/usr/lib64/xorg/protocol.txt" \
              "$PKG/usr/share/man/man1/Xserver.1"
}
