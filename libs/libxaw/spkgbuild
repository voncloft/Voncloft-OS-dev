# description	: X11 Athena Widget library
# depends	: libxext libxmu libxt libx11 libxpm 

name=libxaw
version=1.0.16
release=1
_name=libXaw
source="http://ftp.x.org/pub/individual/lib/${_name}-$version.tar.xz"

build() {
	cd libXaw-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}

