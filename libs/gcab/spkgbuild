# description	: A GObject library to create cabinet files
# depends	: glib glib vala meson

name=gcab
version=1.5
release=1
source="https://ftp.gnome.org/pub/GNOME/sources/${name}/$version/$name-$version.tar.xz"

build() {
	cd $name-$version

	mkdir build
	cd build

	meson \
		--prefix=/usr \
		-Ddocs=false \
		-Dtests=false
	ninja
	DESTDIR=$PKG ninja install
}
