# description	: X11 Direct Graphics Access extension library
# depends	: libx11 libxext 

name=libxxf86dga
version=1.1.7
release=1
source="https://www.x.org/pub/individual/lib/libXxf86dga-1.1.7.tar.gz"

build() {
	cd libXxf86dga-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
