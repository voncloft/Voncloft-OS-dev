# description : A C++/Qt client library for gpodder.net
# depends : qt6

name=libmygpo-qt6
version=1.2.0
release=3

source="https://github.com/gpodder/libmygpo-qt/archive/refs/tags/1.2.0.tar.gz"
options="!checksum"

build() {
	cd "$SRC"/libmygpo-qt*/
	mkdir build
	cd build
	cmake ..  \
    	-DCMAKE_BUILD_TYPE='Release' \
    	-DCMAKE_INSTALL_PREFIX='/usr' \
    	-DMYGPO_BUILD_TESTS=OFF
	make
	make DESTDIR=$PKG install
}
