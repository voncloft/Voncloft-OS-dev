# description	: Window Navigator Construction Kit
# depends	: gtk2 startup-notification

name=libwnck2
version=2.30.7
release=1
_name=libwnck
source="https://ftp.gnome.org/pub/gnome/sources/${_name}/${version%.*}/${_name}-$version.tar.xz"

build() {
	cd "$SRC"/libwnck*/

	./configure --prefix=/usr \
	            --disable-static \
	            --program-suffix=-1
	make GETTEXT_PACKAGE=libwnck-1
	make GETTEXT_PACKAGE=libwnck-1 DESTDIR=$PKG install
}
