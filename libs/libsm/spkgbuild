# description	: X11 Session Management library
# depends	: libice util-linux 

name=libsm
version=1.2.6
release=1
_name=libSM
source="https://www.x.org/archive//individual/lib/${_name}-$version.tar.xz"

build() {
	cd libSM-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
