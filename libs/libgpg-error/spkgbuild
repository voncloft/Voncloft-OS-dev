# depends     :
# description : Library that defines common error values for all GnuPG components

name=libgpg-error
version=1.61
release=3
source="https://www.gnupg.org/ftp/gcrypt/${name}/${name}-${version}.tar.bz2"
options="!checksum"

build() {
    # 64-bit build.
    cd $name-$version

    # allow building with gawk-5.0

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr
    make
    make DESTDIR=$PKG install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --includedir=/usr/include/m32/libgpg-error \
        --host=i686-pc-linux-gnu \
        --disable-static
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    mkdir -p "$PKG/usr/include/m32"
    cp -a DESTDIR/usr/include/m32/. "$PKG/usr/include/m32/"
    # Select the matching ABI even when a consumer does not use pkg-config.
    mv "$PKG/usr/include/gpg-error.h" "$PKG/usr/include/gpg-error-64.h"
    printf '%s\n' \
        '#if defined(__i386__)' \
        '#include "m32/libgpg-error/gpg-error.h"' \
        '#else' \
        '#include "gpg-error-64.h"' \
        '#endif' > "$PKG/usr/include/gpg-error.h"
    # Select the matching ABI even when a consumer does not use pkg-config.
    mv "$PKG/usr/include/gpgrt.h" "$PKG/usr/include/gpgrt-64.h"
    printf '%s\n' \
        '#if defined(__i386__)' \
        '#include "m32/libgpg-error/gpgrt.h"' \
        '#else' \
        '#include "gpgrt-64.h"' \
        '#endif' > "$PKG/usr/include/gpgrt.h"
    rm -rf DESTDIR
}
