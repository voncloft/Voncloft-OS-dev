# description : lager
# depends : boost cmake immer make zug

name=lager
version=0.1.3
release=2
options="!checksum"
source="lager-0.1.3.tar.gz::https://github.com/arximboldi/lager/archive/refs/tags/v0.1.3.tar.gz"

build() {
    cd "lager-0.1.3"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -Dlager_BUILD_TESTS=OFF \
        -Dlager_BUILD_FAILURE_TESTS=OFF \
        -Dlager_BUILD_EXAMPLES=OFF \
        -Dlager_BUILD_DEBUGGER_EXAMPLES=OFF \
        -Dlager_BUILD_DOCS=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
