# description : lib bluray playback
# depends : fontconfig freetype2 libxml2 libudfread

name=libbluray
version=1.5.0
release=1

source="https://download.videolan.org/pub/videolan/libbluray/1.5.0/libbluray-1.5.0.tar.xz"
options="!checksum"

build() {
	cd "$SRC"/libbluray*/
	autoreconf -ifv
	autoconf
	./configure --prefix=/usr --disable-bdjava-jar
	make
	make DESTDIR=$PKG install
}
