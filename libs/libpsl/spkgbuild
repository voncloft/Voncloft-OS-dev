# description : Library for accessing and resolving information from the Public Suffix List
# depends     : libidn2 libunistring python

name=libpsl
version=0.23.3
release=3
source="https://github.com/rockdaboot/${name}/releases/download/$version/${name}-$version.tar.gz"

build() {
    # 64-bit build.
    cd $name-$version
    sed -i '1s/env python$/env python3/' src/psl-make-dafsa
    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --disable-static
    make
    make DESTDIR=$PKG install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --disable-static
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
