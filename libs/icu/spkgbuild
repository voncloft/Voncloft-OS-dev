# depends     :
# description : International Components for Unicode libraries

name=icu
version=79.1
release=5
_name=icu
_source_name=icu4c
source="https://github.com/unicode-org/${_name}/releases/download/release-${version}/${_source_name}-${version}-sources.tgz
        bidi-array-overflow.patch"

build() {
    # 64-bit build.
    export CC=gcc
    export CXX=g++
    cd "$SRC/icu/source"
    patch --fuzz=0 -p1 < "$SRC/bidi-array-overflow.patch"
    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static
    make
    make DESTDIR="$PKG" install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH
    export CFLAGS="$CFLAGS -msse2 -mfpmath=sse"
    export CXXFLAGS="$CXXFLAGS -msse2 -mfpmath=sse"

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --disable-static
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
