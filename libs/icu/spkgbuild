# description : International Components for Unicode libraries

name=icu
version=79.1
release=4
_name=icu
_source_name=icu4c
source="https://github.com/unicode-org/${_name}/releases/download/release-${version}/${_source_name}-${version}-sources.tgz
        bidi-array-overflow.patch"

build() {
    export CC=gcc
    export CXX=g++
    cd "$SRC/icu/source"
    patch --fuzz=0 -p1 < "$SRC/bidi-array-overflow.patch"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make
    make DESTDIR="$PKG" install
}
