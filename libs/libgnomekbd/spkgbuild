# description : xkb hooks used by gnome desktop
# depends : gtk3 intltool libxklavier glib

name=libgnomekbd
version=3.28.1
release=1

source="https://download.gnome.org/sources/libgnomekbd/3.28/libgnomekbd-3.28.1.tar.xz"
options="!checksum"

build() {
	cd "$SRC"/libgnomekbd*/
	autoreconf -ifv
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
      	--disable-schemas-compile --disable-static
	make
	make DESTDIR=$PKG install
}
