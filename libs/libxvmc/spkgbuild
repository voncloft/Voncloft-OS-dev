# description	: X11 Video Motion Compensation extension library
# depends	: libx11 libxext libxv 

name=libxvmc
version=1.0.15
release=1
_name=libXvMC
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXvMC-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
