# description : X11 keyboard file manipulation library
# depends     : libx11 util-macros xorgproto meson ninja

name=libxkbfile
version=1.2.0
release=4
source="https://www.x.org/pub/individual/lib/libxkbfile-$version.tar.xz"

build() {
    # 64-bit build.
    cd "libxkbfile-$version"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release
    meson compile -C build
    DESTDIR="$PKG" meson install -C build

    # 32-bit build.
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
