# depends : libx11 util-macros xorgproto
# description	: X11 keyboard file manipulation library

name=libxkbfile
version=1.1.3
release=2
options="!checksum"
source="http://ftp.x.org/pub/individual/lib/libxkbfile-$version.tar.xz"

build() {
	cd libxkbfile-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
