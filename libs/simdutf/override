# Read the current stable release from official upstream metadata.
source="https://api.github.com/repos/simdutf/simdutf/releases/latest"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import json,pathlib,re
release=json.loads(pathlib.Path('index.html').read_text())
tag=release.get('tag_name','')
if release.get('draft') or release.get('prerelease') or not re.fullmatch(r'v[0-9]+\.[0-9]+\.[0-9]+',tag):
    raise SystemExit('No stable simdutf release found')
print(tag[1:])
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
