# description	: PDF rendering library and command line tools used to manipulate PDF files
# depends	: boost brotli cairo cmake curl fontconfig freetype2 glib gpgmepp harfbuzz lcms2 libjpeg-turbo libpng libtiff ninja nss openjpeg pkgconf poppler-data qt6 zlib

name=poppler
version=26.10.0
release=2
source="https://poppler.freedesktop.org/$name-$version.tar.xz"

build() {
    cd "$SRC/$name-$version"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DENABLE_UNSTABLE_API_ABI_HEADERS=ON \
        -DENABLE_CPP=ON \
        -DENABLE_GLIB=ON \
        -DENABLE_GOBJECT_INTROSPECTION=ON \
        -DENABLE_QT5=OFF \
        -DENABLE_QT6=ON \
        -DENABLE_BROTLI=ON \
        -DBUILD_MANUAL_TESTS=OFF \
        -DBUILD_CPP_TESTS=OFF \
        -DBUILD_GTK_TESTS=OFF \
        -DBUILD_QT5_TESTS=OFF \
        -DBUILD_QT6_TESTS=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
