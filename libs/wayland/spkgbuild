# depends     : expat libffi libxml2 meson ninja pkgconf
# description : wayland - KDE dependency

name=wayland
version=1.26.0
release=2

source="$name-$version.tar.xz::https://gitlab.freedesktop.org/${name}/${name}/-/releases/$version/downloads/${name}-$version.tar.xz"
options="!checksum"

build() {
    # 64-bit build.
    cd "wayland-$version"
    meson setup build \
        --prefix=/usr \
        --libdir=lib64 \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --buildtype=release \
        -Ddocumentation=false \
        -Dtests=false
    ninja -C build
    DESTDIR="$PKG" ninja -C build install

    # 32-bit build.
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Ddocumentation=false \
        -Dtests=false
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
