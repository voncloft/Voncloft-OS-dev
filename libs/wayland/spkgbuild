# depends : expat libffi libxml2 meson ninja pkgconf
# description : wayland - KDE dependency

name=wayland
version=1.26.0
release=2

source="$name-$version.tar.xz::https://gitlab.freedesktop.org/${name}/${name}/-/releases/$version/downloads/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "wayland-$version"
    meson setup build --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var --buildtype=release -Ddocumentation=false -Dtests=false
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
