# description : pystring
# depends : cmake make

name=pystring
version=1.2.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/imageworks/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cd "pystring-${version}"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
