# description : iCalendar protocol and data-format libraries
# depends : cmake vala icu libxml2 glib
# GLib supplies the GObject Introspection tools on Voncloft OS.

name=libical
version=4.0.7
release=2
source="https://github.com/libical/$name/releases/download/v$version/$name-$version.tar.gz"

build() {
    cd "$name-$version"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release -DLIBICAL_STATIC=false \
        -DLIBICAL_BUILD_DOCS=false -DLIBICAL_GLIB_BUILD_DOCS=false \
        -DLIBICAL_GOBJECT_INTROSPECTION=true -DLIBICAL_GLIB_VAPI=true \
        -DLIBICAL_BUILD_TESTING=false
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
