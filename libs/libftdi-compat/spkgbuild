# description : library to talk to ftdi chips
# depends : gcc libusb-compat

name=libftdi-compat
version=0.20
release=8

_name=libftdi
source="https://www.intra2net.com/en/developer/${_name}/download/${_name}-$version.tar.gz"
options="!checksum"

build() {
	cd libftdi-$version
	./configure --prefix=/usr --without-examples
    make
    make DESTDIR=$PKG install
}
