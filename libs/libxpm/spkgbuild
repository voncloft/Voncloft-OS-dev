# description	: X11 pixmap library
# depends	: libxt libxext libx11 

name=libxpm
version=3.5.20
release=1
source="https://www.x.org/pub/individual/lib/libXpm-3.5.20.tar.gz"

build() {
	cd libXpm-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
