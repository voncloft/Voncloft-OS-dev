# description : An high dynamic-range image file format library 
# depends : zlib imath

name=openexr
version=3.5.3
release=3

source="${name}-${version}.tar.gz::https://github.com/openexr/${name}/archive/v$version.tar.gz"
options="!checksum"

build() {
	cd $name-$version
	mkdir build
	cd build
	cmake .. \
	-DCMAKE_INSTALL_PREFIX=/usr

	make

	make DESTDIR=$PKG install
}
