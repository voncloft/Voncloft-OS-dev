# description	: A library that feh uses as a wrapper to imlib2
# depends	: freetype2 imlib2 libxext

name=giblib
version=1.2.4
release=1
source="https://downloads.sourceforge.net/project/slackbuildsdirectlinks/${name}/${name}-${version}.tar.gz
	giblib.patch"
build() {
	cd "$SRC"/giblib*/
	patch -Np1 -i "${SRC}/giblib.patch"
	autoreconf -ifv
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG docsdir=/usr/share/doc/giblib install
	rm -r $PKG/usr/share
}
