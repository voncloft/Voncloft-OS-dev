# description	: Libraries that support programs that use the Remote Procedure Call (RPC) API

name=libtirpc
version=1.3.8
release=1
source="https://downloads.sourceforge.net/${name}/$name-$version.tar.bz2
	https://www.linuxfromscratch.org/patches/blfs/svn/${name}-$version-gcc15_fixes-1.patch"

build() {
	cd $name-$version
	patch -Np1 -i $SRC/libtirpc-1.3.6-gcc15_fixes-1.patch
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-static \
		--disable-gssapi
	make
	make DESTDIR=$PKG install
}
