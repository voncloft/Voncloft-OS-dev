# description	: Libraries that support programs that use the Remote Procedure Call (RPC) API

name=libtirpc
version=1.3.8
release=2
source="https://downloads.sourceforge.net/project/${name}/${name}/${version}/$name-$version.tar.bz2"
backup="etc/netconfig etc/bindresvport.blacklist"

build() {
	cd $name-$version
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-static \
		--disable-gssapi
	make
	make DESTDIR=$PKG install
}
