# description : libolm - KDE dependency
# depends : kde-deps-installer

name=libolm
version=3.2.16
release=1

_name=olm
source="$name-$version.tar.gz::https://gitlab.matrix.org/matrix-org/${_name}/-/archive/$version/${_name}-$version.tar.gz"
options="!checksum"

build() {
    cd "olm-$version"
    plasma-package-installer -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_SHARED_LIBS=ON -DOLM_TESTS=OFF
    cd build
    make DESTDIR="$PKG" install
}
