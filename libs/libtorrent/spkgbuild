# description	: A C++ BitTorrent library that aims to be a good alternative to all the other implementations around
# depends	: boost python cmake

name=libtorrent
version=2.1.2
release=1
source="https://github.com/arvidn/${name}/archive/refs/tags/v$version.tar.gz"

build() {
    cd "$SRC/$name-$version"
    cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON -Dpython-bindings=ON -Dbuild_examples=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
