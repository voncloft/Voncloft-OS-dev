# description : Simple C API for reading and writing ESRI shapefiles
# depends : gcc

name=shapelib
version=1.6.3
release=3

source="https://download.osgeo.org/shapelib/shapelib-1.6.3.tar.gz"
options="!checksum"

build() {
	cd "$SRC"/shapelib*/
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
