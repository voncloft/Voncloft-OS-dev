# description	: Software library that implements a self-contained, serverless, zero-configuration, transactional SQL database engine
# depends	: zlib readline ncurses tcl

name=sqlite
version=3540100
release=1
_upstream_version="$((version / 1000000)).$((version / 10000 % 100)).$((version / 100 % 100))"
source="${name}-${version}.tar.gz::https://sqlite.org/src/tarball/${name}-${version}.tar.gz?r=version-${_upstream_version}"
options="!checksum"
build() {
	cd $name-$version

	./configure --prefix=/usr     \
            --disable-static  \
            --disable-tcl     \
            --enable-fts{4,5} \
            CPPFLAGS="-D SQLITE_ENABLE_COLUMN_METADATA=1 \
                      -D SQLITE_ENABLE_UNLOCK_NOTIFY=1   \
                      -D SQLITE_ENABLE_DBSTAT_VTAB=1     \
                      -D SQLITE_SECURE_DELETE=1" 
	make
	make DESTDIR=$PKG install
}
