# description	: Fraunhofer FDK AAC library, which is purported to be a high quality Advanced Audio Coding implementation

name=fdk-aac
version=3.0.0
release=1
source="https://downloads.sourceforge.net/project/opencore-amr/fdk-aac/fdk-aac-3.0.0.tar.gz"

build() {
	cd "$SRC"/fdk-aac*/

	./configure --prefix=/usr    \
	            --disable-static
	make
	make DESTDIR=$PKG install
}
