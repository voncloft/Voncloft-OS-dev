# description:	library that provides type definitions for NVMe structures
# depends:	

name=libnvme
version=1.16.2
release=1

source="https://github.com/linux-nvme/${name}/archive/v${version}/${name}-$version.tar.gz"

build()
{
	cd *
	

	mkdir build &&
	cd    build &&

	meson setup --prefix=/usr --buildtype=release -D libdbus=auto .. &&
	ninja

	DESTDIR=$PKG ninja install
}
