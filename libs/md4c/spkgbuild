# description : md4c
# depends : cmake make

name=md4c
version=0.6.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/mity/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cd "md4c-${version}"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_MD2HTML_EXECUTABLE=ON \
        -DBUILD_TESTS=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
