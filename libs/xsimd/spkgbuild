# description : xsimd
# depends : cmake make

name=xsimd
version=14.3.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/xtensor-stack/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    cd "xsimd-${version}"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_TESTS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DENABLE_XTL_COMPLEX=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
