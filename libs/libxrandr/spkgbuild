# description	: X11 RandR extension library
# depends	: libxext libxrender libx11 

name=libxrandr
version=1.5.5
release=1
source="https://www.x.org/pub/individual/lib/libXrandr-1.5.5.tar.gz"

build() {
	cd libXrandr-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
