# description	: X11 Composite extension library
# depends	: libx11 libxfixes

name=libxcomposite
version=0.4.7
release=1
_name=libXcomposite
source="http://ftp.x.org/pub/individual/lib/${_name}-$version.tar.xz"

build() {
	cd libXcomposite-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
