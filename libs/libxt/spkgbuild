# description	: X11 toolkit intrinsics library
# depends	: libsm libice libx11 

name=libxt
version=1.3.1
release=1
_name=libXt
source="http://ftp.x.org/pub/individual/lib/${_name}-$version.tar.xz"

build() {
	cd libXt-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static \
		--with-appdefaultdir=/etc/X11/app-defaults
	make
	make DESTDIR=$PKG install
}
