# description : netcdf
# depends : cmake curl hdf5 libxml2 make zlib

name=netcdf
version=4.10.1
release=2
options="!checksum"
_name=netcdf-c
source="${name}-${version}.tar.gz::https://github.com/Unidata/${_name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cd "netcdf-c-${version}"
    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DNETCDF_ENABLE_TESTS=OFF \
        -DNETCDF_ENABLE_EXAMPLES=OFF \
        -DNETCDF_ENABLE_HDF5=ON
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
