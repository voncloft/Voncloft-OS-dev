# note : A Secret Service provider is needed at runtime; Plasma can use KWallet.
# depends : glib gnutls libgcrypt vala meson ninja
# description   : The libsecret package contains a GObject based library for accessing the Secret Service API

name=libsecret
version=0.21.8.2    
release=3
_minor=${version#*.}
source="https://download.gnome.org/sources/${name}/${version%%.*}.${_minor%%.*}/${name}-${version}.tar.xz"

options="!checksum"

build() {
        cd $name-$version
        mkdir bld 
cd    bld 
meson setup --prefix=/usr       \
--buildtype=release \
-D gtk_doc=false    \
..                  
ninja
DESTDIR=$PKG ninja install
}
