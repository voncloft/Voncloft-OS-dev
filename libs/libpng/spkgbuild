# description	: A collection of routines used to create PNG format graphics files
# depends	: zlib

name=libpng
version=1.6.59
release=2
source="https://downloads.sourceforge.net/project/$name/libpng16/$version/$name-$version.tar.gz
	https://downloads.sourceforge.net/project/apng/$name/libpng16/$name-$version-apng.patch.gz"
build() {
	cd $name-$version

	gzip -cd $SRC/$name-$version-apng.patch.gz | patch --fuzz=0 -p0

	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install
}
