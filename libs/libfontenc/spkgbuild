# description	: X11 font encoding library
# depends	: zlib font-util xorgproto

name=libfontenc
version=1.1.9
release=2
source="https://www.x.org/pub/individual/lib/${name}-$version.tar.xz"

build() {
	cd libfontenc-$version

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PKG install
}
