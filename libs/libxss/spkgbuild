# description : x11 screensavers
# depends : libxext

name=libxss
version=1.2.5
release=3

_name=libXScrnSaver
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"
options="!checksum"

build() {
	cd libXScrnSaver-$version
	./configure --prefix=/usr --sysconfdir=/etc
	make
	make DESTDIR=$PKG install

}
