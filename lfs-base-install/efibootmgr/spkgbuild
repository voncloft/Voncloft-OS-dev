# description	: Manipulate efi boot managers
# depends	: efivar

name=efibootmgr
version=0.12
release=1
source="$name-$version.tar.gz::https://github.com/rhboot/${name}/archive/$version.tar.gz"

build() {
	cd $name-$version

	make EFIDIR=LFS EFI_LOADER=grubx64.efi
	make DESTDIR=$PKG install EFIDIR=LFS
}
