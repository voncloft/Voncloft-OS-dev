# description : Heap memory profiler for finding allocation hotspots, excessive allocations, and memory leaks
# depends : boost elfutils extra-cmake-modules kde-deps-installer libunwind qt6 zlib zstd

name=heaptrack
version=1.5.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/sdk/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "heaptrack-v${version}"
    plasma-package-installer \
        -DHEAPTRACK_USE_QT6=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    cd build
    make DESTDIR="$PKG" install
}
