# description : Heaptrack
# depends : boost elfutils extra-cmake-modules kde-deps-installer libunwind qt6 zlib zstd

name=heaptrack
version=1.5.0
release=2
options="!checksum"
source="heaptrack-1.5.0.tar.gz::https://invent.kde.org/sdk/heaptrack/-/archive/v1.5.0/heaptrack-v1.5.0.tar.gz"

build() {
    cd "heaptrack-v1.5.0"
    plasma-package-installer \
        -DHEAPTRACK_USE_QT6=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    cd build
    make DESTDIR="$PKG" install
}
