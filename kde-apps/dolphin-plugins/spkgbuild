# description : Dolphin extensions for version control integration and additional file management actions
# depends : dolphin extra-cmake-modules kconfig kcoreaddons kde-deps-installer ki18n kio kservice ktexteditor ktextwidgets kxmlgui qt6 solid

name=dolphin-plugins
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "dolphin-plugins-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
