# description : Core components for the kde desktop
# depends : extra-cmake-modules kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes knewstuff kwidgetsaddons kxmlgui libkdegames qt6

name=picmi
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/picmi-$version.tar.xz"
options="!checksum"

build() {
    cd "picmi-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
