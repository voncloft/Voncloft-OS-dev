# description : Developer utilities for inspecting Qt interfaces and testing KDE application components
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n kio kparts kwidgetsaddons qt6

name=kde-dev-utils
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kde-dev-utils-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
