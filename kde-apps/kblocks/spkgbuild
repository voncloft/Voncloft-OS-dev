# description : Falling-block puzzle game in which players arrange pieces to clear complete rows
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kwidgetsaddons kxmlgui libkdegames qt6

name=kblocks
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kblocks-$version.tar.xz"
options="!checksum"

build() {
    cd "kblocks-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
