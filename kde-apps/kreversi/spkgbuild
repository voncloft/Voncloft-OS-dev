# description : Reversi board game in which players flip opposing pieces to control the board
# depends : extra-cmake-modules kcolorscheme kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio kjobwidgets kwidgetsaddons kxmlgui libkdegames qt6

name=kreversi
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kreversi-$version.tar.xz"
options="!checksum"

build() {
    cd "kreversi-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
