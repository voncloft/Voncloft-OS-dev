# description : Logic puzzle game in which players slide atoms into position to assemble molecules
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes knewstuff kwidgetsaddons kxmlgui libkdegames qt6

name=katomic
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/katomic-$version.tar.xz"
options="!checksum"

build() {
    cd "katomic-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
