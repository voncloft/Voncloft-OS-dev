# description : Backup application for saving selected files and folders into archive sets
# depends : extra-cmake-modules karchive kconfig kcoreaddons kde-deps-installer kdoctools kguiaddons ki18n kiconthemes kio knotifications kstatusnotifieritem kwidgetsaddons kxmlgui libarchive qt6 shared-mime-info

name=kbackup
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kbackup-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
