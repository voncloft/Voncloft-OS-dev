# description : kdev-python - KDE gear component
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer kdevelop ki18n kparts kservice ktexteditor kwidgetsaddons kxmlgui python qt6 threadweaver

name=kdev-python
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kdev-python-$version.tar.xz"
options="!checksum"

build() {
    cd "kdev-python-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
