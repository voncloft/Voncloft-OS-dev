# description : Library for parsing and generating MIME email messages and headers
# depends : extra-cmake-modules kcodecs kde-deps-installer qt6

name=kmime
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kmime-$version.tar.xz"
options="!checksum"

build() {
    cd "kmime-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
