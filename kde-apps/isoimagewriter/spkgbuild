# description : Utility for writing ISO disk images to USB drives and checking image integrity
# depends : extra-cmake-modules karchive kauth kconfig kcoreaddons kcrash kde-deps-installer ki18n kiconthemes kwidgetsaddons qt6 solid

name=isoimagewriter
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "isoimagewriter-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
