# description : Calculator for evaluating mathematical expressions and plotting two- and three-dimensional functions
# depends : analitza extra-cmake-modules kconfigwidgets kcoreaddons kde-deps-installer kdoctools ki18n kio kwidgetsaddons kxmlgui libplasma qt6

name=kalgebra
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kalgebra-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
