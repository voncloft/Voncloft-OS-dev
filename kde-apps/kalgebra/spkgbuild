# description : Core components for the kde desktop
# depends : analitza extra-cmake-modules kconfigwidgets kcoreaddons kde-deps-installer kdoctools ki18n kio kwidgetsaddons kxmlgui libplasma qt6

name=kalgebra
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kalgebra-$version.tar.xz"
options="!checksum"

build() {
    cd "kalgebra-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
