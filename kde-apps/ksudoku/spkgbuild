# description : Sudoku game with puzzle generation, solving assistance, and several board variants
# depends : extra-cmake-modules karchive kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools kguiaddons ki18n kiconthemes kio kjobwidgets kwidgetsaddons kxmlgui libkdegames qt6

name=ksudoku
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/ksudoku-$version.tar.xz"
options="!checksum"

build() {
    cd "ksudoku-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
