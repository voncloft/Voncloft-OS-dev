# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer ki18n kparts qt6

name=markdownpart
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/markdownpart-$version.tar.xz"
options="!checksum"

build() {
    cd "markdownpart-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
