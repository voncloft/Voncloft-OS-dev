# description : Geography learning application with maps and quizzes about countries, regions, capitals, and flags
# depends : extra-cmake-modules kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kiconthemes kitemviews kwidgetsaddons kxmlgui qt6

name=kgeography
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kgeography-$version.tar.xz"
options="!checksum"

build() {
    cd "kgeography-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
