# description : frontend for scanner
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kde-deps-installer ki18n kio kirigami kquickimageeditor ksanecore kxmlgui leptonica purpose qt6 tesseract

name=skanpage
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/skanpage-$version.tar.xz"
options="!checksum"

build() {
    cd "skanpage-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
