# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools kguiaddons ki18n kirigami kirigami-addons kxmlgui qt6

name=blinken
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/blinken-$version.tar.xz"
options="!checksum"

build() {
    cd "blinken-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
