# description : Mahjong solitaire game in which players remove matching pairs of tiles
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n knewstuff kxmlgui libkdegames libkmahjongg qt6

name=kmahjongg
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kmahjongg-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
