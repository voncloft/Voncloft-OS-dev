# description : Two-player space combat game with orbiting spacecraft, gravity, and projectiles
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kxmlgui libkdegames qt6

name=kspaceduel
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kspaceduel-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
