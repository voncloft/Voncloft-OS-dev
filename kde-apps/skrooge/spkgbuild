# description : Personal finance manager for tracking transactions, categorizing spending, and creating financial reports
# depends : extra-cmake-modules karchive kcodecs kcolorscheme kcompletion kconfig kconfigwidgets kcoreaddons kde-deps-installer kdoctools kguiaddons ki18n kiconthemes kio kitemviews knewstuff knotifications knotifyconfig kparts ktexttemplate kwallet kwidgetsaddons kxmlgui qt6 sqlcipher

name=skrooge
version=26.8.0
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${name}-${version}.tar.xz"

build() {
    cd "skrooge-${version}"
    plasma-package-installer \
        -DSKG_BUILD_TEST=OFF \
        -DSKG_DESIGNER=OFF
    cd build
    make DESTDIR="$PKG" install
}
