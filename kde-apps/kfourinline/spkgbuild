# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdnssd kdoctools ki18n kiconthemes kwidgetsaddons kxmlgui libkdegames qt6

name=kfourinline
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kfourinline-$version.tar.xz"
options="!checksum"

build() {
    cd "kfourinline-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
