# description : Alphabet learning application that teaches letters and syllables through recorded pronunciation
# depends : extra-cmake-modules kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n knewstuff kwidgetsaddons kxmlgui qt6

name=klettres
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "klettres-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
