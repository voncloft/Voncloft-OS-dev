# description : Qt library for discovering network services and devices using the WS-Discovery protocol
# depends : extra-cmake-modules kde-deps-installer kdsoap qt6

name=kdsoap-ws-discovery-client
version=0.4.0
release=2

source="https://download.kde.org/stable/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdsoap-ws-discovery-client-$version"
    plasma-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
