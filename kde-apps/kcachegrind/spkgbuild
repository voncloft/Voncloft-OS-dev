# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kconfig kcoreaddons kdbusaddons kde-deps-installer kdoctools ki18n kio kwidgetsaddons kxmlgui qt6

name=kcachegrind
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kcachegrind-$version.tar.xz"
options="!checksum"

build() {
    cd "kcachegrind-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
