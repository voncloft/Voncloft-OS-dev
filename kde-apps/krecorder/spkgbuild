# description : Audio recording application for capturing, playing back, and managing recordings
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer ki18n kio kirigami kirigami-addons qt6

name=krecorder
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/krecorder-$version.tar.xz"
options="!checksum"

build() {
    cd "krecorder-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
