# description : Snake racing game in which players avoid walls and the trails left by moving snakes
# depends : extra-cmake-modules kcompletion kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools kguiaddons ki18n kiconthemes kwidgetsaddons kxmlgui libkdegames qt6

name=ksnakeduel
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/ksnakeduel-$version.tar.xz"
options="!checksum"

build() {
    cd "ksnakeduel-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
