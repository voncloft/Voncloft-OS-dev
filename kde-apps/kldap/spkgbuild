# description : Core components for the kde desktop
# depends : cyrus-sasl extra-cmake-modules kde-deps-installer kdoctools ki18n kio kwidgetsaddons qt6 qtkeychain

name=kldap
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kldap-$version.tar.xz"
options="!checksum"

build() {
    cd "kldap-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
