# description : Libraries and settings components for integrating online accounts with KDE applications
# depends : extra-cmake-modules kcmutils kcoreaddons kdbusaddons kde-deps-installer ki18n kio kwallet libaccounts-qt qcoro qt6 signond

name=kaccounts-integration
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kaccounts-integration-$version.tar.xz"
options="!checksum"

build() {
    cd "kaccounts-integration-$version"
    plasma-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
