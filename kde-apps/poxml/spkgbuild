# description : Tools for translating XML documentation using gettext PO message catalogs
# depends : extra-cmake-modules gettext kde-deps-installer kdoctools qt6

name=poxml
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "poxml-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
