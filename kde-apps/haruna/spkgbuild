# description : MPV-based media player with playlist controls and support for local files and online video
# depends : breeze extra-cmake-modules ffmpeg kcolorscheme kconfig kcoreaddons kcrash kde-deps-installer kdsingleapplication kfilemetadata ki18n kiconthemes kio kirigami kwindowsystem mpvqt qt6 yt-dlp

name=haruna
version=1.8.1
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "haruna-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
