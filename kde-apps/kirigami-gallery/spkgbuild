# description : Demonstration application showing Kirigami interface components and example layouts
# depends : extra-cmake-modules kde-deps-installer kirigami kitemmodels qt6

name=kirigami-gallery
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kirigami-gallery-$version.tar.xz"
options="!checksum"

build() {
    cd "kirigami-gallery-$version"
    plasma-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
