# description : Time tracking application for recording how long is spent on tasks and projects
# depends : extra-cmake-modules kcalendarcore kcmutils kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kidletime kio kjobwidgets knotifications kstatusnotifieritem ktextwidgets kwindowsystem kxmlgui qt6

name=ktimetracker
version=6.0.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/pim/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "ktimetracker-v${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
