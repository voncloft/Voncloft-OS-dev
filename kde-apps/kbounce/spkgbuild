# description : Arcade puzzle game in which players enclose bouncing balls to claim areas of the board
# depends : extra-cmake-modules kcolorscheme kcompletion kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio kwidgetsaddons kxmlgui libkdegames qt6

name=kbounce
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kbounce-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
