# description : Image optimization tool for reducing picture file sizes
# depends : extra-cmake-modules jpegoptim kconfig kcoreaddons kcrash kde-deps-installer ki18n kiconthemes kio kirigami kirigami-addons libwebp oxipng python-scour qcoro qt6

name=optiimage
version=1.0.0
release=2
options="!checksum"
source="optiimage-1.0.0.tar.gz::https://invent.kde.org/graphics/optiimage/-/archive/v1.0.0/optiimage-v1.0.0.tar.gz"

build() {
    cd "optiimage-v${version}"
    sed -i 's/COMPONENTS Kirigami2 /COMPONENTS Kirigami /' CMakeLists.txt
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
