# description : Video browsing and playback application for YouTube and supported alternative video services
# depends : extra-cmake-modules kconfig kcoreaddons kdbusaddons kde-deps-installer ki18n kirigami kirigami-addons kitemmodels kwindowsystem mpvqt purpose qqc2-desktop-style qt6 qtkeychain

name=plasmatube
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/plasmatube-$version.tar.xz"
options="!checksum"

build() {
    cd "plasmatube-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
