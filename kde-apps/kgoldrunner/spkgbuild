# description : Platform puzzle game in which players collect gold, evade enemies, and escape through ladders
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio kwidgetsaddons kxmlgui libkdegames qt6

name=kgoldrunner
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kgoldrunner-$version.tar.xz"
options="!checksum"

build() {
    cd "kgoldrunner-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
