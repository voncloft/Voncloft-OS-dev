# description : Minesweeper puzzle game in which players uncover squares while avoiding hidden mines
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes ktextwidgets kwidgetsaddons kxmlgui libkdegames qt6

name=kmines
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kmines-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
