# description : Disk usage viewer that shows which folders and files occupy space using interactive circular charts
# depends : extra-cmake-modules kcolorscheme kconfig kcrash kde-deps-installer kdoctools ki18n kio qt6

name=filelight
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/filelight-$version.tar.xz"
options="!checksum"

build() {
    cd "filelight-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
