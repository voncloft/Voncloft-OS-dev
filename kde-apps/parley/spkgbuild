# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio knewstuff knotifications ktextwidgets kxmlgui libkeduvocdocument qt6 sonnet

name=parley
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/parley-$version.tar.xz"
options="!checksum"

build() {
    cd "parley-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
