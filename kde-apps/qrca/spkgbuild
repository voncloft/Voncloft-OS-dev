# description : qrca - KDE gear component
# depends : extra-cmake-modules kconfig kcontacts kcoreaddons kcrash kdbusaddons kde-deps-installer ki18n kio kirigami kirigami-addons knotifications kservice networkmanager-qt prison qt6

name=qrca
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/qrca-$version.tar.xz"
options="!checksum"

build() {
    cd "qrca-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
