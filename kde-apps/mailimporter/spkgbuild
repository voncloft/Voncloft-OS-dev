# description : Library for importing email folders and messages from other mail applications
# depends : akonadi akonadi-mime extra-cmake-modules karchive kconfig kcoreaddons kde-deps-installer ki18n kio kmime pimcommon qt6

name=mailimporter
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/mailimporter-$version.tar.xz"
options="!checksum"

build() {
    cd "mailimporter-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
