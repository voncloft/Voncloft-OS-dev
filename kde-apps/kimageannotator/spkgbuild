# description : Qt image annotation library with drawing, highlighting, text, and other markup tools
# depends : kcolorpicker kde-deps-installer qt6

name=kimageannotator
version=0.7.2
release=1

source="$name-$version.tar.gz::https://github.com/ksnip/kImageAnnotator/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
    cd "kImageAnnotator-$version"
    plasma-package-installer -DBUILD_WITH_QT6=ON -DBUILD_SHARED_LIBS=ON
    cd build
    make DESTDIR="$PKG" install
}
