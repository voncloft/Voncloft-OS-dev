# description : Core components for the kde desktop
# depends : extra-cmake-modules kcoreaddons kde-deps-installer kio qt6

name=kdesdk-thumbnailers
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kdesdk-thumbnailers-$version.tar.xz"
options="!checksum"

build() {
    cd "kdesdk-thumbnailers-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
