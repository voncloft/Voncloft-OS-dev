# description : Utility for calculating file hashes, comparing checksums, and checking file signatures
# depends : extra-cmake-modules gpgmepp kconfig kcoreaddons kdbusaddons kde-deps-installer ki18n kirigami kwindowsystem libkleo qgpgme-qt qt6

name=hash-o-matic
version=1.0.1
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/utilities/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "hash-o-matic-v${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
