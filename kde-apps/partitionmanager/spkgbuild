# description : Disk partition editor for creating, deleting, resizing, moving, and checking partitions and filesystems
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kio kjobwidgets kpmcore kwidgetsaddons kwindowsystem kxmlgui polkit-qt qt6

name=partitionmanager
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "partitionmanager-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
