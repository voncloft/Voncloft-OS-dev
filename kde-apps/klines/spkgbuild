# description : Color Lines puzzle game in which players arrange matching balls into rows to clear the board
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kwidgetsaddons kxmlgui libkdegames qt6

name=klines
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/klines-$version.tar.xz"
options="!checksum"

build() {
    cd "klines-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
