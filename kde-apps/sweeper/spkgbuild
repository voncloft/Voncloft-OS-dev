# description : Privacy cleanup tool for removing temporary files, recent document lists, and browsing traces
# depends : extra-cmake-modules kbookmarks kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n ktextwidgets kxmlgui plasma-activities-stats qt6

name=sweeper
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "sweeper-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
