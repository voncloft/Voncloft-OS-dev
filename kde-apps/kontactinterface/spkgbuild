# description : Plugin interfaces for embedding personal information applications in the Kontact shell
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n kparts kwindowsystem kxmlgui libx11 libxext libxfixes libxi libxrender libxtst qt6

name=kontactinterface
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kontactinterface-$version.tar.xz"
options="!checksum"

build() {
    cd "kontactinterface-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
