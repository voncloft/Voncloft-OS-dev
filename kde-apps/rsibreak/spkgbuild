# description : Break reminder that monitors computer use and encourages regular rest periods
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kidletime knotifications knotifyconfig kstatusnotifieritem ktextwidgets kwindowsystem kxmlgui qt6

name=rsibreak
version=0.13.0
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    cd "rsibreak-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
