# description : Editor for defining clickable regions and links in HTML image maps
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools kguiaddons ki18n kparts kwidgetsaddons kxmlgui qt6

name=kimagemapeditor
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kimagemapeditor-$version.tar.xz"
options="!checksum"

build() {
    cd "kimagemapeditor-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
