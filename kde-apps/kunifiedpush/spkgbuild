# description : kunifiedpush - KDE gear component
# depends : extra-cmake-modules kcmutils kcoreaddons kcrash kde-deps-installer ki18n kservice openssl qt6 solid

name=kunifiedpush
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kunifiedpush-$version.tar.xz"
options="!checksum"

build() {
    cd "kunifiedpush-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
