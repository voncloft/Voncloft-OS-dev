# description : Conference companion for browsing event schedules, session details, and favorite talks
# depends : extra-cmake-modules kcalendarcore kcolorscheme kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer ki18n kirigami kirigami-addons knotifications kosmindoormap qt6

name=kongress
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kongress-$version.tar.xz"
options="!checksum"

build() {
    cd "kongress-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
