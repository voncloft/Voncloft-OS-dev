# description : Library for querying public transport journeys, stops, departures, and service information
# depends : extra-cmake-modules kde-deps-installer ki18n kirigami-addons kitemmodels networkmanager-qt qt6 zlib

name=kpublictransport
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kpublictransport-$version.tar.xz"
options="!checksum"

build() {
    cd "kpublictransport-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
