# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kconfig kcrash kde-deps-installer ki18n kirigami kitemmodels knewstuff libxml2 qt6

name=artikulate
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/artikulate-$version.tar.xz"
options="!checksum"

build() {
    cd "artikulate-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
