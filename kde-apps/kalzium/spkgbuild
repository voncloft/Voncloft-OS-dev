# description : Interactive periodic table with chemical element properties, isotope information, and chemistry tools
# depends : extra-cmake-modules gettext karchive kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio kitemviews knewstuff kplotting ktextwidgets kunitconversion kwidgetsaddons kxmlgui qt6

name=kalzium
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kalzium-$version.tar.xz"
options="!checksum"

build() {
    cd "kalzium-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
