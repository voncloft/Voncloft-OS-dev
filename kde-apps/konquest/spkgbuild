# description : Turn-based space strategy game in which players send fleets to conquer planets
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools kguiaddons ki18n kwidgetsaddons kxmlgui libkdegames qt6

name=konquest
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/konquest-$version.tar.xz"
options="!checksum"

build() {
    cd "konquest-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
