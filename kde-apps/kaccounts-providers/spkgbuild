# description : Core components for the kde desktop
# depends : extra-cmake-modules kaccounts-integration kde-deps-installer ki18n kio kpackage qcoro qt6

name=kaccounts-providers
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kaccounts-providers-$version.tar.xz"
options="!checksum"

build() {
    cd "kaccounts-providers-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
