# description : Shared Mahjong tile graphics, backgrounds, and rendering support for KDE games
# depends : extra-cmake-modules imagemagick7 kconfig kconfigwidgets kcoreaddons kde-deps-installer ki18n kwidgetsaddons qt6

name=libkmahjongg
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libkmahjongg-$version.tar.xz"
options="!checksum"

build() {
    cd "libkmahjongg-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
