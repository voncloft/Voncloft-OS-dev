# description : Logic game in which players locate hidden balls by observing how laser beams behave
# depends : extra-cmake-modules karchive kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes ktextwidgets kwidgetsaddons kxmlgui libkdegames qt6

name=kblackbox
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kblackbox-$version.tar.xz"
options="!checksum"

build() {
    cd "kblackbox-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
