# description : Gwenview is a fast and easy-to-use image viewer for KDE
# depends : exiv2 extra-cmake-modules kcolorpicker kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools kglobalaccel kguiaddons ki18n kiconthemes kimageannotator kio kitemmodels knewstuff knotifications kparts kwidgetsaddons kwindowsystem kxmlgui lcms2 libjpeg-turbo libkdcraw libpng plasma-activities purpose qt6 wayland wayland-protocols

name=gwenview
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/gwenview-$version.tar.xz"
options="!checksum"

build() {
    cd "gwenview-$version"
    plasma-package-installer '-DFORCE_NOT_REQUIRED_DEPENDENCIES=CFitsio'
    cd build
    make DESTDIR="$PKG" install
}
