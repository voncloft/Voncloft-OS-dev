# description : Core components for the kde desktop
# depends : breeze-icons extra-cmake-modules kcalendarcore kcodecs kcoreaddons kde-deps-installer ki18n kiconthemes kidentitymanagement ktexttemplate kwidgetsaddons qt6

name=kcalutils
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kcalutils-$version.tar.xz"
options="!checksum"

build() {
    cd "kcalutils-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
