# description : Graphical environment for statistical analysis with R, including data editing, scripts, and plots
# depends : breeze-icons extra-cmake-modules gettext karchive kconfig kcoreaddons kcrash kde-deps-installer kdoctools kdsingleapplication ki18n knotifications kparts ktexteditor kwidgetsaddons kwindowsystem kxmlgui qt6 r

name=rkward
version=0.8.3
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.gz"

build() {
    cd "rkward-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
