# description : Developer scripts for maintaining, checking, and working with KDE source trees
# depends : extra-cmake-modules kde-deps-installer kdoctools qt6

name=kde-dev-scripts
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kde-dev-scripts-$version.tar.xz"
options="!checksum"

build() {
    cd "kde-dev-scripts-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
