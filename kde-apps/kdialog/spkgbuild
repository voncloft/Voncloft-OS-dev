# description : Command-line tool for displaying KDE dialogs and collecting input from shell scripts
# depends : extra-cmake-modules kdbusaddons kde-deps-installer kguiaddons kiconthemes kio knotifications ktextwidgets kwindowsystem qt6

name=kdialog
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kdialog-$version.tar.xz"
options="!checksum"

build() {
    cd "kdialog-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
