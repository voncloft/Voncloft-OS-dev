# description : KIO worker for browsing Subversion repositories from KDE applications
# depends : extra-cmake-modules kde-deps-installer ki18n kio qt6

name=kdesdk-kio
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdesdk-kio-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
