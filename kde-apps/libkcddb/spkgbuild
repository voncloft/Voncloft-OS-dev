# description : Library for looking up audio CD album and track metadata
# depends : extra-cmake-modules kcmutils kconfig kconfigwidgets kde-deps-installer kdoctools ki18n kio kwidgetsaddons qt6

name=libkcddb
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "libkcddb-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
