# description : Core components for the kde desktop
# depends : boost extra-cmake-modules gpgmepp kcodecs kcolorscheme kcompletion kconfig kcoreaddons kde-deps-installer ki18n kitemmodels ktextaddons kwidgetsaddons libgpg-error qgpgme-qt qt6

name=libkleo
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libkleo-$version.tar.xz"
options="!checksum"

build() {
    cd "libkleo-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
