# description : Qt WebEngine web browser with tabs, bookmarks, history, and ad blocking
# depends : extra-cmake-modules karchive kcoreaddons kcrash kde-deps-installer ki18n kio kwallet libxcb openssl purpose qt6 xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm

name=falkon
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "falkon-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
