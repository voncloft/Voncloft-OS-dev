# description : Core components for the kde desktop
# depends : extra-cmake-modules kauth kcmutils kconfigwidgets kcoreaddons kde-deps-installer kdoctools ki18n kirigami-addons qt6

name=kcron
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kcron-$version.tar.xz"
options="!checksum"

build() {
    cd "kcron-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
