# description : Desktop planetarium with sky maps, astronomical calculations, and telescope control
# depends : cfitsio curl eigen extra-cmake-modules gsl indi kconfig kconfigwidgets kcrash kdbusaddons kde-deps-installer ki18n kio knewstuff knotifications knotifyconfig kplotting kwidgetsaddons kxmlgui libnova libraw opencv qt6 qtkeychain stellarsolver wcslib

name=kstars
version=3.8.5
release=3
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "kstars-${version}"
    plasma-package-installer -DOpenCV_DIR=/usr/lib/cmake/opencv5 \
        -DBUILD_WITH_QT6=ON
    cd build
    make DESTDIR="$PKG" install
}
