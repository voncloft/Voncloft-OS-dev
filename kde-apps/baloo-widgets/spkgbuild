# description : Core components for the kde desktop
# depends : baloo extra-cmake-modules kconfig kde-deps-installer kfilemetadata ki18n kio kservice qt6

name=baloo-widgets
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/baloo-widgets-$version.tar.xz"
options="!checksum"

build() {
    cd "baloo-widgets-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
