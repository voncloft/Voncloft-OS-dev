# description : File preview generators for graphics formats such as camera RAW, PDF, and PostScript
# depends : extra-cmake-modules karchive kde-deps-installer kdegraphics-mobipocket kio libkdcraw libkexiv2 qt6

name=kdegraphics-thumbnailers
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kdegraphics-thumbnailers-$version.tar.xz"
options="!checksum"

build() {
    cd "kdegraphics-thumbnailers-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
