# description : Library and thumbnail support for reading Mobipocket ebook files
# depends : extra-cmake-modules kde-deps-installer qt6

name=kdegraphics-mobipocket
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdegraphics-mobipocket-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
