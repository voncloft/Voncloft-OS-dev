# description : Interactive physics simulator for constructing experiments and observing forces and motion
# depends : eigen extra-cmake-modules kconfig kcrash kde-deps-installer kdoctools ki18n kiconthemes kio knewstuff kplotting ktextwidgets kxmlgui qt6 shared-mime-info

name=step
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/step-$version.tar.xz"
options="!checksum"

build() {
    cd "step-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
