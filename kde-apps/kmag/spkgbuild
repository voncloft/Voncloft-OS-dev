# description : Core components for the kde desktop
# depends : extra-cmake-modules kcrash kde-deps-installer kdoctools ki18n kio kxmlgui libqaccessibilityclient qt6

name=kmag
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kmag-$version.tar.xz"
options="!checksum"

build() {
    cd "kmag-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
