# description : Piano practice and notation application with MIDI input, guided lessons, recording, and sheet music import
# depends : alsa-lib ffmpeg kde-deps-installer libarchive librsvg libsndfile opencv pkgconf poppler pulseaudio python qt6 zlib

name=varpeggio
version=0.2.48.git20261030083733.g3412b7002e9325b586bf2861941dcbcaa4896cdc
release=3
_commit=${version##*.g}
_name=VArpeggio
source="$name-$_commit.tar.gz::https://github.com/voncloft/${_name}/archive/$_commit.tar.gz
        varpeggio-opencv5.patch"

build() {
    cd "VArpeggio-$_commit"
    if patch -p1 --dry-run --batch < "$SRC/varpeggio-opencv5.patch" >/dev/null 2>&1; then
        patch -p1 --batch < "$SRC/varpeggio-opencv5.patch"
    elif ! patch -Rp1 --dry-run --batch < "$SRC/varpeggio-opencv5.patch" >/dev/null 2>&1; then
        echo "The OpenCV 5 compatibility patch needs updating for $name-$version" >&2
        return 1
    fi
    # Discard any build directory committed by upstream before configuring.
    rm -rf build
    # Use the canonical executable path instead of resolving it through PATH.
    sed -i 's|^Exec=varpeggio$|Exec=/usr/bin/varpeggio|' com.voncloft.VArpeggio.desktop
    plasma-package-installer -DOpenCV_DIR=/usr/lib/cmake/opencv5 -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_BINDIR=bin
    DESTDIR="$PKG" cmake --install build
}
