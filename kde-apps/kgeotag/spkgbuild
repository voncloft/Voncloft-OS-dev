# description : Photo geotagging tool that matches image timestamps to GPS tracks and writes location metadata
# depends : extra-cmake-modules kcolorscheme kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kxmlgui libkexiv2 marble qt6

name=kgeotag
version=2.0.0
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "kgeotag-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
