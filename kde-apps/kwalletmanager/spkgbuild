# description : Graphical tool for creating, opening, and managing KDE password wallets and stored entries
# depends : extra-cmake-modules karchive kauth kcmutils kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kio kservice kstatusnotifieritem kwallet kwidgetsaddons kwindowsystem kxmlgui qt6

name=kwalletmanager
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kwalletmanager-$version.tar.xz"
options="!checksum"

build() {
    cd "kwalletmanager-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
