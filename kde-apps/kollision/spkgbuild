# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kwidgetsaddons kxmlgui libkdegames qt6

name=kollision
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kollision-$version.tar.xz"
options="!checksum"

build() {
    cd "kollision-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
