# description : KIO worker for browsing and transferring photos from digital cameras through gPhoto2
# depends : extra-cmake-modules kcmutils kconfig kconfigwidgets kde-deps-installer kdoctools ki18n kio kxmlgui libgphoto2 qt6

name=kamera
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kamera-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
