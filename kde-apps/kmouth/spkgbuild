# description : Text-to-speech interface for speaking typed text and stored phrases
# depends : extra-cmake-modules kcompletion kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio kwidgetsaddons kxmlgui qt6

name=kmouth
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kmouth-$version.tar.xz"
options="!checksum"

build() {
    cd "kmouth-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
