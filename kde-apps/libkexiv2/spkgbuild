# description : Qt wrapper around Exiv2 for reading and editing image metadata such as EXIF, IPTC, and XMP
# depends : exiv2 extra-cmake-modules kde-deps-installer qt6

name=libkexiv2
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libkexiv2-$version.tar.xz"
options="!checksum"

build() {
    cd "libkexiv2-$version"
    plasma-package-installer -DBUILD_WITH_QT6=ON
    cd build
    make DESTDIR="$PKG" install
}
