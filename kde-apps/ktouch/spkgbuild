# description : Touch typing tutor with lessons, keyboard guidance, and progress statistics
# depends : extra-cmake-modules kcmutils kcompletion kconfig kconfigwidgets kcoreaddons kde-deps-installer kdoctools ki18n kiconthemes kitemviews ktextwidgets kwidgetsaddons kwindowsystem kxmlgui libxml2 qt6

name=ktouch
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ktouch-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
