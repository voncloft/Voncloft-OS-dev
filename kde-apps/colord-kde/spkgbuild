# description : KDE interface for assigning and managing device color profiles through colord
# depends : extra-cmake-modules kcmutils kcoreaddons kdbusaddons kde-deps-installer ki18n kitemmodels kwidgetsaddons kwindowsystem lcms2 libxcb qt6 xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm

name=colord-kde
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/colord-kde-$version.tar.xz"
options="!checksum"

build() {
    cd "colord-kde-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
