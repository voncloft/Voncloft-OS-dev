# description : Alternative desktop shell using Qt Widgets for panels, menus, and desktop controls
# depends : bluez-qt extra-cmake-modules karchive kcmutils kconfig kconfigwidgets kcrash kdbusaddons kde-deps-installer ki18n kiconthemes kio kitemviews knewstuff knotifications kservice kwidgetsaddons kwindowsystem kxmlgui networkmanager-qt packagekit-qt qt6 solid

name=liquidshell
version=1.10.1
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${name}-${version}.tar.xz"

build() {
    cd "liquidshell-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
