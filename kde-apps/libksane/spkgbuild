# description : Qt scanner interface widgets for configuring scans and acquiring images through SANE
# depends : extra-cmake-modules kde-deps-installer ki18n ksanecore ktextwidgets kwallet kwidgetsaddons qt6

name=libksane
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "libksane-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
