# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer ki18n ksanecore ktextwidgets kwallet kwidgetsaddons qt6

name=libksane
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libksane-$version.tar.xz"
options="!checksum"

build() {
    cd "libksane-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
