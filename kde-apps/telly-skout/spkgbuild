# description : Television program guide for browsing channel schedules and upcoming broadcasts
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kde-deps-installer ki18n kirigami kirigami-addons qqc2-desktop-style qt6

name=telly-skout
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/telly-skout-$version.tar.xz"
options="!checksum"

build() {
    cd "telly-skout-$version"
    plasma-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
