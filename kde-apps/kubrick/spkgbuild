# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kwidgetsaddons kxmlgui libkdegames mesa qt6

name=kubrick
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kubrick-$version.tar.xz"
options="!checksum"

build() {
    cd "kubrick-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
