# description : Library and QML components for displaying indoor maps using OpenStreetMap data
# depends : bison extra-cmake-modules flex kcontacts kde-deps-installer ki18n kirigami kirigami-addons kopeninghours kpublictransport kservice qt6 zlib

name=kosmindoormap
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kosmindoormap-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
