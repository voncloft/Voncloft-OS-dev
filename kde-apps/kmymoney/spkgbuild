# description : Personal finance manager for tracking accounts, transactions, budgets, and investments
# depends : extra-cmake-modules gpgmepp karchive kcmutils kcompletion kconfig kconfigwidgets kcontacts kcoreaddons kcrash kde-deps-installer kdiagram kdoctools kholidays ki18n kio kitemmodels kitemviews knotifications kservice ktextwidgets kxmlgui libalkimia libical libofx qgpgme-qt qt6 qtkeychain sqlcipher

name=kmymoney
version=5.2.2
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "kmymoney-${version}"
    plasma-package-installer \
        -DBUILD_WITH_QT6=ON
    cd build
    make DESTDIR="$PKG" install
}
