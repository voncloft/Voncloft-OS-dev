# description : Go board game interface with computer opponent support and saved game review
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio knewstuff ktextwidgets kwidgetsaddons kxmlgui libkdegames qt6

name=kigo
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kigo-$version.tar.xz"
options="!checksum"

build() {
    cd "kigo-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
