<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-voncloft-crossword">
    <comment>Voncloft crossword and saved progress</comment>
    <glob pattern="*.vxcrossword"/>
    <sub-class-of type="application/json"/>
  </mime-type>
  <mime-type type="application/x-crossword">
    <comment>Across Lite crossword</comment>
    <glob pattern="*.puz"/>
    <magic priority="60"><match type="string" offset="2" value="ACROSS&amp;DOWN"/></magic>
  </mime-type>
  <mime-type type="application/x-ipuz">
    <comment>ipuz puzzle</comment>
    <glob pattern="*.ipuz"/>
    <sub-class-of type="application/json"/>
  </mime-type>
</mime-info>
