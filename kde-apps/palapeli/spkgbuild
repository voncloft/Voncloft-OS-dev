# description : Jigsaw puzzle game with a puzzle collection and tools for creating puzzles from images
# depends : extra-cmake-modules karchive kcompletion kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio kitemviews knotifications kwidgetsaddons kxmlgui libkdegames qt6

name=palapeli
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "palapeli-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
