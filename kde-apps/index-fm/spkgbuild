# description : Maui file manager for browsing and organizing local and remote files
# depends : extra-cmake-modules karchive kcoreaddons kde-deps-installer ki18n kio mauikit mauikit-filebrowsing qt6

name=index-fm
version=4.0.2
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/maui/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "index-fm-v${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
