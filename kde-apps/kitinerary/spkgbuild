# description : Core components for the kde desktop
# depends : extra-cmake-modules kcalendarcore kcodecs kcontacts kde-deps-installer ki18n kmime kpkpass libxml2 openssl qt6 shared-mime-info zlib zxing-cpp

name=kitinerary
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kitinerary-$version.tar.xz"
options="!checksum"

build() {
    cd "kitinerary-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
