# description : Core components for the kde desktop
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n kxmlgui qt6

name=kcolorchooser
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kcolorchooser-$version.tar.xz"
options="!checksum"

build() {
    cd "kcolorchooser-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
