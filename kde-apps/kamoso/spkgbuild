# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kde-deps-installer kdoctools ki18n kio knotifications pkgconf purpose qt6

name=kamoso
version=26.08.2
release=2

source="https://download.kde.org/stable/release-service/$version/src/kamoso-$version.tar.xz"
options="!checksum"

build() {
    cd "kamoso-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
