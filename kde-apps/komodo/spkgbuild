# description : Task manager that stores and organizes to-do lists in the plain-text todo.txt format
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kdbusaddons kde-deps-installer kdoctools kguiaddons ki18n kiconthemes kirigami kirigami-addons kitemmodels qqc2-desktop-style qt6

name=komodo
version=1.6.0
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "komodo-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
