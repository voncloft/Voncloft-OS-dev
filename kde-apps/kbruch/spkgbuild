# description : Fraction practice application with arithmetic, comparison, conversion, and factorization exercises
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kde-deps-installer kdoctools ki18n kwidgetsaddons kxmlgui qt6

name=kbruch
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kbruch-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
