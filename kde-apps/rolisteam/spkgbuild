# description : Virtual tabletop for playing role-playing games online with maps, dice, chat, and shared materials
# depends : extra-cmake-modules gettext karchive kde-deps-installer qt6

name=rolisteam
version=1.10.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/${name}/${name}/-/archive/v${version}/${name}-v${version}.tar.gz
    ${name}-${version}.tar.gz::https://invent.kde.org/${name}/${name}-diceparser/-/archive/1086c22300d1db477f0109a743581e493b1d9ae8/${name}-diceparser-1086c22300d1db477f0109a743581e493b1d9ae8.tar.gz"

build() {
    cd "rolisteam-v${version}"
    cp -a "$SRC/rolisteam-diceparser-1086c22300d1db477f0109a743581e493b1d9ae8/." src/libraries/diceparser/
    plasma-package-installer \
        -DNO_BUILD_CLI=ON
    cd build
    make DESTDIR="$PKG" install
}
