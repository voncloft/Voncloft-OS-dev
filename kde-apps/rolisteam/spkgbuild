name=rolisteam
version=1.10.0
release=2
options="!checksum"
source="rolisteam-1.10.0.tar.gz::https://invent.kde.org/rolisteam/rolisteam/-/archive/v1.10.0/rolisteam-v1.10.0.tar.gz
