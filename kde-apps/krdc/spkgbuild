# description : Remote desktop client for connecting to other computers through RDP or VNC
# depends : extra-cmake-modules freerdp kbookmarks kcmutils kcompletion kconfig kcrash kde-deps-installer kdnssd kguiaddons ki18n kiconthemes kio knotifications knotifyconfig kstatusnotifieritem kwidgetsaddons kwindowsystem kxmlgui libvncserver pkgconf qt6 qtkeychain

name=krdc
version=26.08.2
release=2

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "krdc-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
