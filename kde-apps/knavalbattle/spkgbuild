# description : Battleship-style game in which players locate and sink an opponent's hidden ships
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdnssd kdoctools ki18n ktextwidgets kwidgetsaddons kxmlgui libkdegames qt6

name=knavalbattle
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/knavalbattle-$version.tar.xz"
options="!checksum"

build() {
    cd "knavalbattle-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
