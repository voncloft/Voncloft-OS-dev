# description : Core components for the kde desktop
# depends : extra-cmake-modules kcompletion kconfig kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio knewstuff knotifications libkeduvocdocument qt6

name=khangman
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/khangman-$version.tar.xz"
options="!checksum"

build() {
    cd "khangman-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
