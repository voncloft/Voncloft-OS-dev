# description : Pomodoro timer for alternating focused work sessions and breaks
# depends : extra-cmake-modules kconfig kcoreaddons kdbusaddons kde-deps-installer ki18n kirigami kirigami-addons kwindowsystem qqc2-desktop-style qt6

name=francis
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "francis-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
