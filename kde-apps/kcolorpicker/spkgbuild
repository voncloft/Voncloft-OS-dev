# description : kcolorpicker - KDE dependency
# depends : kde-deps-installer qt6

name=kcolorpicker
version=0.3.1
release=2

source="$name-$version.tar.gz::https://github.com/ksnip/kColorPicker/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
    cd "kColorPicker-$version"
    plasma-package-installer -DBUILD_WITH_QT6=ON -DBUILD_SHARED_LIBS=ON
    cd build
    make DESTDIR="$PKG" install
}
