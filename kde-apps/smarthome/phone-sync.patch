+PhoneSync::PhoneSync(const QString &configDir,QObject *parent):QObject(parent),directory(configDir) {
+    QFile source(":/phone/phone_sync.py");
+    if(!source.open(QIODevice::ReadOnly)||!helper.open())return;
+    helper.write(source.readAll());helper.flush();
+    connect(&server,&QProcess::readyReadStandardOutput,this,[this]{
+        buffer+=server.readAllStandardOutput();if(buffer.size()>1024*1024){buffer.clear();return;}
+        int pos;while((pos=buffer.indexOf('\n'))>=0){auto line=buffer.left(pos);buffer.remove(0,pos+1);auto o=QJsonDocument::fromJson(line).object();auto event=o.value("event").toString();
+            if(event=="ready"){ready=true;emit diagnostic("Private phone sync is ready on port "+QString::number(o.value("port").toInt())+".");emit routinesChanged();}
+            else if(event=="routines")emit routinesChanged();
+            else if(event=="refresh"&&o.value("source")!="desktop")QTimer::singleShot(1500,this,&PhoneSync::refreshRequested);
+            else if(event=="owner")emit diagnostic("Scheduled routines now run on "+o.value("owner").toString()+".");
+        }
+    });
+    connect(&server,&QProcess::finished,this,[this]{ready=false;emit diagnostic("Phone sync stopped. Open Phone sync for status.");});
+    connect(&server,&QProcess::errorOccurred,this,[this]{emit diagnostic("Could not start phone sync. Python 3 and OpenSSL are required.");});
+    // Keep stderr out of normal logs: private paths and request details are unnecessary.
+    connect(&server,&QProcess::readyReadStandardError,this,[this]{server.readAllStandardError();emit diagnostic("Phone sync encountered an error. Check that port 43829 is free and OpenSSL is installed.");});
+    if(!qEnvironmentVariableIsSet("LIGHTS_DISABLE_SYNC"))server.start("python3",{"-I",helper.fileName(),"--config-dir",directory});
+}
+PhoneSync::~PhoneSync(){server.closeWriteChannel();if(!server.waitForFinished(1500)){server.terminate();if(!server.waitForFinished(1000))server.kill();}}
+void PhoneSync::commandAccepted(const QString &device){if(server.state()==QProcess::Running)server.write(QJsonDocument(QJsonObject{{"event","command"},{"device",device}}).toJson(QJsonDocument::Compact)+'\n');}
+bool PhoneSync::desktopOwnsSchedules() const {QFile f(directory+"/phone-sync-state.json");if(!f.open(QIODevice::ReadOnly))return true;return QJsonDocument::fromJson(f.readAll()).object().value("owner").toString("desktop")!="phone";}
+bool PhoneSync::mergeRoutines(const QJsonObject &base,const QJsonObject &local,QString *error){
+    if(!helper.isOpen()){*error="Could not prepare the routine synchronization helper.";return false;}
+    QProcess p;p.start("python3",{"-I",helper.fileName(),"--config-dir",directory,"--merge-routines"});
+    if(!p.waitForStarted(2000)){*error="Could not start Python to safely save shared routines.";return false;}
+    p.write(QJsonDocument(QJsonObject{{"base",base},{"local",local}}).toJson(QJsonDocument::Compact));p.closeWriteChannel();
+    if(!p.waitForFinished(5000)){p.kill();p.waitForFinished();*error="Routine save timed out. Existing routines were kept.";return false;}
+    if(p.exitCode()!=0){*error="Could not save routines. Existing file was kept.";return false;}return true;
+}
+void PhoneSync::showPairing(QWidget *parent){
+    QDialog d(parent);d.setWindowTitle("Phone sync");d.resize(640,440);auto *l=new QVBoxLayout(&d);
+    auto *info=new QLabel(ready?"Pair Android Lights over your home LAN or WireGuard. Copy this private code to the phone's Settings → Pair with desktop. It includes the address, certificate fingerprint and pairing token.":"Phone sync is not running. Check Diagnostics; Python 3, OpenSSL and a free TCP port 43829 are required.");info->setWordWrap(true);l->addWidget(info);
+    QFile f(directory+"/phone-sync-private.json");QJsonObject cfg;if(f.open(QIODevice::ReadOnly))cfg=QJsonDocument::fromJson(f.readAll()).object();
+    auto *address=new QComboBox;address->setEditable(true);for(const QHostAddress &a:QNetworkInterface::allAddresses())if(a.protocol()==QAbstractSocket::IPv4Protocol&&!a.isLoopback())address->addItem(a.toString());l->addWidget(new QLabel("Desktop address reachable from the phone:"));l->addWidget(address);
+    auto *code=new QPlainTextEdit;code->setReadOnly(true);code->setLineWrapMode(QPlainTextEdit::WidgetWidth);l->addWidget(code);
+    auto update=[=]{QJsonObject pairing{{"host",address->currentText().trimmed()},{"port",cfg.value("port")},{"token",cfg.value("token")},{"fingerprint",cfg.value("fingerprint")}};code->setPlainText("lights://"+QString::fromLatin1(QJsonDocument(pairing).toJson(QJsonDocument::Compact).toBase64(QByteArray::Base64UrlEncoding|QByteArray::OmitTrailingEquals)));};
+    connect(address,&QComboBox::currentTextChanged,&d,update);update();auto *copy=new QPushButton("Copy pairing code");copy->setEnabled(ready&&!cfg.value("token").toString().isEmpty());connect(copy,&QPushButton::clicked,&d,[code]{QApplication::clipboard()->setText(code->toPlainText());});l->addWidget(copy);
+    auto *owner=new QLabel(desktopOwnsSchedules()?"Scheduled routines execute on the desktop.":"Scheduled routines execute on the phone; desktop execution is paused.");l->addWidget(owner);auto *useDesktop=new QPushButton("Run schedules on this desktop");connect(useDesktop,&QPushButton::clicked,&d,[this,owner]{QSaveFile out(directory+"/phone-sync-state.json");if(out.open(QIODevice::WriteOnly)){out.setPermissions(QFile::ReadOwner|QFile::WriteOwner);out.write("{\"owner\":\"desktop\"}");if(out.commit())owner->setText("Scheduled routines execute on the desktop.");}});l->addWidget(useDesktop);
+    auto *close=new QPushButton("Close");connect(close,&QPushButton::clicked,&d,&QDialog::accept);l->addWidget(close);d.exec();
+}
