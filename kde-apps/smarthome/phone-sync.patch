@@ -0,0 +1,30 @@
+import copy, importlib.util, json, tempfile, unittest
+from pathlib import Path
+spec=importlib.util.spec_from_file_location('phone_sync',Path(__file__).resolve().parents[1]/'phone_sync.py');sync=importlib.util.module_from_spec(spec);spec.loader.exec_module(sync)
+
+def routine(rid,name='Evening'):
+    return {'id':rid,'name':name,'time':'20:30','days':[1,2,3,4,5,6,7],'enabled':True,'phoneCondition':0,'settings':[{'group':'Bathroom','usePower':True,'power':1}]}
+def root(*rows):return {'version':1,'routines':list(rows)}
+
+class SyncTest(unittest.TestCase):
+    def test_additions_both_sides_survive(self):
+        base=root(routine('one'));local=root(routine('one'),routine('two'));remote=root(routine('one'),routine('three'))
+        self.assertEqual({x['id'] for x in sync.merge_routines(base,local,remote)['routines']},{'one','two','three'})
+    def test_edit_and_unrelated_delete(self):
+        base=root(routine('one'),routine('two'));local=root(routine('one','Desktop edit'));remote=root(routine('one'),routine('two'),routine('three'))
+        merged=sync.merge_routines(base,local,remote)['routines'];self.assertEqual([x['id'] for x in merged],['one','three']);self.assertEqual(merged[0]['name'],'Desktop edit')
+    def test_same_routine_conflict_keeps_both(self):
+        base=root(routine('one'));local=root(routine('one','Desktop edit'));remote=root(routine('one','Phone edit'))
+        merged=sync.merge_routines(base,local,remote)['routines'];self.assertEqual(len(merged),2);self.assertEqual(merged[0]['name'],'Phone edit');self.assertIn('Desktop edit',merged[1]['name']);self.assertNotEqual(merged[0]['id'],merged[1]['id'])
+    def test_delete_against_edit_preserves_edit(self):
+        self.assertEqual(sync.merge_routines(root(routine('one')),root(),root(routine('one','Changed')))['routines'][0]['name'],'Changed')
+    def test_invalid_file_does_not_pass_validation(self):
+        r=root(routine('one'));r['routines'][0]['time']='25:99'
+        with self.assertRaises(ValueError):sync.validate_routines(r)
+    def test_revision_ignores_key_order(self):
+        self.assertEqual(sync.revision({'a':1,'b':2}),sync.revision({'b':2,'a':1}))
+    def test_atomic_file_permissions(self):
+        with tempfile.TemporaryDirectory() as d:
+            p=Path(d)/'settings.json';sync.atomic(p,{'hello':'world'});self.assertEqual(p.stat().st_mode&0o777,0o600);self.assertEqual(json.loads(p.read_text()),{'hello':'world'})
+
+if __name__=='__main__':unittest.main()
