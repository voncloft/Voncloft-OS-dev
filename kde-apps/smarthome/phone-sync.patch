+void MainWindow::pollCloudStates()
+{
+    if (cloudPollActive || apiKey.isEmpty() || deviceList.isEmpty()) return;
+    cloudPollActive = true;
+    auto remaining = std::make_shared<int>(deviceList.size());
+    for (const auto &v : std::as_const(deviceList)) {
+        const auto dev = v.toObject();
+        const QString mac = dev.value("device").toString();
+        QNetworkRequest req(QUrl("https://openapi.api.govee.com/router/api/v1/device/state"));
+        req.setTransferTimeout(15000);
+        req.setRawHeader("Govee-API-Key", apiKey.toUtf8());
+        req.setHeader(QNetworkRequest::ContentTypeHeader, "application/json");
+        auto *reply = nam->post(req, QJsonDocument(QJsonObject{{"requestId",QUuid::createUuid().toString(QUuid::WithoutBraces)}, {"payload",QJsonObject{{"device",mac},{"sku",dev.value("sku")}}}}).toJson(QJsonDocument::Compact));
+        connect(reply, &QNetworkReply::finished, this, [this,reply,mac,remaining] {
+            if(reply->error()==QNetworkReply::NoError) {
+                const auto doc=QJsonDocument::fromJson(reply->readAll()).object();
+                if(doc.value("code").toInt(200)==200) {
+                    const auto payload=doc.value("payload").toObject();
+                    if(payload.value("capabilities").isArray()) deviceStates[mac]=payload.value("capabilities").toArray();
+                }
+            }
+            reply->deleteLater();
+            if(--*remaining==0) { cloudPollActive=false; refreshPowerButtons(); }
+        });
+    }
+}
