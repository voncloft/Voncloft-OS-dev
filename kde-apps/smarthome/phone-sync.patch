index 0000000..27c2bc1
--- /dev/null
+++ b/phone_sync.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+"""Private HTTPS companion sync. Started/stopped by Lights; no cloud service."""
+import fcntl
+from contextlib import contextmanager
+import argparse, base64, hashlib, hmac, json, os, secrets, socket, ssl, subprocess, sys, tempfile, threading, time, uuid
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+
+def atomic(path, data):
+    path=Path(path);path.parent.mkdir(parents=True,exist_ok=True)
+    fd,name=tempfile.mkstemp(prefix='.'+path.name,dir=path.parent)
+    try:
+        with os.fdopen(fd,'w') as f:json.dump(data,f,indent=2);f.flush();os.fsync(f.fileno())
+        os.chmod(name,0o600);os.replace(name,path)
+    finally:
+        if os.path.exists(name):os.unlink(name)
+
+
+def read(path,default):
+    try:
+        if path.stat().st_size>2*1024*1024:raise ValueError('Configuration is too large')
+        return json.loads(path.read_text())
+    except FileNotFoundError:return default
+
+
+def revision(data):return hashlib.sha256(json.dumps(data,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+
+def validate_routines(data):
+    if not isinstance(data,dict) or not isinstance(data.get('routines'),list):raise ValueError('Missing routines')
+    seen=set()
+    for r in data['routines']:
+        if not isinstance(r,dict) or not isinstance(r.get('name'),str) or not r['name'].strip():raise ValueError('Missing routine name')
+        parts=r.get('time','').split(':')
+        if len(parts)!=2 or any(not p.isdigit() for p in parts) or not 0<=int(parts[0])<24 or not 0<=int(parts[1])<60:raise ValueError('Invalid routine time')
+        if not r.get('days') or any(type(d) is not int or not 1<=d<=7 for d in r['days']):raise ValueError('Invalid routine days')
+        if not r.get('settings') or not isinstance(r['settings'],list):raise ValueError('Missing routine actions')
+        r.setdefault('id',str(uuid.uuid4()))
+        if not isinstance(r['id'],str) or r['id'] in seen:raise ValueError('Duplicate routine identity')
+        seen.add(r['id'])
+        for s in r['settings']:
+            if not isinstance(s,dict) or not isinstance(s.get('group'),str):raise ValueError('Invalid routine group')
+    return data
+
+
+@contextmanager
+def routine_lock(folder):
+    with open(Path(folder)/'routines.lock','a') as lock:
+        os.chmod(lock.name,0o600)
+        fcntl.flock(lock,fcntl.LOCK_EX)
+        yield
+
+
+def merge_routines(base, local, remote):
+    def index(root):return {r['id']:r for r in root.get('routines',[])}
+    b,l,r=index(base),index(local),index(remote);out=[]
+    for rid in dict.fromkeys([*r,*l,*b]):
+        bv,lv,rv=b.get(rid),l.get(rid),r.get(rid)
+        if lv==bv:chosen=rv
+        elif rv==bv or lv==rv:chosen=lv
+        elif lv is None:chosen=rv
+        elif rv is None:chosen=lv
+        else:
+            out.append(rv);chosen=dict(lv,id=str(uuid.uuid4()),name=lv['name']+' (desktop conflict copy)')
+        if chosen is not None:out.append(chosen)
+    return {'version':1,'routines':out}
+
+
+class State:
+    def __init__(self,folder):
+        self.folder=Path(folder);self.lock=threading.RLock();self.events=[];self.sequence=0
+        self.private=self.folder/'phone-sync-private.json'
+        self.config=read(self.private,{})
+        if not self.config.get('token'):
+            self.config={'token':secrets.token_urlsafe(32),'port':43829};atomic(self.private,self.config)
+        cert=self.folder/'phone-sync-cert.pem';key=self.folder/'phone-sync-key.pem'
+        if not cert.exists() or not key.exists():
+            subprocess.run(['openssl','req','-config','/dev/null','-x509','-newkey','rsa:2048','-nodes','-days','3650','-subj','/CN=Lights private sync','-keyout',str(key),'-out',str(cert)],check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+            key.chmod(0o600);cert.chmod(0o600)
+        self.cert=cert;self.key=key
+        self.fingerprint=hashlib.sha256(ssl.PEM_cert_to_DER_cert(cert.read_text())).hexdigest()
+        self.config['fingerprint']=self.fingerprint;atomic(self.private,self.config)
+        self.owner=read(self.folder/'phone-sync-state.json',{'owner':'desktop'}).get('owner','desktop')
+        self.instance=secrets.token_hex(8)
+    def routines(self):
+        p=self.folder/'routines.json';r=read(p,{'version':1,'routines':[]});before=revision(r)
+        for x in r.get('routines',[]):x.setdefault('id',str(uuid.uuid4()))
+        if revision(r)!=before:atomic(p,r)
+        return r
+    def signal(self,device='',source='phone'):
+        with self.lock:
+            self.sequence+=1;self.events.append({'seq':self.sequence,'device':device,'source':source});self.events=self.events[-100:]
+        print(json.dumps({'event':'refresh','device':device,'source':source}),flush=True)
+    def snapshot(self):
+        with self.lock, routine_lock(self.folder):
+            self.owner=read(self.folder/'phone-sync-state.json',{'owner':'desktop'}).get('owner','desktop')
+            r=self.routines()
+            return {'version':1,'routines':r,'revision':revision(r),'owner':self.owner,'events':self.events,'sequence':self.sequence,'instance':self.instance}
+
+
+class Handler(BaseHTTPRequestHandler):
+    protocol_version='HTTP/1.0'
+    def log_message(self,*a):pass
+    def reply(self,code,data):
+        b=json.dumps(data,separators=(',',':')).encode();self.send_response(code);self.send_header('Content-Type','application/json');self.send_header('Cache-Control','no-store');self.send_header('Content-Length',str(len(b)));self.end_headers();self.wfile.write(b)
+    def authorized(self):
+        return hmac.compare_digest(self.headers.get('Authorization',''),'Bearer '+self.server.state.config['token'])
+    def do_GET(self):
+        if not self.authorized():return self.reply(401,{'error':'Pair this device with Lights on the desktop.'})
+        s=self.server.state
+        try:
+            if self.path=='/v1/snapshot':return self.reply(200,s.snapshot())
+            if self.path=='/v1/bootstrap':
+                c=read(s.folder/'Lights.json',{});key=c.get('apiKey','').strip()
+                if not key:
+                    for name in ['api-key','key']:
+                        p=s.folder/name
+                        if p.exists():key=p.read_text().strip();break
+                return self.reply(200,{'settings':c,'apiKey':key,'infrared':read(s.folder/'infrared.json',{'version':1,'hubs':[],'remotes':[]}),**s.snapshot()})
+            self.reply(404,{'error':'Unknown endpoint'})
+        except Exception:self.reply(500,{'error':'Could not read desktop settings; check desktop diagnostics.'})
+    def do_POST(self):
+        if not self.authorized():return self.reply(401,{'error':'Pair this device with Lights on the desktop.'})
+        try:
+            length=int(self.headers.get('Content-Length','0'))
+            if not 0<length<=2*1024*1024:return self.reply(413,{'error':'Invalid request size'})
+            data=json.loads(self.rfile.read(length));s=self.server.state
+            with s.lock:
+                if self.path=='/v1/routines':
+                    with routine_lock(s.folder):
+                        current=s.routines()
+                        conflict=data.get('base')!=revision(current)
+                        if not conflict:
+                            result=validate_routines(data['routines']);atomic(s.folder/'routines.json',result)
+                    if conflict:return self.reply(409,s.snapshot())
+                    print(json.dumps({'event':'routines'}),flush=True);return self.reply(200,s.snapshot())
+                if self.path=='/v1/event':
+                    s.signal(str(data.get('device',''))[:128]);return self.reply(200,{'ok':True})
+                if self.path=='/v1/owner':
+                    owner=data.get('owner')
+                    if owner not in ('desktop','phone'):raise ValueError('Invalid schedule owner')
+                    s.owner=owner;atomic(s.folder/'phone-sync-state.json',{'owner':owner});print(json.dumps({'event':'owner','owner':owner}),flush=True);return self.reply(200,s.snapshot())
+            self.reply(404,{'error':'Unknown endpoint'})
+        except (ValueError,KeyError,TypeError):self.reply(400,{'error':'Invalid settings. Existing settings were kept.'})
+        except Exception:self.reply(500,{'error':'Could not save desktop settings.'})
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--config-dir',required=True);p.add_argument('--port',type=int);p.add_argument('--merge-routines',action='store_true');a=p.parse_args()
+    if a.merge_routines:
+        folder=Path(a.config_dir);folder.mkdir(parents=True,exist_ok=True)
+        data=json.loads(sys.stdin.read(2*1024*1024))
+        with routine_lock(folder):
+            remote=read(folder/'routines.json',{'version':1,'routines':[]})
+            result=validate_routines(merge_routines(data['base'],data['local'],remote))
+            atomic(folder/'routines.json',result)
+        return
+    s=State(a.config_dir)
+    server=ThreadingHTTPServer(('0.0.0.0',a.port if a.port is not None else s.config['port']),Handler);server.daemon_threads=True;server.state=s
+    tls=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER);tls.minimum_version=ssl.TLSVersion.TLSv1_2;tls.load_cert_chain(s.cert,s.key);server.socket=tls.wrap_socket(server.socket,server_side=True)
+    print(json.dumps({'event':'ready','port':server.server_port}),flush=True)
+    def stdin_events():
+        for line in sys.stdin:
+            try:
+                e=json.loads(line)
+                if e.get('event')=='command':s.signal(e.get('device',''),'desktop')
+            except (ValueError,TypeError):pass
+        server.shutdown()
+    threading.Thread(target=stdin_events,daemon=True).start();server.serve_forever(poll_interval=.3)
+
+if __name__=='__main__':main()
