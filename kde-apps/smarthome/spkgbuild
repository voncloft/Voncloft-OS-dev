# description : Govee lighting and BroadLink infrared controller with saved remotes, schedules, presence detection, and audio-reactive lighting
# depends : inetutils kde-deps-installer pulseaudio python-broadlink qt6

name=smarthome
version=0.1.git20260314.g12d028126b3deff57ee7090e0eb1332000761505
release=3
_commit=${version##*.g}
_name=Smarthome
source="$name-$_commit.tar.gz::https://github.com/voncloft/${_name}/archive/$_commit.tar.gz
        smarthome-broadlink.patch"

build() {
    cd "Smarthome-$_commit"
    # Discard any build directory committed by upstream before configuring.
    rm -rf build
    patch -Np1 -i "$SRC/smarthome-broadlink.patch"
    plasma-package-installer -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_BINDIR=bin
    DESTDIR="$PKG" cmake --install build
}
