# description : Govee lighting and BroadLink infrared controller with saved remotes, schedules, presence detection, and audio-reactive lighting
# depends : inetutils kde-deps-installer pulseaudio openssl python-broadlink qt6

name=smarthome
version=0.2.0.git20261127084138.gcb070b6cc6a5de9f7e4b8575b2264ce900709332
release=1
_commit=${version##*.g}
_name=Smarthome
source="$name-$_commit.tar.gz::https://github.com/voncloft/${_name}/archive/$_commit.tar.gz
        unified-diagnostics.patch
        phone-sync.patch"

build() {
    cd "Smarthome-$_commit"
    # Discard any build directory committed by upstream before configuring.
    rm -rf build
    # Skip the compatibility patch once the unified view is in the GitHub source.
    if grep -q 'createDiagnosticsWidget' infraredpanel.h; then
        patch -Np1 -i "$SRC/unified-diagnostics.patch"
    fi
    # Local companion-sync patch until the updated source is pushed upstream.
    if ! grep -q 'class PhoneSync' phonesync.h 2>/dev/null; then
        patch -Np1 -i "$SRC/phone-sync.patch"
    fi
    plasma-package-installer -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_BINDIR=bin
    DESTDIR="$PKG" cmake --install build
    sed -i 's|^Exec=.*|Exec=/usr/bin/Lights|' "$PKG/usr/share/applications/lights.desktop"
}
