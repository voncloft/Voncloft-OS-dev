+    void removeHub();
+    void removeRemote();
+    void forgetCommand();
+    int hubIndex() const;
+    int remoteIndex() const;
+    QJsonObject selectedHub() const;
+    QJsonObject selectedRemote() const;
+    void status(const QString &text);
+
+    QString settingsFile;
+    QString helper;
+    QTemporaryFile helperFile;
+    QJsonArray hubs;
+    QJsonArray remotes;
+    bool readOnly = false;
+    bool busy = false;
+    bool gotResult = false;
+    bool canceled = false;
+    QJsonObject pending;
+    QJsonObject result;
+    QByteArray output;
+    QProcess process;
+    QTimer deadline;
+    QComboBox *hubBox;
+    QComboBox *remoteBox;
+    QComboBox *commandBox;
+    QLabel *statusLabel;
+    QLabel *hubDetails;
+    QPushButton *learnButton;
+    QPushButton *sendButton;
+    QPushButton *menuButton;
+    QPushButton *cancelButton;
+    QPushButton *forgetButton;
+    QPushButton *removeRemoteButton;
+    QList<QWidget *> idleControls;
+};
+
+#endif
