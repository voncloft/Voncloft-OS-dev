# description : Core components for the kde desktop
# depends : extra-cmake-modules kcompletion kconfig kcrash kdbusaddons kde-deps-installer kdoctools kguiaddons ki18n kio kjobwidgets kparts ktextwidgets kwidgetsaddons qt6

name=kmplot
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kmplot-$version.tar.xz"
options="!checksum"

build() {
    cd "kmplot-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
