# description : Task management application for organizing to-do lists, projects, and action items
# depends : akonadi akonadi-calendar boost extra-cmake-modules kcalendarcore kcoreaddons kcrash kde-deps-installer ki18n kontactinterface kparts krunner kwindowsystem qt6

name=zanshin
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/zanshin-$version.tar.xz"
options="!checksum"

build() {
    cd "zanshin-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
