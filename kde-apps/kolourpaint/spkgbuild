# description : Core components for the kde desktop
# depends : extra-cmake-modules kcrash kde-deps-installer kdoctools kguiaddons ki18n kio kjobwidgets ktextwidgets kwidgetsaddons kxmlgui libksane qt6

name=kolourpaint
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kolourpaint-$version.tar.xz"
options="!checksum"

build() {
    cd "kolourpaint-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
