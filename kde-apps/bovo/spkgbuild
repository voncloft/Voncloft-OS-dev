# description : Gomoku board game in which players try to place five pieces in a row
# depends : extra-cmake-modules kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kwidgetsaddons kxmlgui libkdegames qt6

name=bovo
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/bovo-$version.tar.xz"
options="!checksum"

build() {
    cd "bovo-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
