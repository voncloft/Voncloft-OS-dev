# description : Core components for the kde desktop
# depends : cdparanoia extra-cmake-modules kcmutils kconfig kde-deps-installer kdoctools ki18n kio kwidgetsaddons libkcddb qt6 solid

name=audiocd-kio
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/audiocd-kio-$version.tar.xz"
options="!checksum"

build() {
    cd "audiocd-kio-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
