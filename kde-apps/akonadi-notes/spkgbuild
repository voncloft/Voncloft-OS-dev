# depends : kde-deps-installer
# status : Final archived release; excluded from current Frameworks/Plasma/Gear package groups.
# description : Library for storing and retrieving notes through Akonadi

name=akonadi-notes
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/akonadi-notes-$version.tar.xz"
options="!checksum"

build() {
   cd $name-$version
   plasma-package-installer
  cd build
  make DESTDIR=$PKG install
}
