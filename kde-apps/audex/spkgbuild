# description : Audio CD ripper for saving tracks as audio files with album and track information
# depends : extra-cmake-modules kcmutils kcompletion kconfig kcoreaddons kcrash kde-deps-installer ki18n kiconthemes kio ktextwidgets kwidgetsaddons kxmlgui libcdio libcdio-paranoia libkcddb qt6 solid

name=audex
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/audex-$version.tar.xz"
options="!checksum"

build() {
    cd "audex-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
