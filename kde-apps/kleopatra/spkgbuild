# description : Certificate and encryption key manager for signing, verifying, encrypting, and decrypting data
# depends : extra-cmake-modules gpgmepp kcmutils kcodecs kcolorscheme kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools kdsingleapplication ki18n kiconthemes kidentitymanagement kio kitemmodels kmailtransport kmime kwidgetsaddons kwindowsystem kxmlgui libassuan libgpg-error libkleo mimetreeparser qgpgme-qt qt6

name=kleopatra
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kleopatra-$version.tar.xz"
options="!checksum"

build() {
    cd "kleopatra-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
