# description : KDE printer configuration, print queue management, and printer status tools
# depends : cups extra-cmake-modules kcmutils kconfig kconfigwidgets kcoreaddons kdbusaddons kde-deps-installer kdeclarative ki18n kio kirigami kirigami-addons kitemmodels knotifications kwidgetsaddons kwindowsystem libplasma plasma-workspace qqc2-desktop-style qt6

name=print-manager
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/print-manager-$version.tar.xz"
options="!checksum"

build() {
    cd "print-manager-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
