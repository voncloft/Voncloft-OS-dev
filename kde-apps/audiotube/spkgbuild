# description : YouTube Music client for searching, browsing, and playing music
# depends : extra-cmake-modules futuresql kconfig kcoreaddons kcrash kde-deps-installer ki18n kiconthemes kirigami kirigami-addons kwindowsystem pybind11 python python-ytmusicapi qcoro qt6 yt-dlp

name=audiotube
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "audiotube-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
