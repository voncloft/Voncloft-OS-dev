# description : Music player for browsing a music collection, managing playlists, and listening to audio
# depends : extra-cmake-modules kcodecs kcolorscheme kconfig kconfigwidgets kcoreaddons kdbusaddons kde-deps-installer kdoctools kfilemetadata ki18n kiconthemes kio kirigami kirigami-addons kxmlgui qqc2-desktop-style qt6

name=elisa
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/elisa-$version.tar.xz"
options="!checksum"

build() {
    cd "elisa-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
