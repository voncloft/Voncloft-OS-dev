# description : Audio tag editor for modifying metadata and artwork across many music file formats
# depends : chromaprint extra-cmake-modules ffmpeg flac kconfig kconfigwidgets kcoreaddons kde-deps-installer kdoctools ki18n kio kwidgetsaddons kxmlgui libvorbis python qt6 taglib

name=kid3
version=3.10.2
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "kid3-${version}"
    plasma-package-installer \
        -DBUILD_WITH_QT6=ON
    cd build
    make DESTDIR="$PKG" install
}
