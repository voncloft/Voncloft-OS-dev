# description : Countdown scheduler that runs commands after specified delays
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kio knotifications kstatusnotifieritem kwidgetsaddons qt6

name=ktimer
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/ktimer-$version.tar.xz"
options="!checksum"

build() {
    cd "ktimer-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
