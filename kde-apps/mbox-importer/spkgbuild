# description : Utility for importing email messages from mbox archives into Akonadi
# depends : akonadi extra-cmake-modules kconfig kcrash kde-deps-installer ki18n kiconthemes kidentitymanagement kservice mailcommon mailimporter qt6

name=mbox-importer
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "mbox-importer-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
