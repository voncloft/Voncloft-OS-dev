# depends : dbus extra-cmake-modules kcmutils kcolorscheme kconfig kcontacts kcoreaddons kcrash kdbusaddons kde-deps-installer kguiaddons ki18n kiconthemes kio kirigami kirigami-addons kitemmodels knotifications kpackage kpeople kservice kstatusnotifieritem kwidgetsaddons kwindowsystem modemmanager-qt pkgconf plasma-wayland-protocols pulseaudio-qt qqc2-desktop-style qt6 solid wayland wayland-protocols
# description : Desktop and phone integration for sharing files, notifications, clipboard contents, and remote controls

name=kdeconnect-kde
version=26.08.3
release=1
backup="etc/ufw/applications.d/kdeconnect etc/xdg/autostart/org.kde.kdeconnect.daemon.desktop"

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz
        configurable-udev-directory.patch"
options="!checksum"

build() {
    cd "kdeconnect-kde-$version"
    patch --fuzz=0 -p1 < "$SRC/configurable-udev-directory.patch"
    plasma-package-installer -DUDEVDIR=/usr/lib/udev
    cd build
    make DESTDIR="$PKG" install
}
