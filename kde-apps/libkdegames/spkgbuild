# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kcolorscheme kcompletion kconfig kconfigwidgets kde-deps-installer kdnssd kguiaddons ki18n kiconthemes knewstuff kxmlgui libsndfile openal qt6

name=libkdegames
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libkdegames-$version.tar.xz"
options="!checksum"

build() {
    cd "libkdegames-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
