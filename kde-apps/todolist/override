# Read upstream metadata; only report uversion. update-repo edits version=.
source=https://github.com/voncloft/Todolist/commits/HEAD.atom
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - "${version:-}" "${release:-}" <<'PYVERSION'
import json,pathlib,re,sys
try:
    text=pathlib.Path('index.html').read_text(encoding='utf-8')
    import datetime,subprocess,xml.etree.ElementTree as ET
    ns={'a':'http://www.w3.org/2005/Atom'}
    entry=ET.fromstring(text).find('a:entry',ns)
    if entry is None: raise ValueError('Empty upstream commit feed')
    sha=(entry.findtext('a:id',namespaces=ns) or '').rsplit('/',1)[-1]
    if not re.fullmatch(r'[0-9a-f]{40}',sha): raise ValueError('Invalid upstream commit ID')
    current=sys.argv[1]
    if current.endswith('.g'+sha):
        print(current)  # Keep existing date precision when this commit is already packaged.
    else:
        stamp=datetime.datetime.fromisoformat(entry.findtext('a:updated',namespaces=ns).replace('Z','+00:00')).astimezone(datetime.timezone.utc).strftime('%Y%m%d%H%M%S')
        cmake=subprocess.check_output(['curl','-fLsS','--max-time','20','https://raw.githubusercontent.com/voncloft/Todolist/'+sha+'/CMakeLists.txt'],text=True)
        cmake=re.sub(r'(?m)#.*$','',cmake)
        match=re.search(r'(?is)\bproject\s*\([^)]*?\bVERSION\s+["\']?([0-9]+(?:\.[0-9]+)+)',cmake)
        if not match: raise ValueError('No project VERSION at upstream commit')
        print(match[1]+'.git'+stamp+'.g'+sha)
except Exception as error:
    print('ERROR: Unable to read upstream version: '+str(error),file=sys.stderr)
    sys.exit(1)
PYVERSION
    ) || return 1
    [ -n "$detected" ] || return 1
    uversion=$detected
}
