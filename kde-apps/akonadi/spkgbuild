# description : Background service for storing and accessing email, contacts, calendars, and other personal information
# depends : extra-cmake-modules kcolorscheme kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer ki18n kiconthemes kirigami kirigami-addons kitemmodels kwidgetsaddons kwindowsystem kxmlgui qt6 shared-mime-info xz

name=akonadi
version=26.08.3
release=1
backup="etc/apparmor.d/mariadbd_akonadi etc/apparmor.d/usr.bin.akonadiserver etc/apparmor.d/mysqld_akonadi etc/apparmor.d/postgresql_akonadi etc/xdg/akonadi/mysql-global.conf etc/xdg/akonadi/mysql-global-mobile.conf"

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "akonadi-$version"
    plasma-package-installer  -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
