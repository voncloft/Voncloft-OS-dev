# description : Background service for storing and accessing email, contacts, calendars, and other personal information
# depends : extra-cmake-modules kcolorscheme kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer ki18n kiconthemes kirigami kirigami-addons kitemmodels kwidgetsaddons kwindowsystem kxmlgui qt6 shared-mime-info xz

name=akonadi
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/akonadi-$version.tar.xz"
options="!checksum"

build() {
    cd "akonadi-$version"
    plasma-package-installer  -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
