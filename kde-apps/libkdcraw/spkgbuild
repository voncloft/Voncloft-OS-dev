# description : Qt library wrapper around LibRaw for decoding digital camera RAW images
# depends : extra-cmake-modules kde-deps-installer libraw qt6

name=libkdcraw
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libkdcraw-$version.tar.xz"
options="!checksum"

build() {
    cd "libkdcraw-$version"
    plasma-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
