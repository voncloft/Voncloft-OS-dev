# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kcompletion kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio ktextwidgets kwidgetsaddons kxmlgui qt6

name=kwave
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kwave-$version.tar.xz"
options="!checksum"

build() {
    cd "kwave-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
