# description : Text translation application with speech playback and support for online translation services
# depends : extra-cmake-modules kde-deps-installer kiconthemes kwayland libxcb qt6 tesseract

name=crow-translate
version=4.1.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.gz"

build() {
    cd "crow-translate"
    plasma-package-installer \
        -DWITH_PIPER_TTS=OFF \
        -DWITH_TTS=ON
    cd build
    make DESTDIR="$PKG" install
}
