# description : Library for reading and writing vocabulary documents used by language learning applications
# depends : extra-cmake-modules karchive kde-deps-installer ki18n kio qt6

name=libkeduvocdocument
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libkeduvocdocument-$version.tar.xz"
options="!checksum"

build() {
    cd "libkeduvocdocument-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
