# description : Virtual globe and map application with geographic information, route planning, and multiple map views
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kde-deps-installer ki18n kio knewstuff kparts qt6

name=marble
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "marble-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
