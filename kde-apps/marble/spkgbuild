# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kde-deps-installer ki18n kio knewstuff kparts qt6

name=marble
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/marble-$version.tar.xz"
options="!checksum"

build() {
    cd "marble-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
