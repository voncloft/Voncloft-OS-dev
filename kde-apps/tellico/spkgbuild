# description : Collection manager for cataloging books, films, music, games, and other personal collections
# depends : exiv2 extra-cmake-modules gettext karchive kcodecs kcolorscheme kcompletion kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools kfilemetadata kguiaddons ki18n kiconthemes kio kitemmodels kjobwidgets knewstuff ktextwidgets kwidgetsaddons kxmlgui libkcddb libksane libxml2 libxslt poppler qt6 solid sonnet taglib

name=tellico
version=4.3
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/office/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "tellico-v${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
