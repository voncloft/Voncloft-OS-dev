# description : Educational activity collection for children covering reading, arithmetic, science, and computer skills
# depends : extra-cmake-modules kde-deps-installer kdoctools openssl qt6

name=gcompris
version=26.2
release=2
options="!checksum"
_name=gcompris-qt
source="${name}-${version}.tar.xz::https://download.kde.org/stable/gcompris/qt/src/${_name}-${version}.tar.xz
    ${name}-${version}.tar.gz::https://github.com/qml-box2d/qml-box2d/archive/e3674e0fe030c406a1d915e47eab760624fffa55.tar.gz"

build() {
    cd "gcompris-qt-${version}"
    cp -a "$SRC/qml-box2d-e3674e0fe030c406a1d915e47eab760624fffa55/." external/qml-box2d/
    plasma-package-installer \
        -DBUILD_STANDALONE=OFF \
        -DCOMPILE_DOC=ON \
        -DBUILD_SERVER=ON \
        -DPACKAGE_SERVER=ON
    cd build
    make DESTDIR="$PKG" install
}
