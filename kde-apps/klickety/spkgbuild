# description : Puzzle game in which players remove connected groups of matching colored blocks
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio kwidgetsaddons kxmlgui libkdegames qt6

name=klickety
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "klickety-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
