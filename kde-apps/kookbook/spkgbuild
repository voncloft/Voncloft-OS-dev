# description : Recipe manager for browsing and organizing recipes stored as text files
# depends : extra-cmake-modules kde-deps-installer qt6

name=kookbook
version=0.3.0
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${name}-${version}.tar.xz"

build() {
    cd "kookbook-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
