# description : Library and editing components for managing Sieve email filtering scripts
# depends : cyrus-sasl extra-cmake-modules karchive kcolorscheme kcoreaddons kde-deps-installer ki18n kiconthemes kidentitymanagement kimap kio kmailtransport kmime knewstuff ktextaddons libkdepim pimcommon qt6 sonnet syntax-highlighting

name=libksieve
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libksieve-$version.tar.xz"
options="!checksum"

build() {
    cd "libksieve-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
