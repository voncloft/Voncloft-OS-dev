# description : UML modeling application for creating software diagrams and generating or importing code
# depends : extra-cmake-modules karchive kcompletion kconfig kcoreaddons kcrash kde-deps-installer kdoctools ki18n kiconthemes kio ktexteditor kwidgetsaddons kwindowsystem kxmlgui libxml2 libxslt qt6

name=umbrello
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/umbrello-$version.tar.xz"
options="!checksum"

build() {
    cd "umbrello-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
