# description : Plasma 6 widget for viewing E*TRADE holdings, portfolio value, gains and losses, and performance history
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n libplasma qt6

name=etrade-widget
version=0.1.0.git20260831.gbece75e8790c67c3a6fe106ce32e2ebe694b6b2b
release=1
_commit=${version##*.g}
source="$name-$_commit.tar.gz::https://github.com/voncloft/${name}/archive/$_commit.tar.gz"

build() {
    cd "etrade-widget-$_commit"
    # Discard any build directory committed by upstream before configuring.
    rm -rf build
    plasma-package-installer
    DESTDIR="$PKG" cmake --install build
}
