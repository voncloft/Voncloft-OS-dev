# description : Core components for the kde desktop
# depends : aubio extra-cmake-modules fluidsynth kcolorscheme kcoreaddons kcrash kde-deps-installer kdoctools ki18n kirigami kirigami-addons pkgconf qqc2-desktop-style qt6

name=minuet
version=26.08.2
release=2

source="https://download.kde.org/stable/release-service/$version/src/minuet-$version.tar.xz"
options="!checksum"

build() {
    cd "minuet-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
