# description : Note-taking application for organizing notebooks and writing formatted notes
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kcrash kde-deps-installer ki18n kiconthemes kirigami kirigami-addons kitemmodels kmime knotifications krunner kwindowsystem md4c qt6

name=marknote
version=1.6.0
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${name}-${version}.tar.xz"

build() {
    cd "marknote-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
