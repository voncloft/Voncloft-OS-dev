# description : Setup wizard for configuring email accounts and related services in KMail
# depends : akonadi extra-cmake-modules kcrash kdbusaddons kde-deps-installer kdoctools ki18n kidentitymanagement kio kmailtransport kmime qt6

name=kmail-account-wizard
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kmail-account-wizard-$version.tar.xz"
options="!checksum"

build() {
    cd "kmail-account-wizard-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
