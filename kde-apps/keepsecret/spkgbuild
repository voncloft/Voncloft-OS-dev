# description : Password manager for viewing and editing credentials stored by Secret Service-compatible backends
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer ki18n kiconthemes kirigami kirigami-addons kirigami-app-components kitemmodels libsecret pkgconf qqc2-desktop-style qt6

name=keepsecret
version=26.08.2
release=2

source="https://download.kde.org/stable/release-service/$version/src/keepsecret-$version.tar.xz"
options="!checksum"

build() {
    cd "keepsecret-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
