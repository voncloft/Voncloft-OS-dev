# description : Graphical Git client for reviewing changes, browsing history, and managing branches and commits
# depends : dolphin extra-cmake-modules kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio ktexteditor ktextwidgets kxmlgui libgit2 openssl qt6 syntax-highlighting

name=kommit
version=1.8.1
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/sdk/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "kommit-v${version}"
    plasma-package-installer \
        -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
