# description : Japanese dictionary and study tool with kanji lookup and learning exercises
# depends : extra-cmake-modules karchive kcompletion kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio kxmlgui qt6

name=kiten
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kiten-$version.tar.xz"
options="!checksum"

build() {
    cd "kiten-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
