# description : On-screen ruler for measuring pixel distances and checking alignment
# depends : extra-cmake-modules kcoreaddons kcrash kde-deps-installer kdoctools ki18n knotifications kstatusnotifieritem kwindowsystem kxmlgui qt6

name=kruler
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kruler-$version.tar.xz"
options="!checksum"

build() {
    cd "kruler-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
