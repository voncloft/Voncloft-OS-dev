# description : Blackjack and poker with computer opponents, network players, card themes, and bundled sound effects
# depends : cmake ninja qt6

name=velvet-casino
version=1.0.17.git20261102125120.g09cd53a8556e0cbd3d981be838c621e4d1b78ce6
release=1
_commit=${version##*.g}
source="$name-$_commit.tar.gz::https://github.com/voncloft/Velvet_casino/archive/$_commit.tar.gz
io.voncloft.VelvetCasino.desktop"

build() {
    : "${PKG:?Package staging directory is required}"
    : "${SRC:?Source directory is required}"
    cd "Velvet_casino-$_commit"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF \
        -DCASINO_SOUND_DIR=
    cmake --build build
    DESTDIR="$PKG" cmake --install build
    install -Dm644 "$SRC/io.voncloft.VelvetCasino.desktop" \
        "$PKG/usr/share/applications/io.voncloft.VelvetCasino.desktop"
    install -Dm644 LICENSE "$PKG/usr/share/licenses/$name/LICENSE"
    install -Dm644 licenses/Kenney-Casino-Audio.txt \
        "$PKG/usr/share/licenses/$name/Kenney-Casino-Audio.txt"
}
