# Track master commits: upstream does not publish release tags.
# Only report uversion; update-repo owns the version= edit, including in test mode.
_upstream_repo=Velvet_casino
source="https://raw.githubusercontent.com/voncloft/$_upstream_repo/master/CMakeLists.txt"
# update-repo sources this again immediately before its fetch.
url="https://api.github.com/repos/voncloft/$_upstream_repo/commits?sha=master&per_page=1"

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - "$_upstream_repo" <<'PY'
import datetime
import json
import re
import subprocess
import sys

repo = sys.argv[1]
try:
    with open("index.html", encoding="utf-8") as stream:
        commit = json.load(stream)[0]
    sha = commit["sha"]
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise ValueError("invalid GitHub commit ID")
    stamp = datetime.datetime.strptime(
        commit["commit"]["committer"]["date"], "%Y-%m-%dT%H:%M:%SZ"
    ).strftime("%Y%m%d%H%M%S")
    # Read the version from the exact commit used by the source archive.
    result = subprocess.run(
        ["curl", "--fail", "--location", "--silent", "--show-error",
         "--max-time", "20",
         f"https://raw.githubusercontent.com/voncloft/{repo}/{sha}/CMakeLists.txt"],
        check=True, capture_output=True, text=True,
    )
    cmake = re.sub(r"#[^\n]*", "", result.stdout)
    project = re.search(r"\bproject\s*\(([^)]*)\)", cmake, re.I | re.S)
    if not project:
        raise ValueError("CMakeLists.txt has no project declaration")
    match = re.search(r'\bVERSION\s+"?([0-9]+(?:\.[0-9]+)+)"?(?=\s|$)',
                      project[1], re.I)
    if not match:
        raise ValueError("project version is missing or unsupported")
    print(f"{match[1]}.git{stamp}.g{sha}")
except (OSError, ValueError, KeyError, IndexError, TypeError,
        subprocess.CalledProcessError) as error:
    print(f"ERROR: Unable to read GitHub version for {repo}: {error}", file=sys.stderr)
    sys.exit(1)
PY
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
