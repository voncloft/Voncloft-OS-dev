# description : Markdown text editor with live preview and document export
# depends : extra-cmake-modules kconfigwidgets kcoreaddons kde-deps-installer kxmlgui qt6 sonnet

name=ghostwriter
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ghostwriter-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
