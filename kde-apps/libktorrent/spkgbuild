# description : Core components for the kde desktop
# depends : boost extra-cmake-modules gmp karchive kcrash kde-deps-installer ki18n kio qt6 solid

name=libktorrent
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libktorrent-$version.tar.xz"
options="!checksum"

build() {
    cd "libktorrent-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
