+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+pragma ComponentBehavior: Bound
+import QtQuick
+import org.kde.kirigami as Kirigami
+import org.kde.ki18n
+import org.kde.kasts
+
+Kirigami.ScrollablePage {
+    title: KI18n.i18n("Continue listening")
+    GenericEntryListView {
+        id: episodes
+        anchors.fill: parent
+        reuseItems: true
+        model: EpisodeProxyModel {
+            continueListening: true
+        }
+        delegate: GenericEntryDelegate {
+            listViewObject: episodes
+        }
+        Kirigami.PlaceholderMessage {
+            anchors.centerIn: parent
+            width: Math.min(parent.width, Kirigami.Units.gridUnit * 20)
+            visible: episodes.count === 0
+            text: KI18n.i18n("No unfinished episodes")
+            explanation: KI18n.i18n("Episodes you start listening to will appear here until you finish them.")
+        }
+    }
+}
