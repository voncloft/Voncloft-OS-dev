 #include "models/episodeproxymodel.h"
+#include "database.h"
+#include "datamanager.h"
+#include <QSqlQuery>
 
 EpisodeProxyModel::EpisodeProxyModel(QObject *parent)
     : AbstractEpisodeProxyModel(parent)
 {
     m_episodeModel = &EpisodeModel::instance();
     setSourceModel(m_episodeModel);
+    connect(&DataManager::instance(), &DataManager::entryPlayPositionsChanged, this, &EpisodeProxyModel::refreshContinueListening);
+    connect(&DataManager::instance(), &DataManager::entryReadStatusChanged, this, &EpisodeProxyModel::refreshContinueListening);
+    connect(&DataManager::instance(), &DataManager::enclosureDurationsChanged, this, &EpisodeProxyModel::refreshContinueListening);
+    connect(m_episodeModel, &QAbstractItemModel::modelReset, this, &EpisodeProxyModel::refreshContinueListening);
 }
+
+void EpisodeProxyModel::setContinueListening(bool enabled)
+{
+    if (m_continueListening == enabled) {
+        return;
+    }
+    m_continueListening = enabled;
+    refreshContinueListening();
+    Q_EMIT continueListeningChanged();
+}
+
+void EpisodeProxyModel::refreshContinueListening()
+{
+    m_unfinished.clear();
+    if (m_continueListening) {
+        QSqlQuery query;
+        query.prepare(QStringLiteral("SELECT DISTINCT Entries.entryuid FROM Entries JOIN Enclosures ON Entries.entryuid=Enclosures.entryuid "
+                                     "WHERE Entries.read=0 AND Enclosures.playposition>0 "
+                                     "AND (Enclosures.duration<=0 OR Enclosures.playposition<Enclosures.duration*1000)"));
+        Database::instance().execute(query);
+        while (query.next()) {
+            m_unfinished.insert(query.value(0).toLongLong());
+        }
+    }
+    invalidateFilter();
+}
+
+bool EpisodeProxyModel::filterAcceptsRow(int row, const QModelIndex &parent) const
+{
+    if (m_continueListening && !m_unfinished.contains(sourceModel()->data(sourceModel()->index(row, 0, parent), AbstractEpisodeModel::EntryuidRole).toLongLong())) {
+        return false;
+    }
+    return AbstractEpisodeProxyModel::filterAcceptsRow(row, parent);
+}
