+namespace {
+bool validUrl(const QString &text)
+{
+    const QUrl url(text);
+    return text.size() <= 8192 && url.isValid() && !url.host().isEmpty()
+        && (url.scheme() == QStringLiteral("https") || url.scheme() == QStringLiteral("http"));
+}
+
+bool queueSnapshot(QJsonArray &items, QList<qint64> &ids)
+{
+    QSqlQuery query;
+    if (!query.exec(QStringLiteral("SELECT q.entryuid, f.url AS podcast, e.id AS guid, c.url AS episode, e.title, f.name AS podcast_title, e.created, c.duration "
+                                  "FROM Queue q JOIN Entries e ON e.entryuid=q.entryuid JOIN Feeds f ON f.feeduid=e.feeduid "
+                                  "JOIN Enclosures c ON c.entryuid=e.entryuid ORDER BY q.listnr;"))) {
+        return false;
+    }
+    while (query.next()) {
+        QJsonObject item;
+        for (const QString &key : {QStringLiteral("podcast"), QStringLiteral("episode"), QStringLiteral("guid"), QStringLiteral("title"), QStringLiteral("podcast_title")}) {
+            item.insert(key, query.value(key).toString());
+        }
+        if (!validUrl(item.value(QStringLiteral("podcast")).toString()) || !validUrl(item.value(QStringLiteral("episode")).toString())) {
+            return false;
+        }
+        item.insert(QStringLiteral("published"), qMax<qint64>(0, query.value(QStringLiteral("created")).toLongLong()));
+        item.insert(QStringLiteral("duration"), qMax<qint64>(0, query.value(QStringLiteral("duration")).toLongLong()));
+        items.append(item);
+        ids.append(query.value(QStringLiteral("entryuid")).toLongLong());
+    }
+    return ids == QueueModel::instance().queue();
+}
+
+qint64 resolveEntry(const QJsonObject &item, bool &imported)
+{
+    const QString podcast = item.value(QStringLiteral("podcast")).toString();
+    const QString episode = item.value(QStringLiteral("episode")).toString();
+    const QString guid = item.value(QStringLiteral("guid")).toString();
+    QSqlQuery query;
+    if (!query.prepare(QStringLiteral("SELECT e.entryuid FROM Entries e JOIN Feeds f ON f.feeduid=e.feeduid "
+                                      "JOIN Enclosures c ON c.entryuid=e.entryuid WHERE f.url=:podcast "
+                                      "AND ((:guid<>'' AND e.id=:guid) OR c.url=:episode) LIMIT 1;"))) {
+        return 0;
+    }
+    query.bindValue(QStringLiteral(":podcast"), podcast);
+    query.bindValue(QStringLiteral(":guid"), guid);
+    query.bindValue(QStringLiteral(":episode"), episode);
+    if (!query.exec()) {
+        return 0;
+    }
+    if (query.next()) {
+        return query.value(0).toLongLong();
+    }
+    query.finish();
+    DataManager::instance().addFeeds(QStringList{podcast}, false);
+    if (!query.prepare(QStringLiteral("SELECT feeduid FROM Feeds WHERE url=?;"))) {
+        return 0;
+    }
+    query.addBindValue(podcast);
+    if (!query.exec() || !query.next()) {
+        return 0;
+    }
+    const qint64 feeduid = query.value(0).toLongLong();
+    query.finish();
+    QSqlDatabase db = QSqlDatabase::database();
+    if (!db.transaction()) {
+        return 0;
+    }
+    const qint64 published = item.value(QStringLiteral("published")).toInteger();
+    bool ok = query.prepare(QStringLiteral("INSERT INTO Entries (feeduid,id,title,content,created,updated,link,read,new,hasEnclosure,image,favorite,playposition,removed) "
+                                          "VALUES (?,?,?,'',?,?,'',0,0,1,'',0,0,0);"));
+    query.addBindValue(feeduid);
+    query.addBindValue(guid.isEmpty() ? episode : guid);
+    query.addBindValue(item.value(QStringLiteral("title")).toString(episode));
+    query.addBindValue(published);
+    query.addBindValue(published);
+    ok = ok && query.exec();
+    const qint64 entryuid = ok ? query.lastInsertId().toLongLong() : 0;
+    ok = ok && query.prepare(QStringLiteral("INSERT INTO Enclosures (entryuid,feeduid,url,duration,size,type,playposition,downloaded) VALUES (?,?,?,?,0,'audio/mpeg',0,0);"));
+    query.addBindValue(entryuid);
+    query.addBindValue(feeduid);
+    query.addBindValue(episode);
+    query.addBindValue(item.value(QStringLiteral("duration")).toInteger());
+    ok = ok && query.exec();
+    if (!ok || !db.commit()) {
+        db.rollback();
+        return 0;
+    }
+    DataManager::instance().registerSyncedEntry(entryuid, feeduid);
+    imported = true;
+    return entryuid;
+}
+}
