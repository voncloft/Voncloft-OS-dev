+bool QueueModel::replaceQueueForSync(const QList<qint64> &expected, const QList<qint64> &desired)
+{
+    if (m_queue != expected) {
+        return false;
+    }
+    const qint64 playing = AudioManager::instance().entryuid();
+    QSqlDatabase db = QSqlDatabase::database();
+    if (!db.transaction()) {
+        return false;
+    }
+    QSqlQuery query;
+    if (!query.exec(QStringLiteral("DELETE FROM Queue;"))
+        || !query.prepare(QStringLiteral("INSERT INTO Queue (listnr, entryuid, playing) VALUES (?, ?, ?);"))) {
+        db.rollback();
+        return false;
+    }
+    for (qsizetype i = 0; i < desired.size(); ++i) {
+        query.bindValue(0, i);
+        query.bindValue(1, desired[i]);
+        query.bindValue(2, desired[i] == playing);
+        if (!query.exec()) {
+            db.rollback();
+            return false;
+        }
+    }
+    if (!db.commit()) {
+        db.rollback();
+        return false;
+    }
+    beginResetModel();
+    m_queue = desired;
+    endResetModel();
+    QList<qint64> removed;
+    for (qint64 uid : expected) {
+        if (!desired.contains(uid)) {
+            removed.append(uid);
+        }
+    }
+    Q_EMIT DataManager::instance().entryQueueStatusChanged(false, removed);
+    Q_EMIT DataManager::instance().entryQueueStatusChanged(true, desired);
+    Q_EMIT queueSorted();
+    Q_EMIT timeLeftChanged();
+    if (playing != 0 && !desired.contains(playing)) {
+        AudioManager::instance().setEntryuid(desired.isEmpty() ? 0 : desired.first());
+    }
+    return true;
+}
