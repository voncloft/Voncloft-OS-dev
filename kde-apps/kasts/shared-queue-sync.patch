+void SyncJob::syncQueueThenEpisodeActions()
+{
+    Q_EMIT infoMessage(this, i18n("(Step %1 of %2) Synchronizing shared queue", processedAmount(KJob::Unit::Items), totalAmount(KJob::Unit::Items)));
