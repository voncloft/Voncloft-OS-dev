+QueueSyncJob::QueueSyncJob(GPodder *gpodder, const QString &device, QObject *parent)
+    : KJob(parent), m_gpodder(gpodder), m_device(device)
+{
+}
+
+void QueueSyncJob::fail(const QString &message)
+{
+    setError(KJob::UserDefinedError);
+    setErrorText(message);
+    emitResult();
+}
+
+void QueueSyncJob::abort()
+{
+    m_aborted = true;
+    if (m_reply) {
+        m_reply->abort();
+    }
+}
+
+void QueueSyncJob::start()
+{
+    QTimer::singleShot(0, this, [this]() {
+        if (m_aborted) {
+            fail(i18n("Queue synchronization was aborted."));
+            return;
+        }
+        QJsonArray local;
+        QList<qint64> before;
+        if (!queueSnapshot(local, before)) {
+            fail(i18n("Could not read the local queue safely."));
+            return;
+        }
+        const QString group = QStringLiteral("VonQueue/v1/")
+            + QString::fromLatin1(QCryptographicHash::hash(m_gpodder->queueSyncScope(m_device).toUtf8(), QCryptographicHash::Sha256).toHex());
+        QSettings state;
+        state.beginGroup(group);
+        QJsonObject payload;
+        payload.insert(QStringLiteral("base_revision"), state.contains(QStringLiteral("revision"))
+                           ? QJsonValue(state.value(QStringLiteral("revision")).toLongLong()) : QJsonValue(QJsonValue::Null));
+        payload.insert(QStringLiteral("items"), local);
+        m_reply = m_gpodder->queueRequest(m_device, payload);
+        QNetworkReply *reply = m_reply;
+        connect(reply, &QNetworkReply::finished, this, [this, reply, before, group]() {
+            const auto error = reply->error();
+            const QString errorText = reply->errorString();
+            const QByteArray data = reply->readAll();
+            reply->deleteLater();
+            if (error) {
+                fail(errorText);
+                return;
+            }
+            QJsonParseError parseError;
+            const QJsonObject response = QJsonDocument::fromJson(data, &parseError).object();
+            const QJsonValue revision = response.value(QStringLiteral("revision"));
+            if (parseError.error || response.value(QStringLiteral("protocol")).toString() != QStringLiteral("vonqueue-v1")
+                || !revision.isDouble() || revision.toInteger(-1) < 0 || !response.value(QStringLiteral("items")).isArray()) {
+                fail(i18n("The server returned an invalid shared queue."));
+                return;
+            }
+            const QJsonArray items = response.value(QStringLiteral("items")).toArray();
+            if (items.size() > 50000) {
+                fail(i18n("The shared queue is too large."));
+                return;
+            }
+            QSet<QString> seen;
+            for (const QJsonValue &value : items) {
+                const QJsonObject item = value.toObject();
+                const QString podcast = item.value(QStringLiteral("podcast")).toString();
+                const QString episode = item.value(QStringLiteral("episode")).toString();
+                const QString guid = item.value(QStringLiteral("guid")).toString();
+                const QString key = podcast + QLatin1Char('\n') + (guid.isEmpty() ? episode : guid);
+                if (!validUrl(podcast) || !validUrl(episode) || seen.contains(key)
+                    || item.value(QStringLiteral("duration")).toInteger(-1) < 0 || item.value(QStringLiteral("published")).toInteger(-1) < 0) {
+                    fail(i18n("The server returned an invalid shared queue."));
+                    return;
+                }
+                seen.insert(key);
+            }
+            if (QueueModel::instance().queue() != before) {
+                fail(i18n("The queue changed during synchronization. Please sync again."));
+                return;
+            }
+            QList<qint64> desired;
+            QSet<qint64> ids;
+            for (const QJsonValue &value : items) {
+                const qint64 entryuid = resolveEntry(value.toObject(), m_importedEpisodes);
+                if (entryuid <= 0 || ids.contains(entryuid)) {
+                    fail(i18n("Could not restore an episode in the shared queue."));
+                    return;
+                }
+                ids.insert(entryuid);
+                desired.append(entryuid);
+            }
+            if (!QueueModel::instance().replaceQueueForSync(before, desired)) {
+                fail(i18n("The queue changed during synchronization or could not be saved. Please sync again."));
+                return;
+            }
+            QSettings state;
+            state.beginGroup(group);
+            state.setValue(QStringLiteral("revision"), revision.toInteger());
+            state.sync();
+            if (state.status() != QSettings::NoError) {
+                fail(i18n("Could not save the queue synchronization revision."));
+                return;
+            }
+            emitResult();
+        });
+    });
+}
