+
+void Sync::reportPlaybackStatus()
+{
+    if (!m_syncEnabled || m_provider != Provider::GPodderNet || m_hostname.isEmpty() || m_username.isEmpty() || m_password.isEmpty()
+        || m_presenceBusy || QDateTime::currentSecsSinceEpoch() < m_presenceRetryAfter) {
+        return;
+    }
+    QUrl url(m_hostname);
+    if (!url.isValid() || url.host().isEmpty() || !url.userInfo().isEmpty()
+        || (url.scheme() != QLatin1String("http") && url.scheme() != QLatin1String("https"))) {
+        return;
+    }
+    QString path = url.path();
+    while (path.endsWith(QLatin1Char('/'))) {
+        path.chop(1);
+    }
+    url.setPath(path + QStringLiteral("/api/2/presence/") + m_username + QLatin1Char('/') + m_presenceInstance + QStringLiteral(".json"));
+    url.setQuery(QString());
+    url.setFragment(QString());
+    auto &audio = AudioManager::instance();
+    QString state = QStringLiteral("stopped");
+    if (audio.playbackState() == KMediaSession::PlaybackState::PlayingState) {
+        state = QStringLiteral("playing");
+    } else if (audio.playbackState() == KMediaSession::PlaybackState::PausedState) {
+        state = QStringLiteral("paused");
+    }
+    QJsonObject payload{{QStringLiteral("device"), m_device},
+                        {QStringLiteral("client"), QStringLiteral("Kasts")},
+                        {QStringLiteral("caption"), QStringLiteral("Kasts on %1").arg(QSysInfo::machineHostName().left(60))},
+                        {QStringLiteral("state"), state},
+                        {QStringLiteral("position"), qMax<qint64>(0, audio.position() / 1000)},
+                        {QStringLiteral("duration"), qMax<qint64>(0, audio.duration() / 1000)}};
+    QSqlQuery query;
+    query.prepare(QStringLiteral("SELECT f.url AS podcast, e.id AS guid, c.url AS episode, e.title, f.name AS podcast_title "
+                                 "FROM Entries e JOIN Feeds f ON f.feeduid=e.feeduid JOIN Enclosures c ON c.entryuid=e.entryuid WHERE e.entryuid=? LIMIT 1;"));
+    query.addBindValue(audio.entryuid());
+    // Use the same numeric entry/feed joins as the shared-queue protocol.
+    if (!query.exec() || !query.next()) {
+        payload.insert(QStringLiteral("state"), QStringLiteral("stopped"));
+    } else {
+        QJsonObject item;
+        for (const QString &key : {QStringLiteral("podcast"), QStringLiteral("episode"), QStringLiteral("guid"), QStringLiteral("title"), QStringLiteral("podcast_title")}) {
+            const int length = (key == QLatin1String("title") || key == QLatin1String("podcast_title")) ? 512 : 2000;
+            item.insert(key, query.value(key).toString().left(length));
+        }
+        payload.insert(QStringLiteral("item"), item);
+    }
+    QNetworkRequest request(url);
+    request.setTransferTimeout(10000);
+    request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+    request.setHeader(QNetworkRequest::ContentTypeHeader, QStringLiteral("application/json"));
+    request.setRawHeader("Authorization", "Basic " + (m_username + QLatin1Char(':') + m_password).toUtf8().toBase64());
+    m_presenceBusy = true;
+    QNetworkReply *reply = m_presenceNetwork->post(request, QJsonDocument(payload).toJson(QJsonDocument::Compact));
+    connect(reply, &QNetworkReply::finished, this, [this, reply]() {
+        m_presenceBusy = false;
+        const int code = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        if (code == 404 || code == 501) {
+            m_presenceRetryAfter = QDateTime::currentSecsSinceEpoch() + 300;
+        } else if (code != 200) {
+            m_presenceRetryAfter = QDateTime::currentSecsSinceEpoch() + 15;
+        }
+        reply->deleteLater();
+    });
 }
 
