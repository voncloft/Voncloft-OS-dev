# description : Podcast application for finding feeds, downloading episodes, and tracking playback progress
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer ki18n kiconthemes kirigami kirigami-addons kwindowsystem qqc2-desktop-style qt6 qtkeychain syndication taglib threadweaver

name=kasts
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kasts-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
