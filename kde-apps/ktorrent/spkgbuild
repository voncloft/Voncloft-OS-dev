name=ktorrent
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/ktorrent-$version.tar.xz"
options="!checksum"

build() {
    cd "ktorrent-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
