# description : kvantum - KDE dependency
# depends : kde-deps-installer kwindowsystem qt6

name=kvantum
version=1.1.8
release=1

source="$name-$version.tar.xz::https://github.com/tsujan/Kvantum/releases/download/V$version/Kvantum-$version.tar.xz"
options="!checksum"

build() {
    cd "Kvantum-$version/Kvantum"
    plasma-package-installer -DENABLE_QT5=OFF
    cd build
    make DESTDIR="$PKG" install
}
