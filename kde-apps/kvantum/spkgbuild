# description : a win xp theme installer
# depends : kwindowsystem

name=kvantum
version=1.1.6
release=1

source="https://github.com/tsujan/Kvantum/releases/download/V$version/Kvantum-$version.tar.xz"

build()
{
	cd Kvantum-$version/Kvantum
	mkdir build
	cd build
	cmake .. -DCMAKE_INSTALL_PREFIX=/usr
	make 
	make DESTDIR=$PKG install
}
