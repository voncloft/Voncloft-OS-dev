# description : SVG-based Qt widget style engine with a theme manager for customizing application appearance
# depends : kde-deps-installer kwindowsystem qt6

name=kvantum
version=1.1.8
release=1

_name=Kvantum
source="$name-$version.tar.xz::https://github.com/tsujan/${_name}/releases/download/V$version/${_name}-$version.tar.xz"
options="!checksum"

build() {
    cd "Kvantum-$version/Kvantum"
    plasma-package-installer -DENABLE_QT5=OFF
    cd build
    make DESTDIR="$PKG" install
}
