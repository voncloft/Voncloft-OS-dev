# description : Digital painting application with brushes, layers, illustration tools, and animation support
# depends : boost eigen exiv2 extra-cmake-modules ffmpeg fftw fontconfig freetype2 fribidi giflib harfbuzz immer kcolorscheme kcompletion kconfig kcoreaddons kcrash kde-deps-installer kguiaddons ki18n kitemviews kwidgetsaddons lager lcms2 libheif libjpeg-turbo libjxl libkdcraw libmypaint libpng libtiff libunibreak libwebp libxi opencolorio openexr openjpeg poppler qt6 sdl2 xsimd zlib zug

name=krita
version=6.0.4.1
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "krita-${version}"
    plasma-package-installer \
        -DBUILD_WITH_QT6=ON
    cd build
    make DESTDIR="$PKG" install
}
