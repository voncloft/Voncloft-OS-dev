# description : Library and configuration tools for sending email through configured mail transports
# depends : extra-cmake-modules kconfigwidgets kde-deps-installer ki18n kio ksmtp libkgapi qt6 qtkeychain

name=kmailtransport
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kmailtransport-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
