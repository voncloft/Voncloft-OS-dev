# description : Weather application for viewing current conditions and forecasts for selected locations
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kde-deps-installer ki18n kirigami kirigami-addons knotifications krunner kweathercore libplasma qt6

name=kweather
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kweather-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
