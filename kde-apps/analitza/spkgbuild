# description : Library for parsing, evaluating, and plotting mathematical expressions
# depends : extra-cmake-modules kde-deps-installer qt6

name=analitza
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/analitza-$version.tar.xz"
options="!checksum"

build() {
    cd "analitza-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
