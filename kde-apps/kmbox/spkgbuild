# description : Library for reading and writing email messages stored in mbox mailbox files
# depends : extra-cmake-modules kde-deps-installer kmime qt6

name=kmbox
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kmbox-$version.tar.xz"
options="!checksum"

build() {
    cd "kmbox-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
