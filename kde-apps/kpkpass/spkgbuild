# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kde-deps-installer qt6 shared-mime-info

name=kpkpass
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kpkpass-$version.tar.xz"
options="!checksum"

build() {
    cd "kpkpass-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
