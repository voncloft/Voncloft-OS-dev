# description : Library for managing user identities and sender profiles in KDE email applications
# depends : extra-cmake-modules kcodecs kconfig kcoreaddons kde-deps-installer ki18n kio kirigami-addons kpimtextedit ktextaddons kxmlgui qt6

name=kidentitymanagement
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kidentitymanagement-$version.tar.xz"
options="!checksum"

build() {
    cd "kidentitymanagement-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
