# description : File and folder comparison tool with automatic and interactive three-way merging
# depends : boost extra-cmake-modules icu kconfig kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio kwidgetsaddons kxmlgui qt6

name=kdiff3
version=1.12.6
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${name}-${version}.tar.xz"

build() {
    cd "kdiff3-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
