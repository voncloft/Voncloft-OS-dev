# description : Library for accessing and managing email on IMAP servers
# depends : cyrus-sasl extra-cmake-modules kcoreaddons kde-deps-installer ki18n kio kmime qt6

name=kimap
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kimap-$version.tar.xz"
options="!checksum"

build() {
    cd "kimap-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
