# depends : breeze-icons extra-cmake-modules karchive kbookmarks kcolorscheme kcompletion kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdegraphics-mobipocket ki18n kiconthemes kio kparts ktextwidgets kwidgetsaddons kwindowsystem kxmlgui libkexiv2 phonon poppler purpose qt6 threadweaver zlib
# description : Okular is a document viewer for KDE

name=okular
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/okular-$version.tar.xz"
options="!checksum"

build() {
    cd "okular-$version"
    plasma-package-installer '-DFORCE_NOT_REQUIRED_DEPENDENCIES=Discount;DjVuLibre;EPub;LibSpectre;LibZip'
    cd build
    make DESTDIR="$PKG" install
}
