# description : Core components for the kde desktop
# depends : akonadi extra-cmake-modules kde-deps-installer ki18n kio kitemmodels kmime kxmlgui libxslt qt6 shared-mime-info

name=akonadi-mime
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/akonadi-mime-$version.tar.xz"
options="!checksum"

build() {
    cd "akonadi-mime-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
