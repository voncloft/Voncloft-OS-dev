# description : KIO worker for browsing local network services advertised through Zeroconf
# depends : extra-cmake-modules kdbusaddons kde-deps-installer kdnssd ki18n kio qt6

name=kio-zeroconf
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kio-zeroconf-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
