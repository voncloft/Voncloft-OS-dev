# description : Core components for the kde desktop
# depends : akonadi akonadi-calendar calendarsupport extra-cmake-modules kcalendarcore kde-deps-installer ki18n qt6

name=akonadi-calendar-tools
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/akonadi-calendar-tools-$version.tar.xz"
options="!checksum"

build() {
    cd "akonadi-calendar-tools-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
