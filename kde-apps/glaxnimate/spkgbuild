# description : Glaxnimate
# depends : breeze-icons extra-cmake-modules karchive kcompletion kconfig kcoreaddons kcrash kde-deps-installer ki18n kiconthemes kwidgetsaddons kxmlgui libarchive potrace python qt6 zlib

name=glaxnimate
version=0.6.0
release=2
options="!checksum"
source="glaxnimate-0.6.0.tar.xz::https://download.kde.org/stable/glaxnimate/0.6.0/glaxnimate-0.6.0.tar.xz"

build() {
    cd "glaxnimate-0.6.0"
    plasma-package-installer \
        -DBUILD_WITH_QT6=ON \
        -DQT_MAJOR_VERSION=6 \
        -DQT_VERSION_MAJOR=6 \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    cd build
    make DESTDIR="$PKG" install
}
