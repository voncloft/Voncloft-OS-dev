# description : Configuration tool for enabling and filtering Qt and KDE application debug logging
# depends : extra-cmake-modules kcompletion kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdsingleapplication ki18n kiconthemes kitemviews kwidgetsaddons kwindowsystem kxmlgui qt6

name=kdebugsettings
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdebugsettings-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
