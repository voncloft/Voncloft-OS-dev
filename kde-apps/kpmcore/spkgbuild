# description : Library for detecting storage devices and creating, resizing, moving, or deleting disk partitions
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n kwidgetsaddons pkgconf polkit-qt qt6 util-linux

name=kpmcore
version=26.08.2
release=2

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kpmcore-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
