# description : System log viewer for browsing, filtering, and monitoring log files
# depends : extra-cmake-modules karchive kcompletion kconfig kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio kitemviews ktextwidgets kwidgetsaddons kxmlgui qt6

name=ksystemlog
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ksystemlog-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
