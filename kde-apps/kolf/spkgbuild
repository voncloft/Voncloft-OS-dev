# description : Core components for the kde desktop
# depends : extra-cmake-modules kcompletion kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio ktextwidgets kwidgetsaddons kxmlgui libkdegames qt6

name=kolf
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kolf-$version.tar.xz"
options="!checksum"

build() {
    cd "kolf-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
