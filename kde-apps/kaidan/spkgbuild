# description : XMPP messaging client for exchanging messages and files on desktop and mobile devices
# depends : extra-cmake-modules gstreamer icu kcrash kde-deps-installer kdsingleapplication kiconthemes kio kirigami kirigami-addons kitemmodels knotifications kwindowsystem openssl prison qqc2-desktop-style qt6 qtkeychain qxmpp sqlite

name=kaidan
version=0.16.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/network/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "kaidan-v${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
