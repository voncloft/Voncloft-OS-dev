# description : Shared calendar utilities and widgets used by KDE personal information applications
# depends : akonadi akonadi-calendar extra-cmake-modules kcalendarcore kcalutils kcodecs kde-deps-installer kguiaddons kholidays ki18n kidentitymanagement kio kmime ktextaddons qt6

name=calendarsupport
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/calendarsupport-$version.tar.xz"
options="!checksum"

build() {
    cd "calendarsupport-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
