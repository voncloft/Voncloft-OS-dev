# description : kdominate - KDE gear component
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kxmlgui libkdegames qt6

name=kdominate
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kdominate-$version.tar.xz"
options="!checksum"

build() {
    cd "kdominate-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
