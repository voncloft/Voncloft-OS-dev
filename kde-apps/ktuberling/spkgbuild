# description : Children's picture-building game for decorating characters and scenes with movable objects
# depends : extra-cmake-modules kcompletion kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kio kwidgetsaddons kxmlgui libkdegames qt6

name=ktuberling
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ktuberling-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
