# description : Embeddable viewer component for displaying SVG vector images in KDE applications
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kde-deps-installer ki18n kparts kxmlgui qt6

name=svgpart
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "svgpart-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
