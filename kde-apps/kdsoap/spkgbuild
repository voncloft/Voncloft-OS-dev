# description : Qt library and code generator for building SOAP web service clients and servers
# depends : kde-deps-installer qt6

name=kdsoap
version=2.3.0
release=1

source="$name-$version.tar.gz::https://github.com/KDAB/KDSoap/releases/download/kdsoap-$version/kdsoap-$version.tar.gz"
options="!checksum"

build() {
    cd "kdsoap-$version"
    plasma-package-installer -DKDSoap_QT6=ON -DKDSoap_EXAMPLES=OFF
    cd build
    make DESTDIR="$PKG" install
}
