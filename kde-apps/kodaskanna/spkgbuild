# description : Barcode scanning application for reading one- and two-dimensional codes from images and other inputs
# depends : extra-cmake-modules kconfigwidgets kcoreaddons kcrash kde-deps-installer ki18n kio kwidgetsaddons kxmlgui purpose qt6 zxing-cpp

name=kodaskanna
version=0.2.3
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/graphics/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "kodaskanna-v${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
