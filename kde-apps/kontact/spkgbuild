# description : Personal information suite combining email, calendars, contacts, tasks, and other organizer tools
# depends : extra-cmake-modules grantleetheme kcmutils kcrash kdbusaddons kde-deps-installer kguiaddons ki18n kiconthemes kontactinterface ktextaddons ktexttemplate libkdepim pimcommon qt6

name=kontact
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kontact-$version.tar.xz"
options="!checksum"

build() {
    cd "kontact-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
