# description : Core components for the kde desktop
# depends : breeze-icons extra-cmake-modules gettext kcoreaddons kcrash kde-deps-installer kdoctools kguiaddons ki18n kiconthemes knewstuff ktexteditor kuserfeedback qt6 qtkeychain

name=kate
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kate-$version.tar.xz"
options="!checksum"

build() {
    cd "kate-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
