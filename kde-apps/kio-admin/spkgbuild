# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer ki18n kio polkit-qt qt6

name=kio-admin
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kio-admin-$version.tar.xz"
options="!checksum"

build() {
    cd "kio-admin-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
