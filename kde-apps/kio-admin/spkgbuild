# description : KIO worker that allows authorized applications to access files with administrator privileges
# depends : extra-cmake-modules kde-deps-installer ki18n kio polkit-qt qt6

name=kio-admin
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kio-admin-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
