# description : Core components for the kde desktop
# depends : extra-cmake-modules kbookmarks kcodecs kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kiconthemes kio kparts kwidgetsaddons kwindowsystem qt6

name=keditbookmarks
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/keditbookmarks-$version.tar.xz"
options="!checksum"

build() {
    cd "keditbookmarks-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
