# description : Board game in which players increase dice values to capture neighboring squares
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kio kjobwidgets kwidgetsaddons kxmlgui libkdegames qt6

name=kjumpingcube
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kjumpingcube-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
