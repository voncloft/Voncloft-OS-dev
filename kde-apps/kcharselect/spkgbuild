# description : Character browser for finding, inspecting, and copying Unicode symbols
# depends : extra-cmake-modules kbookmarks kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kiconthemes kwidgetsaddons kxmlgui qt6

name=kcharselect
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kcharselect-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
