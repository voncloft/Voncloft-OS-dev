# description : alligator - KDE gear component
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kcrash kde-deps-installer ki18n kirigami kirigami-addons qqc2-breeze-style qqc2-desktop-style qt6 syndication

name=alligator
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/alligator-$version.tar.xz"
options="!checksum"

build() {
    cd "alligator-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
