# description : Infinite whiteboard for drawing diagrams, handwriting notes, and arranging text, images, and shapes
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kiconthemes kwidgetsaddons kxmlgui qt6 shared-mime-info syntax-highlighting zstd

name=drawy
version=1.0.2
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "drawy-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
