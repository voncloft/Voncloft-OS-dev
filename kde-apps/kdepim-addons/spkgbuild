name=kdepim-addons
version=26.08.2
release=2

source="https://download.kde.org/stable/release-service/$version/src/kdepim-addons-$version.tar.xz"
options="!checksum"

build() {
    cd "kdepim-addons-$version"
    # Rust is installed under /opt; sudo does not preserve that PATH entry.
    export PATH="/opt/rustc/bin:$PATH"
    rustc --version
    cargo --version
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
