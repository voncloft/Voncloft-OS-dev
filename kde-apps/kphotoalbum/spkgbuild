# description : Photo and video organizer with tags, annotations, and powerful collection searches
# depends : extra-cmake-modules karchive kcolorscheme kcompletion kconfig kcoreaddons kde-deps-installer kdoctools ki18n kiconthemes kio kjobwidgets ktextwidgets kwidgetsaddons kxmlgui libjpeg-turbo libkdcraw marble purpose qt6 vlc

name=kphotoalbum
version=6.2.0
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "kphotoalbum-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
