# description : Plasma 6 calendar widget displaying upcoming events directly from a Radicale or CalDAV calendar
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer ki18n libplasma qt6

name=kde-calendar
version=0.1.0.git20260211
release=1
_commit=1e40d77e34d6204cc79530863800a9eb027e4169
source="$name-$_commit.tar.gz::https://github.com/voncloft/KDE_CALENDAR/archive/$_commit.tar.gz"

build() {
    cd "KDE_CALENDAR-$_commit"
    # Discard any build directory committed by upstream before configuring.
    rm -rf build
    plasma-package-installer
    DESTDIR="$PKG" cmake --install build
}
