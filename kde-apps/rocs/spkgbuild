# description : Graph theory teaching application for creating graphs and experimenting with graph algorithms
# depends : boost extra-cmake-modules karchive kconfig kcoreaddons kcrash kde-deps-installer kdoctools ki18n kitemviews ktexteditor ktexttemplate ktextwidgets kxmlgui qt6

name=rocs
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/rocs-$version.tar.xz"
options="!checksum"

build() {
    cd "rocs-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
