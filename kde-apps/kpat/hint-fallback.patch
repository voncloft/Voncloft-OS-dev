Fix missing legal-move hints when a solver supplies no quick hints.
SpiderSolver2 intentionally relies on bruteForceHints for this case.
Includes regression coverage for one-, two-, and four-suit Spider.

--- a/src/dealer.cpp
+++ b/src/dealer.cpp
@@ -661,16 +661,22 @@
     const auto moves = solver()->firstMoves();
     for (const MOVE &m : moves) {
         MoveHint mh = solver()->translateMove(m);
-        hintList << mh;
+        if (mh.isValid())
+            hintList << mh;
     }
     return hintList;
 }
 
 QList<MoveHint> DealerScene::getHints()
 {
-    if (solver())
-        return getSolverHints();
-
+    if (solver()) {
+        const auto hints = getSolverHints();
+        if (!hints.isEmpty())
+            return hints;
+    }
+
+    // Some solvers (notably SpiderSolver2) do not provide quick hints.
+    // In that case, find legal moves directly from the current board.
     return bruteForceHints();
 }
 
