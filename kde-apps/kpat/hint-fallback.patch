+void TestSolverFormat::spiderHints_data()
+{
+    QTest::addColumn<int>("variant");
+    QTest::newRow("one suit") << int(DealerInfo::SpiderOneSuitId);
+    QTest::newRow("two suits") << int(DealerInfo::SpiderTwoSuitId);
+    QTest::newRow("four suits") << int(DealerInfo::SpiderFourSuitId);
+}
+
+void TestSolverFormat::spiderHints()
+{
+    QFETCH(int, variant);
+    std::unique_ptr<DealerScene> dealer(getDealer(variant));
+    QVERIFY(dealer);
+    dealer->mapOldId(variant);
+    dealer->setSolverEnabled(false);
+    dealer->setAutoDropEnabled(false);
+    dealer->startNew(2106638737);
+    dealer->deck()->stopAnimations();
+    dealer->startHint();
+    QVERIFY(dealer->isHintActive());
+    QVERIFY(!dealer->highlightedItems().isEmpty());
+    for (QGraphicsItem *item : dealer->highlightedItems()) {
+        auto *card = dynamic_cast<KCard *>(item);
+        QVERIFY(card);
+        QVERIFY(card->isFaceUp());
+        QVERIFY(card->isHighlighted());
+    }
+    dealer->stopHint();
+    QVERIFY(dealer->highlightedItems().isEmpty());
+}
+
 QTEST_MAIN(TestSolverFormat)
 #include "solver_format.moc"
