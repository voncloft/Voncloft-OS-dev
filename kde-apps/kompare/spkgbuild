# description : Core components for the kde desktop
# depends : extra-cmake-modules kcodecs kconfig kcoreaddons kde-deps-installer kdoctools ki18n kiconthemes kjobwidgets kparts ktexteditor kwidgetsaddons libkomparediff2 qt6

name=kompare
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kompare-$version.tar.xz"
options="!checksum"

build() {
    cd "kompare-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
