# description : Word puzzle game in which players rearrange scrambled letters to identify a word
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio knewstuff kxmlgui libkeduvocdocument qt6 sonnet

name=kanagram
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kanagram-$version.tar.xz"
options="!checksum"

build() {
    cd "kanagram-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
