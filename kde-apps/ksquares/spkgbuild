# description : Dots and boxes game in which players draw lines to claim squares
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kwidgetsaddons kxmlgui libkdegames qt6

name=ksquares
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/ksquares-$version.tar.xz"
options="!checksum"

build() {
    cd "ksquares-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
