# description : FFmpeg-based video thumbnail generator for Dolphin and other KDE file browsers
# depends : extra-cmake-modules ffmpeg kconfig kde-deps-installer kio qt6

name=ffmpegthumbs
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ffmpegthumbs-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
