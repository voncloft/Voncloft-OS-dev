# description : Authenticator that generates time-based and counter-based codes for two-factor authentication
# depends : extra-cmake-modules kconfig kcoreaddons kdbusaddons kde-deps-installer kguiaddons ki18n kirigami kirigami-addons kwidgetsaddons kwindowsystem libsodium openssl prison qqc2-desktop-style qt6

name=keysmith
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "keysmith-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
