# description : Media player with a simple interface for playing video and audio files
# depends : extra-cmake-modules ffmpeg kconfig kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio kirigami kwindowsystem qt6

name=dragon
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/dragon-$version.tar.xz"
options="!checksum"

build() {
    cd "dragon-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
