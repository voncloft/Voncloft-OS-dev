# description : Library that connects calendar applications to events and tasks stored in Akonadi
# depends : akonadi akonadi-contacts akonadi-mime extra-cmake-modules gpgmepp kcalendarcore kcalutils kcodecs kcontacts kcrash kdbusaddons kde-deps-installer ki18n kidentitymanagement kio kmailtransport kmime knotifications kwidgetsaddons kxmlgui libkleo messagelib qgpgme-qt qt6

name=akonadi-calendar
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "akonadi-calendar-$version"
    plasma-package-installer  -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
