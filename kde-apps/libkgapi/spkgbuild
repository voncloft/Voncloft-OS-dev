# description : Qt library for accessing Google services such as calendars, contacts, and Drive
# depends : cyrus-sasl extra-cmake-modules kcalendarcore kcontacts kde-deps-installer kwallet qt6

name=libkgapi
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "libkgapi-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
