# description : Core components for the kde desktop
# depends : cyrus-sasl extra-cmake-modules kcalendarcore kcontacts kde-deps-installer kwallet qt6

name=libkgapi
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libkgapi-$version.tar.xz"
options="!checksum"

build() {
    cd "libkgapi-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
