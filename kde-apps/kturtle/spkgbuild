# description : Educational programming environment using turtle graphics to teach basic coding concepts
# depends : extra-cmake-modules kcoreaddons kcrash kde-deps-installer kdoctools ki18n kio knewstuff ktextwidgets kxmlgui qt6

name=kturtle
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kturtle-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
