# description : Qt Quick components for displaying charts in QML applications
# depends : extra-cmake-modules kde-deps-installer qt6

name=kqtquickcharts
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kqtquickcharts-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
