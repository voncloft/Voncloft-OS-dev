# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer qt6

name=kqtquickcharts
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kqtquickcharts-$version.tar.xz"
options="!checksum"

build() {
    cd "kqtquickcharts-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
