# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kconfig kconfigwidgets kcoreaddons kde-deps-installer kdoctools ki18n kiconthemes kirigami kirigami-addons qt6

name=kapptemplate
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kapptemplate-$version.tar.xz"
options="!checksum"

build() {
    cd "kapptemplate-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
