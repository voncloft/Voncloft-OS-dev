# description : Video thumbnail generator that combines selected frames into a single contact sheet image
# depends : extra-cmake-modules ffmpeg kconfig kcoreaddons kde-deps-installer ki18n kio kirigami qt6

name=hana
version=1.0.0
release=2
options="!checksum"
source="${name}-${version}.tar.xz::https://download.kde.org/stable/${name}/${version}/${name}-${version}.tar.xz"

build() {
    cd "hana-${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
