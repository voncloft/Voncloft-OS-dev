# note : Preserves the local kaffeine.tar.xz Qt6 port (source identifies itself as 2.1.0).
# description : Media player with digital television tuning, channel management, and recording support
# depends : kde-deps-installer extra-cmake-modules qt6 kcoreaddons kconfig ki18n kxmlgui kio solid kdbusaddons vlc v4l-utils

name=kaffeine
version=2.0.19
release=2

source="https://github.com/KDE/kaffeine/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd kaffeine
   plasma-package-installer
  cd build
  make DESTDIR=$PKG install
}
