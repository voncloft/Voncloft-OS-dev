# description : Library for retrieving user avatar images from Gravatar services
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kde-deps-installer ki18n kwidgetsaddons qt6

name=libgravatar
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "libgravatar-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
