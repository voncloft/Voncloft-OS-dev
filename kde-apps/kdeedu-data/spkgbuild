# description : Shared data files and icons used by KDE educational applications
# depends : extra-cmake-modules kde-deps-installer qt6

name=kdeedu-data
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdeedu-data-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
