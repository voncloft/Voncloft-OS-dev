# description : Calculator with basic arithmetic and scientific functions for desktop and mobile devices
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer ki18n kirigami kirigami-addons kunitconversion libqalculate pkgconf qqc2-desktop-style qt6

name=kalk
version=26.08.2
release=2

source="https://download.kde.org/stable/release-service/$version/src/kalk-$version.tar.xz"
options="!checksum"

build() {
    cd "kalk-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
