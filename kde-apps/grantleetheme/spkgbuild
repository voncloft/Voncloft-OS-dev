# description : Core components for the kde desktop
# depends : extra-cmake-modules kcolorscheme kde-deps-installer kguiaddons ki18n kiconthemes knewstuff ktexttemplate kxmlgui qt6

name=grantleetheme
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/grantleetheme-$version.tar.xz"
options="!checksum"

build() {
    cd "grantleetheme-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
