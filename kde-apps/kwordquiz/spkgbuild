# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kcrash kdbusaddons kde-deps-installer kdoctools ki18n kirigami kirigami-addons knewstuff libkeduvocdocument qt6

name=kwordquiz
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kwordquiz-$version.tar.xz"
options="!checksum"

build() {
    cd "kwordquiz-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
