# description : Calendar application for managing events and tasks on mobile and desktop devices
# depends : extra-cmake-modules kcalendarcore kconfig kcoreaddons kdbusaddons kde-deps-installer ki18n kirigami knotifications kpeople qt6

name=calindori
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "calindori-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
