# description : Match-three puzzle game in which players swap colored diamonds to clear groups
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes knotifications knotifyconfig kwidgetsaddons kxmlgui libkdegames qt6

name=kdiamond
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kdiamond-$version.tar.xz"
options="!checksum"

build() {
    cd "kdiamond-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
