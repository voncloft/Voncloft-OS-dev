# description : Scientific calculator with trigonometric, statistical, and numeric base conversion functions
# depends : extra-cmake-modules kcolorscheme kconfig kconfigwidgets kcoreaddons kcrash kde-deps-installer kdoctools kguiaddons ki18n kiconthemes knotifications kxmlgui qt6

name=kcalc
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kcalc-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
