# description : Two-player card game based on the German game Lieutnant Skat
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools kguiaddons ki18n kiconthemes kwidgetsaddons kxmlgui libkdegames qt6

name=lskat
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "lskat-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
