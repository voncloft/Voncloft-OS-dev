# depends : kde-deps-installer
# status : Final archived release; excluded from current Frameworks/Plasma/Gear package groups.
# description : Library for accessing audio CD drives and controlling disc playback

name=libkcompactdisc
version=25.12.3
release=1

source="https://download.kde.org/Attic/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
   cd $name-$version
   plasma-package-installer
  cd build
  make DESTDIR=$PKG install
}
