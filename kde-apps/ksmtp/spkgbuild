# description : Library for sending email through SMTP servers
# depends : cyrus-sasl extra-cmake-modules kcoreaddons kde-deps-installer ki18n kio qt6

name=ksmtp
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/ksmtp-$version.tar.xz"
options="!checksum"

build() {
    cd "ksmtp-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
