# description : Pac-Man-style maze game in which players collect pills while avoiding ghosts
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kiconthemes kwidgetsaddons kxmlgui libkdegames qt6

name=kapman
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kapman-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
