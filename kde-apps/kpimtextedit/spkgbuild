# description : Core components for the kde desktop
# depends : extra-cmake-modules kcodecs kconfig kcoreaddons kde-deps-installer ki18n kiconthemes kio ktextaddons kwidgetsaddons kxmlgui qt6 sonnet syntax-highlighting

name=kpimtextedit
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kpimtextedit-$version.tar.xz"
options="!checksum"

build() {
    cd "kpimtextedit-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
