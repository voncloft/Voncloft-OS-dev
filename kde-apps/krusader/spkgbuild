# description : Dual-pane file manager with archive handling, synchronization, search, and remote file access
# depends : extra-cmake-modules karchive kbookmarks kcodecs kcompletion kconfig kcoreaddons kcrash kde-deps-installer kdoctools kglobalaccel kguiaddons ki18n kiconthemes kio kitemviews knotifications kparts kstatusnotifieritem ktextwidgets kwallet kwidgetsaddons kwindowsystem kxmlgui qt6 solid

name=krusader
version=2.9.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://invent.kde.org/utilities/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cd "krusader-v${version}"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
