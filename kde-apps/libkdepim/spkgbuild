# description : Core components for the kde desktop
# depends : extra-cmake-modules kcompletion kde-deps-installer ki18n kwidgetsaddons qt6

name=libkdepim
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/libkdepim-$version.tar.xz"
options="!checksum"

build() {
    cd "libkdepim-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
