# description : World conquest strategy game in which players deploy armies and capture territories
# depends : extra-cmake-modules kcompletion kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kio knewstuff kwallet kwidgetsaddons kxmlgui libkdegames qt6

name=ksirk
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ksirk-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
