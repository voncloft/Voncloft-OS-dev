# description : Library and viewer for extracting attachments from TNEF email files such as winmail.dat
# depends : extra-cmake-modules kcalendarcore kcalutils kcontacts kde-deps-installer ki18n qt6

name=ktnef
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ktnef-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
