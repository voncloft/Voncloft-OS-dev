# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kcoreaddons kcrash kde-deps-installer kdoctools kfilemetadata ki18n kio kwidgetsaddons kxmlgui qt6

name=kfind
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/kfind-$version.tar.xz"
options="!checksum"

build() {
    cd "kfind-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
