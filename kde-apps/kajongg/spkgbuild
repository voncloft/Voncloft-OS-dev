# description : Four-player Mahjong game with scoring, computer opponents, and network play
# depends : extra-cmake-modules kde-deps-installer kdoctools ki18n libkmahjongg python python-twisted qt6

name=kajongg
version=26.08.2
release=1

source="https://download.kde.org/stable/release-service/$version/src/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kajongg-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
