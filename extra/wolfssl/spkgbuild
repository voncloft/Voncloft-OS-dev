# description : SSL library
# depends : glibc cmake

name=wolfssl
version=5.9.4
release=4
source="${name}-${version}.tar.gz::https://github.com/wolfssl/${name}/archive/refs/tags/v${version}-stable.tar.gz"

build() {
    cd "$name-$version-stable"
    cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWOLFSSL_CURVE25519=ON \
        -DWOLFSSL_CURVE448=ON \
        -DWOLFSSL_ED25519=ON \
        -DWOLFSSL_ED448=ON \
        -DWOLFSSL_REPRODUCIBLE_BUILD=ON \
        -DWOLFSSL_SNI=ON \
        -DWOLFSSL_DTLS=yes \
        -DWOLFSSL_DTLS_MTU=yes
    cmake --build build --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-4}"
    DESTDIR="$PKG" cmake --install build
}
