# description : markdown implementation written in C
# depends : glibc

name=discount
version=3.0.2.0
_ver=${version}
release=1

source="${name}-${version}.tar.gz::https://github.com/Orc/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
	cd $name-$_ver
	  ./configure.sh \
    	--prefix=/usr \
    	--enable-all-features \
    	--with-fenced-code \
    	--github-checkbox \
    	--shared
  	make
	make DESTDIR=$PKG install
}
