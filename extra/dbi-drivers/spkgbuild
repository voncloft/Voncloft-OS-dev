# description : database drivers for libdbi
# depends : libdbi sqlite

name=dbi-drivers
version=0.9.0
release=10

_name=libdbi-drivers
source="https://sourceforge.net/projects/${_name}/files/${_name}/${_name}-$version/${_name}-$version.tar.gz"
options="!checksum"

build() {
	cd "$SRC"/libdbi-drivers*/
	autoreconf -ifv
	./configure --prefix=/usr --localstatedir=/var \
	--with-sqlite3
	sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
	make
	make DESTDIR=$PKG install
}
