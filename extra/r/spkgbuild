# description : r
# depends : bzip2 cairo curl gcc-fortran icu libjpeg-turbo libpng libtiff libxt make pcre2 readline xz zlib

name=r
version=4.6.2
release=2
options="!checksum"
_name=R
source="${name}-${version}.tar.xz::https://cran.r-project.org/src/base/${_name}-4/${_name}-${version}.tar.xz"

build() {
    cd "R-${version}"
    ./configure --prefix=/usr --libdir=/usr/lib64 --enable-R-shlib --with-x --with-readline
    make
    make DESTDIR="$PKG" install
}
