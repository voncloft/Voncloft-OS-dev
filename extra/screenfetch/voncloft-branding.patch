@@ -214,6 +214,23 @@
 #
 # Web terminal interface: http://10.1.1.10
 
+# Voncloft defaults, kept separate from upstream's -C custom-line support.
+use_customlines=1
+voncloftlines () {
+	local interface address
+	interface=$(ip -4 route show default 2>/dev/null | "${AWK}" '{for (i=1;i<NF;i++) if ($i=="dev") {print $(i+1); exit}}')
+	address="Not connected"
+	if [[ -n "$interface" ]]; then
+		address=$(ip -o -4 addr show dev "$interface" scope global 2>/dev/null | "${AWK}" '{split($4,a,"/"); print a[1]; exit}')
+		address=${address:-Not connected}
+	fi
+	out_array+=("$(printf '%b' "$labelcolor   \x60->$textcolor power supply plugged in")")
+	# Preserve the original label; this is the default interface's local address.
+	out_array+=("$(printf '%b' "$labelcolor WAN Address:$textcolor $address")")
+	out_array+=("$(printf '%b' "$labelcolor Domain:$textcolor voncloft.dnsfor.me")")
+	((display_index+=3))
+}
+
 customlines () {
 	OLD_IFS="${IFS}"
 	IFS=,
