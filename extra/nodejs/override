# Read the current stable release from official upstream metadata.
source="https://nodejs.org/dist/index.json"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import json,pathlib,re
releases=json.loads(pathlib.Path('index.html').read_text())
versions=[x['version'][1:] for x in releases
          if isinstance(x.get('lts'),str) and x['lts'] and 'src' in x.get('files',[])
          and re.fullmatch(r'v[0-9]+\.[0-9]+\.[0-9]+',x.get('version',''))]
if not versions: raise SystemExit('No stable Node.js LTS source release found')
print(max(versions,key=lambda v:tuple(map(int,v.split('.')))))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
