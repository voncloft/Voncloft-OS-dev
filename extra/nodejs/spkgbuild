# description   : Node
# depends       : which brotli c-ares icu libuv nghttp2

name=nodejs
version=22.23.4    
release=1
_name=node
source="https://nodejs.org/dist/v${version}/${_name}-v${version}.tar.xz"

options="!checksum"

build() {
	cd "$SRC"/node*/
        ./configure --prefix=/usr          \
--shared-brotli        \
--shared-cares         \
--shared-libuv         \
--shared-openssl       \
--shared-nghttp2       \
--shared-zlib          \
--with-intl=system-icu 
make
make DESTDIR=$PKG install 
}
