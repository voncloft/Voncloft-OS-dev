# description : Check battery level of logitech devices
# depends : gtk3 libnotify

name=solaar
version=1.1.20rc3
release=2

_name=Solaar
source="https://github.com/pwr-Solaar/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
	cd *
	tools/po-compile.sh
	python setup.py build
	python setup.py install --skip-build \
                          --optimize=1 \
                          --root="${PKG}/"
	
}
