# description : Scanner Access Now Easy
# depends : avahi cups curl libjpeg-turbo libtiff libusb libxml2 pkgconf poppler python v4l-utils

name=sane
version=1.4.0
release=2

source="https://anduin.linuxfromscratch.org/BLFS/sane/sane-backends-$version.tar.gz
	net.conf"
options="!checksum"

build() {
    cd "sane-backends-$version"
    PYTHON=python3 ./configure --prefix=/usr \
        --libdir=/usr/lib64 \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --with-lockdir=/run/lock \
        --with-usb --with-avahi --without-systemd \
        --docdir="/usr/share/doc/sane-backends-$version"
    make
    make DESTDIR="$PKG" install
    install -Dm644 tools/udev/libsane.rules "$PKG/etc/udev/rules.d/65-scanner.rules"
    install -Dm644 "$SRC/net.conf" "$PKG/etc/sane.d/net.conf"
}
