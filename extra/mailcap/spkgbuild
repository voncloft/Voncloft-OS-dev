# description : helper application and mime type association for the types
# depends : git python

name=mailcap
version=2.1.54
release=1
_version=${version//./-}

source="${name}-${version}.tar.gz::https://github.com/InfrastructureServices/${name}/archive/refs/tags/r${_version}.tar.gz"

build() {
	cd mailcap-r$_version
	make
	make DESTDIR=$PKG install
}
