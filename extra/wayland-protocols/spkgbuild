# description : wayland-protocols - KDE dependency
# depends : meson ninja wayland

name=wayland-protocols
version=1.49
release=1

source="$name-$version.tar.xz::https://gitlab.freedesktop.org/wayland/${name}/-/releases/$version/downloads/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "$SRC"/wayland-protocols*/
    meson setup build --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var --buildtype=release -Dtests=false
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
