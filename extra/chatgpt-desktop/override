# Read upstream release metadata and keep version, source, and SHA-256 together.
source=https://persistent.oaistatic.com/codex-app-prod/linux/deb/dists/stable/main/binary-amd64/Packages
url=$source

get_generic()
{
    local detected recipe comparison edit
    local -a fields sed_args
    unset uversion
    recipe="${ppath%/*}/spkgbuild"
    detected=$(python3 - "$recipe" <<'PYRELEASE'
import pathlib, re, sys
try:
    text=pathlib.Path('index.html').read_text()
    records=[]
    for block in re.split(r'\n\s*\n',text):
        fields=dict(re.findall(r'^([A-Za-z0-9-]+): (.*)$',block,re.M))
        if fields.get('Package')!='chatgpt' or fields.get('Architecture')!='amd64':
            continue
        version=fields['Version']
        if not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+',version):continue
        path=fields['Filename']
        if path!='pool/main/c/chatgpt/chatgpt_'+version+'_amd64.deb':
            raise ValueError('unexpected ChatGPT archive path')
        digest=fields['SHA256']
        if not re.fullmatch(r'[0-9a-f]{64}',digest):raise ValueError('invalid SHA-256')
        records.append((tuple(map(int,version.split('.'))),version,path,digest))
    if not records:raise ValueError('no stable amd64 ChatGPT package')
    _,version,path,digest=max(records)
    updates={'_package_path':path,'_sha256':digest}
    # Require exactly the fields that will be changed; do not partially update.
    recipe=pathlib.Path(sys.argv[1]).read_text()
    for key in updates:
        if len(re.findall(r'^'+key+r'=.*$',recipe,re.M))!=1:
            raise ValueError('missing or duplicate recipe field '+key)
    print(version)
    for key,value in updates.items():print('s|^'+key+'=.*$|'+key+'='+value+'|')
except (OSError,ValueError,KeyError) as error:
    sys.exit('ERROR: Invalid upstream release metadata: '+str(error))
PYRELEASE
    ) || return 1
    mapfile -t fields <<< "$detected"
    uversion=${fields[0]}
    if vercomp "$uversion" "$version" >/dev/null; then
        return 0
    else
        comparison=$?
    fi
    [ "$comparison" = 2 ] || return 0
    sed_args=()
    for edit in "${fields[@]:1}"; do
        sed_args+=(-e "$edit")
    done
    if [ -n "${test_upgrade:-}" ]; then
        printf 'sed -i' >> test_updates.sh
        printf ' %q' "${sed_args[@]}" -- "$recipe" >> test_updates.sh
        printf '\n' >> test_updates.sh
    else
        sed -i "${sed_args[@]}" -- "$recipe" || return 1
    fi
}
