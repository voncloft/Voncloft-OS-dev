# description : oxipng
# depends : rust

name=oxipng
version=10.2.1
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/oxipng/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cd "oxipng-${version}"
    export PATH="/opt/rustc/bin:$PATH"
    cargo build --release --locked
    install -Dm755 target/release/oxipng "$PKG/usr/bin/oxipng"
    install -Dm644 LICENSE "$PKG/usr/share/licenses/oxipng/LICENSE"
}
