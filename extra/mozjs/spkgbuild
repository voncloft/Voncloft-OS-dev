# description	: Mozilla's JavaScript engine written in C
# depends	: autoconf2.13 icu rust which

name=mozjs
version=102.15.1
release=1
_name=firefox
source="https://archive.mozilla.org/pub/${_name}/releases/${version}esr/source/${_name}-${version}esr.source.tar.xz"
options="!checksum"
build() {
	cd firefox-$version

	#sed '21,+4d' -i js/moz.configure

	mkdir obj
	cd    obj

	#export SHELL=/bin/sh

	#CC=gcc \
	sh ../js/src/configure.in --prefix=/usr            \
                          --with-intl-api          \
                          --with-system-zlib       \
                          --with-system-icu        \
                          --disable-jemalloc       \
                          --disable-debug-symbols  \
                          --enable-readline 
	make -j1
	make DESTDIR=$PKG install

	rm $PKG/usr/lib/libjs_static.ajs
}
