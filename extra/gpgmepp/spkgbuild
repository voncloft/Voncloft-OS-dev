# description : gpgmepp - KDE dependency
# depends : gpgme kde-deps-installer libgpg-error

name=gpgmepp
version=2.2.0
release=1

source="$name-$version.tar.xz::https://gnupg.org/ftp/gcrypt/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "gpgmepp-$version"
    plasma-package-installer -DBUILD_TESTING=OFF
    cd build
    make DESTDIR="$PKG" install
}
