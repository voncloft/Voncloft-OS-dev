# description	: htmlq
# depends	: gcc git rust

name=htmlq
version=9.3
release=1
source="https://github.com/mgdm/${name}/archive/refs/tags/v$version.tar.gz"

options="!checksum"
build() {
	cd "$SRC"/htmlq*/
	cargo test --frozen --release
	cargo fetch --locked --target
	cargo build --frozen --release
	install -vDm755 target/release/htmlq $PKG/usr/bin 
}
