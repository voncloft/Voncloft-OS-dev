# description : jpegoptim
# depends : libjpeg-turbo make

name=jpegoptim
version=1.5.6
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/tjko/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cd "jpegoptim-${version}"
    ./configure --prefix=/usr
    make
    make DESTDIR="$PKG" install
}
