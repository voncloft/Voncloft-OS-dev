+namespace
+{
+// NNG 2 initialization is reference-counted. Keep one reference for each
+// listener thread, including every early-return path below.
+struct NNG_RUNTIME
+{
+    NNG_RUNTIME() : result( nng_init( nullptr ) ) {}
+    ~NNG_RUNTIME() { if( result == 0 ) nng_fini(); }
+    const int result;
+};
+}
