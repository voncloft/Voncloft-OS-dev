# depends : 

name=anki
version=test
release=1

source="https://github.com/ankitects/${name}/releases/download/$version/${name}-$version-linux-qt6.tar.zst"

build() {
	tar xaf $SRC/anki-$version-linux-qt6.tar.zst
	cd anki-$version-linux-qt6
	PREFIX=$PKG/usr ./install.sh
	rm $PKG/usr/bin/anki
	ln -sfv /usr/share/anki/anki "$PKG"/usr/bin/anki
}
