# description : Extra modules and scripts for CMake
# depends : kde-deps-installer

name=extra-cmake-modules
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/extra-cmake-modules-$version.tar.xz"
options="!checksum"

build() {
    cd "extra-cmake-modules-$version"
    kf-package-installer -DBUILD_TESTING=OFF -DBUILD_HTML_DOCS=OFF -DBUILD_QTHELP_DOCS=OFF -DBUILD_MAN_DOCS=OFF
    cd build
    make DESTDIR="$PKG" install
}
