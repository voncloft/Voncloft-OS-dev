# description : Virtual Keyboard
# depends : onboard-launcher

name=onboard
version=1.4.1
release=7

source="https://launchpad.net/$name/${version%.*}/$version/+download/$name-$version.tar.gz"
options="!checksum"

build() {
	cd $name-$version
	python3 setup.py build
	python3 setup.py install --prefix=/usr --root="$PKG" --optimize=1
	# The separate Scratch-managed launcher owns /usr/bin/onboard.
	mv "$PKG/usr/bin/onboard" "$PKG/usr/bin/onboard-app"
}
