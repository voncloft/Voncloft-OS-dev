# description	: GTK+3 terminal emulator for xfce desktop
# depends	: libxfce4ui vte3

name=xfce4-terminal
version=1.2.0
release=1


source="https://archive.xfce.org/src/apps/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	cd $name-$version

	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install
}
