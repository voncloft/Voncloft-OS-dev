# description	: A set of plug-ins considered by the GStreamer developers to have good quality code, correct functionality, and the preferred license
# depends	: gst-plugins-base cairo flac gdk-pixbuf lame libsoup libvpx mpg123 nasm pulseaudio meson ninja pkgconf

name=gst-plugins-good
version=1.28.8
release=2
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz"

build() {
    cd "$SRC/$name-$version"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dtests=disabled \
        -Dexamples=disabled \
        -Ddoc=disabled
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
