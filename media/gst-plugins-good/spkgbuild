# description	: A set of plug-ins considered by the GStreamer developers to have good quality code, correct functionality, and the preferred license
# depends	: gst-plugins-base cairo flac gdk-pixbuf lame libsoup libvpx mpg123 nasm pulseaudio meson ninja pkgconf qt6

name=gst-plugins-good
version=1.28.9
release=3
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz"

build() {
    cd "$SRC/$name-$version"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dtests=disabled \
        -Dqt6=enabled \
        -Dexamples=disabled \
        -Ddoc=disabled
    ninja -j"${NINJAJOBS:-$(nproc)}" -C build
    DESTDIR="$PKG" ninja -j"${NINJAJOBS:-$(nproc)}" -C build install
}
