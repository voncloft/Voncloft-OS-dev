# description : 3d audio library
# depends : gcc

name=openal
version=1.25.2
release=1

_name=openal-soft
source="https://github.com/kcat/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
	cd $name-soft-$version
	mkdir builds
	cd builds
	cmake .. \
	    -DCMAKE_INSTALL_PREFIX=/usr \
    	-DCMAKE_BUILD_TYPE=None \
    	-DCMAKE_INSTALL_LIBDIR=lib
	make
	make DESTDIR=$PKG install
}
