# description : AV1 cross-platform decoder
# depends : glibc meson ninja nasm

name=dav1d
version=1.5.4
release=1

source="https://downloads.videolan.org/pub/videolan/${name}/${version}/${name}-${version}.tar.xz"
options="!checksum"

build() {
	cd $name-$version
	mkdir build
	cd build
	meson setup .. --prefix=/usr --libdir=lib --buildtype=release --default-library=shared -Denable_tests=false
	ninja
	DESTDIR=$PKG ninja install
	
}
