# description	: Library for encoding video streams into the H.264/MPEG-4 AVC format
# depends	: nasm

name=x264
version=20250815
release=1
source="https://anduin.linuxfromscratch.org/BLFS/${name}/${name}-${version}.tar.xz"

build() {
	cd *

	./configure --prefix=/usr \
	            --enable-shared \
	            --disable-cli
	make
	make DESTDIR=$PKG install
}
