# description : Music visualization engine and preset playlist library
# depends : cmake pkgconf glm libglvnd

name=projectm
version=4.1.8
release=2

source="https://github.com/projectM-visualizer/$name/releases/download/v$version/libprojectM-$version.tar.gz"
options="!checksum"

build() {
    cd "libprojectM-$version"
    cmake -S . -B build -G "Unix Makefiles" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DENABLE_SYSTEM_GLM=ON \
        -DENABLE_SYSTEM_PROJECTM_EVAL=OFF \
        -DENABLE_PLAYLIST=ON \
        -DENABLE_DEBUG_POSTFIX=OFF \
        -DBUILD_TESTING=OFF \
        -DBUILD_DOCS=OFF
    make -C build
    make -C build DESTDIR="$PKG" install
}
