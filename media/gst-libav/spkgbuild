# description	: GStreamer audio and video codecs using FFmpeg
# depends	: gst-plugins-base ffmpeg meson ninja pkgconf

name=gst-libav
version=1.28.8
release=2
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz"

build() {
    cd "$SRC/$name-$version"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dtests=disabled \
        -Ddoc=disabled \
        -Dpackage-name="GStreamer FFmpeg Plugins $version (Voncloft Linux)"
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
