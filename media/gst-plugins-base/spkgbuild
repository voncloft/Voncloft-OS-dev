# description : Well-groomed and well-maintained collection of GStreamer plug-ins and elements
# depends     : alsa-lib gstreamer libglvnd libtheora libvorbis libogg glib iso-codes meson ninja pkgconf

name=gst-plugins-base
version=1.28.9
release=3
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz"

build() {
    # 64-bit build.
    cd "$SRC/$name-$version"
    # GL headers are provided by libglvnd; do not fetch and install a second copy.
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dtests=disabled \
        -Dexamples=disabled \
        -Ddoc=disabled \
        -Dgl=enabled
    ninja -C build
    DESTDIR="$PKG" ninja -C build install

    # 32-bit build.
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dtests=disabled \
        -Dexamples=disabled \
        -Ddoc=disabled \
        -Dgl=enabled \
        -Dintrospection=disabled \
        -Dogg=disabled \
        -Dvorbis=disabled \
        -Dtheora=disabled
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
