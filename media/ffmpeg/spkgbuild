# note : Major FFmpeg upgrades require rebuilding linked applications such as VLC.
# note : libvdpau-va-gl is an optional VDPAU driver built after FFmpeg, not a build dependency.
# depends : openssl pkgconf alsa-lib fdk-aac freetype2 lame libaom libass libva libvdpau libvorbis libvpx nasm opus sdl2 x264 x265 yasm
# description   : FFmpeg is a solution to record, convert and stream audio and video

name=ffmpeg
version=9.0.2
release=4
source="https://ffmpeg.org/releases/ffmpeg-$version.tar.xz
https://www.linuxfromscratch.org/patches/blfs/svn/ffmpeg-$version-chromium_method-1.patch"

options="!checksum"

build() {
        cd $name-$version
patch -Np1 -i $SRC/ffmpeg-$version-chromium_method-1.patch
./configure --prefix=/usr        \
--enable-gpl         \
--enable-version3    \
--enable-nonfree     \
--disable-static     \
--enable-shared      \
--disable-debug      \
--enable-libaom      \
--enable-libass      \
--enable-libfdk-aac  \
--enable-libfreetype \
--enable-libmp3lame  \
--enable-libopus     \
--enable-libvorbis   \
--enable-libvpx      \
--enable-libx264     \
--enable-libx265     \
--enable-openssl     \
--ignore-tests=enhanced-flv-av1 \
--docdir=/usr/share/doc/ffmpeg-$version
make
make DESTDIR=$PKG install
}
