# description	: Rendering engine for graphite fonts
# depends	: cmake freetype2

name=graphite2
version=1.3.15
release=4
_name=graphite
source="https://github.com/silnrsi/${_name}/releases/download/$version/$name-$version.tgz"

build() {
	cd $name-$version

	mkdir build
	cd    build

	cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_INSTALL_PREFIX=/usr \
	      ..

	make
	make DESTDIR=$PKG install
}
