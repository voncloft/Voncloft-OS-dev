# description	: Set of plug-ins that aren't up to par compared to the rest
# depends	: flite meson ninja opencv pkgconf gst-plugins-base libdvdread libdvdnav libva soundtouch

name=gst-plugins-bad
version=1.28.8
release=4
source="https://gstreamer.freedesktop.org/src/${name}/$name-$version.tar.xz
        opencv5.patch
        flite-shared.patch"

build() {
    cd "$SRC/$name-$version"
    for compatibility_patch in opencv5.patch flite-shared.patch; do
        if patch -p1 --dry-run --batch < "$SRC/$compatibility_patch" >/dev/null 2>&1; then
            patch -p1 --batch < "$SRC/$compatibility_patch"
        elif ! patch -Rp1 --dry-run --batch < "$SRC/$compatibility_patch" >/dev/null 2>&1; then
            echo "$compatibility_patch needs updating for $name-$version" >&2
            return 1
        fi
    done
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dtests=disabled \
        -Dexamples=disabled \
        -Ddoc=disabled \
        -Dgpl=enabled \
        -Dopencv=enabled \
        -Dflite=enabled \
        -Dcpp_std=c++17
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
