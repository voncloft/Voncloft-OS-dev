# depends : bison cbindgen elfutils flex glslang libclc libdrm libglvnd libva libvdpau llvm make-ca meson ninja pkgconf python-mako python-packaging python-yaml rust rust-bindgen wayland-protocols xorg-libraries
# description : OpenGL compatible 3D graphics library

name=mesa
version=26.3.0
release=3
source="https://mesa.freedesktop.org/archive/$name-$version.tar.xz"
options="!checksum"

build() {
    cd "$name-$version"
    # Scratch runs under sudo's restricted PATH; Rust is installed under /opt/rustc.
    export PATH="/opt/rustc/bin:$PATH"
    # Native builds must not fall back to 32-bit pkg-config metadata.
    export PKG_CONFIG_LIBDIR="/usr/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig"
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH
    rustc --version
    bindgen --version

    meson setup build \
        --prefix=/usr \
        --libdir=lib64 \
        -Dplatforms=x11,wayland \
        -Dgallium-drivers=auto \
        -Dvulkan-drivers=auto \
        -Degl=enabled \
        -Dglvnd=enabled \
        -Dvalgrind=disabled \
        -Dvideo-codecs=all \
        -Dlibunwind=disabled
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
