# depends : bison cbindgen flex gslang libclc libdrm libglvnd libva libvdpau llvm make-ca meson ninja pkgconf python-mako python-packaging python-yaml rust rust-bindgen wayland-protocols xorg-libraries
# description : OpenGL compatible 3D graphics library

name=mesa
version=25.1.3
release=3
source="https://mesa.freedesktop.org/archive/$name-$version.tar.xz"
options="!checksum"

build() {
    cd "$name-$version"
    # Scratch runs under sudo's restricted PATH; Rust is installed under /opt/rustc.
    export PATH="/opt/rustc/bin:$PATH"
    rustc --version
    bindgen --version

    meson setup build \
        --prefix=/usr \
        --libdir=lib64 \
        -Dplatforms=x11,wayland \
        -Dgallium-drivers=auto \
        -Dvulkan-drivers=auto \
        -Degl=enabled \
        -Dglvnd=enabled \
        -Dvalgrind=disabled \
        -Dvideo-codecs=all \
        -Dlibunwind=disabled
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
