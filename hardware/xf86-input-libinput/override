# This is the Xorg driver, not the separate libinput library.
source="https://www.x.org/pub/individual/driver/"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re
versions=re.findall(r'xf86-input-libinput-([0-9]+(?:\.[0-9]+)+)\.tar\.(?:gz|xz|bz2)',pathlib.Path('index.html').read_text())
if not versions: raise SystemExit('No Xorg libinput driver release found')
print(max(versions,key=lambda v:tuple(map(int,v.split('.')))))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
