# description : This package provides the Mesa OpenGL Utility library
# depends     : mesa libglvnd meson ninja

name=glu
version=9.0.3
release=2
source=" https://archive.mesa3d.org/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    # 64-bit build.
    cd $name-$version
    mkdir build
    cd build
    meson setup .. \
        --prefix=/usr \
        -D gl_provider=gl \
        --buildtype=release
    ninja
    DESTDIR=$PKG ninja install
    rm -vf $PKG/usr/lib/libGLU.a

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dgl_provider=gl
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
