# description : Vulkan C and C++ API headers
# depends : cmake ninja

name=vulkan-headers
version=1.4.365
release=1
source="Vulkan-Headers-$version.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
    cd "Vulkan-Headers-$version"
    cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DVULKAN_HEADERS_ENABLE_TESTS=OFF \
        -DVULKAN_HEADERS_ENABLE_MODULE=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
