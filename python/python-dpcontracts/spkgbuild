# description : A simple implementation of contracts for Python
# depends : python

name=python-dpcontracts
version=0.6.0
release=7

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/d/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
