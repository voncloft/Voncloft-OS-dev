# description : open source version of the scalable, non-blocking web server and tools
# depends : python

name=python-tornado
version=6.6.0
release=3

_name=${name#python-}
source="https://github.com/tornadoweb/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
