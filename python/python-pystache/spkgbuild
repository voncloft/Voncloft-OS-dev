# description : The mustache template engine written in python
# depends : python

name=python-pystache
version=0.5.4
release=9

_name=${name#python-}
source="https://github.com/defunkt/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
