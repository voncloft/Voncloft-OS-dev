# description : Enumerates all IP addresses on all network adapters of the system
# depends : python

name=python-ifaddr
version=0.2.0
release=3

_name=${name#python-}
source="https://github.com/pydron/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
