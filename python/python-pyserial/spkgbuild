# description : Multiplatform Serial Port Module for Python
  # depends : python

name=python-pyserial
version=3.5
release=1

_name=${name#python-}
source="https://github.com/pyserial/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
