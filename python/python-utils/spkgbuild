# description : A module with some convenient utilities not included with the standard Python install
# depends : python-six

name=python-utils
version=3.5.2
release=1

source="https://files.pythonhosted.org/packages/source/p/${name}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "${name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
