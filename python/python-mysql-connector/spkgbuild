# description : A standardized database driver for Python platforms and development
# depends : python python-dnspython

name=python-mysql-connector
version=26.10.0
release=2

_name=mysql-connector-python
source="https://github.com/mysql/${_name}/archive/${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
