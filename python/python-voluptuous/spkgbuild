# description : A Python data validation library
# depends : python

name=python-voluptuous
version=0.16.0
release=1

_name=${name#python-}
source="https://github.com/alecthomas/${_name}/archive/refs/tags/${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
