# description : Validating URI References per RFC 3986
# depends : python

name=python-rfc3986
version=2.0.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/r/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
