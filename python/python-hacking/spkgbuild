# description : OpenStack Hacking Guideline Enforcement
# depends : python-flake8

name=python-hacking
version=8.1.0
release=1

_name=${name#python-}
source="https://github.com/openstack/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
