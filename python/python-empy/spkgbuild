# description : Powerful and robust templating system for Python
# depends : python

name=python-empy
version=4.2.1
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/e/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/empy*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
