# description : Python 3 compatible port of Python 2 random module
# depends : python

name=python-random2
version=1.0.1
release=6

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/r/${_name}/${_name}-${version}.zip"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
