# description : Python library for Hawk HTTP authorization
# depends : python-six

name=python-mohawk
version=1.1.0
release=3

_name=${name#python-}
source="https://github.com/kumar303/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
