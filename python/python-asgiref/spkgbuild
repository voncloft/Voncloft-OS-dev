# description : Reference ASGI adapters and channel layers
# depends : python

name=python-asgiref
version=3.6.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/a/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
