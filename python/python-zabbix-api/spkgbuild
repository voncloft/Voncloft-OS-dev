# description : Python Zabbix API
# depends : python

name=python-zabbix-api
version=0.5.6
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/z/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
