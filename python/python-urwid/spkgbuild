# description : Curses-based user interface library
# depends : python glibc

name=python-urwid
version=4.2.5
release=3

_name=${name#python-}
source="${name}-${version}.tar.gz::https://github.com/urwid/${_name}/archive/${version##*.g}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
