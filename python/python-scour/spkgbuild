# description : SVG optimizer
# depends : python python-pip python-setuptools python-six python-wheel

name=python-scour
version=0.38.2
release=3
options="!checksum"
_name=${name#python-}
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"

build() {
    cd "scour-${version}"
    pip3 wheel --no-build-isolation --no-deps --no-cache-dir -w dist .
    pip3 install --no-index --no-deps --ignore-installed --no-user \
        --prefix=/usr --root="$PKG" dist/*.whl
}
