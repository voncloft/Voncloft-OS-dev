# description : Python library for the creation of PostScript and PDF files
# depends : python texlive-core

name=python-pyx
version=0.18
release=4

_name=${name#python-}
source="https://github.com/pyx-project/${_name}/archive/refs/tags/${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
