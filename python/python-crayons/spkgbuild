# description : TextUI colors for Python
# depends : python-colorama

name=python-crayons
version=0.4.0
release=2

_name=${name#python-}
source="https://github.com/kennethreitz/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
