# description : Alternative python regular expression module.
# depends : python

name=python-regex
version=2023.5.5
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/r/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
