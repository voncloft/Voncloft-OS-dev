# description : Python bindings and binding generator for the Qt 6 framework
# depends : python qt6 cmake ninja clang llvm python-packaging python-setuptools

name=pyside6
version=6.12.0
release=2
source="https://download.qt.io/official_releases/QtForPython/pyside6/PySide6-$version-src/pyside-setup-everywhere-src-$version.tar.xz"

build() {
    cd "$SRC/pyside-setup-everywhere-src-$version"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DPYTHON_EXECUTABLE=/usr/bin/python3 \
        -DBUILD_TESTS=OFF
    cmake --build build
    DESTDIR="$PKG" cmake --install build
}
