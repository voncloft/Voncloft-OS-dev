# description : SPARQL Endpoint interface to Python
# depends : python

name=python-sparqlwrapper
version=2.0.0
release=2

_name=${name#python-}
source="https://github.com/RDFLib/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
