# description : Python parser for SubRip srt files
# depends : python-chardet

name=python-pysrt
version=1.1.2
release=2

_name=${name#python-}
source="https://github.com/byroot/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
