# description : Python library for printing trees on the console
# depends : python

name=python-tree-format
version=0.1.2
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/t/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
