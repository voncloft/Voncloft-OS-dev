# description : Pure python SSH tunnels
  # depends : python python-sshtunnel python-setuptools
  # depends : python python-paramiko

name=python-sshtunnel
version=0.5.1
release=5

_name=${name#python-}
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
