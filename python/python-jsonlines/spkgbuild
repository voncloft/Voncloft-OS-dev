# description : Library with helpers for the jsonlines file format
# depends : python-six

name=python-jsonlines
version=4.0.0
release=7

_name=${name#python-}
source="https://github.com/wbolster/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
