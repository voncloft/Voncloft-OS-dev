# description : Exclude specific directories from nosetests runs
# depends : python-nose

name=python-nose-exclude
version=0.5.0
release=6

_name=${name#python-}
source="https://github.com/kgrandis/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
