# description : A general purpose Python retyring library
  # depends : python-six

name=python-retrying
version=1.3.3
release=9

_name=${name#python-}
source="https://github.com/rholder/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
