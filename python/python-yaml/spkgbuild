# description : pyyaml Python build/runtime dependency
# depends : python python-setuptools cython3 yaml python-wheel

name=python-yaml
version=6.0.3
release=1
_name=pyyaml
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "${_name}-${version}"
    pip3 wheel --no-index --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
