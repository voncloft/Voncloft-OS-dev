# description : Python toolkit for stream-based generation of output for the web.
# depends : python

name=python-genshi
version=0.7.12
release=2

_name=${name#python-}
source="https://github.com/edgewall/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
