# description : Bindings to Coin3D
# depends : python soqt

name=python-pivy
version=0.6.11
release=3

_name=${name#python-}
source="https://github.com/coin3d/${_name}/archive/refs/tags/${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pivy*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
