# description : Builds Python bindings for Qt with SIP
# depends : python python-sip python-packaging python-setuptools python-wheel

name=python-pyqt-builder
version=1.20.3
release=1
_name=pyqt_builder
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"

build() {
    cd "$SRC"/pyqt_builder-*/
    pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir .
    pip3 install --no-index --find-links dist --no-deps --root="$PKG" --prefix=/usr PyQt-builder
}
