# description : A CSS4 selector implementation for Beautiful Soup
# depends : python

name=python-soupsieve
version=3.0.4
release=1

_name=${name#python-}
source="https://github.com/facelessuser/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
