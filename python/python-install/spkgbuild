# description : A simple, correct PEP427 wheel installer
# depends : python python-build python-flit-core python-installer

name=python-install
version=1.1.0
release=1

_name=installer
source="https://files.pythonhosted.org/packages/source/i/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "$SRC/${_name}-${version}"
    python -m build --wheel --no-isolation
    python -m installer --destdir="$PKG" dist/*.whl
}
