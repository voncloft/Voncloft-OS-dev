# description : A pure git implementation of a sliding window memory map manager
# depends : python

name=python-smmap
version=5.0.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
