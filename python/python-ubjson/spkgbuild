# description : Universal Binary JSON draft-12 serializer for Python
# depends : python

name=python-ubjson
version=0.16.1
release=3

_name=py-ubjson
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
