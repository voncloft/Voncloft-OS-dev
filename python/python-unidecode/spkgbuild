# description : ASCII transliterations of Unicode text
# depends : python

name=python-unidecode
version=1.4.0
release=1

_name=Unidecode
source="https://files.pythonhosted.org/packages/source/U/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/Unidecode*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
