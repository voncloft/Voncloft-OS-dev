# description : Sphinx plugin to automatically document click-based applications
# depends : python-pbr python-sphinx

name=python-sphinx-click
version=4.4.0
release=2

source="https://files.pythonhosted.org/packages/source/s/sphinx-click/sphinx-click-4.4.0.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
