# description : Cython memory pool for RAII-style memory management
# depends : cython3 python

name=python-cymem
version=2.0.16
release=1

_name=${name#python-}
source="https://github.com/explosion/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
