# description : A collection of utilities for working with PIL the Python Imaging Library
# depends : python

name=python-pilkit
version=2.0
release=7

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
