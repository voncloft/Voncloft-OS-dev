# description : Python template library
# depends : python python-setuptools python-wheel python-markupsafe

name=python-mako
version=1.3.10
release=2
source="https://files.pythonhosted.org/packages/source/m/mako/mako-$version.tar.gz"
options="!checksum"

build() {
    cd "mako-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/mako-"$version"-*.whl
}
