# description : Bidirectional mapping library for Python
# depends : python

name=python-bidict
version=0.24.1
release=2

_name=${name#python-}
source="https://github.com/jab/${_name}/archive/refs/tags/v${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
