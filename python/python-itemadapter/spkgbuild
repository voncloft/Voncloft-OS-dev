# description : Common interface for data container classes
# depends : python

name=python-itemadapter
version=0.14.0
release=1

_name=${name#python-}
source="https://github.com/scrapy/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
