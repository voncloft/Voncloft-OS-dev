# description : ODBC module for Python
# depends : python unixodbc

name=python-pyodbc
version=5.3.0
release=3

_name=${name#python-}
source="https://github.com/mkleehammer/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
