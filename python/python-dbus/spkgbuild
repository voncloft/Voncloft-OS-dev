# description : Python bindings for D-Bus
# depends : dbus glib python meson ninja pkgconf

name=python-dbus
version=1.5.1
release=1
_name=dbus_python
source="https://dbus.freedesktop.org/releases/dbus-python/${_name}-$version.tar.gz"

build() {
    cd "dbus_python-$version"
    export PYTHONNOUSERSITE=1
    meson setup build --prefix=/usr --libdir=lib \
        --buildtype=release --wrap-mode=nofallback \
        -Dpython=/usr/bin/python3 -Ddoc=disabled -Dtests=auto
    meson compile -C build
    meson test -C build --print-errorlogs
    DESTDIR="$PKG" meson install -C build --no-rebuild
}
