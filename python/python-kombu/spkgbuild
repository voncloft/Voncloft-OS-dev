# description : A messaging library for Python
# depends : python-amqp

name=python-kombu
version=5.7.0
release=3

_name=${name#python-}
source="https://github.com/celery/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
