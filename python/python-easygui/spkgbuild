# description : Python module for very simple, very easy GUI programming
# depends : python tk

name=python-easygui
version=0.98.2
release=6

_name=${name#python-}
source="https://github.com/robertlugg/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
