# description : http client for python 
# depends : hatch_vcs

name=urllib3
version=2.8.0
release=1

source="https://files.pythonhosted.org/packages/e3/05/b17359e1cefb4f909b5e40b1b90a496d987258916dbbf88e842c729f510e/urllib3-2.8.0.tar.gz"

build()
{
	cd *
	pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
	pip3 install --no-index --find-links dist --no-user urllib3 --root=$PKG
}
