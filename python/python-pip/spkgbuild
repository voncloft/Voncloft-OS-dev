# description : PyPA package installer
# depends : python python-flit

name=python-pip
version=26.2.2
release=2
options="!checksum"
_name=${name#python-}
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"

build() {
    cd "${_name}-${version}"
    pip3 wheel --no-build-isolation --no-deps --no-cache-dir -w dist .
    pip3 install --no-index --no-deps --ignore-installed --no-user \
        --prefix=/usr --root="$PKG" dist/*.whl
}
