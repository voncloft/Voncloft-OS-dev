# description : Helping users and developers to get information about the environment to report bugs
# depends : python-importlib-metadata python-psutil

name=python-helpdev
version=0.7.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/h/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
