# description : A pluggable API specification generator - currently supports the OpenAPI Specification
# depends : python

name=python-apispec
version=6.10.0
release=3

_name=${name#python-}
source="https://github.com/marshmallow-code/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
