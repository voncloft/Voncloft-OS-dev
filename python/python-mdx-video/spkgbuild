# description : Python-Markdown extension for easy video embedding
# depends : python

name=python-mdx-video
version=0.1.8
release=6

_name=mdx_video
source="https://files.pythonhosted.org/packages/source/m/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
