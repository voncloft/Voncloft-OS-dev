# description : A pure Python Levenshtein implementation thats not freaking GPLd
# depends : python

name=python-pylev
version=1.4.0
release=6

_name=${name#python-}
source="https://github.com/toastdriven/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
