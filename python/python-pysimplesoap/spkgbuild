# description : Python simple and lightweight SOAP Library
# depends : python

name=python-pysimplesoap
version=1.16
release=5

_name=${name#python-}
source="https://github.com/pysimplesoap/${_name}/archive/refs/tags/u$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
