# description : Python typography filter for quotes, dashes, and ellipses
# depends : python python-setuptools python-wheel

name=python-smartypants
version=2.0.2
release=8

_name=smartypants.py
source="${name}-${version}.tar.gz::https://github.com/leohemsted/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
    cd "smartypants.py-$version"
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Stage the wheel even if this version is already installed on the host.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/smartypants-"$version"-*.whl
}
