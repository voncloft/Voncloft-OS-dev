# description : Python client for Sentry
# depends : python

name=python-raven
version=6.10.0
release=7

_name=raven-python
source="https://github.com/getsentry/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
