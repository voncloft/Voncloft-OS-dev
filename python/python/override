# Read the upstream release archive instead of a version-specific directory.
source="https://www.python.org/ftp/python/"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re,subprocess
name='python'
url='https://www.python.org/ftp/python/'
versions=set(re.findall('href="([0-9]+\\.[0-9]+\\.[0-9]+)/',pathlib.Path('index.html').read_text()))
versions=sorted(versions,key=lambda v:tuple(map(int,re.findall(r'[0-9]+',v))),reverse=True)
for version in versions[:10]:
    child=subprocess.run(['curl','-fLsS','--retry','2','--max-time','25',url+version+'/'],capture_output=True,text=True,check=True).stdout
    if 'Python-'+version+'.tar.xz' in child:
        print(version)
        break
else:raise SystemExit('No final Python source release found')
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
