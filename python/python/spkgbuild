# description	: Next generation of the python high-level scripting language
# depends	: bzip2 expat gdbm libffi ncurses openssl readline sqlite xz zlib pkgconf

name=python
version=3.13.5
release=1
source="https://www.python.org/ftp/python/$version/Python-$version.tar.xz"

options="!checksum"

build() {
	cd Python-$version

  	CXX="/usr/bin/g++"              \
	./configure --prefix=/usr        \
            --enable-shared      \
            --with-system-expat  \
            --with-ensurepip=yes \
            --enable-optimizations
	make
	make DESTDIR=$PKG install

}
