# description	: Next generation of the python high-level scripting language
# depends	: bzip2 expat gdbm libffi ncurses openssl readline sqlite xz zlib pkgconf

name=python
version=3.15.2
release=1
backup="etc/pip.conf"
_name=Python
source="https://www.python.org/ftp/python/$version/${_name}-$version.tar.xz
    pip.conf"

options="!checksum"

# Bundle pip with Python through ensurepip; the interpreter package owns its files.

build() {
	cd Python-$version

  	CXX="/usr/bin/g++"              \
	./configure --prefix=/usr        \
            --enable-shared      \
            --with-system-expat  \
            --with-ensurepip=upgrade \
            --enable-optimizations
	make
	make DESTDIR=$PKG install
	install -Dm644 "$SRC/pip.conf" "$PKG/etc/pip.conf"

}
