# description : Next generation of the python high-level scripting language
# depends     : bzip2 expat gdbm libffi ncurses openssl readline sqlite xz zlib pkgconf

name=python
version=3.15.2
release=2
backup="etc/pip.conf"
_name=Python
source="https://www.python.org/ftp/python/$version/${_name}-$version.tar.xz
    pip.conf"

options="!checksum"

# Bundle pip with Python through ensurepip; the interpreter package owns its files.

build() {
    # 64-bit build.
    cd Python-$version

    mkdir -p build
    cd build

    CXX="/usr/bin/g++" \
        ../configure \
        --prefix=/usr \
        --enable-shared \
        --with-system-expat \
        --with-ensurepip=upgrade \
        --enable-optimizations
    make
    make DESTDIR=$PKG install
    install -Dm644 "$SRC/pip.conf" "$PKG/etc/pip.conf"

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --with-platlibdir=lib32 \
        --enable-shared \
        --with-system-expat \
        --without-ensurepip
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    install -Dm755 "DESTDIR/usr/bin/python${version%.*}" "$PKG/usr/bin/python${version%.*}-32"
    ln -sf "python${version%.*}-32" "$PKG/usr/bin/python3-32"
    # Keep the generated configuration for each ABI.
    mv "$PKG/usr/include/python${version%.*}/pyconfig.h" "$PKG/usr/include/python${version%.*}/pyconfig-64.h"
    install -m644 "DESTDIR/usr/include/python${version%.*}/pyconfig.h" "$PKG/usr/include/python${version%.*}/pyconfig-32.h"
    printf '%s\n' \
        '#if defined(__i386__)' \
        '#include "pyconfig-32.h"' \
        '#else' \
        '#include "pyconfig-64.h"' \
        '#endif' > "$PKG/usr/include/python${version%.*}/pyconfig.h"
    rm -rf DESTDIR
}
