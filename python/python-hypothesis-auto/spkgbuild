# description : Extends Hypothesis to add fully automatic testing of type annotated functions
# depends : python-pydantic python-hypothesis

name=python-hypothesis-auto
version=1.1.5
release=3

_name=hypothesis_auto
source="https://files.pythonhosted.org/packages/source/h/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/hypothesis_auto*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
