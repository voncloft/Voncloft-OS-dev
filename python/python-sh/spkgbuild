# description : Subprocess interface that allows you to call any program as if it were a function
# depends : python

name=python-sh
version=1.14.3
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
