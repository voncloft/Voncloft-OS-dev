# description : Wrappers to build() Python packages using PEP 517 hooks
  # depends : python-toml

name=python-pep517
version=0.13.1
release=3

source="https://files.pythonhosted.org/packages/44/d7/8f5d2be1a5fed3b0b5ccd3e800153c0f4dd84c2a688d25bce0bb0cb1f87f/pep517-0.13.1.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
