# description : Configuration manager in your pocket
# depends : python-yaml

name=python-kaptan
version=0.5.12
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/k/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
