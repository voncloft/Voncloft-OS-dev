# description : Simplified, fast RSS parsing library in Python
# depends : python

name=python-podcastparser
version=0.6.11
release=1

_name=${name#python-}
source="https://github.com/gpodder/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
