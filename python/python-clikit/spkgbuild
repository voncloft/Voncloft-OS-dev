# description : clikit allows you to create beautiful and testable command-line interfaces
# depends : python-crashtest python-pastel python-pylev

name=python-clikit
version=0.6.2
release=1

_name=${name#python-}
source="https://github.com/sdispater/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
