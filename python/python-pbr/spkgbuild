# description : Python Build Reasonableness
  # depends : python-setuptools

name=python-pbr
version=7.1.3
release=3

_name=${name#python-}
source="https://github.com/openstack-dev/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
