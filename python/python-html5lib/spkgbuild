# description : A Python HTML parser/tokenizer based on the WHATWG HTML5 spec
# depends : python python-setuptools python-six python-webencodings

name=python-html5lib
version=1.1
release=6
_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/h/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "html5lib-$version"

    # Drop obsolete setuptools compatibility code; pkg_resources was removed.
    sed -i '/^from pkg_resources import parse_version$/,/^classifiers = \[/{
        /^classifiers = \[/!d
    }' setup.py

    # pip is included by this repository's Python build via ensurepip.
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    python3 -m pip install --no-cache-dir --no-index --no-deps \
        --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
