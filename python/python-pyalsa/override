# Read upstream metadata; only report uversion. update-repo edits version=.
source=https://www.alsa-project.org/files/pub/pyalsa/
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - "${version:-}" "${release:-}" <<'PYVERSION'
import json,pathlib,re,sys
try:
    text=pathlib.Path('index.html').read_text(encoding='utf-8')
    from html.parser import HTMLParser
    from urllib.parse import urlsplit,unquote
    candidates=[]
    class Links(HTMLParser):
        def handle_starttag(self,tag,attrs):
            if tag=='a':
                candidates.extend(unquote(urlsplit(v).path).rstrip('/').rsplit('/',1)[-1] for k,v in attrs if k=='href' and v)
    Links().feed(text)
    values=[]
    for candidate in candidates:
        match=re.fullmatch('pyalsa-([0-9]+(?:\\.[0-9]+)*)\\.tar\\.bz2',candidate)
        if match:
            value=match[1]
            values.append(value)
    if not values: raise ValueError('No matching upstream release found')
    print(max(set(values),key=lambda value:tuple(int(n) if n.isdigit() else n for n in re.findall(r'[0-9]+|[a-z]+',value))))
except Exception as error:
    print('ERROR: Unable to read upstream version: '+str(error),file=sys.stderr)
    sys.exit(1)
PYVERSION
    ) || return 1
    [ -n "$detected" ] || return 1
    uversion=$detected
}
