# description : Python binding for the ALSA library
# depends : alsa-lib python

name=python-pyalsa
version=1.2.7
release=6

_name=${name#python-}
source="https://www.alsa-project.org/files/pub/${_name}/${_name}-${version}.tar.bz2"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
