# description : Testinfra test your infrastructures
# depends : python-pytest
# TODO: add salt to optdepends, after it has been ported to python3

name=python-pytest-testinfra
version=7.0.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
