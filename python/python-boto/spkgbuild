# description : A Python interface to Amazon Web Services AWS
# depends : python

name=python-boto
version=2.49.0
release=5

_name=${name#python-}
source="https://github.com/boto/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
