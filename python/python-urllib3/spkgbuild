# description : Python HTTP connection pooling
# depends : python hatchling hatch-vcs python-setuptools-scm

name=python-urllib3
version=2.8.0
release=1
_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/u/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "urllib3-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/urllib3-"$version"-*.whl
}
