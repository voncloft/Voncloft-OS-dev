# description : Python 3/2 compatibility library, allowing to add py2 compat to py3 code
# depends : python

name=python-nine
version=1.2.0
release=3

_name=${name#python-}
source="https://github.com/nandoflorestan/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
