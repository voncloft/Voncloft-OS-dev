# description : Module for OpenGL, OpenGL ES, Vulkan, window and input support
# depends : glfw python

name=python-glfw
version=2.11.0
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/g/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
