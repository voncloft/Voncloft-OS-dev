# description : Python Low-Overhead Profiler
# depends : python-six python-tornado

name=python-plop
version=0.4.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
