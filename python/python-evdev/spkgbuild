# description : Python bindings for the Linux input subsystem
# depends : python python-setuptools python-wheel
# note : Requires Python >= 3.11 and setuptools >= 77.

name=python-evdev
version=2.0.0
release=1
source="https://files.pythonhosted.org/packages/source/e/evdev/evdev-$version.tar.gz"

build() {
    cd "evdev-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/evdev-"$version"-*.whl
}
