# description : Python wrapper for SWI-Prolog
# depends : python swi-prolog

name=python-pyswip
version=0.3.3
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
