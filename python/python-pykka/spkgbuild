# description : Easy to use concurrency abstractions for Python using the actor model
# depends : python

name=python-pykka
version=3.1.1
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
