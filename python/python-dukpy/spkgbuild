# description : Python bindings for the duktape embeddable JavaScript engine
# depends : python

name=python-dukpy
version=0.3
release=6

_name=${name#python-}
source="https://github.com/kovidgoyal/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
