# description : A Python 3.x interface to libcurl
# depends : python curl

name=python-pycurl
version=7.49.0
release=4

_name=${name#python-}
source="https://github.com/pycurl/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
