# description : Library for FIDO 2.0, including communication with a device over USBA
# depends : python

name=python-fido2
version=2.2.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/f/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
