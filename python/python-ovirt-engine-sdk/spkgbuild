# description : Python access to the oVirt Engine API
# depends : python-pycurl python-six libxml2

name=python-ovirt-engine-sdk
version=4.4.15
release=1

_name=ovirt-engine-sdk-python
source="https://resources.ovirt.org/pub/ovirt-${version%.*}/src/python-ovirt-engine-sdk4/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
