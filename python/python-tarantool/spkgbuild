# description : Python client library for Tarantool 1.6 Database
  # depends : python python-msgpack python-yaml python-six

name=python-tarantool
version=1.3.0
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/t/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
