# description : Python bindings for Cairo
# depends : python cairo meson ninja pkgconf

name=pycairo
version=1.29.2
release=1
source="https://github.com/pygobject/${name}/releases/download/v$version/${name}-$version.tar.gz"
options="!checksum"

build() {
    cd "pycairo-$version"
    meson setup build --prefix=/usr --libdir=lib64 --buildtype=release
    meson compile -C build
    DESTDIR="$PKG" meson install -C build
}
