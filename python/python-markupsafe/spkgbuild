# description : markupsafe Python build/runtime dependency
# depends : python python-setuptools python-wheel

name=python-markupsafe
version=3.0.4
release=1
source="https://files.pythonhosted.org/packages/38/9b/e422a865e1d5d57d0e509b4e0bf1c1a70a7f6382c29a5aa428df994c8bc8/markupsafe-3.0.4.tar.gz"
options="!checksum"

build() {
    cd "markupsafe-3.0.4"
    pip3 wheel --no-index --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
