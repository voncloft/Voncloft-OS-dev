# description	: Python module implements html and xml markup
# depends : python python-setuptools python-wheel

name=python-markupsafe
_name=${name#python-}
version=3.0.4
release=1
source="https://files.pythonhosted.org/packages/source/m/${_name}/${_name}-${version}.tar.gz"
options="!checksum"
build() {
    cd "$_name-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
