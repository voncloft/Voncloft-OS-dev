# description : Python bindings to zopfli
# depends : python

name=python-zopfli
version=0.2.2
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/z/${_name}/${_name}-${version}.zip"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
