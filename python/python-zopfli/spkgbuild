# description : Python bindings to zopfli
# depends : python

name=python-zopfli
version=0.2.2
release=3

source="https://files.pythonhosted.org/packages/source/z/zopfli/zopfli-0.2.2.zip"
options="!checksum"

build() {
   cd ${name#python-}-$version
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
