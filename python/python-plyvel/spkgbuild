# description : A fast and feature-rich Python interface to LevelDB
# depends : leveldb python

name=python-plyvel
version=1.5.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
