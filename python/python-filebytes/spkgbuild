# description : Library to read and edit executable binary files
# depends : python

name=python-filebytes
version=0.10.2
release=3

_name=${name#python-}
source="https://github.com/sashs/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
