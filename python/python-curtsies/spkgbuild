# description : Curses-like terminal wrapper with a display based on compositing 2d arrays of text
# depends : python-blessings python-wcwidth

name=python-curtsies
version=0.4.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
