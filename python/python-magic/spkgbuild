# description : Python bindings to the magic library
# depends : python

name=python-magic
version=5.48
release=3

_name=file
source="https://astron.com/pub/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/file*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
