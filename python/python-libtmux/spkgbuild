# description : Python api for tmux
# depends : python tmux

name=python-libtmux
version=0.62.0
release=3

_name=${name#python-}
source="https://github.com/tmux-python/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
