# description : Python bindings for GObject Introspection
# depends : python glib pycairo meson ninja pkgconf

name=pygobject3
version=3.52.3
release=2
source="https://download.gnome.org/sources/pygobject/3.52/pygobject-$version.tar.gz"
options="!checksum"

build() {
    cd "pygobject-$version"
    meson setup build --prefix=/usr --libdir=lib64 --buildtype=release \
        -Dpython=python3 -Dpycairo=enabled -Dtests=false
    meson compile -C build
    DESTDIR="$PKG" meson install -C build
}
