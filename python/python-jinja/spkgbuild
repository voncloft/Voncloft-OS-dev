# description : jinja2
# depends : python python-flit python-markupsafe python-pip

name=python-jinja
version=3.1.6
release=2
options="!checksum"
source="python-jinja-3.1.6.tar.gz::https://files.pythonhosted.org/packages/df/bf/f7da0350254c0ed7c72f3e33cef02e048281fec7ecec5f032d4aac52226b/jinja2-3.1.6.tar.gz"

build() {
    cd "jinja2-3.1.6"
    pip3 wheel --no-build-isolation --no-deps --no-cache-dir -w dist .
    pip3 install --no-index --no-deps --ignore-installed --no-user \
        --prefix=/usr --root="$PKG" dist/*.whl
}
