# description : jinja2
# depends : python python-flit python-markupsafe python-pip

name=python-jinja
version=3.1.2
release=2
options="!checksum"
_name=jinja2
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/j/${_name}/${_name}-${version}.tar.gz"

build() {
    cd "${_name}-${version}"
    pip3 wheel --no-build-isolation --no-deps --no-cache-dir -w dist .
    pip3 install --no-index --no-deps --ignore-installed --no-user \
        --prefix=/usr --root="$PKG" dist/*.whl
}
