# description : A Python SVG graph plotting library
# depends : python-setuptools

name=python-pygal
version=3.1.3
release=8

_name=${name#python-}
source="https://github.com/Kozea/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
