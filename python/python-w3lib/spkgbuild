# description : Library of web-related functions
# depends : python-six

name=python-w3lib
version=2.5.0
release=3

_name=${name#python-}
source="https://github.com/scrapy/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
