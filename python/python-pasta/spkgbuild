# description : Library to refactor python code through AST manipulation
# depends : python

name=python-pasta
version=0.2.0
release=3

_name=${name#python-}
source="https://github.com/google/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
