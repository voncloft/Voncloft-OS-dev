# description : Implements a topological sort algorithm
# depends : python

name=python-toposort
version=1.10
release=1

_name=${name#python-}
source="https://gitlab.com/ericvsmith/${_name}/-/archive/${version}/${_name}-${version}.tar.bz2"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
