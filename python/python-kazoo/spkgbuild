# description : A high-level Python library that makes it easier to use Apache Zookeeper
# depends : python-six

name=python-kazoo
version=2.9.0
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/k/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
