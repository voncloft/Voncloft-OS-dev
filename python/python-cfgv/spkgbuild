name=python-cfgv
version=3.5.0
release=3

_name=${name#python-}
source="https://github.com/asottile/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
