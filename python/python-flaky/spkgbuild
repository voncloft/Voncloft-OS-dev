# description : Plugin for nose or py.test that automatically reruns flaky tests
# depends : python

name=python-flaky
version=3.8.1
release=3

_name=${name#python-}
source="https://github.com/box/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
