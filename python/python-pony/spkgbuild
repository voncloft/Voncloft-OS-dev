# description : Pony Object Relational Mapper
# depends : python

name=python-pony
version=0.7.20
release=2

_name=${name#python-}
source="https://github.com/ponyorm/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
