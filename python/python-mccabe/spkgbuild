# description : McCabe complexity checker for Python
# depends : python

name=python-mccabe
version=0.7.0
release=8

_name=${name#python-}
source="https://github.com/PyCQA/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
