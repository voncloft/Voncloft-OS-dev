# Read upstream metadata; only report uversion. update-repo edits version=.
source='https://sourceforge.net/projects/py-gnupg/rss?path=/'
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - "${version:-}" "${release:-}" <<'PYVERSION'
import json,pathlib,re,sys
try:
    text=pathlib.Path('index.html').read_text(encoding='utf-8')
    import xml.etree.ElementTree as ET
    from urllib.parse import urlsplit,unquote
    candidates=[unquote(urlsplit(item.findtext('link') or '').path).removesuffix('/download').rsplit('/',1)[-1] for item in ET.fromstring(text).iter('item')]
    values=[]
    for candidate in candidates:
        match=re.fullmatch('GnuPGInterface-([0-9]+(?:\\.[0-9]+)*)\\.tar\\.gz',candidate)
        if match:
            value=match[1]
            values.append(value)
    if not values: raise ValueError('No matching upstream release found')
    print(max(set(values),key=lambda value:tuple(int(n) if n.isdigit() else n for n in re.findall(r'[0-9]+|[a-z]+',value))))
except Exception as error:
    print('ERROR: Unable to read upstream version: '+str(error),file=sys.stderr)
    sys.exit(1)
PYVERSION
    ) || return 1
    [ -n "$detected" ] || return 1
    uversion=$detected
}
