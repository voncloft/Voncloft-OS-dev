# description : A Python interface to GNU Privacy Guard GnuPG.
# depends : gnupg python

name=python-gnupginterface
version=0.3.2
release=9

_name=GnuPGInterface
source="https://downloads.sourceforge.net/sourceforge/py-gnupg/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd ${name#python-}-$version
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
