# description : Fast, correct Python JSON library supporting dataclasses and datetimes
# depends : python

name=python-orjson
version=3.13.0
release=1

_name=${name#python-}
source="https://github.com/ijl/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
