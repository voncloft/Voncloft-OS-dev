# description : Real-time framework for Web, Mobile & Internet of Things
# depends : python-cffi python-twisted python-txaio python-wsaccel

name=python-autobahn
version=23.1.2
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/a/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
