# description : A pure-Python robots.txt parser with support for modern conventions
# depends : python-six

name=python-protego
version=0.7.0
release=3

_name=${name#python-}
source="https://github.com/scrapy/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
