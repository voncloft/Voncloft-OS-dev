# description : A library to handle automated deprecations
# depends : python

name=python-deprecation
version=2.1.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/d/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
