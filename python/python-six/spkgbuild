# description : Python 2 and 3 compatibility utilities
# depends : python python-setuptools

name=python-six
version=1.17.0
release=1
_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "six-$version"

    # pip is included by this repository's Python build via ensurepip.
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    python3 -m pip install --no-cache-dir --no-index --no-deps \
        --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
