# description : Convert restructured text to PDF via reportlab.
# depends : python

name=python-pdfrw
version=0.4
release=6

_name=${name#python-}
source="https://github.com/pmaupin/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
