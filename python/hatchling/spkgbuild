# description : Modern Python build backend
# depends : python python-packaging python-pathspec python-pluggy python-tomlkit python-trove-classifiers python-wheel

name=hatchling
version=1.33.0
release=1

source="https://files.pythonhosted.org/packages/source/h/${name}/${name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "hatchling-$version"
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Stage the wheel even if this version is already installed on the host.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/hatchling-"$version"-*.whl
}
