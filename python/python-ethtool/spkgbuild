# description : Python bindings for the ethtool kernel interface.
# depends : python libnl

name=python-ethtool
version=0.15
release=6

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/e/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
