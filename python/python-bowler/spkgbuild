# description : Safe code refactoring for modern Python.
# depends : python-attrs python-click python-fissix python-setuptools python-sh

name=python-bowler
version=0.9.0
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/b/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
