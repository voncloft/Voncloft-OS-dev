# description : A Module similar to bencode from the BitTorrent project
# depends : python

name=python-rencode
version=1.0.9
release=5

_name=${name#python-}
source="https://github.com/aresch/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
