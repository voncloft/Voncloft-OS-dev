# description : Julian dates, from proleptic Gregorian and Julian calendars
# depends : python

name=python-jdcal
version=1.4.1
release=6

_name=${name#python-}
source="https://github.com/phn/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
