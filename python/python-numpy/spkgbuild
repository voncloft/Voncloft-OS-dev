# description : Scientific array tools for Python
# depends : python cython3 python-meson python-metadata meson ninja pkgconf

name=python-numpy
version=1.24.3
release=2
_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/n/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "numpy-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist -C setup-args=-Dallow-noblas=true .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/numpy-"$version"-*.whl
}
