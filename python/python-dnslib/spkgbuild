# description : Simple library to encode/decode DNS wire-format packets
# depends : python

name=python-dnslib
version=0.9.26
release=2

_name=${name#python-}
source="https://github.com/paulc/${_name}/archive/${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
