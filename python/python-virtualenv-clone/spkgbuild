# description : A script for cloning a non-relocatable virtualenv.
# depends : python

name=python-virtualenv-clone
version=0.5.7
release=4

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/v/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
