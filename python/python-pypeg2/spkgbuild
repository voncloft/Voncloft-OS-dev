# description : An intrinsic PEG Parser-Interpreter for Python
# depends : python

name=python-pypeg2
version=2.15.2
release=7

_name=pyPEG2
source="http://fdik.org/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pyPEG2*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
