# description : Random collection of testing helpers
# depends : python

name=python-flufl.testing
version=0.8
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/f/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
