# description : Toolkit for plotting data on map projections
# depends : cython3 python-matplotlib geos shapelib python-numpy python-pyproj

name=python-basemap
version=2.0.0
release=2

_name=${name#python-}
source="https://github.com/matplotlib/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
