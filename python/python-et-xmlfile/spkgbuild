# description : A low memory library for creating large XML files.
# depends : python-lxml

name=python-et-xmlfile
version=2.0.0
release=9

_name=et_xmlfile
source="https://files.pythonhosted.org/packages/source/e/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/et_xmlfile*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
