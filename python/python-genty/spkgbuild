# description : Allows you to run a test with multiple data sets
# depends : python-six

name=python-genty
version=1.3.2
release=7

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/g/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
