# description : Activate virtual environment for current shell
# depends : python-attrs python-pexpect python-shellingham

name=python-dephell-shells
version=0.1.5
release=5

_name=dephell_shells
source="https://files.pythonhosted.org/packages/source/d/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
