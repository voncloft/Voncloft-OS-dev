# description : A thin, practical wrapper around terminal styling, screen positioning, and keyboard input
# depends : python-six python-wcwidth

name=python-blessed
version=1.52.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/b/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
