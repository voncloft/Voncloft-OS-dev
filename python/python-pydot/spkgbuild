# description : Python interface to Graphvizs Dot
# depends : python-pyparsing graphviz

name=python-pydot
version=4.0.1
release=5

_name=${name#python-}
source="https://github.com/erocarrera/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
