# description : Python implementation of SAML Version 2
# depends : python

name=python-pysaml2
version=7.1.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
