# description : Manage headless displays with Xvfb X virtual framebuffer
# depends : python xorg-server-xvfb

name=python-xvfbwrapper
version=0.2.9
release=6

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/x/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
