# description : Meson backend for Python wheels
# depends : python meson ninja python-packaging python-metadata

name=python-meson
version=0.22.1
release=2
source="https://files.pythonhosted.org/packages/b4/40/343ae23722d5d66a7b94b752d1b194202640995296379333b274b1860871/meson_python-0.22.1.tar.gz"
options="!checksum"

build() {
    cd "meson_python-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/meson_python-"$version"-*.whl
}
