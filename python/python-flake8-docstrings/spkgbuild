# description : Plugin to Flake8 to include checks provided by pydocstyle
# depends : flake8 python-pydocstyle python-setuptools

name=python-flake8-docstrings
version=1.7.0
release=3

source="python-flake8-docstrings::git+https://github.com/pycqa/flake8-docstrings#commit=75d591dced2e225c31a897527b6672217b4aae91"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
