# description : Capture the outcome of Python function calls
# depends : 

name=python-outcome
version=1.3.0.post0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/o/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/outcome*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
