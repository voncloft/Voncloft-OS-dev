# description : Base types for calmjs framework
# depends : python

name=python-calmjs.types
version=1.0.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.zip"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
