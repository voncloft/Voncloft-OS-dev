# description : Super-fast and clean conversions to numbers
# depends : python

name=python-fastnumbers
version=5.0.1
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/f/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
