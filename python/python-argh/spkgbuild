# description : An unobtrusive argparse wrapper with natural syntax
# depends : python

name=python-argh
version=0.31.3
release=8

_name=${name#python-}
source="https://github.com/neithere/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
