# description : Mozilla CA certificate bundle for Python
# depends : python python-setuptools python-wheel

name=certifi
version=2026.10.23
release=2
source="https://files.pythonhosted.org/packages/source/c/${name}/${name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "certifi-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/certifi-"$version"-*.whl
}
