# description : 2D and 3D vector, matrix, quaternion and geometry module
# depends : python

name=python-euclid3
version=0.01
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/e/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
