# description : A Python HTML/XML parser designed for quick turnaround projects like screen-scraping
# depends : python-soupsieve

name=python-beautifulsoup4
version=4.12.2
release=3

_name=${name#python-}
source="${name}-${version}.tar.gz::https://www.crummy.com/software/BeautifulSoup/bs4/download/${version%.*}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
