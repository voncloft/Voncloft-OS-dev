# description : unicodedata backport/updates to Python 3
# depends : python

name=python-unicodedata2
version=18.0.0
release=2

_name=${name#python-}
source="https://github.com/mikekap/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
