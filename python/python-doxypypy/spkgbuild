# description : doxypypy Python build/runtime dependency
# depends : python python-setuptools python-chardet python-wheel

name=python-doxypypy
version=0.8.8.7
release=1
source="https://files.pythonhosted.org/packages/f9/d2/8331005fb117a27c0122f714fe3f528d8c5752aa13d11d5cba12d754270b/doxypypy-0.8.8.7.tar.gz"
options="!checksum"

build() {
    cd "doxypypy-${version}"
    pip3 wheel --no-index --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
