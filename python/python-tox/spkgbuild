# description : Python virtualenv management and testing tool
  # depends : python-py python-virtualenv python-packaging python-pluggy python-toml

name=python-tox
version=4.5.1
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/t/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
