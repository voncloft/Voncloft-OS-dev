# description : ADAL for Python
# depends : python-cryptography python-dateutil python-pyjwt python-requests

name=python-adal
version=1.2.7
release=1

_name=azure-activedirectory-library-for-python
source="https://github.com/AzureAD/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
