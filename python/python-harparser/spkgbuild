# description : Python HAR Parser Utility
# depends : python

name=python-harparser
version=0.4
release=6

_name=${name#python-}
source="https://github.com/JustusW/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
