# description : A set of Python bindings for the low level FUSE API.
# depends : python fuse2

name=python-llfuse
version=1.4.2
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/l/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
