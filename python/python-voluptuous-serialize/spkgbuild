# description : Convert voluptuous schemas to JSON
# depends : python-voluptuous

name=python-voluptuous-serialize
version=2.7.0
release=3

_name=voluptuous_serialize
source="https://files.pythonhosted.org/packages/source/v/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/voluptuous_serialize*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
