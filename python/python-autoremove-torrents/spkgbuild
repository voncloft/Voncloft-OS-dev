# description	: python compatibility library to remove torrents from deluge
# depends	: python

name=python-autoremove-torrents
version=1.5.4
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/a/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/autoremove-torrents*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
