# description : A subprocess.run that works like tee
# depends : python

name=python-subprocess-tee
version=0.4.1
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
