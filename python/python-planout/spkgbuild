name=python-planout
version=0.6.0
release=6

_name=${name#python-}
source="https://github.com/facebook/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/PlanOut*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
