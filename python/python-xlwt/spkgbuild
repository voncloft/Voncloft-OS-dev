# description : Library to create spreadsheet files compatible with MS Excel 97/2000/XP/2003 XLS files
# depends : python

name=python-xlwt
version=1.3.0
release=5

_name=${name#python-}
source="https://github.com/python-excel/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
