# description : Manipulation and analysis of geometric objects in the Cartesian plane
# depends : geos python

name=python-shapely
version=2.0.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
