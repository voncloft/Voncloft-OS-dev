# description : Minimalistic evaluator of python expression using ast module
# depends : python

name=python-asteval
version=1.0.10
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/a/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/asteval*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
