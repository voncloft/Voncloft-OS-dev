# description : Low-level, pure Python DBus protocol wrapper
# depends : python

name=python-jeepney
version=0.8.0
release=4

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/j/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
