# description : LZ4 bindings for Python
# depends : python

name=python-lz4
version=4.3.2
release=6

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/l/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
