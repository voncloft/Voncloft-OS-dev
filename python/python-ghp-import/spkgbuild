name=python-ghp-import
version=1.1.0
release=1

_name=${name#python-}
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/g/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
