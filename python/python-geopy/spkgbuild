# description : Geocoding library for Python
# depends : python-geographiclib

name=python-geopy
version=2.5.0
release=1

_name=${name#python-}
source="https://github.com/geopy/${_name}/archive/refs/tags/r$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
