# description : Easy to use mocking, stubbing and spying framework.
# depends : python

name=python-chai
version=1.1.2
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
