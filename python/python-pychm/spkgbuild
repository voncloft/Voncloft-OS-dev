# description : Python bindings for chmlib
# depends : chmlib python

name=python-pychm
version=0.8.6
release=4

_name=${name#python-}
source="https://github.com/dottedmag/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
