# description : Port of node.jss EventEmitter to python
# depends : python-trio python-twisted

name=python-pyee
version=9.1.0
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
