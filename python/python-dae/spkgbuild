# description : Deepin desktop application engine
# depends : python-xlib python-pyqt6

name=python-dae
version=2014.2.1
release=2

_name=${name#python-}
source="https://github.com/linuxdeepin/${_name}/archive/refs/tags/${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/dae*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
