# description : A Python interface to the gpgme GnuPG library
# depends : python gpgme

name=python-pygpgme
version=0.6
release=9

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pygpgme*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
