# description : N-D labeled arrays and datasets in Python
# depends : python-numpy python-pandas

name=python-xarray
version=2026.09.0
release=1

_name=${name#python-}
source="https://github.com/pydata/${_name}/archive/refs/tags/v${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
