# description : Simple module to parse ISO 8601 dates
# depends : python

name=python-iso8601
version=1.1.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/i/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
