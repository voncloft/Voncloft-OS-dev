# description : Google Authentication Library
# depends : make-ca python-pyasn1-modules python-rsa python-setuptools

name=python-google-auth
version=3.0.0
release=1

_name=google-auth-library-python
source="https://github.com/GoogleCloudPlatform/${_name}/archive/refs/tags/v$version.tar.gz"
