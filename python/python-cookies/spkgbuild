# description : Friendlier RFC 6265-compliant cookie parser/renderer
# depends : python

name=python-cookies
version=2.2.1
release=5

_name=${name#python-}
source="https://github.com/sashahart/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
