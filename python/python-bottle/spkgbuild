# description : A fast and simple micro-framework for small web-applications
# depends : python

name=python-bottle
version=0.13.4
release=2

_name=${name#python-}
source="https://github.com/defnull/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
