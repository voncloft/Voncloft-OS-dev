# description : Sphinx extension to execute the code output it into a document.
# depends : python

name=python-sphinx-autorun
version=2.0.0
release=3

_name=sphinx_autorun
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
