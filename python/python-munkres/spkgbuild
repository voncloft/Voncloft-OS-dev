# description : Munkres algorithm for Python
# depends : python

name=python-munkres
version=3.0.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/m/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/munkres*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
