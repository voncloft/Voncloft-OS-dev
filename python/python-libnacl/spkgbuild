# description : A simple ctypes based python binding to libsodium
# depends : python libsodium

name=python-libnacl
version=1.8.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/l/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
