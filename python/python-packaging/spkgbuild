# description : packaging Python build/runtime dependency
# depends : python python-flit python-wheel

name=python-packaging
version=26.3
release=1
source="https://files.pythonhosted.org/packages/7d/fa/3944b40b07da9ce895c0e6303a5ab7d53da063554f534556b134a54d6093/packaging-26.3.tar.gz"
options="!checksum"

build() {
    cd "packaging-26.3"
    pip3 wheel --no-index --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
