# description : Moto is a library to mock out the boto library.
# depends : python-aws-xray-sdk python-boto python-boto3

name=python-moto
version=4.1.9
release=5

source="https://files.pythonhosted.org/packages/source/m/moto/moto-4.1.9.tar.gz"
