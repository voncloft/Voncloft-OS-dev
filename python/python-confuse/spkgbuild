# description : Painless YAML config files for Python
# depends : python-yaml

name=python-confuse
version=2.3.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
