# description : A functional standard library for Python
# depends : python

name=python-toolz
version=0.12.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/t/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
