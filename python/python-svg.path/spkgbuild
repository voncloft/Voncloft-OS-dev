name=python-svg.path
version=7.1
release=2

_name=${name#python-}
source="https://github.com/regebro/${_name}/archive/refs/tags/a$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
