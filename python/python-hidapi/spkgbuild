# description : A Cython interface to the hidapi from signal11/hidapi
# depends : python hidapi

name=python-hidapi
version=0.13.1
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/h/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
