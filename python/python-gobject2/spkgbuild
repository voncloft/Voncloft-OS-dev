# description	: Python 3 bindings to the GObject class from GLib
# depends	: glib

name=python-gobject2
version=2.28.7
release=2

_name=pygobject
source="https://download.gnome.org/sources/${_name}/${version%.*}/${_name}-$version.tar.xz"
options="!checksum"

build() {
   cd "$SRC"/pygobject*/
	./configure --prefix=/usr --disable-introspection
	make
	make DESTDIR=$PKG install
 }
