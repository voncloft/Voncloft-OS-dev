# description : A pure-Python, bring-your-own-I/O implementation of HTTP/1.1
# depends : python

name=python-h11
version=0.14.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/h/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
