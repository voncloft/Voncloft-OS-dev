# description : Python library for working with CouchDB
# depends : python-setuptools

name=python-couchdb
version=1.2
release=4

_name=couchdb-python
source="https://github.com/djc/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
