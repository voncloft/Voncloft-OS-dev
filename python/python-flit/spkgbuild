# note : Preserves the existing local python-flit package identity for the flit_core 3.x backend.
# description : flit_core Python build/runtime dependency
# depends : python

name=python-flit
version=3.12.0
release=4
_name=flit_core
source="https://files.pythonhosted.org/packages/source/f/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "${_name}-${version}"
    pip3 wheel --no-index --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
