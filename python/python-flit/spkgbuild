# note : Preserves the existing local python-flit package identity for the flit_core backend.
# description : flit_core Python build/runtime dependency
# depends : python

name=python-flit
version=4.2.0
release=1
_name=flit_core
source="https://files.pythonhosted.org/packages/source/f/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "${_name}-${version}"
    # Upstream's bootstrap path needs only the new Python interpreter.
    export PYTHONNOUSERSITE=1
    python3 -m flit_core.wheel
    python3 bootstrap_install.py --install-root="$PKG" dist/*.whl
}
