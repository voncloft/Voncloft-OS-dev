# description : Provides powerful extensions to the standard datetime module
# depends : python-six

name=python-dateutil
version=3.0.0
release=5

_name=python_dateutil
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/python_dateutil*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
