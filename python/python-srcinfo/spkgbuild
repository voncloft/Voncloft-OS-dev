# description : Simple .SRCINFO parsing library
# depends : python python-setuptools python-parse

name=python-srcinfo
version=0.1.1
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
