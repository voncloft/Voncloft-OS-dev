# description : Tzinfo object for the local timezone
# depends : python-pytz

name=python-tzlocal
version=5.0.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/t/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
