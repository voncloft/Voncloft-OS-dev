# description : Distributed task scheduler for Dask
# depends : 

name=python-distributed
version=2026.8.0
release=2

_name=${name#python-}
source="https://github.com/dask/${_name}/archive/${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
