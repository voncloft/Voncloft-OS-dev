# description : Awesome autocompletion for python
# depends : python python-parso

name=python-jedi
version=0.20.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/j/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
