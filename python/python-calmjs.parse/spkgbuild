# description : Various parsers for ECMA standards
# depends : python-ply

name=python-calmjs.parse
version=1.3.0
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.zip"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
