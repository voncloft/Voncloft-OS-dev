# description : Python dependency management and packaging made easy
# depends : ${_deps[@]/#/python-}

name=python-poetry
version=2.5.1
release=1

_name=${name#python-}
source="https://github.com/sdispater/${_name}/archive/refs/tags/a$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
