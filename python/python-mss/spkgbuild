# description : Ultra fast cross-platform multiple screenshots module
# depends : python

name=python-mss
version=7.0.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/m/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
