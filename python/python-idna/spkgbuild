# description : Internationalized domain name support
# depends : python python-flit

name=python-idna
version=3.10
release=1
_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/i/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "idna-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/idna-"$version"-*.whl
}
