# description : Simple VTXXX-compatible terminal emulator
# depends : python-wcwidth

name=python-pyte
version=0.8.2
release=6

_name=${name#python-}
source="https://github.com/selectel/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
