# description : Flask extension providing simple email sending capabilities
# depends : python python-flask python-blinker

name=python-flask-mail
version=0.10.0
release=6

_name=${name#python-}
source="https://github.com/mattupstate/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
