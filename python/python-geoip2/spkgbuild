# description : MaxMind GeoIP2 API
# depends : python-aiohttp python-maxminddb python-requests

name=python-geoip2
version=5.3.0
release=3

_name=GeoIP2-python
source="https://github.com/maxmind/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
