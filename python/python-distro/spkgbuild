# description : detect distro of OS via python 
# depends : python python-sphinx

name=python-distro
version=1.9.0
release=1

_name=${name#python-}
source="https://github.com/python-distro/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
