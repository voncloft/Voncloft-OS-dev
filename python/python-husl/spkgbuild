# description : A Python implementation of HUSL revision 3
# depends : python

name=python-husl
version=4.0.3
release=7

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/h/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
