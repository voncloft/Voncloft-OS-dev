# description : Calendar version support for setuptools
# depends : python python-setuptools python-wheel

name=python-calver
version=2025.10.20
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "calver-$version"
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Stage the wheel even if this version is already installed on the host.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/calver-"$version"-*.whl
}
