# description : An immutable URL class for easy URL-build()ing and manipulation
# depends : python-six

name=python-purl
version=1.6
release=6

_name=${name#python-}
source="https://github.com/codeinthehole/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
