# description : Python API for YouTube
# depends : python youtube-dl

name=python-pafy
version=0.5.5
release=3

_name=${name#python-}
source="https://github.com/mps-youtube/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
