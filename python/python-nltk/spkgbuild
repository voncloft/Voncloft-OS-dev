# description : Natural language processing in Python
# depends : python-yaml

name=python-nltk
version=3.10.1
release=3

_name=${name#python-}
source="https://github.com/nltk/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd ${name#python-}-$version
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
