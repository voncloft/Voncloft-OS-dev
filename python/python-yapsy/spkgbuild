# description : A simple plugin system for Python applications
# depends : python

name=python-yapsy
version=1.12.2
release=5

_name=Yapsy
source="https://files.pythonhosted.org/packages/source/Y/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
