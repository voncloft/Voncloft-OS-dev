# description : Python client for copr service
# depends : python-marshmallow python-requests python-requests-toolbelt python-six python-munch

name=python-copr
version=1.123
release=1

_name=copr
source="https://pagure.io/${_name}/${_name}/archive/${name}-${version}-1/${_name}-${name}-${version}-1.tar.gz"
options="!checksum"

build() {
   cd "$SRC/${_name}-${name}-${version}-1/python"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
