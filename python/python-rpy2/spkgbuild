# description : A very simple, yet robust, Python interface to the R Programming Language.
# depends : python-cffi python-numpy python-tzlocal r

name=python-rpy2
version=3.5.11
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/r/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
