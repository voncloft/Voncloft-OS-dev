# description : A web micro-framework built on werkzeug and twisted.web
# depends : python python-attrs python-hyperlink python-incremental python-six

name=python-klein
version=24.8.0
release=3

_name=${name#python-}
source="https://github.com/twisted/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
