# description : Python module to interface with iwlib
# depends : python-cffi wireless_tools

name=python-iwlib
version=1.7.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/i/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
