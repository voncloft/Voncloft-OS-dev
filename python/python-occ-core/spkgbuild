# description : Python package for 3D CAD/BIM/PLM/CAM
# depends : python opencascade libxmu libxi

name=python-occ-core
version=8.0.1.2
release=2

_name=pythonocc-core
source="https://github.com/tpaviot/${_name}/archive/refs/tags/${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pythonocc-core*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
