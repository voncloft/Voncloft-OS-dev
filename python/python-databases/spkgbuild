# description : Async database support for Python
# depends : python

name=python-databases
version=0.9.0
release=1

_name=${name#python-}
source="https://github.com/encode/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
