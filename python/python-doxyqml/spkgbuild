# description : doxyqml Python build/runtime dependency
# depends : python python-setuptools python-wheel

name=python-doxyqml
version=0.6.0
release=1
source="https://files.pythonhosted.org/packages/bf/5c/a8a1552bdd6b9e0f7371497b7ed3b06b73b2e1a207d9ee57b8ae2d45aa36/doxyqml-0.6.0.tar.gz"
options="!checksum"

build() {
    cd "doxyqml-${version}"
    pip3 wheel --no-index --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
