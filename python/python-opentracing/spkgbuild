# description : OpenTracing API for Python
# depends : python

name=python-opentracing
version=2.4.0
release=1

_name=opentracing-python
source="https://github.com/opentracing/${_name}/archive/refs/tags/r$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
