# description : MessagePack serializer implementation for Python
# depends : python

name=python-msgpack
version=1.2.4
release=2

_name=msgpack-python
source="https://github.com/msgpack/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
