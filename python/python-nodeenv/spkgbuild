# description : Node.js virtual environment build()er
# depends : python make

name=python-nodeenv
version=1.11.0
release=3

_name=${name#python-}
source="https://github.com/ekalinin/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
