# description : Run-time type checker for Python
# depends : python

name=python-typeguard
version=4.6.0
release=3

_name=${name#python-}
source="https://github.com/agronholm/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
