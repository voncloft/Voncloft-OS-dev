# description : Rich assertions library for Python
# depends : python-six

name=python-pyassert
version=0.4.2
release=6

_name=${name#python-}
source="https://github.com/pyclectic/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
