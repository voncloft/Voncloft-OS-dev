# description : LHA archive support for Python
# depends : python

name=python-lhafile
version=0.3.1
release=5

source="https://github.com/FrodeSolheim/${name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
