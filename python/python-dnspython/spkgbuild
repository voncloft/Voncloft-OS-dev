# description : A DNS toolkit for Python
# depends : python

name=python-dnspython
version=2.3.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/d/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
