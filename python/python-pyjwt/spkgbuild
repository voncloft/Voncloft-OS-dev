# description : JSON Web Token implementation in Python
# depends : python-setuptools

name=python-pyjwt
version=2.15.1
release=6

_name=${name#python-}
source="https://github.com/jpadilla/${_name}/archive/refs/tags/a$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
