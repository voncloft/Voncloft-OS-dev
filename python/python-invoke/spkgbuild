# description : Pythonic task execution
# depends : python

name=python-invoke
version=2.1.1
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/i/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
