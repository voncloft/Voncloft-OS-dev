# description : File identification library for Python
# depends : python

name=python-identify
version=2.6.20
release=1

_name=${name#python-}
source="https://github.com/chriskuehl/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
