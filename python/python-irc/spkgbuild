# description : IRC Internet Relay Chat protocol client library for Python
# depends : python-six python-pytz python-more-itertools python-jaraco

name=python-irc
version=20.1.0
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/i/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
