# description : Python wrapper for the BlueZ Bluetooth stack
  # depends : python bluez-libs

name=python-pybluez
version=0.23.r58.g4d46ce1
release=6

_name=pybluez
source="${name}-${version}.tar.gz::https://github.com/pybluez/${_name}/archive/${version##*.g}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
