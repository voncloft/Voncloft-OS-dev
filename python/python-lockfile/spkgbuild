# description : Platform-independent file locking module
  # depends : python

name=python-lockfile
version=0.12.2
release=8

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/l/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
