# description : Ultra fast JSON encoder and decoder for Python
# depends : python

name=python-ujson
version=6.0.0
release=1

_name=ultrajson
source="https://github.com/ultrajson/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
