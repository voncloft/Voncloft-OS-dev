# description : Versatile TCP/UDP asynchronous tunnel proxy implemented in Python 3 asyncio
# depends : python

name=python-pproxy
version=2.7.8
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pproxy*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
