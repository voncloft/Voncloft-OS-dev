# description : Low-level AMQP client for Python fork of amqplib
# depends : python-vine

name=python-amqp
version=5.4.1
release=1

_name=py-amqp
source="https://github.com/celery/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
