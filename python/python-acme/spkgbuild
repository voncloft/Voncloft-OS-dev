# description : ACME protocol implementation in Python
# depends : python-setuptools python-pyopenssl python-pyrfc3339 python-pytz python-requests python-six python-josepy python-requests-toolbelt

name=python-acme
version=2.6.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/a/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
