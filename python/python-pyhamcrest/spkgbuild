# description : Hamcrest framework for matcher objects
  # depends : python-six

name=python-pyhamcrest
version=2.1.0
release=7

_name=PyHamcrest
source="https://github.com/hamcrest/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
