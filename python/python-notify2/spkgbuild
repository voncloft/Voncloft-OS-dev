# description : Python interface to DBus notifications
# depends : python-dbus

name=python-notify2
version=0.3.1
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/n/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
