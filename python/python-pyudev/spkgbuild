# description : Python bindings to libudev
# depends : python-six systemd

name=python-pyudev
version=0.24.5
release=5

_name=${name#python-}
source="https://github.com/pyudev/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
