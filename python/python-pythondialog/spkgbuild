# description : Python package for interfacing with dialog
# depends : python dialog

name=python-pythondialog
version=3.5.3
release=2

_name=python3-pythondialog
source="https://downloads.sourceforge.net/project/pythondialog/pythondialog/${version}/${_name}-${version}.tar.bz2"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
