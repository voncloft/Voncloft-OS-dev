# description : A tool for build()ing interactive command line apps
# depends : python-attrs python-colorama python-pyperclip python-wcwidth

name=python-cmd2
version=2.4.3
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
