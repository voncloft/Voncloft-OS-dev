# description : Python module for creating GDSII stream files, usually CAD layouts
# depends : python-numpy

name=python-gdspy
version=1.6.13
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/g/${_name}/${_name}-${version}.zip"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
