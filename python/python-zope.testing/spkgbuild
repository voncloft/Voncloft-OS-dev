# description : Zope testing frameworks
  # depends : python

name=python-zope.testing
version=6.2
release=1

_name=${name#python-}
source="https://github.com/zopefoundation/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
