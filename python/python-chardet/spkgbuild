# description : Python module for character encoding auto-detection
# depends : python hatchling hatch-vcs

name=python-chardet
version=7.7.0
release=1

_name=chardet
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "chardet-$version"
    export PYTHONNOUSERSITE=1

    # pip is supplied by this repository's Python package through ensurepip.
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Stage the built wheel even when the same version is installed on the host.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/chardet-"$version"-*.whl
}
