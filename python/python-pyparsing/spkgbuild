# description : General parsing module for Python
# depends : python python-flit python-wheel

name=python-pyparsing
version=3.2.3
release=4

source="https://files.pythonhosted.org/packages/bb/22/f1129e69d94ffff626bdb5c835506b3a5b4f3d070f17ea295e12c2c6f60f/pyparsing-3.2.3.tar.gz"
options="!checksum"

build() {
    cd "pyparsing-$version"
    pip3 wheel --no-index --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --no-user --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
