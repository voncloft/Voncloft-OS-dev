# description : asynchronous networking framework in Python
# depends : python

name=python-twisted
version=26.10.0
release=1

_name=${name#python-}
source="https://github.com/twisted/${_name}/archive/refs/tags/r$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
