# description : Use the fastest JSON functions available at import time
# depends : python

name=python-mujson
version=1.4
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/m/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
