# description : A library for working with color names and color value formats defined by the HTML and CSS specifications for use in documents on the Web
# depends : python

name=python-webcolors
version=1.13
release=4

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/w/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
