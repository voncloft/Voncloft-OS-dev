# description : EditorConfig File Locator and Interpreter for Python
# depends : python

name=python-editorconfig
version=0.12.3
release=1

_name=EditorConfig
source="https://files.pythonhosted.org/packages/source/E/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
