# description : Waitress WSGI server
# depends : python

name=python-waitress
version=3.0.2
release=5

_name=${name#python-}
source="https://github.com/Pylons/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
