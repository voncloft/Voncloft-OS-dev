# description : pytest plugin to run Xvfb for tests
# depends : python-pytest python-pyvirtualdisplay xorg-server-xvfb

name=python-pytest-xvfb
version=2.0.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
