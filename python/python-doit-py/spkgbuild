# description : doit tasks for python stuff
# depends : python-configclass python-doit

name=python-doit-py
version=0.5.0
release=3

_name=${name#python-}
source="https://github.com/pydoit/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
