# description : Pure Python library for PNG image encoding/decoding
# depends : python

name=python-pypng
version=0.0.21
release=3

_name=${name#python-}
source="https://github.com/drj11/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
