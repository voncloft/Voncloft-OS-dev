# description : Python bindings for the inet_diag kernel interface
# depends : python

name=python-inet_diag
version=0.2.1
release=6

source="https://git.kernel.org/pub/scm/libs/python/${name}/python-inet_diag.git/snapshot/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/python-inet_diag*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
