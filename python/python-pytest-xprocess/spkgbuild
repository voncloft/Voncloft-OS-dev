# description : Pytest plugin to manage external processes across test runs.
# depends : python-psutil python-pytest python-setuptools

name=python-pytest-xprocess
version=0.22.2
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
