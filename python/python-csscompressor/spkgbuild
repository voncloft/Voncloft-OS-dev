# description : Port of YUI CSS Compressor to Python
# depends : python

name=python-csscompressor
version=0.9.5
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/c/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
