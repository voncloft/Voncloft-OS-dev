# description : A jquery-like library for python.
# depends : python-lxml python-cssselect

name=python-pyquery
version=2.1.0
release=1

_name=${name#python-}
source="https://github.com/gawel/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
