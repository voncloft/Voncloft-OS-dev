# description : WSDL parsing services package for Web Services for Python
  # depends : python-six

name=python-wstools
version=0.4.11
release=3

_name=${name#python-}
source="https://github.com/pycontribs/${_name}/archive/refs/tags/r$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
