# description : Extends rich library functionality with a set of changes that were not accepted
# depends : python-rich

name=python-enrich
version=1.2.7
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/e/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
