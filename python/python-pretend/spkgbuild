# description : A library for stubbing in Python
  # depends : python

name=python-pretend
version=1.0.9
release=6

_name=${name#python-}
source="https://github.com/alex/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
