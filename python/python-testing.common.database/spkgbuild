# description : Utilities for testing.* packages
# depends : python

name=python-testing.common.database
version=2.0.3
release=5

_name=${name#python-}
source="https://github.com/tk0miya/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
