# description : Asynchronous Python HTTP Requests for Humans using twisted
# depends : python-requests python-twisted

name=python-txrequests
version=0.9.6
release=6

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/t/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
