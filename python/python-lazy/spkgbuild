# description : Lazy attributes for Python objects
# depends : python

name=python-lazy
version=2.0
release=5

_name=${name#python-}
source="https://github.com/stefanholek/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd ${name#python-}-$version
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
