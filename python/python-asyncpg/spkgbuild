# description : A fast PostgreSQL Database Client Library for Python/asyncio
# depends : python

name=python-asyncpg
version=0.32.0
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/a/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
