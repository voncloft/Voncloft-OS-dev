# description : Python interfaces to PROJ.4 library
# depends : proj python

name=python-pyproj
version=3.8.0
release=3

_name=${name#python-}
source="https://github.com/pyproj4/${_name}/archive/refs/tags/r$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
