# description : Chromium HSTS Preload list as a Python package
# depends : python

name=python-hstspreload
version=2025.1.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/h/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
