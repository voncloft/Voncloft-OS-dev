# description : a Python implementation of RFC6570
  # depends : python

name=python-uritemplate
version=4.2.0
release=3

_name=${name#python-}
source="https://github.com/sigmavirus24/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
