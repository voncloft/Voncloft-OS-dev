# description : Refactoring library

name=python-rope
version=1.15.0
release=3

_name=${name#python-}
source="https://github.com/python-rope/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
