# description : Low-level library for implementing MAC Access Authentication
# depends : python-requests python-webob

name=python-hawkauthlib
version=2.0.0
release=7

_name=${name#python-}
source="https://github.com/mozilla-services/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
