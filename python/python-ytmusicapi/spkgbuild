# description : python-ytmusicapi - KDE dependency
# depends : python python-requests python-setuptools python-setuptools-scm python-wheel

name=python-ytmusicapi
version=1.12.3
release=1

_name=${name#python-}
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/y/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "ytmusicapi-$version"
    pip3 wheel --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
