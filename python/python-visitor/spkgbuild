# description : A tiny pythonic visitor implementation
# depends : python

name=python-visitor
version=0.1.3
release=5

_name=${name#python-}
source="https://github.com/mbr/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
