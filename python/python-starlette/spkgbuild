# description : The little ASGI framework that shines
# depends : python

name=python-starlette
version=1.10.0
release=3

_name=${name#python-}
source="https://github.com/encode/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
