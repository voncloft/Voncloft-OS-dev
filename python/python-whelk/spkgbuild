# description : Easy access to shell commands from python
# depends : python

name=python-whelk
version=2.5.1
release=2

_name=${name#python-}
source="https://github.com/seveas/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
