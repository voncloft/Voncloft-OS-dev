# description : A simple implementation of GNU tail and head
# depends : python

name=python-tailer
version=0.4.1
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/t/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
