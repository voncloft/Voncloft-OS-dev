# description : Snowball stemming library collection for Python
# depends : python

name=python-snowballstemmer
_upstream_name=python-snowball
version=3.1.1
release=1

_name=snowballstemmer
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/snowballstemmer*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
