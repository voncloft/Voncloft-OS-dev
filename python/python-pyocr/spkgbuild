# description : Python wrapper for Tesseract and Cuneiform
# depends : python-pillow python-six

name=python-pyocr
version=0.8.3
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
