# description : Read/rewrite/write Python ASTs
# depends : python

name=python-astor
version=0.8.1
release=3

_name=${name#python-}
source="https://github.com/berkerpeksag/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
