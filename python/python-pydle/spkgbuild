# description : A compact, flexible and standards-abiding IRC library
# depends : python

name=python-pydle
version=1.1.0
release=2

_name=${name#python-}
source="https://github.com/Shizmob/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd ${name#python-}-$version
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
