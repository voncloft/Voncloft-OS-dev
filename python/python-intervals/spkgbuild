# description : Python tools for handling intervals ranges of comparable objects.
# depends : python python-infinity

name=python-intervals
version=0.9.2
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/i/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
