# description : AWS X-Ray SDK for Python
# depends : python python-botocore python-future python-jsonpickle python-wrapt

name=python-aws-xray-sdk
version=2.15.0
release=3

_name=aws-xray-sdk-python
source="https://github.com/aws/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
