# description : Hatch version control plugin
# depends : python hatchling python-setuptools-scm

name=hatch-vcs
version=0.5.0
release=1
source="https://files.pythonhosted.org/packages/source/h/hatch_vcs/hatch_vcs-$version.tar.gz"
options="!checksum"

build() {
    cd "hatch_vcs-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/hatch_vcs-"$version"-*.whl
}
