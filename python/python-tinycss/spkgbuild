# description : A complete yet simple CSS parser for Python
# depends : python

name=python-tinycss
version=0.4
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/t/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
