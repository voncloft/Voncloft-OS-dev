# description : Store and access your passwords safely
# depends : python-entrypoints python-secretstorage

name=python-keyring
version=25.7.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/k/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
