# description : A simple wrapper around optparse for powerful command line utilities
# depends : python

name=python-click
version=8.5.0
release=3

_name=${name#python-}
source="https://github.com/pallets/${_name}/archive/refs/tags/r$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
