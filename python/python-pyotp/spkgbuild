# description : Python library for generating and verifying one-time passwords
# depends : python

name=python-pyotp
version=2.10.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pyotp*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
