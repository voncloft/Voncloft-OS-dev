# description : A Python interface to sendfile2 syscall
# depends : python

name=python-pysendfile
version=2.0.1
release=6

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
