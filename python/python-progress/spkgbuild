# description : Easy to use progress bars for Python
    # depends : python

name=python-progress
version=1.6
release=5

_name=${name#python-}
source="https://github.com/verigak/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
