# description : XML bomb protection for Python stdlib modules
# depends : python

name=python-defusedxml
version=0.7.1
release=6

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/d/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
