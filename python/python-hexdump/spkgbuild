# description : Library and tool to work with hex and binary data
# depends : python

name=python-hexdump
version=3.3
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/h/${_name}/${_name}-${version}.zip"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
