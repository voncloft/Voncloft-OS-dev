# description : Python Authentication-Results headers generation and parsing
# depends : python

name=python-authres
version=1.2.0
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/a/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
