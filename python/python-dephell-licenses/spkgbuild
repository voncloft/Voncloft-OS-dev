# description : Manage OSS licenses: retrieve information, generate
# depends : python-attrs python-requests

name=python-dephell-licenses
version=0.1.7
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/d/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
