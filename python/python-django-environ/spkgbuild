# description : Utilize 12factor inspired environment variables to configure your Django application
# depends : python

name=python-django-environ
version=0.10.0
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/d/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
