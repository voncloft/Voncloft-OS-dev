# description : Python3 binding for the libxml2 and libxslt libraries
# depends : python libxslt

name=python-lxml
version=7.0.0
release=1

_name=${name#python-}
source="https://github.com/lxml/${_name}/releases/download/${_name}-$version/${_name}-$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
