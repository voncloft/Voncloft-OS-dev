# description : A refreshed Python toolbox for build()ing complex digital hardware
# depends : python

name=python-nmigen
version=0.5.10
release=3

_name=${name#python-}
source="https://github.com/nmigen/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
