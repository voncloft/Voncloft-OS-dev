# description : Bindings for the NaCL implementation of Salsa20 and XSalsa20 by D. J. Bernstein
# depends : python

name=python-salsa20
version=0.3.0
release=8

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
