# description : A pure-Python git object database
# depends : git python-smmap

name=python-gitdb
version=4.0.10
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/g/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
