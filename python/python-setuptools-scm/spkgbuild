# description : setuptools-scm Python build/runtime dependency
# depends : python python-packaging python-vcs-versioning python-setuptools python-wheel

name=python-setuptools-scm
version=10.3.4
release=1
source="https://files.pythonhosted.org/packages/85/d8/fc143f88819ccf10ba2388ba86732ee2de193e578234e25a783f6cc14bf7/setuptools_scm-10.3.4.tar.gz"
options="!checksum"

build() {
    cd "setuptools_scm-10.3.4"
    pip3 wheel --no-index --no-deps --no-build-isolation --no-cache-dir --wheel-dir dist .
    pip3 install --no-deps --no-index --ignore-installed --root="$PKG" --prefix=/usr dist/*.whl
}
