# description : Compatibility package for the Cairo bindings supplied by pycairo
# depends : pycairo

name=python-cairo
version=1.23.0
release=1
options="!checksum"

build() {
    # This name must not install a second copy of Cairo's Python files.
    install -d "$PKG/usr/share/doc/python-cairo"
    printf '%s\n' 'Cairo Python bindings are supplied by the pycairo package.' \
        > "$PKG/usr/share/doc/python-cairo/README"
}
