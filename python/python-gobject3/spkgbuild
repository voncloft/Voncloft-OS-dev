# description	: python bindings for PyGObject3
# depends	: pycairo glib

name=python-gobject3
version=3.58.1
release=1

_name=pygobject
source="https://download.gnome.org/sources/${_name}/${version%.*}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd pygobject-$version
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
