# description : Fake implementation of redis API redis-py for testing purposes
# depends : python-redis python-six python-sortedcontainers

name=python-fakeredis
version=2.12.1
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/f/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
