# description : A crypto and SSL toolkit for Python
  # depends : python openssl

name=python-m2crypto
version=0.51.0
release=1

_name=${name#python-}
source="${name}-${version}.tar.gz::https://gitlab.com/m2crypto/${_name}/-/archive/${version}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
