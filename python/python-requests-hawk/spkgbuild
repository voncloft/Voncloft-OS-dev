# description : Hawk authentication strategy for the requests python library
# depends : python-mohawk python-requests

name=python-requests-hawk
version=1.2.1
release=2

_name=${name#python-}
source="https://github.com/mozilla-services/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
