# description : Python package for writing Value Change Dump VCD files

name=python-pyvcd
version=0.5.1
release=1

_name=${name#python-}
source="https://github.com/SanDisk-Open-Source/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
