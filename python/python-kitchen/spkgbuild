# description : Useful snippets of python code
# depends : python

name=python-kitchen
version=1.2.6
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/k/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
