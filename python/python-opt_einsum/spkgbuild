# description : Optimizing einsum functions in NumPy, Tensorflow, Dask, and more with contraction order optimization
# depends : python

name=python-opt_einsum
version=3.3.0
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/o/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
