# description : Mocking and Patching Library for Testing
# depends : python python-six python-pbr

name=python-mock
version=5.2.0
release=5

_name=${name#python-}
source="https://github.com/testing-cabal/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
