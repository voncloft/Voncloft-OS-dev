# description : Python Btrfs module, with useful scripts to inspect btrfs internals
# depends : python

name=python-btrfs
version=15
release=2

_name=${name#python-}
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/b/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
