# description : Linux /proc abstraction classes for python
# depends : python-six

name=python-linux-procfs
version=0.7.1
release=1

source="https://git.kernel.org/pub/scm/libs/python/${name}/python-linux-procfs.git/snapshot/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd ${name#python-}-$version
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
