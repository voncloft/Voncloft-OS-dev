# description : Query metadatdata from sdists / bdists / installed packages
# depends : python

name=python-pkginfo
version=1.9.6
release=1

_name=${name#python-}
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
