# description : Module of basic functions for parsing mime-type names and matching them against a list of media-ranges
# depends : python

name=python-mimeparse
version=2.0.0
release=8

_name=python_mimeparse
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/python_mimeparse*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
