# description : A Python extension module that allows you to manipulate the extended attributes.
# depends : python

name=python-pyxattr
version=0.8.1
release=1

_name=${name#python-}
source="https://pyxattr.k1024.org/downloads/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
