# description : OpenGL loader generator
# depends : python python-jinja python-pip python-setuptools python-wheel

name=python-glad
version=2.0.8
release=2
options="!checksum"
_name=glad2
source="${name}-${version}.tar.gz::https://files.pythonhosted.org/packages/source/g/${_name}/${_name}-${version}.tar.gz"

build() {
    cd "glad2-${version}"
    pip3 wheel --no-build-isolation --no-deps --no-cache-dir -w dist .
    pip3 install --no-index --no-deps --ignore-installed --no-user \
        --prefix=/usr --root="$PKG" dist/*.whl
}
