# description : Backport of Python 3 csv module.
# depends : python

name=python-backports.csv
version=1.0.7
release=4

_name=${name#python-}
source="${name}-${version}.zip::https://github.com/ryanhiebert/${_name}/archive/${version}.zip"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
