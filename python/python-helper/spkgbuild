# description : Development library for quickly writing configurable applications and daemons
# depends : python-yaml

name=python-helper
version=2.5.0
release=1

_name=${name#python-}
source="https://github.com/gmr/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
