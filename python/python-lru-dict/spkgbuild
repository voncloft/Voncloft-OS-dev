# description : lru cache for python
# depends : python

name=python-lru-dict
version=1.5.0
release=2

_name=${name#python-}
source="https://github.com/amitdev/${_name}/archive/refs/tags/v${version}.tar.gz"

build() {
	cd lru-dict
	python setup.py build_ext
	python setup.py install --root="$PKG" --optimize=1
}
