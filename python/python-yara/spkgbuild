# description : Tool aimed at helping malware researchers to identify and classify malware samples
  # depends : python yara libyara.so glibc

name=python-yara
version=4.5.4
release=2

_name=yara_python
source="https://files.pythonhosted.org/packages/source/y/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/yara_python*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
