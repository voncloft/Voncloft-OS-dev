# description : Python game library
# depends : python sdl2_mixer sdl2_ttf sdl2_image portmidi

name=python-pygame
version=2.1.3
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
