# description : Web API framework for build()ing fast and reliable microservices, proxies, and app backends in Python
# depends : python

name=python-falcon
version=4.4.0
release=6

_name=${name#python-}
source="${name}-${version}.tar.gz::https://github.com/falconry/${_name}/archive/refs/tags/${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
