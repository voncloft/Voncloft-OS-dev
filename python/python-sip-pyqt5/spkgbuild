# description : SIP runtime support for Python bindings to Qt 6
# depends	: python-sip

name=python-sip-pyqt6
version=13.13.0
release=2
source="https://files.pythonhosted.org/packages/78/35/bed43ff7cf040ced6b62a17b272abecb94914755284b54e8d06844e1ed23/pyqt6_sip-13.13.0.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pyqt6_sip-*/
   pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir .
   pip3 install --no-index --find-links dist --no-deps --root="$PKG" --prefix=/usr PyQt6-sip
 }
