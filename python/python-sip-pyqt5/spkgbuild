# description : SIP runtime support for Python bindings to Qt 6
# depends	: python-sip

name=python-sip-pyqt5
_upstream_name=python-sip-pyqt6
version=13.13.0
release=2
_name=pyqt6_sip
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pyqt6_sip*/
   pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir .
   pip3 install --no-index --find-links dist --no-deps --root="$PKG" --prefix=/usr PyQt6-sip
 }
