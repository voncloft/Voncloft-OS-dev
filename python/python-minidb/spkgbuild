# description : Simple SQLite3 store for Python objects
# depends : python

name=python-minidb
version=2.0.8
release=3

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/m/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/minidb*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
