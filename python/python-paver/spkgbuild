# description : Python-based project scripting
# depends : python-six

name=python-paver
version=1.3.4
release=4

_name=${name#python-}
source="https://github.com/paver/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
