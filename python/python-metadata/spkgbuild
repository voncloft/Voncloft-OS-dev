# description : PEP 621 project metadata support
# depends : python python-flit python-packaging

name=python-metadata
version=0.12.1
release=2
_name=pyproject_metadata
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "pyproject_metadata-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/pyproject_metadata-"$version"-*.whl
}
