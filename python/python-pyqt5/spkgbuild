# description : Python bindings for the Qt 6 toolkit
# depends : python-sip python-pyqt6-sip python-pyqt-builder qt6

name=python-pyqt5
_upstream_name=python-pyqt6
version=6.11.0
release=2
_name=${_upstream_name#python-}
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/pyqt6*/
	sip-build \
    	--confirm-license \
    	--no-make \
    	--api-dir /usr/share/qt/qsci/api/python
  	cd build
  	make
	make INSTALL_ROOT="$PKG" install -j1
}
