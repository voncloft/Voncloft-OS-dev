# description : Aggregate profiling for WSGI requests
# depends : python

name=python-repoze.profile
version=2.3
release=4

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/r/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
