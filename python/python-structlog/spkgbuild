# description : Structured Logging for Python
# depends : python-six

name=python-structlog
version=26.1.0
release=1

_name=${name#python-}
source="https://github.com/hynek/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
