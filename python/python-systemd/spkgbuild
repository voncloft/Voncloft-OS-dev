# description : Python bindings for systemd
  # depends : python3 libsystemd

name=python-systemd
version=235
release=7

_name=systemd-python
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/systemd-python*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
