# description : Python wrapper around Lua and LuaJIT
# depends : lua53 python

name=python-lupa
version=2.0
release=4

source="https://files.pythonhosted.org/packages/source/l/lupa/.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
