name=python-pyfix
version=0.2.3
release=6

_name=${name#python-}
source="https://github.com/pyclectic/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
