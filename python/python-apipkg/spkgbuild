# description : Namespace control and lazy-import mechanism
# depends : python

name=python-apipkg
version=3.0.2
release=5

_name=${name#python-}
source="https://github.com/pytest-dev/${_name}/archive/v${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
