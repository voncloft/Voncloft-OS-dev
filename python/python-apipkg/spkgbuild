# description : Namespace control and lazy-import mechanism
# depends : python

name=python-apipkg
version=3.0.2
release=5

source="https://github.com/pytest-dev/apipkg/archive/v3.0.1/python-apipkg-3.0.1.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
