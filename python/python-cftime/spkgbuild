# description : Time-handling functionality from python-netcdf4
# depends : python-numpy

name=python-cftime
version=1.6.6.1
release=1

_name=${name#python-}
source="https://github.com/Unidata/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
