# description : Python-based IP-XACT parser
# depends : python python-yaml

name=python-ipyxact
version=0.3.2
release=3

_name=${name#python-}
source="https://github.com/olofk/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
