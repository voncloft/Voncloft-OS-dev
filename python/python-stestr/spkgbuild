# description : A test runner runner similar to testrepository
# depends : python-future python-cliff python-pbr python-subunit python-fixtures

name=python-stestr
version=4.0.1
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/s/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
