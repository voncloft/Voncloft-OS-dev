# description : A small Python library that makes parsing and manipulating URLs easy
# depends : python-orderedmultidict python-six

name=python-furl
version=2.1.3
release=6

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/f/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
