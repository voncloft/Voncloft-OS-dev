# description : Extensions to Ian Bickings virtualenv tool
# depends : python-virtualenv python-virtualenv-clone python-stevedore

name=python-virtualenvwrapper
version=4.8.4
release=5

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/v/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
