# description : A Python ASGI web microframework with the same API as Flask
# depends : 

name=python-quart
version=0.18.4
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/q/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
