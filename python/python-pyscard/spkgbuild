# description : Framework for build()ing smart card aware applications in Python
# depends : python pcsclite

name=python-pyscard
version=2.0.7
release=2

_name=${name#python-}
source="https://downloads.sourceforge.net/project/${_name}/${_name}/pyscard%20${version}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
