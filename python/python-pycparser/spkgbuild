# description : C parser and AST generator written in Python
  # depends : python-ply

name=python-pycparser
version=3.12
release=3

_name=${name#python-}
source="https://github.com/eliben/${_name}/archive/refs/tags/release_v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
