# Report the upstream version; update-repo owns the version= edit.
source=https://pypi.org/pypi/pycparser/json
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PY'
import json
import pathlib
import re
import sys
import urllib.parse

try:
    data = json.loads(pathlib.Path('index.html').read_text(encoding='utf-8'))
    if data['info']['name'].lower() != 'pycparser':
        raise ValueError('PyPI project identity mismatch')
    version = data['info']['version']
    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)*', version):
        raise ValueError('latest release is not a stable numeric version')
    archives = [entry for entry in data['urls']
                if entry['packagetype'] == 'sdist' and not entry.get('yanked')
                and entry['filename'] == f'pycparser-{version}.tar.gz'
                and urllib.parse.urlsplit(entry['url']).hostname == 'files.pythonhosted.org']
    if len(archives) != 1:
        raise ValueError('no unique non-yanked source archive')
    print(version)
except (OSError, ValueError, KeyError, TypeError) as error:
    print(f'ERROR: Unable to read pycparser version: {error}', file=sys.stderr)
    sys.exit(1)
PY
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
