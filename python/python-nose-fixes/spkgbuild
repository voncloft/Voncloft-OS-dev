# description : A plugin to make nose behave better
# depends : python-nose

name=python-nose-fixes
version=1.3
release=5

_name=nose_fixes
source="https://files.pythonhosted.org/packages/source/n/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "$SRC"/nose_fixes*/
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
