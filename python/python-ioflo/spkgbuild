# description : Flo based programming interface in python
# depends : python

name=python-ioflo
version=2.0.3
release=3

_name=${name#python-}
source="https://github.com/ioflo/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
