# description : Poetry Python build backend and core utilities
# depends : python python-wheel

name=python-poetry-core
version=2.5.0
release=1

_name=poetry_core
source="https://files.pythonhosted.org/packages/source/p/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "poetry_core-$version"
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Stage the wheel even if this version is already installed on the host.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/poetry_core-"$version"-*.whl
}
