# description	: python library to access freedesktop.org standards
# depends	: python

name=python-xdg
version=6.0.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/x/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
