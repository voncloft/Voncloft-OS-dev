# description : A gaggle of idiosyncratic and questionable wrappers for the stdlib.
# depends : python-six python-pytz python-more-itertools
# And now cherrypy depends on this too :-

name=python-jaraco
version=4.3.0
release=1

_name=jaraco_text
source="https://files.pythonhosted.org/packages/source/j/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
