# description : The next generation of nicer testing for python
# depends : python-coverage python-six

name=python-nose2
version=0.13.0
release=1

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/n/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
