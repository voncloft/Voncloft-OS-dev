# description : Pathlib-compatible object wrapper for zip files
# depends : python

name=python-zipp
version=4.1.2
release=3

_name=${name#python-}
source="https://github.com/jaraco/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
