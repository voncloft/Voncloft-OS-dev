# description : Command Arguments for Humans
# depends : python

name=python-args
version=0.1.0
release=5

_name=${name#python-}
source="https://github.com/kenneth-reitz/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
