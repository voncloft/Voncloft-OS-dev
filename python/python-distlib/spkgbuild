# description : Low-level components of distutils2/packaging
# depends : python

name=python-distlib
version=0.3.6
release=2

_name=${name#python-}
source="https://files.pythonhosted.org/packages/source/d/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd "${_name}-${version}"
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
