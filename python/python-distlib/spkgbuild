# description : Low-level components of distutils2/packaging
# depends : python

name=python-distlib
version=0.4.4
release=2

source="https://github.com/pypa/distlib/releases/download/0.3.6/distlib-0.3.6.tar.gz"
options="!checksum"

build() {
   cd ${name#python-}-$version
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
