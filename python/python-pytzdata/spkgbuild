# description : Official timezone database for Python.
# depends : python

name=python-pytzdata
version=2020.1
release=3

_name=${name#python-}
source="https://github.com/sdispater/${_name}/archive/refs/tags/$version.tar.gz"
options="!checksum"

build() {
   cd *
   python setup.py build
   python setup.py install --optimize=1 --root=$PKG
 }
