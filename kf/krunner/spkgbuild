# description : Framework for search plugins that return desktop search results and executable actions
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer ki18n kitemmodels kwindowsystem qt6 threadweaver

name=krunner
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "krunner-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
