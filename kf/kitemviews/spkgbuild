# description : Enhanced Qt item views and delegates for displaying lists, trees, and tables
# depends : extra-cmake-modules kde-deps-installer qt6

name=kitemviews
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kitemviews-$version.tar.xz"
options="!checksum"

build() {
    cd "kitemviews-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
