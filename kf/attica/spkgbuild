# description : Qt library for accessing Open Collaboration Services such as downloadable community content
# depends : extra-cmake-modules kde-deps-installer qt6

name=attica
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/attica-$version.tar.xz"
options="!checksum"

build() {
    cd "attica-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
