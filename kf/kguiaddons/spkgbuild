# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer libx11 libxcb libxext libxfixes libxi libxrender libxtst plasma-wayland-protocols qt6 wayland wayland-protocols xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm

name=kguiaddons
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kguiaddons-$version.tar.xz"
options="!checksum"

build() {
    cd "kguiaddons-$version"
    kf-package-installer -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
