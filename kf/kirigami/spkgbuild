# description : QML interface components for applications that adapt to desktop and mobile screens
# depends : extra-cmake-modules kde-deps-installer qt6

name=kirigami
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kirigami-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
