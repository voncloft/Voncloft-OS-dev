# description : Library for downloading and parsing RSS and Atom news feeds
# depends : extra-cmake-modules kcodecs kde-deps-installer qt6

name=syndication
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/syndication-$version.tar.xz"
options="!checksum"

build() {
    cd "syndication-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
