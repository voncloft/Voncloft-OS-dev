# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kconfigwidgets kcoreaddons kde-deps-installer kglobalaccel kguiaddons ki18n kiconthemes kitemviews ktextwidgets kwidgetsaddons qt6

name=kxmlgui
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kxmlgui-$version.tar.xz"
options="!checksum"

build() {
    cd "kxmlgui-$version"
    kf-package-installer  -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
