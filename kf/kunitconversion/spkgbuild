# description : Library for converting measurements between units such as length, mass, and temperature
# depends : extra-cmake-modules kconfig kde-deps-installer ki18n qt6

name=kunitconversion
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kunitconversion-$version"
    kf-package-installer  -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
