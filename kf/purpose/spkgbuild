# description : Framework for offering context-sensitive actions such as sharing files through service plugins
# depends : extra-cmake-modules kcmutils kconfig kcoreaddons kde-deps-installer ki18n kio kirigami kitemmodels knotifications kservice prison qt6

name=purpose
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/purpose-$version.tar.xz"
options="!checksum"

build() {
    cd "purpose-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
