# description : Library and tools for translating application text with gettext message catalogs
# depends : extra-cmake-modules gettext kde-deps-installer python qt6

name=ki18n
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/ki18n-$version.tar.xz"
options="!checksum"

build() {
    cd "ki18n-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
