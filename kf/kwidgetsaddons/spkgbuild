# description : Additional Qt widgets for dialogs, selectors, buttons, and other common interface elements
# depends : extra-cmake-modules kde-deps-installer qt6

name=kwidgetsaddons
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kwidgetsaddons-$version.tar.xz"
options="!checksum"

build() {
    cd "kwidgetsaddons-$version"
    kf-package-installer  -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
