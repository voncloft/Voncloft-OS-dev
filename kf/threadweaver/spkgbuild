# description : Library for scheduling dependent tasks and running them in a pool of worker threads
# depends : extra-cmake-modules kde-deps-installer qt6

name=threadweaver
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "threadweaver-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
