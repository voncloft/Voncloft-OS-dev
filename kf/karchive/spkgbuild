# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer qt6 zlib

name=karchive
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/karchive-$version.tar.xz"
options="!checksum"

build() {
    cd "karchive-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
