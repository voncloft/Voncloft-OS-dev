# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer ki18n kpty qt6

name=kdesu
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kdesu-$version.tar.xz"
options="!checksum"

build() {
    cd "kdesu-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
