name=kwindowsystem
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kwindowsystem-$version.tar.xz"
options="!checksum"

build() {
    cd "kwindowsystem-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
