# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer perl qt6

name=syntax-highlighting
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/syntax-highlighting-$version.tar.xz"
options="!checksum"

build() {
    cd "syntax-highlighting-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
