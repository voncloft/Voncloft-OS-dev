# description : Library for registering application keyboard shortcuts that work across the desktop
# depends : extra-cmake-modules kde-deps-installer qt6

name=kglobalaccel
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kglobalaccel-$version.tar.xz"
options="!checksum"

build() {
    cd "kglobalaccel-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
