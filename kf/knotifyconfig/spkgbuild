# description : Settings widgets for configuring application notification events and actions
# depends : extra-cmake-modules kcompletion kconfig kde-deps-installer ki18n kio knotifications kxmlgui qt6

name=knotifyconfig
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/knotifyconfig-$version.tar.xz"
options="!checksum"

build() {
    cd "knotifyconfig-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
