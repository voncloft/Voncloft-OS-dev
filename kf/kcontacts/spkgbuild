# description : Library for storing contact details and reading and writing vCard address books
# depends : extra-cmake-modules kcodecs kconfig kde-deps-installer ki18n qt6

name=kcontacts
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kcontacts-$version.tar.xz"
options="!checksum"

build() {
    cd "kcontacts-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
