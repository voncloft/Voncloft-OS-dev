# description : Tools and stylesheets for generating application handbooks from DocBook sources
# depends : docbook-xml docbook-xsl extra-cmake-modules karchive kde-deps-installer ki18n libxml2 libxslt qt6

name=kdoctools
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kdoctools-$version.tar.xz"
options="!checksum"

build() {
    cd "kdoctools-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
