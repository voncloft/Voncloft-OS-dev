# description : Core components for the kde desktop
# depends : attica extra-cmake-modules karchive kconfig kcoreaddons kde-deps-installer ki18n kirigami kpackage kwidgetsaddons qt6 syndication

name=knewstuff
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/knewstuff-$version.tar.xz"
options="!checksum"

build() {
    cd "knewstuff-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
