# description : Plugins that integrate Qt applications with KDE dialogs, settings, and desktop behavior
# depends : appstream-qt extra-cmake-modules kcolorscheme kconfig kconfigwidgets kde-deps-installer kguiaddons ki18n kiconthemes kio kitemviews knewstuff knotifications kpackage kwidgetsaddons oxygen-icons qt6

name=frameworkintegration
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/frameworkintegration-$version.tar.xz"
options="!checksum"

build() {
    cd "frameworkintegration-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
