# description : Library for rendering and caching themed SVG graphics and scalable interface elements
# depends : extra-cmake-modules karchive kcolorscheme kconfig kcoreaddons kde-deps-installer kguiaddons kirigami qt6

name=ksvg
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/ksvg-$version.tar.xz"
options="!checksum"

build() {
    cd "ksvg-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
