# description : Widgets and dialogs that connect application settings to KConfig
# depends : extra-cmake-modules kcodecs kcolorscheme kconfig kcoreaddons kde-deps-installer kguiaddons ki18n kwidgetsaddons qt6

name=kconfigwidgets
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kconfigwidgets-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
