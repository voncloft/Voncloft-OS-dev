# description : Qt libraries for drawing charts and Gantt project timelines
# depends : extra-cmake-modules kde-deps-installer qt6

name=kdiagram
version=3.0.1
release=2

source="https://download.kde.org/stable/${name}/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdiagram-$version"
    kf-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
