# description : create business diagrams
# depends : extra-cmake-modules kde-deps-installer qt6

name=kdiagram
version=3.0.1
release=2

source="https://download.kde.org/stable/kdiagram/$version/kdiagram-$version.tar.xz"
options="!checksum"

build() {
    cd "kdiagram-$version"
    kf-package-installer -DQT_MAJOR_VERSION=6
    cd build
    make DESTDIR="$PKG" install
}
