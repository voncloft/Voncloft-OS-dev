# description : Library for storing, organizing, and displaying application bookmarks
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer kwidgetsaddons qt6

name=kbookmarks
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kbookmarks-$version.tar.xz"
options="!checksum"

build() {
    cd "kbookmarks-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
