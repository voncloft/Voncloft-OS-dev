# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfigwidgets kcoreaddons kde-deps-installer kguiaddons ki18n kio kirigami kitemviews kwidgetsaddons kxmlgui qt6

name=kcmutils
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kcmutils-$version.tar.xz"
options="!checksum"

build() {
    cd "kcmutils-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
