# description : QML components for displaying line, bar, pie, and other data charts
# depends : extra-cmake-modules kde-deps-installer qt6

name=kquickcharts
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kquickcharts-$version.tar.xz"
options="!checksum"

build() {
    cd "kquickcharts-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
