# description : Embeddable text editor component with syntax highlighting, code navigation, and editing tools
# depends : breeze-icons extra-cmake-modules karchive kauth kcolorscheme kconfig kde-deps-installer kguiaddons ki18n kio kjobwidgets kparts kxmlgui qt6 sonnet syntax-highlighting

name=ktexteditor
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/ktexteditor-$version.tar.xz"
options="!checksum"

build() {
    cd "ktexteditor-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
