# Read current upstream release metadata, excluding prereleases.
source="https://download.kde.org/stable/frameworks/"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import json,pathlib,re,subprocess
text=pathlib.Path("index.html").read_text()
series=re.findall(r'href="([0-9]+\.[0-9]+)/"',text)
latest=max(series,key=lambda v:tuple(map(int,v.split('.'))))
child=subprocess.run(['curl','-fLsS','--max-time','30','https://download.kde.org/stable/frameworks/'+latest+'/'],capture_output=True,text=True,check=True).stdout
versions=re.findall(r'kapidox-([0-9]+(?:\.[0-9]+)*)\.tar\.xz',child)
if not versions:raise SystemExit("No final upstream release found")
print(max(set(versions),key=lambda v:tuple(map(int,v.split(".")))))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
