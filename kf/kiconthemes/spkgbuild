# description : Library for locating, loading, selecting, and displaying themed icons
# depends : breeze-icons extra-cmake-modules karchive kcolorscheme kconfig kde-deps-installer ki18n kwidgetsaddons qt6

name=kiconthemes
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kiconthemes-$version.tar.xz"
options="!checksum"

build() {
    cd "kiconthemes-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
