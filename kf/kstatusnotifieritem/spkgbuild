# description : Library for adding application icons, menus, and status information to the system tray
# depends : extra-cmake-modules kde-deps-installer kwindowsystem qt6

name=kstatusnotifieritem
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kstatusnotifieritem-$version.tar.xz"
options="!checksum"

build() {
    cd "kstatusnotifieritem-$version"
    kf-package-installer  -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
