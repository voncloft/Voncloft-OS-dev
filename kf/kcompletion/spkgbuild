# description : Text completion library and input widgets with suggestions and history
# depends : extra-cmake-modules kcodecs kconfig kde-deps-installer kwidgetsaddons qt6

name=kcompletion
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kcompletion-$version.tar.xz"
options="!checksum"

build() {
    cd "kcompletion-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
