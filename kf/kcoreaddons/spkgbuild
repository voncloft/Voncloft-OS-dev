# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer qt6 util-linux

name=kcoreaddons
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kcoreaddons-$version.tar.xz"
options="!checksum"

build() {
    cd "kcoreaddons-$version"
    kf-package-installer -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
