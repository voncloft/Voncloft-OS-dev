# description : Library for integrating KDE functionality and configuration with QML interfaces
# depends : extra-cmake-modules kconfig kde-deps-installer kglobalaccel kguiaddons ki18n kwidgetsaddons qt6

name=kdeclarative
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdeclarative-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
