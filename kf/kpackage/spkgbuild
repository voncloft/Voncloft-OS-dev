# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kcoreaddons kde-deps-installer kdoctools ki18n qt6

name=kpackage
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kpackage-$version.tar.xz"
options="!checksum"

build() {
    cd "kpackage-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
