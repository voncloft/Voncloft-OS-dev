# description : Core components for the kde desktop
# depends : extra-cmake-modules kcontacts kcoreaddons kde-deps-installer ki18n kitemviews kwidgetsaddons qt6

name=kpeople
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kpeople-$version.tar.xz"
options="!checksum"

build() {
    cd "kpeople-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
