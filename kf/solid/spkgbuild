# description : Core components for the kde desktop
# depends : bison extra-cmake-modules flex kde-deps-installer qt6 udev util-linux

name=solid
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/solid-$version.tar.xz"
options="!checksum"

build() {
    cd "solid-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
