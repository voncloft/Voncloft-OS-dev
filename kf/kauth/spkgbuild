# description : Library for requesting authorization and running privileged helper actions through PolicyKit
# depends : extra-cmake-modules kcoreaddons kde-deps-installer kwindowsystem polkit-qt qt6

name=kauth
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kauth-$version.tar.xz"
options="!checksum"

build() {
    cd "kauth-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
