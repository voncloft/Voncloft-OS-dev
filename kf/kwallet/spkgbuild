# description : Core components for the kde desktop
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer ki18n kiconthemes knotifications kwidgetsaddons kwindowsystem qca qt6

name=kwallet
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kwallet-$version.tar.xz"
options="!checksum"

build() {
    cd "kwallet-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
