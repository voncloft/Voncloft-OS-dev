# description : Component framework for embedding document viewers and editors inside other applications
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer ki18n kio kjobwidgets knotifications kservice kwidgetsaddons kxmlgui qt6

name=kparts
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kparts-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
