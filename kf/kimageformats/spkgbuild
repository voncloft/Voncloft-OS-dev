# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kde-deps-installer qt6

name=kimageformats
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kimageformats-$version.tar.xz"
options="!checksum"

build() {
    cd "kimageformats-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
