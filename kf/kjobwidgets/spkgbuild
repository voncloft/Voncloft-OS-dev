# description : Widgets for displaying progress and handling user interaction during background jobs
# depends : extra-cmake-modules kcoreaddons kde-deps-installer knotifications kwidgetsaddons qt6

name=kjobwidgets
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kjobwidgets-$version"
    kf-package-installer -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
