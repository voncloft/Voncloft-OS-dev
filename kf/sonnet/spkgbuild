# description : Spell checking framework with dictionaries, language detection, and text editor integration
# depends : extra-cmake-modules kde-deps-installer qt6

name=sonnet
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "sonnet-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
