# description : Additional Kirigami components for settings, forms, navigation, and common application interfaces
# depends : extra-cmake-modules kcolorscheme kconfig kcoreaddons kcrash kde-deps-installer kglobalaccel kguiaddons ki18n kiconthemes kirigami qt6

name=kirigami-addons
version=1.15.0
release=1

source="https://download.kde.org/stable/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kirigami-addons-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
