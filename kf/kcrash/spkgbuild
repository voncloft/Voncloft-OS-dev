# description : Core components for the kde desktop
# depends : extra-cmake-modules kcoreaddons kde-deps-installer libx11 libxext libxfixes libxi libxrender libxtst qt6

name=kcrash
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kcrash-$version.tar.xz"
options="!checksum"

build() {
    cd "kcrash-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
