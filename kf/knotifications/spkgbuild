# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kde-deps-installer libcanberra qt6

name=knotifications
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/knotifications-$version.tar.xz"
options="!checksum"

build() {
    cd "knotifications-$version"
    kf-package-installer -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
