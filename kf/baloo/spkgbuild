# depends : extra-cmake-modules kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kfilemetadata ki18n kidletime kio lmdb qt6 solid
# description : Core components for the kde desktop

name=baloo
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/baloo-$version.tar.xz"
options="!checksum"

build() {
    cd "baloo-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
