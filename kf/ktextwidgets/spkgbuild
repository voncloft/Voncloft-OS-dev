# description : Core components for the kde desktop
# depends : extra-cmake-modules kcompletion kconfig kde-deps-installer ki18n kwidgetsaddons qt6 sonnet

name=ktextwidgets
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/ktextwidgets-$version.tar.xz"
options="!checksum"

build() {
    cd "ktextwidgets-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
