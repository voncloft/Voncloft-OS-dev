# description : Qt text editing widgets with spell checking, search, and rich text support
# depends : extra-cmake-modules kcompletion kconfig kde-deps-installer ki18n kwidgetsaddons qt6 sonnet

name=ktextwidgets
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ktextwidgets-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
