# description : Library for discovering and advertising local network services using DNS-SD
# depends : extra-cmake-modules kde-deps-installer qt6

name=kdnssd
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kdnssd-$version.tar.xz"
options="!checksum"

build() {
    cd "kdnssd-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
