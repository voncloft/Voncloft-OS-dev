# description : Library for encoding, decoding, and detecting character sets in text and messages
# depends : extra-cmake-modules kde-deps-installer qt6

name=kcodecs
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kcodecs-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
