# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kde-deps-installer kguiaddons ki18n qt6

name=kcolorscheme
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kcolorscheme-$version.tar.xz"
options="!checksum"

build() {
    cd "kcolorscheme-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
