# description : Library for accessing calendars and address books through CalDAV, CardDAV, and GroupDAV
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n qt6

name=kdav
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kdav-$version.tar.xz"
options="!checksum"

build() {
    cd "kdav-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
