# depends : attr exiv2 extra-cmake-modules ffmpeg karchive kcodecs kcoreaddons kde-deps-installer ki18n poppler qt6 taglib
# description : Core components for the kde desktop

name=kfilemetadata
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kfilemetadata-$version.tar.xz"
options="!checksum"

build() {
    cd "kfilemetadata-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
