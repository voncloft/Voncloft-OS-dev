# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer qt6

name=kplotting
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kplotting-$version.tar.xz"
options="!checksum"

build() {
    cd "kplotting-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
