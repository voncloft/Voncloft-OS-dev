# description : Background service that loads KDE modules for shared desktop tasks
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kdoctools ki18n kservice qt6

name=kded
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kded-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
