# description : The oxygen icons theme is a photo-realistic icon style, with a high standard of graphics quality
# depends : extra-cmake-modules kde-deps-installer qt6

name=oxygen-icons
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/oxygen-icons-$version.tar.xz"
options="!checksum"

build() {
    cd "oxygen-icons-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
