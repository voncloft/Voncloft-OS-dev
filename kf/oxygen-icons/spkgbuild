# description : Oxygen icon theme for KDE applications and desktop interfaces
# depends : extra-cmake-modules kde-deps-installer qt6

name=oxygen-icons
version=6.2.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "$SRC"/oxygen-icons*/
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
