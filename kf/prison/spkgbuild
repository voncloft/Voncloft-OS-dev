# depends : extra-cmake-modules kde-deps-installer libdmtx qrencode qt6 zxing-cpp
# description : Library and QML components for generating and reading barcodes and QR codes

name=prison
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "prison-$version"
    kf-package-installer -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
