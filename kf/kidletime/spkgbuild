# description : Library for detecting user inactivity and tracking desktop idle time
# depends : extra-cmake-modules kde-deps-installer libx11 libxcb libxext libxfixes libxi libxrender libxtst plasma-wayland-protocols qt6 wayland wayland-protocols xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm

name=kidletime
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kidletime-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
