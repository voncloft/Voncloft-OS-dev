# description : Library for reading, writing, and managing application configuration files
# depends : extra-cmake-modules kde-deps-installer qt6

name=kconfig
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kconfig-$version.tar.xz"
options="!checksum"

build() {
    cd "kconfig-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
