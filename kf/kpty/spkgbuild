# description : Library for starting and communicating with processes through pseudo-terminals
# depends : extra-cmake-modules kcoreaddons kde-deps-installer ki18n qt6

name=kpty
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kpty-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
