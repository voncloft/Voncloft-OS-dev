# description : Django-style text template engine for generating formatted output from application data
# depends : extra-cmake-modules kde-deps-installer qt6

name=ktexttemplate
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/ktexttemplate-$version.tar.xz"
options="!checksum"

build() {
    cd "ktexttemplate-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
