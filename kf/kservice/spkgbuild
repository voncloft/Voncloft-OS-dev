# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer kdoctools ki18n qt6

name=kservice
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kservice-$version.tar.xz"
options="!checksum"

build() {
    cd "kservice-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
