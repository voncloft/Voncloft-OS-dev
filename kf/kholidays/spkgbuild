# description : Library for looking up public holidays and observances by region
# depends : bison extra-cmake-modules flex kde-deps-installer qt6

name=kholidays
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kholidays-$version.tar.xz"
options="!checksum"

build() {
    cd "kholidays-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
