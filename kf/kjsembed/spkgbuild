# note : Requires a separate Qt 5/KF5 stack; the KF6 upgrade does not supply it.
# depends : kde-deps-installer
# status : Final archived release; excluded from current Frameworks/Plasma/Gear package groups.
# description : Legacy library for exposing Qt objects to scripts running in the KJS JavaScript engine

name=kjsembed
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/portingAids/${name}-$version.tar.xz"
options="!checksum"

build() {
    if ! test -f /usr/lib64/cmake/KF5CoreAddons/KF5CoreAddonsConfig.cmake && \
       ! test -f /usr/lib/cmake/KF5CoreAddons/KF5CoreAddonsConfig.cmake; then
        printf '%s\n' 'This archived Qt5/KF5 package is outside the current Qt6 KDE upgrade.' >&2
        return 1
    fi
   cd $name-$version
   kf-package-installer
   cd build
   make DESTDIR=$PKG install
}
