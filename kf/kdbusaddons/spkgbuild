# description : Qt helpers for D-Bus communication, service registration, and single-instance applications
# depends : extra-cmake-modules kde-deps-installer qt6

name=kdbusaddons
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdbusaddons-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
