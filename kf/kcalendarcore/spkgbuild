# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer libical qt6

name=kcalendarcore
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/kcalendarcore-$version.tar.xz"
options="!checksum"

build() {
    cd "kcalendarcore-$version"
    kf-package-installer -DBUILD_PYTHON_BINDINGS=OFF
    cd build
    make DESTDIR="$PKG" install
}
