# description : Qt wrappers for interacting with Wayland display protocols
# depends : extra-cmake-modules kde-deps-installer mesa plasma-wayland-protocols qt6 wayland wayland-protocols

name=kwayland
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/kwayland-$version.tar.xz"
options="!checksum"

build() {
    cd "kwayland-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
