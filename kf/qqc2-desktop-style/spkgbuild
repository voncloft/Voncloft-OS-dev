# description : Qt Quick Controls style that follows the desktop Qt widget theme and settings
# depends : extra-cmake-modules kcolorscheme kconfig kde-deps-installer kiconthemes kirigami qt6 sonnet

name=qqc2-desktop-style
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "qqc2-desktop-style-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
