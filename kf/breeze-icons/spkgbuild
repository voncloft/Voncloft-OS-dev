# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer python qt6

name=breeze-icons
version=6.31.0
release=1

source="https://download.kde.org/stable/frameworks/${version%.*}/breeze-icons-$version.tar.xz"
options="!checksum"

build() {
    cd "breeze-icons-$version"
    kf-package-installer
    cd build
    make DESTDIR="$PKG" install
}
