# description : Perl module to read TNEF files
# depends : perl-io-stringy perl-mime-tools

name=perl-convert-tnef
version=0.18
release=8

_name=Convert-TNEF
source="https://cpan.metacpan.org/authors/id/D/DO/DOUGW/${_name}-${version}.tar.gz"
