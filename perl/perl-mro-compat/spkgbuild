# description : mro::* interface compatibility for Perls < 5.9.5
# depends : perl

name=perl-mro-compat
version=0.15
release=5

_name=MRO-Compat
source="https://cpan.metacpan.org/authors/id/H/HA/HAARG/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
