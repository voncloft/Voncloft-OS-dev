# description : Perl module that provides lightweight MIME generator
# depends : perl-email-date-format perl-mailtools perl-mime-types perl

name=perl-mime-lite
version=3.033
release=3

_name=MIME-Lite
source="https://cpan.metacpan.org/authors/id/R/RJ/RJBS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
