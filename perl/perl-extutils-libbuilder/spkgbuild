# description : A tools to build C libraries
# depends : perl

name=perl-extutils-libbuilder
version=0.08
release=7

_name=ExtUtils-LibBuilder
source="https://cpan.metacpan.org/authors/id/A/AM/AMBS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
