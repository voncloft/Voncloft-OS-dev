# description : Read/Write YAML files with as little code as possible
# depends : perl

name=perl-yaml-tiny
version=1.74
release=4

_name=YAML-Tiny
source="https://cpan.metacpan.org/authors/id/E/ET/ETHER/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
