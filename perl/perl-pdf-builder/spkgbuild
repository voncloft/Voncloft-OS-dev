# description : Facilitates the creation and modification of PDF files
# depends : perl perl-font-ttf

name=perl-pdf-builder
version=3.025
release=1

_name=PDF-Builder
source="https://cpan.metacpan.org/authors/id/P/PM/PMPERRY/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
