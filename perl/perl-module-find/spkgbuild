# description : Find and use installed perl modules in a subcategory
# depends : perl

name=perl-module-find
version=0.16
release=6

_name=Module-Find
source="https://cpan.metacpan.org/authors/id/C/CR/CRENZ/${_name}-${version}.tar.gz"
