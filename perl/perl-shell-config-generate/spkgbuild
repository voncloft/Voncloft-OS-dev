# description : Portably generate config for any shell
# depends : perl-shell-guess

name=perl-shell-config-generate
version=0.34
release=2

_name=Shell-Config-Generate
source="https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
