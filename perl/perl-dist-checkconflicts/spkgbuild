# description : Declare version conflicts for your dist
# depends : perl-list-moreutils perl-exporter

name=perl-dist-checkconflicts
version=0.11
release=6

_name=Dist-CheckConflicts
source="https://cpan.metacpan.org/authors/id/D/DO/DOY/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
