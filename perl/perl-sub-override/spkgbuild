# description : Perl extension for easily overriding subroutines
# depends : perl

name=perl-sub-override
version=0.09
release=2

_name=Sub-Override
source="https://cpan.metacpan.org/authors/id/O/OV/OVID/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
