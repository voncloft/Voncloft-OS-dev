# description : Open an HTML file with automatic charset detection
# depends : perl

name=perl-io-html
version=1.004
release=1

_name=IO-HTML
source="https://cpan.metacpan.org/authors/id/C/CJ/CJM/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
