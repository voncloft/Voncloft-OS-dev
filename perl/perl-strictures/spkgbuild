# description : Turn on strict and make most warnings fatal
# depends : perl

name=perl-strictures
version=2.000006
release=3

_name=${name#perl-}
source="https://cpan.metacpan.org/authors/id/H/HA/HAARG/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
