# description : IPC::Run - system and background procs w/ piping, redirs, ptys
# depends : perl perl-io-tty
# IPC::Run depends on IO::Pty which is provided by perl-io-tty

name=perl-ipc-run
version=20220807.0
release=2

_name=IPC-Run
source="https://cpan.metacpan.org/authors/id/T/TO/TODDR/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
