# description : Perl interface to the 3.x series of the GTK+ toolkit
# depends : gtk3 perl-cairo-gobject perl-glib-object-introspection

name=perl-gtk3
version=0.038
release=1

_name=Gtk3
source="https://cpan.metacpan.org/authors/id/X/XA/XAOC/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
