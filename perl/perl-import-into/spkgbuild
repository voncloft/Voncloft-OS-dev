# description : Import packages into other packages
# depends : perl-module-runtime perl

name=perl-import-into
version=1.002005
release=6

_name=Import-Into
source="https://cpan.metacpan.org/authors/id/H/HA/HAARG/${_name}-${version}.tar.gz"
