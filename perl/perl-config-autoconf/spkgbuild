# description : A module to implement some of AutoConf macros in pure perl.
# depends : perl-capture-tiny

name=perl-config-autoconf
version=0.320
release=4

_name=Config-AutoConf
source="https://cpan.metacpan.org/authors/id/A/AM/AMBS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
