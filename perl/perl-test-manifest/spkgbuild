# description : configure which test files to run
# depends : perl

name=perl-test-manifest
version=2.023
release=2

_name=Test-Manifest
source="https://cpan.metacpan.org/authors/id/B/BD/BDFOY/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
