# description : Module to check if other perl modules are installed
# depends : perl

name=perl-devel-checklib
version=1.16
release=2

_name=Devel-CheckLib
source="https://cpan.metacpan.org/authors/id/M/MA/MATTN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
