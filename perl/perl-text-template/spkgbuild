# description : Expand template text with embedded perl
# depends : perl

name=perl-text-template
version=1.61
release=1

_name=Text-Template
source="https://cpan.metacpan.org/authors/id/M/MS/MSCHOUT/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
