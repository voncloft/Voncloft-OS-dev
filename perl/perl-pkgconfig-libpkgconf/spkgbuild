# description : Perl bindings for libpkgconf
# depends : perl pkgconf

name=perl-pkgconfig-libpkgconf
version=0.11
release=2

_name=PkgConfig-LibPkgConf
source="https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
