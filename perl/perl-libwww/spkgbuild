# description : The World-Wide Web library for Perl
# depends : perl perl-encode-locale perl-file-listing

name=perl-libwww
version=6.67
release=1

_name=libwww-perl
source="https://cpan.metacpan.org/authors/id/O/OA/OALDERS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
