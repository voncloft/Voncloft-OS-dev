# description : MariaDB and MySQL driver for the Perl5 Database Interface DBI
# depends : mariadb perl-dbi

name=perl-dbd-mariadb
version=1.22
release=1

_name=DBD-MariaDB
source="https://cpan.metacpan.org/authors/id/P/PA/PALI/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
