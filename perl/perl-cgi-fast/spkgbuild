# description : CGI Interface for Fast CGI
# depends : perl perl-cgi perl-fcgi

name=perl-cgi-fast
version=2.16
release=3

_name=CGI-Fast
source="https://cpan.metacpan.org/authors/id/L/LE/LEEJO/${_name}-${version}.tar.gz"
