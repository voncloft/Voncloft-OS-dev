# description : Image viewer widget for Gtk3
# depends : perl-gtk3 imagemagick

name=perl-gtk3-imageview
version=10
release=1

_name=Gtk3-ImageView
source="https://cpan.metacpan.org/authors/id/A/AS/ASOKOLOV/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
