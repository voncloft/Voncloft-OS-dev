# description : Perl interface to SNMP
# depends : perl perl-digest-hmac perl-digest-sha1 perl-crypt-des

name=perl-net-snmp
version=v6.0.1
release=8

_name=Net-SNMP
source="https://cpan.metacpan.org/authors/id/D/DT/DTOWN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
