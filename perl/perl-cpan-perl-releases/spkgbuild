# description : Mapping Perl releases on CPAN to the location of the tarballs
# depends : perl

name=perl-cpan-perl-releases
version=5.20230423
release=2

_name=CPAN-Perl-Releases
source="https://cpan.metacpan.org/authors/id/B/BI/BINGOS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
