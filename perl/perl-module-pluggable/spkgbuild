# description : automatically give your module the ability to have plugins
# depends : perl

name=perl-module-pluggable
version=5.2
release=6

_name=Module-Pluggable
source="https://cpan.metacpan.org/authors/id/S/SI/SIMONW/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
