# description : an exporter with the features of Sub::Exporter but only core dependencies
# depends : perl

name=perl-exporter-tiny
version=1.006002
release=2

_name=Exporter-Tiny
source="https://cpan.metacpan.org/authors/id/T/TO/TOBYINK/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
