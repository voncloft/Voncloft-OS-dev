# description : Lexically disable autovivification.
# depends : perl

name=perl-autovivification
version=0.18
release=6

_name=${name#perl-}
source="https://cpan.metacpan.org/authors/id/V/VP/VPIT/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
