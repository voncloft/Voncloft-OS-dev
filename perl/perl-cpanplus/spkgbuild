# description : Ameliorated interface to the CPAN
# depends : perl perl-log-message perl-archive-extract perl-term-ui perl-log-message-simple

name=perl-cpanplus
version=0.9914
release=1

_name=CPANPLUS
source="https://cpan.metacpan.org/authors/id/B/BI/BINGOS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
