# description : Framework for more readable interactive test scripts
# depends : perl

name=perl-test-inter
version=1.10
release=3

_name=Test-Inter
source="https://cpan.metacpan.org/authors/id/S/SB/SBECK/${_name}-${version}.tar.gz"
