# description : Check that a library is available for FFI
# depends : perl

name=perl-ffi-checklib
version=0.31
release=2

_name=FFI-CheckLib
source="https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
