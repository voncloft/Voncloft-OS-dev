# description : Check that a library is available for FFI
# depends : perl

name=perl-ffi-checklib
version=0.31
release=2

source="https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/FFI-CheckLib-0.31.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
