# description : Perl extension for simple generation of unique IDs
# depends : perl

name=perl-data-uniqid
version=0.12
release=8

_name=Data-Uniqid
source="https://cpan.metacpan.org/authors/id/M/MW/MWX/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
