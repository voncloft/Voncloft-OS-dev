# description : Routines for accessing the OpenSSL pseudo-random number generator
# depends : perl openssl 

name=perl-crypt-openssl-random
version=0.15
release=6

_name=Crypt-OpenSSL-Random
source="https://cpan.metacpan.org/authors/id/R/RU/RURBAN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
