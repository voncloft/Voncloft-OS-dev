# description : Perl bindings to create and manipulate PAR distributions
# depends : perl

name=perl-par-dist
version=0.51
release=1

_name=PAR-Dist
source="https://cpan.metacpan.org/authors/id/R/RS/RSCHUPP/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
