# description : Perl package that combines List::Util and List::MoreUtils in one bite-sized package
# depends : perl perl-list-moreutils.28 perl-scalar-list-utils.45

name=perl-list-allutils
version=0.19
release=2

_name=List-AllUtils
source="https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
