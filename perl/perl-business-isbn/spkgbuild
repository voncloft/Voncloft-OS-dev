# description : Perl package to work with International Standard Book Numbers
# depends : perl perl-business-isbn-data

name=perl-business-isbn
version=3.008
release=7

_name=Business-ISBN
source="https://cpan.metacpan.org/authors/id/B/BD/BDFOY/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
