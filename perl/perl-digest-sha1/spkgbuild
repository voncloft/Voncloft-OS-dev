# description : Perl interface to the SHA-1 Algorithm
# depends : perl

name=perl-digest-sha1
version=2.13
release=15

_name=Digest-SHA1
source="https://cpan.metacpan.org/authors/id/G/GA/GAAS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
