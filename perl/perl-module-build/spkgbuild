# description : Build, test, and install Perl modules
# depends : perl perl-cpan-meta perl-inc-latest

name=perl-module-build
version=0.4232
release=3

_name=Module-Build
source="https://cpan.metacpan.org/authors/id/L/LE/LEONT/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
