# note : CPAN::Meta::Requirements is supplied by the core perl package.
# description : the distribution metadata for a CPAN dist
# depends : perl perl

name=perl-cpan-meta
version=2.150010
release=10

_name=CPAN-Meta
source="https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
