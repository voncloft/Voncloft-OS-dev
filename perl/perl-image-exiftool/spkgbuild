# description : Reader and rewriter of EXIF informations that supports raw files
# depends : perl

name=perl-image-exiftool
version=13.55
release=1

_name=Image-ExifTool
source="https://cpan.metacpan.org/authors/id/E/EX/EXIFTOOL/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
