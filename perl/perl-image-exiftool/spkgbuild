# description : Reader and rewriter of EXIF informations that supports raw files
# depends : perl

name=perl-image-exiftool
version=13.55
release=1

source="https://cpan.metacpan.org/authors/id/E/EX/EXIFTOOL/Image-ExifTool-13.55.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
