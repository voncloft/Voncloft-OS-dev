# description : Perl extension to interface GSM phones / modems
# depends : perl-device-modem

name=perl-device-gsm
version=1.61
release=4

_name=Device-Gsm
source="https://cpan.metacpan.org/authors/id/C/CO/COSIMO/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
