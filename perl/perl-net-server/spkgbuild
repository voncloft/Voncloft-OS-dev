# description : Extensible, general Perl server engine
# depends : perl

name=perl-net-server
version=2.014
release=6

_name=Net-Server
source="https://cpan.metacpan.org/authors/id/R/RH/RHANDOM/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
