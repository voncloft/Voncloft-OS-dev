# description : Faster and more correct implementation of the Package::Stash API
# depends : perl

name=perl-package-stash-xs
version=0.30
release=4

_name=Package-Stash-XS
source="https://cpan.metacpan.org/authors/id/E/ET/ETHER/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
