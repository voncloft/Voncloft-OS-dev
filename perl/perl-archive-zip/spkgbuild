# description : Provide a perl interface to ZIP archive files
# depends : perl

name=perl-archive-zip
version=1.68
release=3

_name=Archive-Zip
source="https://cpan.metacpan.org/authors/id/P/PH/PHRED/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
