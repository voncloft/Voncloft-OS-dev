# description : Perl extension to talk to modem devices connected via serial port
# depends : perl-device-serialport

name=perl-device-modem
version=1.59
release=4

_name=Device-Modem
source="https://cpan.metacpan.org/authors/id/C/CO/COSIMO/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
