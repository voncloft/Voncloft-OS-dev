# description : The Perl Pkgconfig module
# depends : perl

name=perl-extutils-pkgconfig
version=1.16
release=7

_name=ExtUtils-PkgConfig
source="https://cpan.metacpan.org/authors/id/X/XA/XAOC/${_name}-${version}.tar.gz"
