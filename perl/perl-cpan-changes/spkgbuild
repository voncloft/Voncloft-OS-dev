# description : Read and write Changes files
# depends : perl

name=perl-cpan-changes
version=0.400002
release=4

_name=CPAN-Changes
source="https://cpan.metacpan.org/authors/id/H/HA/HAARG/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
