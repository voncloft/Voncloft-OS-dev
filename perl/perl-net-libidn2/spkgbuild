# description : Perl bindings for GNU Libidn2
# depends : libidn2 perl

name=perl-net-libidn2
version=1.02
release=1

_name=Net-LibIDN2
source="https://cpan.metacpan.org/authors/id/T/TH/THOR/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
