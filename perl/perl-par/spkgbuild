# description : Perl Archive Toolkit
# depends : perl-archive-zip perl-par-dist

name=perl-par
version=1.018
release=1

_name=PAR
source="https://cpan.metacpan.org/authors/id/R/RS/RSCHUPP/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
