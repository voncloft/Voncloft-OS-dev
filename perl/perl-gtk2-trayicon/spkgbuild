# description : Perl interface to the EggTrayIcon library
# depends : gtk2-perl

name=perl-gtk2-trayicon
version=0.07
release=20

_name=Gtk2-TrayIcon
source="https://downloads.sourceforge.net/sourceforge/gtk2-perl/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
