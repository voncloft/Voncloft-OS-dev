# description : HTTP cookie jars
# depends : perl perl-http-date perl-http-message

name=perl-http-cookies
version=6.10
release=1

_name=HTTP-Cookies
source="https://cpan.metacpan.org/authors/id/O/OA/OALDERS/${_name}-${version}.tar.gz"
