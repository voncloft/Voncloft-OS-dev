# description : Perl extension for LDAP server side protocol handling
# depends : perl perl-ldap perl-convert-asn1

name=perl-net-ldap-server
version=0.43
release=8

_name=Net-LDAP-Server
source="https://cpan.metacpan.org/authors/id/A/AA/AAR/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
