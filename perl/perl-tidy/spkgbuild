# description : Parses and beautifies perl source
# depends : perl

name=perl-tidy
version=20230309
release=1

_name=Perl-Tidy
source="https://cpan.metacpan.org/authors/id/S/SH/SHANCOCK/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
