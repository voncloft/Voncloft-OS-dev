# description : CPAN/Canary-Stability - canary to check perl compatability for schmorps modules
# depends : perl

name=perl-canary-stability
version=2013
release=3

_name=Canary-Stability
source="https://cpan.metacpan.org/authors/id/M/ML/MLEHMANN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
