# description : Build, test, and install Perl modules
# depends : perl

name=perl-inc-latest
version=0.500
release=7

_name=${name#perl-}
source="https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
