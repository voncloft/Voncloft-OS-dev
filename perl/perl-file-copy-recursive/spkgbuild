# description : Perl extension for recursively copying files and directories
# depends : perl

name=perl-file-copy-recursive
version=0.45
release=3

_name=File-Copy-Recursive
source="https://cpan.metacpan.org/authors/id/D/DM/DMUEY/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
