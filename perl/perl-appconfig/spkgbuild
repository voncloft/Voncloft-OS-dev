# description : Perl/CPAN AppConfig module - Read configuration files and parse command line arguments
# depends : perl

name=perl-appconfig
version=1.71
release=7

_name=AppConfig
source="https://cpan.metacpan.org/authors/id/N/NE/NEILB/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
