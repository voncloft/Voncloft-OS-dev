# description : Perl extension for reading from continously updated files
# depends : perl-io

name=perl-file-tail
version=1.3
release=6

_name=File-Tail
source="https://cpan.metacpan.org/authors/id/M/MG/MGRABNAR/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
