# description : Perl package to work with International Standard Serial Numbers
# depends : perl

name=perl-business-issn
version=1.005
release=4

_name=Business-ISSN
source="https://cpan.metacpan.org/authors/id/B/BD/BDFOY/${_name}-${version}.tar.gz"
