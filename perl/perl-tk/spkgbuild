# description : A graphical user interface toolkit for Perl
# depends : libpng libjpeg tk perl

name=perl-tk
version=804.036
release=2

_name=Tk
source="https://cpan.metacpan.org/authors/id/S/SR/SREZIC/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
