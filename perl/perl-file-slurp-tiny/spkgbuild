# description : A simple, sane and efficient file slurper
# depends : perl

name=perl-file-slurp-tiny
version=0.004
release=6

_name=File-Slurp-Tiny
source="https://cpan.metacpan.org/authors/id/L/LE/LEONT/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
