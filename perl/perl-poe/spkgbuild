# description : portable multitasking and networking framework for Perl 
# depends : perl perl-io-tty perl-io-pipely

name=perl-poe
version=1.370
release=4

_name=POE
source="https://cpan.metacpan.org/authors/id/B/BI/BINGOS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
