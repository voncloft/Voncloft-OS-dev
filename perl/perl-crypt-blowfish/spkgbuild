# description : Perl/CPAN Module Crypt::Blowfish : XSbased implementation of Blowfish

name=perl-crypt-blowfish
version=2.14
release=11

_name=Crypt-Blowfish
source="https://cpan.metacpan.org/authors/id/D/DP/DPARIS/${_name}-${version}.tar.gz"
