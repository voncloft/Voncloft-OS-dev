# description : Perl extension for merging IPv4 or IPv6 CIDR addresses
# depends : perl

name=perl-net-cidr-lite
version=0.22
release=9

_name=Net-CIDR-Lite
source="https://cpan.metacpan.org/authors/id/S/ST/STIGTSP/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
