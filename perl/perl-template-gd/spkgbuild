# description : GD plugins for the Template Toolkit
# depends : perl-template-toolkit perl-gd

name=perl-template-gd
version=2.66
release=7

_name=Template-GD
source="https://cpan.metacpan.org/authors/id/A/AB/ABW/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
