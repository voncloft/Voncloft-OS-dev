# description : Perl extension for using OpenSSL
# depends : openssl

name=perl-net-ssleay
version=1.96
release=3

_name=Net-SSLeay
source="https://cpan.metacpan.org/authors/id/C/CH/CHRISN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
