# description : Implements some sane defaults for Perl programs
# depends : perl

name=perl-common-sense
version=3.75
release=2

_name=${name#perl-}
source="https://cpan.metacpan.org/authors/id/M/ML/MLEHMANN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
