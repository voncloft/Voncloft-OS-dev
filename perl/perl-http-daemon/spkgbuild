# description : Simple http server class
# depends : perl perl-http-date perl-http-message perl-lwp-mediatypes

name=perl-http-daemon
version=6.16
release=2

_name=HTTP-Daemon
source="https://cpan.metacpan.org/authors/id/O/OA/OALDERS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
