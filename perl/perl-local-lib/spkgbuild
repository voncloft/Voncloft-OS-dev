# description : Create and use a local lib/ for perl modules with PERL5LIB
# depends : perl

name=perl-local-lib
version=2.000029
release=3

_name=${name#perl-}
source="https://cpan.metacpan.org/authors/id/H/HA/HAARG/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
