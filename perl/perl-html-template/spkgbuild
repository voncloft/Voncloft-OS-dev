# description : A simple HTML templating system
# depends : perl

name=perl-html-template
version=2.97
release=6

_name=HTML-Template
source="https://cpan.metacpan.org/authors/id/S/SA/SAMTREGAR/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
