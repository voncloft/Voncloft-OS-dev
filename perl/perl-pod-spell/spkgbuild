# description : A formatter for spellchecking Pod
# depends : perl-class-tiny perl-file-sharedir perl-lingua-en-inflect perl-path-tiny

name=perl-pod-spell
version=1.26
release=3

_name=Pod-Spell
source="https://cpan.metacpan.org/authors/id/H/HA/HAARG/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
