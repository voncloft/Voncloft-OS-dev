# description : Locate per-dist and per-module shared files
# depends : perl-class-inspector

name=perl-file-sharedir
version=1.118
release=4

_name=File-ShareDir
source="https://cpan.metacpan.org/authors/id/R/RE/REHSACK/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
