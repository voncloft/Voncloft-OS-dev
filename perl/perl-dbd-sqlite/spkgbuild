# description : Self-contained RDBMS in a DBI driver
# depends : perl-dbi sqlite

name=perl-dbd-sqlite
version=1.72
release=1

_name=DBD-SQLite
source="https://cpan.metacpan.org/authors/id/I/IS/ISHIGAKI/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
