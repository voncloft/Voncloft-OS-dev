# description : Manage perl installations in your $HOME
# depends : perl perl-capture-tiny perl-cpan-perl-releases perl-devel-patchperl

name=perlbrew
version=0.96
release=1

_name=App-perlbrew
source="https://cpan.metacpan.org/authors/id/G/GU/GUGOD/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
