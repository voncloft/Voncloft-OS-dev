# description : Nearly transparent SSL encapsulation for IO::Socket::INET
# depends : perl-net-ssleay make-ca perl-uri

name=perl-io-socket-ssl
version=2.099
release=1

_name=IO-Socket-SSL
source="https://cpan.metacpan.org/authors/id/S/SU/SULLR/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   yes | perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
