# description : Install the C libxml2 library on your system
# depends : libxml2 perl-alien-build

name=perl-alien-libxml2
version=0.19
release=1

_name=Alien-Libxml2
source="https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_name}-${version}.tar.gz"
