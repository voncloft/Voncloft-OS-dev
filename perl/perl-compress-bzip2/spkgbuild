# description : Interface to Bzip2 compression library
# depends : perl bzip2

name=perl-compress-bzip2
version=2.28
release=1

_name=Compress-Bzip2
source="https://cpan.metacpan.org/authors/id/R/RU/RURBAN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
