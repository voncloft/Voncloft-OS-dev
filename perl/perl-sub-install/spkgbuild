# description : Install subroutines into packages easily
# depends : perl

name=perl-sub-install
version=0.928
release=6

_name=Sub-Install
source="https://cpan.metacpan.org/authors/id/R/RJ/RJBS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
