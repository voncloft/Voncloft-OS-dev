# description : Perl interface to rsync file list encoding and decoding
# depends : perl

name=perl-file-rsyncp
version=0.76
release=1

_name=File-RsyncP
source="https://cpan.metacpan.org/authors/id/C/CB/CBARRATT/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
