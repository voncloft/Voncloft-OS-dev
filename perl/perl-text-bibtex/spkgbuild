# description : Perl interface to read and parse BibTeX files
# depends : perl

name=perl-text-bibtex
version=0.89
release=6

_name=Text-BibTeX
source="https://cpan.metacpan.org/authors/id/A/AM/AMBS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
