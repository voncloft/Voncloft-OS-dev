# description : Perl extension for scrubbing/sanitizing html
# depends : perl perl-html-parser

name=perl-html-scrubber
version=0.19
release=3

_name=HTML-Scrubber
source="https://cpan.metacpan.org/authors/id/N/NI/NIGELM/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
