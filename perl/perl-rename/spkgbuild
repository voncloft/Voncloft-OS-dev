# description : Renames multiple files using Perl regular expressions.
# depends : perl

name=perl-rename
version=1.14
release=5

_name=${name#perl-}
source="https://cpan.metacpan.org/authors/id/P/PE/PEDERST/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
