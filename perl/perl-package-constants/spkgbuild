# description : List all constants declared in a package
# depends : perl

name=perl-package-constants
version=0.06
release=6

_name=Package-Constants
source="https://cpan.metacpan.org/authors/id/B/BI/BINGOS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
