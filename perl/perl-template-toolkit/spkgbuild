# description : Perl template processing system
# depends : perl-appconfig perl

name=perl-template-toolkit
version=3.101
release=1

_name=Template-Toolkit
source="https://cpan.metacpan.org/authors/id/A/AB/ABW/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
