# description : SSL support for Net::SMTP
# depends : perl-io-socket-ssl

name=perl-net-smtp-ssl
version=1.04
release=4

_name=Net-SMTP-SSL
source="https://cpan.metacpan.org/authors/id/R/RJ/RJBS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
