# description : Provides a crypt-compatible interface to new MD5-based crypt
# depends : perl

name=perl-crypt-passwdmd5
version=1.42
release=1

_name=Crypt-PasswdMD5
source="https://cpan.metacpan.org/authors/id/R/RS/RSAVAGE/${_name}-${version}.tgz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
