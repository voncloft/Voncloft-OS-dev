# description : Common source code filters for Inline Modules
# depends : perl-inline perl-inline-c

name=perl-inline-filters
version=0.20
release=3

_name=Inline-Filters
source="https://cpan.metacpan.org/authors/id/R/RU/RURBAN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
