# description : CPANPLUS backend for building ArchLinux pacman packages
# depends : perl perl-cpanplus perl-pod-parser

name=perl-cpanplus-dist-arch
version=1.32
release=6

_name=CPANPLUS-Dist-Arch
source="https://cpan.metacpan.org/authors/id/J/JN/JNBEK/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
