# description : Perl/CPAN DBD::mysql module for interacting with MySQL via DBD
# depends : perl-devel-checklib mariadb perl-dbi

name=perl-dbd-mysql
version=4.050
release=6

_name=DBD-mysql
source="https://cpan.metacpan.org/authors/id/D/DV/DVEEDEN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
