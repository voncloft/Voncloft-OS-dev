# description : Use the Freedesktop.org base directory specification
# depends : perl-ipc-system-simple

name=perl-file-basedir
version=0.09
release=5

_name=File-BaseDir
source="https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
