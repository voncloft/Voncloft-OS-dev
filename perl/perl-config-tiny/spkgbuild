# description : Read/Write .ini style files with as little code as possible 
# depends : perl

name=perl-config-tiny
version=2.29
release=4

source="https://search.cpan.org/CPAN/authors/id/R/RS/RSAVAGE/Config-Tiny-2.29.tgz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
