# description : Read/Write .ini style files with as little code as possible 
# depends : perl

name=perl-config-tiny
version=2.29
release=4

_name=Config-Tiny
source="https://cpan.metacpan.org/authors/id/R/RS/RSAVAGE/${_name}-${version}.tgz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
