# description : Jabber daemon written on Perl
# depends : perl-danga-socket perl-log-log4perl perl-unicode-stringprep

name=perl-djabberd
version=0.85
release=7

_name=DJabberd
source="https://cpan.metacpan.org/authors/id/M/MA/MART/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
