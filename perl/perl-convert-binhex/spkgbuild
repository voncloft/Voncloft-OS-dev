# description : Perl module to extract data from Macintosh BinHex files
# depends : perl

name=perl-convert-binhex
version=1.125
release=7

_name=Convert-BinHex
source="https://cpan.metacpan.org/authors/id/S/ST/STEPHEN/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
