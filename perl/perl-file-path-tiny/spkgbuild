# description : recursive versions of mkdir and rmdir without as much overhead as File::Path
# depends : perl

name=perl-file-path-tiny
version=1.0
release=4

_name=File-Path-Tiny
source="https://cpan.metacpan.org/authors/id/D/DM/DMUEY/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
