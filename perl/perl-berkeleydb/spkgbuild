# description : Interface to Berkeley DB version 2, 3 or 4
# depends : perl db

name=perl-berkeleydb
version=0.65
release=9

_name=BerkeleyDB
source="https://cpan.metacpan.org/authors/id/P/PM/PMQS/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
