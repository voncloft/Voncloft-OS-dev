# description : Database independent interface for Perl
# depends : perl

name=perl-dbi
version=1.643
release=2

_name=DBI
source="https://cpan.metacpan.org/authors/id/T/TI/TIMB/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
