# Read the upstream release archive instead of a version-specific directory.
source="https://www.cpan.org/src/5.0/"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re,subprocess
name='perl'
url='https://www.cpan.org/src/5.0/'
versions=set(re.findall('perl-([0-9]+\\.[0-9]+\\.[0-9]+)\\.tar\\.',pathlib.Path('index.html').read_text()))
versions={v for v in versions if int(v.split('.')[1])%2==0}
versions=sorted(versions,key=lambda v:tuple(map(int,re.findall(r'[0-9]+',v))),reverse=True)
if not versions:raise SystemExit('No stable source releases found')
print(versions[0])
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
