# description : Pure-Perl Core-Only replacement for pkg-config
# depends : perl

name=perl-pkgconfig
version=0.25026
release=1

_name=PkgConfig
source="https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
