# description : write filesystems in Perl using FUSE
# depends : perl fuse2

name=perl-fuse
version=0.16.1
release=11

_name=Fuse
source="https://cpan.metacpan.org/authors/id/D/DP/DPATES/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
