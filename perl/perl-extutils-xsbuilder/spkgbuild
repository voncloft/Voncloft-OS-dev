# description : Automatic Perl XS glue code generation
# depends : perl perl-parse-recdescent perl-tie-ixhash

name=perl-extutils-xsbuilder
version=0.28
release=9

_name=ExtUtils-XSBuilder
source="https://cpan.metacpan.org/authors/id/G/GR/GRICHTER/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
