# description : Patches text with given patch
# depends : perl

name=perl-text-patch
version=1.8
release=8

_name=Text-Patch
source="https://cpan.metacpan.org/authors/id/C/CA/CADE/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
