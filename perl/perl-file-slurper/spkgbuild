# description : A simple, sane and efficient module to slurp a file
# depends : perl

name=perl-file-slurper
version=0.013
release=4

_name=File-Slurper
source="https://cpan.metacpan.org/authors/id/L/LE/LEONT/${_name}-${version}.tar.gz"
options="!checksum"

build() {
   cd *
   perl Makefile.PL
   make
   make DESTDIR=$PKG install
}
