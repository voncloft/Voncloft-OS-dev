# description	: Fast and reliable FTP, FTPS and SFTP client
# depends	: libfilezilla gnutls dbus wxgtk3 libidn xdg-utils

name=filezilla
version=3.59.0
release=1
# Upstream changed source compression from bzip2 to xz at 3.64.0.
_archive_ext=xz
if [[ "$(printf '%s\n' "$version" 3.64.0 | LC_ALL=C sort -V | head -n1)" != 3.64.0 ]]; then
    _archive_ext=bz2
fi
source="https://downloads.sourceforge.net/project/portableapps/Source/FileZilla/FileZilla_${version}_src.tar.${_archive_ext}
	missing-list-include.patch"
options="!checksum"
build() {
	cd $name-$version

	patch -Np0 -i ../missing-list-include.patch

	./configure \
	    --prefix=/usr \
	    --disable-manualupdatecheck \
	    --disable-autoupdatecheck \
	    --with-pugixml=builtin \
	    --with-wx-config=/usr/bin/wx-config-gtk3
	make
	make DESTDIR=$PKG install
}
