# description : background images for gnome
# depends : glib meson

name=gnome-backgrounds
version=40.1
release=1
_verz=40
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"
options="!checksum"

build() {
	cd $name-$version
	mkdir build
	cd build
	meson compile ..
	DESTDIR=$PKG meson install ..
}
