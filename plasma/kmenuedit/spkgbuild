# description : Editor for organizing application launcher entries, categories, and launch commands
# depends : extra-cmake-modules kcrash kdbusaddons kde-deps-installer kdoctools kglobalaccel ki18n kiconthemes kio kitemviews kwindowsystem kxmlgui qt6 sonnet

name=kmenuedit
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/kmenuedit-$version.tar.xz"
options="!checksum"

build() {
    cd "kmenuedit-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
