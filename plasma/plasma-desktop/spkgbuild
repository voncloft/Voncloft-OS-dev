name=plasma-desktop
version=6.8.2
release=3

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz
        browser-live-previews.patch"
options="!checksum"

build() {
    cd "plasma-desktop-$version"
    patch -Np1 -i "$SRC/browser-live-previews.patch"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
