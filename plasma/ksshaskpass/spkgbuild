# description : Graphical password and passphrase prompt for SSH clients and ssh-add
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer kdoctools ki18n kwidgetsaddons qt6 qtkeychain

name=ksshaskpass
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ksshaskpass-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
