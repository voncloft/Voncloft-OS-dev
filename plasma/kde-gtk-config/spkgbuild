# description : Settings and background integration for matching GTK application appearance to Plasma
# depends : extra-cmake-modules glib gsettings-desktop-schemas gtk3 kauth kcodecs kcolorscheme kconfig kcoreaddons kdbusaddons kde-deps-installer kdecoration kguiaddons kwidgetsaddons kwindowsystem pkgconf qt6 sassc

name=kde-gtk-config
version=6.8.1
release=2

source="https://download.kde.org/stable/plasma/$version/kde-gtk-config-$version.tar.xz"
options="!checksum"

build() {
    cd "kde-gtk-config-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
