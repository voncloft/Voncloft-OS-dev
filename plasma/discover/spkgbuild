name=discover
version=6.8.3
release=3

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "discover-$version"
    # Discover plugins also need the private library outside the main process.
    plasma-package-installer -DCMAKE_INSTALL_RPATH=/usr/lib64/plasma-discover
    cd build
    make DESTDIR="$PKG" install
}
