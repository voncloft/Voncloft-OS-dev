# description : Disk health monitoring and failure notifications using SMART information
# depends : extra-cmake-modules kauth kcmutils kcodecs kconfig kcoreaddons kdbusaddons kde-deps-installer kdeclarative ki18n kio knotifications kservice kwidgetsaddons kwindowsystem qt6 solid

name=plasma-disks
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-disks-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
