# description : Breeze visual style for Qt Quick Controls applications
# depends : extra-cmake-modules kcodecs kcolorscheme kconfig kde-deps-installer kguiaddons kiconthemes kirigami qt6

name=qqc2-breeze-style
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "qqc2-breeze-style-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
