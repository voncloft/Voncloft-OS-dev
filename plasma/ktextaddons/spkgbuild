# description : Text editing libraries with features such as translation, text-to-speech, and grammar checking
# depends : breeze-icons extra-cmake-modules karchive kcolorscheme kconfig kcoreaddons kde-deps-installer ki18n kiconthemes kio kitemviews kservice ktextwidgets kwidgetsaddons qt6 qtkeychain sonnet syntax-highlighting

name=ktextaddons
version=2.2.0
release=1

source="https://download.kde.org/stable/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ktextaddons-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
