+    void persistentSession()
+    {
+        const QString externalFile = qEnvironmentVariable("KWIN_LAYOUT_TEST_FILE");
+        if (!externalFile.isEmpty()) {
+            stopMemory();
+            m_memory = std::make_unique<WindowLayoutMemory>(workspace(), externalFile);
+        }
+        const bool reading = qEnvironmentVariable("KWIN_LAYOUT_TEST_PHASE") == QStringLiteral("read");
+        const RectF saved(1420, 150, 740, 520);
+        auto first = client(reading ? QStringLiteral("lights") : QStringLiteral("golf"), reading ? QStringLiteral("Lights") : QStringLiteral("Golf"));
+        auto second = client(QStringLiteral("kasts"), QStringLiteral("Kasts"));
+        auto third = client(reading ? QStringLiteral("golf") : QStringLiteral("lights"), reading ? QStringLiteral("Golf") : QStringLiteral("Lights"));
+        QVERIFY(first && second && third);
+        if (!reading) {
+            position(first.get(), saved, 1);
+            QVERIFY(workspace()->windowTabManager()->groupWindows(second->window, first->window));
+            QVERIFY(workspace()->windowTabManager()->groupWindows(third->window, first->window));
+            first->window->tabGroup()->select(second->window);
+            QTRY_COMPARE(third->window->frameGeometry(), saved);
+            VirtualDesktopManager::self()->save();
+            kwinApp()->config()->sync();
+            m_memory->freeze();
+        } else {
+            QTRY_VERIFY(third->window->tabGroup());
+            auto group = third->window->tabGroup();
+            QCOMPARE(group->windows(), (QList<Window *>{third->window, second->window, first->window}));
+            QCOMPARE(group->current(), second->window.data());
+            for (Window *window : group->windows()) {
+                QTRY_COMPARE(window->frameGeometry(), saved);
+                QCOMPARE(window->desktops(), QList<VirtualDesktop *>{VirtualDesktopManager::self()->desktops()[1]});
+                QVERIFY(!window->skipTaskbar());
+            }
+            m_memory->freeze();
+        }
+    }
+#if KWIN_BUILD_X11
+    void mixedWaylandAndXwaylandRestore()
+    {
+        auto connection = Test::createX11Connection();
+        QVERIFY(!xcb_connection_has_error(connection.get()));
+        xcb_window_t id = XCB_WINDOW_NONE;
+        auto mapLegacy = [&]() -> Window * {
+            const auto screen = xcb_setup_roots_iterator(xcb_get_setup(connection.get())).data;
+            id = xcb_generate_id(connection.get());
+            xcb_create_window(connection.get(), XCB_COPY_FROM_PARENT, id, screen->root,
+                              40, 50, 600, 400, 0, XCB_WINDOW_CLASS_INPUT_OUTPUT,
+                              XCB_COPY_FROM_PARENT, 0, nullptr);
+            const QByteArray klass("legacy\0LegacyLayoutTest\0", 24);
+            xcb_change_property(connection.get(), XCB_PROP_MODE_REPLACE, id, XCB_ATOM_WM_CLASS,
+                                XCB_ATOM_STRING, 8, klass.size(), klass.constData());
+            const QByteArray title("Legacy");
+            xcb_change_property(connection.get(), XCB_PROP_MODE_REPLACE, id, XCB_ATOM_WM_NAME,
+                                XCB_ATOM_STRING, 8, title.size(), title.constData());
+            QSignalSpy added(workspace(), &Workspace::windowAdded);
+            xcb_map_window(connection.get(), id); xcb_flush(connection.get());
+            if (!added.wait()) return nullptr;
+            return added.last().first().value<Window *>();
+        };
+        auto native = client(QStringLiteral("native"), QStringLiteral("Native")); QVERIFY(native);
+        QPointer<Window> legacy = mapLegacy(); QVERIFY(legacy);
+        const RectF saved(1450, 140, 720, 510);
+        position(native.get(), saved, 1);
+        QVERIFY(workspace()->windowTabManager()->groupWindows(legacy, native->window));
+        native->window->tabGroup()->select(legacy);
+        QTRY_COMPARE(legacy->frameGeometry(), saved);
+        stopMemory(); native.reset();
+        xcb_destroy_window(connection.get(), id); xcb_flush(connection.get());
+        QTRY_VERIFY(!legacy);
+        startMemory();
+        legacy = mapLegacy(); QVERIFY(legacy);
+        native = client(QStringLiteral("native"), QStringLiteral("Native")); QVERIFY(native);
+        QTRY_VERIFY(native->window->tabGroup());
+        QCOMPARE(native->window->tabGroup(), legacy->tabGroup());
+        QCOMPARE(legacy->tabGroup()->current(), legacy.data());
+        QTRY_COMPARE(legacy->frameGeometry(), saved);
+        QVERIFY(!legacy->skipTaskbar()); QVERIFY(!native->window->skipTaskbar());
+        m_memory->freeze();
+        xcb_destroy_window(connection.get(), id); xcb_flush(connection.get());
+        QTRY_VERIFY(!legacy);
+    }
+#endif
