+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "windowlayoutmemory.h"
+
+#include "core/output.h"
+#include "rules.h"
+#include "sm.h"
+#include "virtualdesktops.h"
+#include "window.h"
+#include "windowtabgroup.h"
+#include "workspace.h"
+
+#include <QCoreApplication>
+#include <QDateTime>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QSaveFile>
+#include <QScopedValueRollback>
+#include <QStandardPaths>
+#include <QUuid>
+#include <algorithm>
+#include <cmath>
+
+namespace KWin
+{
+static QJsonArray rectJson(const RectF &rect)
+{
+    return {rect.x(), rect.y(), rect.width(), rect.height()};
+}
+
+static RectF readRect(const QJsonValue &value)
+{
+    const auto array = value.toArray();
+    if (array.size() != 4) return {};
+    for (const auto &coordinate : array) {
+        if (!coordinate.isDouble() || !std::isfinite(coordinate.toDouble())
+            || std::abs(coordinate.toDouble()) > 1000000) return {};
+    }
+    return RectF(array[0].toDouble(), array[1].toDouble(), array[2].toDouble(), array[3].toDouble());
+}
+
+WindowLayoutMemory::WindowLayoutMemory(Workspace *workspace, const QString &fileName)
+    : QObject(workspace)
+    , m_workspace(workspace)
+    , m_fileName(fileName.isEmpty()
+                     ? QStandardPaths::writableLocation(QStandardPaths::StateLocation) + QStringLiteral("/kwin-window-layout.json")
+                     : fileName)
+{
+    load();
+    m_restoreTimer.setInterval(100);
+    connect(&m_restoreTimer, &QTimer::timeout, this, &WindowLayoutMemory::processPending);
+    m_saveTimer.setInterval(500);
+    m_saveTimer.setSingleShot(true);
+    connect(&m_saveTimer, &QTimer::timeout, this, &WindowLayoutMemory::save);
+    connect(workspace, &Workspace::windowAdded, this, &WindowLayoutMemory::track);
+    connect(workspace->windowTabManager(), &WindowTabManager::groupsChanged, this, [this] {
+        if (m_frozen || m_applying) return;
+        // Grouping by hand is already a placement decision; do not undo it
+        // while waiting for a newly opened window's identity to settle.
+        for (Window *window : std::as_const(m_windowOrder)) {
+            if (m_pending.contains(window) && window->tabGroup() && !application(window).isEmpty()) {
+                const int found = match(window, true);
+                bind(window, found >= 0 ? found : newRecord(window));
+                capture(window);
+            }
+        }
+        captureGroups();
+        scheduleSave();
+    });
+    connect(workspace->windowTabManager(), &WindowTabManager::tabDetached, this, &WindowLayoutMemory::forgetMembership);
+    connect(workspace->windowTabManager(), &WindowTabManager::tabSelected, this, [this](Window *window) {
+        if (m_frozen || m_applying || !m_bindings.contains(window)) return;
+        captureGroups();
+        const QString groupId = m_liveGroups.value(window->tabGroup());
+        if (m_groups.contains(groupId)) m_groups[groupId].current = m_bindings.value(window);
+        scheduleSave();
+    });
+    connect(workspace, &Workspace::currentDesktopChanged, this, [this] {
+        // Desktop switching first updates visibility and tiling. Reapply an
+        // unfinished resize after those updates, when the client can render.
+        QTimer::singleShot(0, this, &WindowLayoutMemory::finishDeferredRestores);
+    });
+    connect(workspace->sessionManager(), &SessionManager::stateChanged, this, [this] {
+        if (m_workspace->sessionManager()->state() == SessionState::Normal) resume();
+        else freeze();
+    });
+    connect(workspace->sessionManager(), &SessionManager::prepareSessionSaveRequested, this, &WindowLayoutMemory::save);
+    connect(qApp, &QCoreApplication::aboutToQuit, this, &WindowLayoutMemory::freeze);
+    for (Window *window : workspace->windows()) track(window);
+}
+
+WindowLayoutMemory::~WindowLayoutMemory()
+{
+    save();
+}
+
+bool WindowLayoutMemory::eligible(Window *window)
+{
+    return window && !window->isDeleted() && window->isNormalWindow()
+        && !window->isUnmanaged() && !window->isTransient()
+        && !window->isInternal() && !window->isAppletPopup();
+}
+
+QString WindowLayoutMemory::application(Window *window)
+{
+    if (!window->desktopFileName().isEmpty()) return QStringLiteral("desktop:") + window->desktopFileName();
+    if (!window->resourceClass().isEmpty()) return QStringLiteral("class:") + window->resourceClass();
+    return {};
+}
+
+void WindowLayoutMemory::load()
+{
+    QFile file(m_fileName);
+    if (!file.open(QIODevice::ReadOnly) || file.size() > 4 * 1024 * 1024) return;
+    const auto root = QJsonDocument::fromJson(file.readAll()).object();
+    if (root.value(QStringLiteral("version")).toInt() != 1) return;
+    QSet<QString> ids;
+    for (const auto &value : root.value(QStringLiteral("windows")).toArray()) {
+        const auto object = value.toObject();
+        Record record;
+        record.id = object.value(QStringLiteral("id")).toString();
+        record.app = object.value(QStringLiteral("app")).toString();
+        record.role = object.value(QStringLiteral("role")).toString();
+        record.title = object.value(QStringLiteral("title")).toString();
+        record.output = object.value(QStringLiteral("output")).toString();
+        record.outputName = object.value(QStringLiteral("outputName")).toString();
+        record.outputGeometry = readRect(object.value(QStringLiteral("outputGeometry")));
+        record.geometry = readRect(object.value(QStringLiteral("geometry")));
+        record.desktops = object.value(QStringLiteral("desktops")).toVariant().toStringList();
+        record.maximize = object.value(QStringLiteral("maximize")).toInt() & int(MaximizeFull);
+        record.touched = object.value(QStringLiteral("touched")).toInteger();
+        if (record.id.isEmpty() || ids.contains(record.id) || record.app.isEmpty()
+            || !record.geometry.isValid()) continue;
+        ids.insert(record.id);
+        m_records.append(record);
+    }
+    const auto groups = root.value(QStringLiteral("groups")).toObject();
+    QSet<QString> grouped;
+    for (auto it = groups.begin(); it != groups.end(); ++it) {
+        const auto object = it.value().toObject();
+        Group group;
+        for (const auto &value : object.value(QStringLiteral("members")).toArray()) {
+            const auto id = value.toString();
+            if (ids.contains(id) && !grouped.contains(id) && !group.members.contains(id)) group.members.append(id);
+        }
+        if (group.members.size() < 2) continue;
+        for (const auto &id : group.members) grouped.insert(id);
+        group.current = object.value(QStringLiteral("current")).toString();
+        if (!group.members.contains(group.current)) group.current = group.members.first();
+        m_groups.insert(it.key(), group);
+    }
+}
+
+void WindowLayoutMemory::track(Window *window)
+{
+    if (!eligible(window) || m_pending.contains(window) || m_bindings.contains(window)) return;
+    m_pending.insert(window, 0);
+    m_windowOrder.append(window);
+    connect(window, &Window::closed, this, [this, window] { closed(window); });
+    const auto changed = [this, window] {
+        if (!m_applying && !m_frozen) {
+            if (!m_bindings.contains(window) && !m_pending.contains(window) && eligible(window) && !application(window).isEmpty()) {
+                m_pending.insert(window, 0);
+                m_restoreTimer.start();
+            }
+            capture(window);
+            scheduleSave();
+        }
+    };
+    connect(window, &Window::frameGeometryChanged, this, changed);
+    connect(window, &Window::maximizeGeometryRestoreChanged, this, changed);
+    connect(window, &Window::maximizedChanged, this, changed);
+    connect(window, &Window::desktopsChanged, this, changed);
+    connect(window, &Window::desktopsChanged, this, [this, window] {
+        if (!m_applying && !m_frozen) m_deferredRestores.remove(window);
+    });
+    connect(window, &Window::outputChanged, this, changed);
+    connect(window, &Window::captionNormalChanged, this, changed);
+    connect(window, &Window::desktopFileNameChanged, this, changed);
+    connect(window, &Window::windowClassChanged, this, changed);
+    connect(window, &Window::windowRoleChanged, this, changed);
+    connect(window, &Window::decorationChanged, this, [this] {
+        QTimer::singleShot(0, this, &WindowLayoutMemory::restoreGroups);
+    });
+    connect(window, &Window::interactiveMoveResizeStarted, this, [this, window] {
+        m_deferredRestores.remove(window);
+        if (!m_frozen && m_pending.remove(window) && !application(window).isEmpty()) bind(window, newRecord(window));
+    });
+    connect(window, &Window::interactiveMoveResizeFinished, this, [this, window] {
+        // Never snap a window back after the user has already positioned it.
+        m_deferredRestores.remove(window);
+        if (!m_frozen && m_pending.remove(window) && !application(window).isEmpty()) bind(window, newRecord(window));
+        capture(window);
+        scheduleSave();
+    });
+    if (!m_frozen) m_restoreTimer.start();
+}
+
+int WindowLayoutMemory::match(Window *window, bool allowUniqueFallback) const
+{
+    QList<int> candidates;
+    const QString app = application(window);
+    const auto claimed = m_bindings.values();
+    for (int i = 0; i < m_records.size(); ++i) {
+        const auto &record = m_records[i];
+        if (record.app == app && record.role == window->windowRole() && !claimed.contains(record.id)) candidates.append(i);
+    }
+    for (int i : candidates) {
+        if (m_records[i].title == window->captionNormal()) return i;
+    }
+    // Ambiguous windows with different titles must not steal each other's slot.
+    return allowUniqueFallback && candidates.size() == 1 ? candidates.first() : -1;
+}
+
+int WindowLayoutMemory::newRecord(Window *window)
+{
+    Record record;
+    record.id = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    record.app = application(window);
+    record.role = window->windowRole();
+    m_records.append(record);
+    return m_records.size() - 1;
+}
+
+void WindowLayoutMemory::bind(Window *window, int record)
+{
+    m_bindings.insert(window, m_records[record].id);
+    m_pending.remove(window);
+    for (auto it = m_groups.cbegin(); it != m_groups.cend(); ++it) {
+        if (it->members.contains(m_records[record].id)) m_restoredGroups.remove(it.key());
+    }
+}
+
+void WindowLayoutMemory::processPending()
+{
+    if (m_frozen) return;
+    const auto windows = m_windowOrder;
+    for (Window *window : windows) {
+        if (!m_pending.contains(window)) continue;
+        if (!eligible(window)) { m_pending.remove(window); continue; }
+        const int attempt = ++m_pending[window];
+        if (application(window).isEmpty()) {
+            if (attempt >= 30) m_pending.remove(window);
+            continue;
+        }
+        const int found = match(window, attempt >= 10);
+        if (found >= 0) {
+            const auto record = m_records[found];
+            bind(window, found);
+            QScopedValueRollback applying(m_applying, true);
+            restore(window, record);
+        } else if (attempt >= 20) {
+            bind(window, newRecord(window));
+        } else {
+            continue;
+        }
+        capture(window);
+        scheduleSave();
+    }
+    restoreGroups();
+    if (m_pending.isEmpty()) m_restoreTimer.stop();
+}
+
+void WindowLayoutMemory::capture(Window *window)
+{
+    if (m_frozen || m_applying || !eligible(window) || !m_bindings.contains(window)) return;
+    auto it = std::find_if(m_records.begin(), m_records.end(), [&](const Record &record) { return record.id == m_bindings.value(window); });
+    if (it == m_records.end() || !window->moveResizeOutput()) return;
+    it->app = application(window);
+    it->role = window->windowRole();
+    it->title = window->captionNormal();
+    if (m_deferredRestores.contains(window)) return;
+    auto output = window->moveResizeOutput();
+    it->output = output->uuid();
+    it->outputName = output->name();
+    it->outputGeometry = output->geometry();
+    auto geometry = window->moveResizeGeometry();
+    if (window->isFullScreen() && window->fullscreenGeometryRestore().isValid()) geometry = window->fullscreenGeometryRestore();
+    else if (window->requestedMaximizeMode() != MaximizeRestore && window->geometryRestore().isValid()) geometry = window->geometryRestore();
+    it->geometry = geometry;
+    it->desktops = window->desktopIds();
+    it->maximize = int(window->requestedMaximizeMode());
+    it->touched = QDateTime::currentMSecsSinceEpoch();
+}
+
+void WindowLayoutMemory::restore(Window *window, const Record &record)
+{
+    auto output = window->moveResizeOutput();
+    for (auto candidate : m_workspace->outputs()) {
+        if (candidate->uuid() == record.output) { output = candidate; break; }
+        if (candidate->name() == record.outputName) output = candidate;
+    }
+    output = window->rules()->checkOutput(output, true);
+    if (!output) return;
+    window->sendToOutput(output);
+    QList<VirtualDesktop *> desktops;
+    for (const auto &id : record.desktops) {
+        if (auto desktop = VirtualDesktopManager::self()->desktopForId(id)) desktops.append(desktop);
+    }
+    // An empty saved list means "all desktops"; a removed desktop falls back
+    // to the current desktop instead of accidentally becoming sticky.
+    if (record.desktops.isEmpty() || !desktops.isEmpty()) window->setDesktops(window->rules()->checkDesktops(desktops, true));
+    auto area = m_workspace->clientArea(PlacementArea, window, output);
+    auto geometry = record.geometry;
+    if (record.outputGeometry.isValid()) geometry.translate(output->geometry().topLeft() - record.outputGeometry.topLeft());
+    QSizeF size = geometry.size().boundedTo(area.size());
+    size = window->constrainFrameSize(window->rules()->checkSize(size, true));
+    geometry.setSize(size);
+    geometry.moveTopLeft(QPointF(std::clamp(geometry.x(), area.left(), qMax(area.left(), area.right() - geometry.width())),
+                                std::clamp(geometry.y(), area.top(), qMax(area.top(), area.bottom() - geometry.height()))));
+    geometry = window->rules()->checkGeometrySafe(geometry, true);
+    window->maximize(window->rules()->checkMaximize(MaximizeRestore, true));
+    window->moveResize(geometry);
+    window->setGeometryRestore(geometry);
+    window->maximize(window->rules()->checkMaximize(MaximizeMode(record.maximize), true));
+    if (!window->isOnCurrentDesktop()) {
+        // Suspended Wayland clients may acknowledge a configure with their
+        // old buffer size. Do not let that overwrite the remembered size.
+        m_deferredRestores.insert(window, record);
+    }
+}
+
+void WindowLayoutMemory::finishDeferredRestores()
+{
+    if (m_frozen || m_applying) return;
+    for (Window *window : m_deferredRestores.keys()) {
+        if (!eligible(window) || !window->isOnCurrentDesktop()) continue;
+        const auto record = m_deferredRestores.take(window);
+        {
+            QScopedValueRollback applying(m_applying, true);
+            restore(window, record);
+        }
+        capture(window);
+    }
+    scheduleSave();
+}
+
+void WindowLayoutMemory::watchGroup(WindowTabGroup *group, const QString &id)
+{
+    if (m_liveGroups.contains(group)) return;
+    m_liveGroups.insert(group, id);
+    connect(group, &QObject::destroyed, this, [this, group] {
+        m_liveGroups.remove(group);
+        // Runtime groups disappear on close; saved membership survives. A new
+        // bind retries restoration, without looping on incompatible clients.
+    });
+}
+
+void WindowLayoutMemory::restoreGroups()
+{
+    if (m_frozen || m_applying) return;
+    QScopedValueRollback applying(m_applying, true);
+    for (auto it = m_groups.cbegin(); it != m_groups.cend(); ++it) {
+        if (m_restoredGroups.contains(it.key())) continue;
+        QList<Window *> members;
+        Window *selected = nullptr;
+        bool waitingForDecoration = false;
+        for (const auto &id : it->members) {
+            Window *window = m_bindings.key(id, nullptr);
+            if (!eligible(window)) continue;
+            if (!WindowTabManager::canGroup(window)) { waitingForDecoration = true; continue; }
+            if (window->tabGroup() && m_liveGroups.value(window->tabGroup()) != it.key()) { members.clear(); break; }
+            if (!members.isEmpty() && (window->desktops() != members.first()->desktops()
+                                      || window->moveResizeOutput() != members.first()->moveResizeOutput()
+                                      || (!(window->tabGroup() && window->tabGroup() == members.first()->tabGroup())
+                                          && !WindowTabManager::canGroupWith(window, members.first())))) { members.clear(); break; }
+            members.append(window);
+            if (id == it->current) selected = window;
+        }
+        // Any two available members can reunite. Missing applications retain
+        // their slots and join in the saved order when they reopen later.
+        if (members.size() < 2) continue;
+        if (members.first()->tabGroup() && members.first()->tabGroup()->windows() == members) {
+            if (!waitingForDecoration) m_restoredGroups.insert(it.key());
+            continue;
+        }
+        QSizeF minimum = members.first()->minSize();
+        QSizeF maximum = members.first()->maxSize();
+        for (Window *member : members) {
+            minimum = minimum.expandedTo(member->minSize());
+            maximum = maximum.boundedTo(member->maxSize());
+        }
+        if (minimum.width() > maximum.width() || minimum.height() > maximum.height()) continue;
+        Window *first = members.first();
+        bool complete = true;
+        for (int i = 1; i < members.size(); ++i) {
+            if (!m_workspace->windowTabManager()->groupWindows(members[i], first, false)) { complete = false; break; }
+        }
+        if (first->tabGroup()) {
+            watchGroup(first->tabGroup(), it.key());
+            first->tabGroup()->setOrder(members);
+            Window *current = selected ? selected : first;
+            const bool activeMember = members.contains(m_workspace->activeWindow());
+            first->tabGroup()->select(current, activeMember && current->isOnCurrentDesktop());
+            if (activeMember && m_workspace->activeWindow() && !m_workspace->activeWindow()->isShown()) {
+                m_workspace->activateNextWindow(m_workspace->activeWindow());
+            }
+        }
+        if (complete && !waitingForDecoration) m_restoredGroups.insert(it.key());
+    }
+}
+
+void WindowLayoutMemory::captureGroups()
+{
+    QSet<WindowTabGroup *> seen;
+    for (Window *window : m_bindings.keys()) {
+        auto group = window->tabGroup();
+        if (!group || seen.contains(group)) continue;
+        seen.insert(group);
+        QStringList liveMembers;
+        bool complete = true;
+        for (Window *member : group->windows()) {
+            if (!m_bindings.contains(member)) { complete = false; break; }
+            liveMembers.append(m_bindings.value(member));
+        }
+        if (!complete || liveMembers.size() < 2) continue;
+        QString id = m_liveGroups.value(group);
+        if (id.isEmpty()) {
+            id = QUuid::createUuid().toString(QUuid::WithoutBraces);
+            watchGroup(group, id);
+        }
+        Group saved = m_groups.value(id);
+        if (saved.members.isEmpty()) saved.members = liveMembers;
+        // Merging live groups also keeps their temporarily closed members.
+        for (auto it = m_groups.begin(); it != m_groups.end();) {
+            if (it.key() != id && std::any_of(liveMembers.cbegin(), liveMembers.cend(), [&](const QString &member) { return it->members.contains(member); })) {
+                for (const auto &member : it->members) if (!saved.members.contains(member)) saved.members.append(member);
+                m_restoredGroups.remove(it.key());
+                it = m_groups.erase(it);
+                continue;
+            }
+            ++it;
+        }
+        for (const auto &member : liveMembers) if (!saved.members.contains(member)) saved.members.append(member);
+        if (!saved.members.contains(saved.current) || liveMembers.contains(saved.current)) saved.current = m_bindings.value(group->current());
+        m_groups.insert(id, saved);
+    }
+}
+
+void WindowLayoutMemory::forgetMembership(Window *window)
+{
+    if (m_frozen || m_applying) return;
+    captureGroups();
+    const QString id = m_bindings.value(window);
+    for (auto it = m_groups.begin(); it != m_groups.end();) {
+        it->members.removeAll(id);
+        if (it->members.size() < 2) it = m_groups.erase(it);
+        else {
+            if (it->current == id) it->current = it->members.first();
+            ++it;
+        }
+    }
+    scheduleSave();
+}
+
+void WindowLayoutMemory::closed(Window *window)
+{
+    if (!m_frozen) captureGroups();
+    const QString id = m_bindings.take(window);
+    m_pending.remove(window);
+    m_windowOrder.removeAll(window);
+    m_deferredRestores.remove(window);
+    if (m_frozen) return;
+    for (auto it = m_groups.cbegin(); it != m_groups.cend(); ++it) {
+        if (it->members.contains(id)) m_restoredGroups.remove(it.key());
+    }
+    scheduleSave();
+}
+
+void WindowLayoutMemory::scheduleSave()
+{
+    if (!m_frozen && !m_applying) m_saveTimer.start();
+}
+
+void WindowLayoutMemory::save()
+{
+    if (m_frozen || m_applying) return;
+    m_saveTimer.stop();
+    for (Window *window : m_bindings.keys()) capture(window);
+    captureGroups();
+    // Retain useful closed-window history without unbounded growth.
+    if (m_records.size() > 512) {
+        auto live = m_bindings.values();
+        for (const auto &group : std::as_const(m_groups)) live.append(group.members);
+        std::stable_sort(m_records.begin(), m_records.end(), [&](const Record &a, const Record &b) {
+            if (live.contains(a.id) != live.contains(b.id)) return live.contains(a.id);
+            return a.touched > b.touched;
+        });
+        while (m_records.size() > 512 && !live.contains(m_records.last().id)) m_records.removeLast();
+    }
+    QJsonArray windows;
+    QSet<QString> ids;
+    for (const auto &record : std::as_const(m_records)) {
+        if (!record.geometry.isValid()) continue;
+        ids.insert(record.id);
+        windows.append(QJsonObject{{QStringLiteral("id"), record.id}, {QStringLiteral("app"), record.app},
+            {QStringLiteral("role"), record.role}, {QStringLiteral("title"), record.title},
+            {QStringLiteral("output"), record.output}, {QStringLiteral("outputName"), record.outputName},
+            {QStringLiteral("outputGeometry"), rectJson(record.outputGeometry)}, {QStringLiteral("geometry"), rectJson(record.geometry)},
+            {QStringLiteral("desktops"), QJsonArray::fromStringList(record.desktops)},
+            {QStringLiteral("maximize"), record.maximize}, {QStringLiteral("touched"), record.touched}});
+    }
+    QJsonObject groups;
+    for (auto it = m_groups.cbegin(); it != m_groups.cend(); ++it) {
+        if (std::all_of(it->members.cbegin(), it->members.cend(), [&](const QString &id) { return ids.contains(id); })) {
+            groups.insert(it.key(), QJsonObject{{QStringLiteral("members"), QJsonArray::fromStringList(it->members)}, {QStringLiteral("current"), it->current}});
+        }
+    }
+    QDir().mkpath(QFileInfo(m_fileName).absolutePath());
+    QSaveFile file(m_fileName);
+    if (!file.open(QIODevice::WriteOnly)) return;
+    file.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+    const auto data = QJsonDocument(QJsonObject{{QStringLiteral("version"), 1}, {QStringLiteral("windows"), windows}, {QStringLiteral("groups"), groups}}).toJson();
+    if (file.write(data) != data.size()) { file.cancelWriting(); return; }
+    file.commit();
+}
+
+void WindowLayoutMemory::freeze()
+{
+    if (m_frozen) return;
+    for (auto it = m_pending.begin(); it != m_pending.end(); ++it) it.value() = 30;
+    processPending();
+    save();
+    m_frozen = true;
+    m_saveTimer.stop();
+    m_restoreTimer.stop();
+}
+
+void WindowLayoutMemory::resume()
+{
+    m_frozen = false;
+    finishDeferredRestores();
+    if (!m_pending.isEmpty()) m_restoreTimer.start();
+    scheduleSave();
+}
+}
