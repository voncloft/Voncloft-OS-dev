+    void savedGroupsSurviveHistoryPruning()
+    {
+        auto a = client(QStringLiteral("one"), QStringLiteral("One"));
+        auto b = client(QStringLiteral("two"), QStringLiteral("Two")); QVERIFY(a && b);
+        QVERIFY(workspace()->windowTabManager()->groupWindows(b->window, a->window));
+        m_memory->save();
+        a.reset(); b.reset();
+        QTRY_VERIFY(waylandServer()->windows().isEmpty());
+        stopMemory();
+        auto root = state();
+        auto records = root.value(QStringLiteral("windows")).toArray();
+        for (int i = 0; i < 600; ++i) {
+            auto record = records.first().toObject();
+            record.insert(QStringLiteral("id"), QStringLiteral("old-%1").arg(i));
+            record.insert(QStringLiteral("app"), QStringLiteral("desktop:old-%1").arg(i));
+            record.insert(QStringLiteral("touched"), double(9000000000000LL + i));
+            records.append(record);
+        }
+        root.insert(QStringLiteral("windows"), records);
+        QFile file(path()); QVERIFY(file.open(QIODevice::WriteOnly));
+        file.write(QJsonDocument(root).toJson()); file.close();
+        startMemory(); m_memory->save();
+        QCOMPARE(state().value(QStringLiteral("windows")).toArray().size(), 512);
+        QCOMPARE(state().value(QStringLiteral("groups")).toObject().size(), 1);
+        b = client(QStringLiteral("two"), QStringLiteral("Two"));
+        a = client(QStringLiteral("one"), QStringLiteral("One")); QVERIFY(a && b);
+        QTRY_VERIFY(a->window->tabGroup());
+        QCOMPARE(a->window->tabGroup(), b->window->tabGroup());
+        m_memory->freeze();
+    }
