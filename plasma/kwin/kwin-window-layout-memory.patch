+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "core/rect.h"
+#include "kwin_export.h"
+
+#include <QHash>
+#include <QMap>
+#include <QObject>
+#include <QPointer>
+#include <QSet>
+#include <QStringList>
+#include <QTimer>
+
+namespace KWin
+{
+class Window;
+class WindowTabGroup;
+class Workspace;
+
+// Compositor-owned placement history. Application session restore launches
+// clients; this class places their normal windows and reunites saved tab groups.
+class KWIN_EXPORT WindowLayoutMemory : public QObject
+{
+    Q_OBJECT
+public:
+    explicit WindowLayoutMemory(Workspace *workspace, const QString &fileName = {});
+    ~WindowLayoutMemory() override;
+    void save();
+    void freeze();
+    void resume();
+
+private:
+    struct Record {
+        QString id;
+        QString app;
+        QString role;
+        QString title;
+        QString output;
+        QString outputName;
+        RectF outputGeometry;
+        RectF geometry;
+        QStringList desktops;
+        int maximize = 0;
+        qint64 touched = 0;
+    };
+    struct Group {
+        QStringList members;
+        QString current;
+    };
+    static bool eligible(Window *window);
+    static QString application(Window *window);
+    void load();
+    void track(Window *window);
+    void processPending();
+    void bind(Window *window, int record);
+    int match(Window *window, bool allowUniqueFallback) const;
+    int newRecord(Window *window);
+    void capture(Window *window);
+    void restore(Window *window, const Record &record);
+    void finishDeferredRestores();
+    void restoreGroups();
+    void captureGroups();
+    void forgetMembership(Window *window);
+    void watchGroup(WindowTabGroup *group, const QString &id);
+    void scheduleSave();
+    void closed(Window *window);
+
+    Workspace *m_workspace;
+    QString m_fileName;
+    QList<Record> m_records;
+    QMap<QString, Group> m_groups;
+    QHash<Window *, QString> m_bindings;
+    QHash<Window *, int> m_pending;
+    QList<Window *> m_windowOrder;
+    QHash<Window *, Record> m_deferredRestores;
+    QHash<WindowTabGroup *, QString> m_liveGroups;
+    QSet<QString> m_restoredGroups;
+    QTimer m_restoreTimer;
+    QTimer m_saveTimer;
+    bool m_frozen = false;
+    bool m_applying = false;
+};
+}
