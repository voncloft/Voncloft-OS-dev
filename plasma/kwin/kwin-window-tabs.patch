+    void backgroundClientResizes()
+    {
+        auto a = createClient(); auto b = createClient(); QVERIFY(a && b);
+        group(a.get(), b.get());
+        const auto geometry = b->window->frameGeometry();
+        // A background client can commit its own preferred size, for example
+        // Konsole restoring its character grid after leaving maximized mode.
+        a->size = QSize(620, 350);
+        Test::render(a->surface.get(), a->size, Qt::blue);
+        QTRY_COMPARE(a->size, b->size);
+        QTRY_COMPARE(a->window->frameGeometry(), geometry);
+        QVERIFY(a->window->isHidden());
+
+        // If the client refuses configure sizes, detach it safely instead of
+        // looping forever or leaving it hidden with an unusable frame.
+        a->ignoreResize = true;
+        a->size = QSize(650, 360);
+        Test::render(a->surface.get(), a->size, Qt::blue);
+        QTRY_VERIFY(!a->window->tabGroup());
+        QVERIFY(a->window->isShown());
+        QVERIFY(b->window->isShown());
+    }
+    void geometryAndState()
+    {
+        auto a = createClient(); auto b = createClient(); QVERIFY(a && b);
+        group(a.get(), b.get());
+        b->window->moveResize(RectF(100, 140, 700, 450));
+        QTRY_COMPARE(b->window->frameGeometry(), RectF(100, 140, 700, 450));
+        QTRY_COMPARE(a->window->frameGeometry(), b->window->frameGeometry());
+        b->window->setMinimized(true);
+        QVERIFY(a->window->isMinimized()); QVERIFY(b->window->isMinimized());
+        workspace()->activateWindow(a->window);
+        QVERIFY(!a->window->isMinimized()); QVERIFY(!b->window->isMinimized());
+        const auto restoredGeometry = a->window->frameGeometry();
+        a->window->maximize(MaximizeFull);
+        QTRY_COMPARE(a->window->maximizeMode(), MaximizeFull);
+        QTRY_COMPARE(b->window->maximizeMode(), MaximizeFull);
+        QTRY_COMPARE(a->window->frameGeometry(), b->window->frameGeometry());
+        a->window->tabGroup()->select(b->window);
+        b->window->maximize(MaximizeRestore);
+        QTRY_COMPARE(a->window->maximizeMode(), MaximizeRestore);
+        QTRY_COMPARE(b->window->maximizeMode(), MaximizeRestore);
+        QTRY_COMPARE(a->window->frameGeometry(), b->window->frameGeometry());
+        QTRY_COMPARE(b->window->frameGeometry(), restoredGeometry);
+        b->window->setQuickTileModeAtCurrentPosition(QuickTileFlag::Left);
+        QTRY_COMPARE(a->window->quickTileMode(), QuickTileMode(QuickTileFlag::Left));
+        QTRY_COMPARE(a->window->frameGeometry(), b->window->frameGeometry());
+        b->window->tabGroup()->select(a->window);
+        a->window->setQuickTileModeAtCurrentPosition(QuickTileFlag::None);
+        QTRY_COMPARE(b->window->quickTileMode(), QuickTileMode(QuickTileFlag::None));
+        QTRY_COMPARE(a->window->frameGeometry(), restoredGeometry);
+        a->window->tabGroup()->select(b->window);
+        b->window->moveResize(RectF(1400, 120, 700, 450));
+        QTRY_COMPARE(a->window->frameGeometry(), b->window->frameGeometry());
+        QTRY_COMPARE(a->window->output(), b->window->output());
+        b->window->tabGroup()->cycle(1);
+        QTRY_COMPARE(a->window->frameGeometry(), b->window->frameGeometry());
+        a->window->tabGroup()->select(b->window);
+        b->window->setKeepAbove(true);
+        QVERIFY(a->window->keepAbove());
+        b->window->setDesktops({VirtualDesktopManager::self()->desktops().last()});
+        QCOMPARE(a->window->desktops(), b->window->desktops());
+        b->window->setDesktops({VirtualDesktopManager::self()->desktops().first()});
+        b->window->setFullScreen(true);
+        QTRY_VERIFY(a->window->isFullScreen());
+        QTRY_VERIFY(b->window->isFullScreen());
+        b->window->tabGroup()->select(a->window);
+        a->window->setFullScreen(false);
+        QTRY_VERIFY(!b->window->isFullScreen());
+        QTRY_VERIFY(qobject_cast<Decoration::TabbedDecoration *>(a->window->decoration()));
+        QTRY_COMPARE(a->window->frameGeometry(), b->window->frameGeometry());
+    }
+    void detachRestoresWindows()
+    {
+        auto a = createClient(); auto b = createClient(); QVERIFY(a && b);
+        a->window->setSkipPager(true);
+        group(a.get(), b.get());
+        b->window->tabGroup()->remove(b->window);
+        QVERIFY(!a->window->tabGroup()); QVERIFY(!b->window->tabGroup());
+        QVERIFY(!a->window->isHidden()); QVERIFY(!b->window->isHidden());
+        QVERIFY(!a->window->skipTaskbar()); QVERIFY(!b->window->skipTaskbar());
+        QVERIFY(a->window->skipPager()); QVERIFY(!b->window->skipPager());
+        QTRY_VERIFY(a->window->decoration() && !qobject_cast<Decoration::TabbedDecoration *>(a->window->decoration()));
+        QTRY_VERIFY(b->window->decoration() && !qobject_cast<Decoration::TabbedDecoration *>(b->window->decoration()));
+    }
