+            Test::keyboardKeyPressed(KEY_LEFTCTRL, time++);
+            Test::keyboardKeyPressed(key, time++);
+            Test::keyboardKeyReleased(key, time++);
+            Test::keyboardKeyReleased(KEY_LEFTCTRL, time++);
+            Test::keyboardKeyReleased(KEY_LEFTMETA, time++);
+        };
+        shortcut(KEY_G);
+        QTRY_VERIFY(input()->isSelectingWindow());
+        Test::keyboardKeyPressed(KEY_ESC, time++);
+        Test::keyboardKeyReleased(KEY_ESC, time++);
+        QTRY_VERIFY(!input()->isSelectingWindow());
+        QVERIFY(!a->window->tabGroup());
+        shortcut(KEY_G);
+        QTRY_VERIFY(input()->isSelectingWindow());
+        Test::pointerMotion(b->window->frameGeometry().center(), time++);
+        Test::pointerButtonPressed(BTN_LEFT, time++);
+        Test::pointerButtonReleased(BTN_LEFT, time++);
+        QTRY_VERIFY(a->window->tabGroup());
+        QCOMPARE(a->window->tabGroup(), b->window->tabGroup());
+        QTRY_COMPARE(workspace()->activeWindow(), b->window.data());
+        shortcut(KEY_TAB);
+        QTRY_COMPARE(workspace()->activeWindow(), a->window.data());
+        shortcut(KEY_U);
+        QTRY_VERIFY(!a->window->tabGroup());
+        QVERIFY(!b->window->tabGroup());
+        QVERIFY(a->window->isShown()); QVERIFY(b->window->isShown());
