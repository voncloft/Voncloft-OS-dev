+    void realKateAndKonsole()
+    {
+        if (!qEnvironmentVariableIsSet("KWIN_TABS_REAL_APPS")) {
+            QSKIP("Set KWIN_TABS_REAL_APPS=1 for the installed Kate/Konsole smoke test");
+        }
+        QTemporaryDir data;
+        QVERIFY(data.isValid());
+        QFile document(data.filePath("window-tabs.txt"));
+        QVERIFY(document.open(QIODevice::WriteOnly));
+        document.write("Kate and Konsole: native KWin window tab test.\n");
+        document.close();
+        auto env = QProcessEnvironment::systemEnvironment();
+        env.insert("WAYLAND_DISPLAY", waylandServer()->socketName());
+        env.insert("QT_QPA_PLATFORM", "wayland");
+        env.insert("XDG_CONFIG_HOME", data.filePath("config"));
+        env.insert("XDG_DATA_HOME", data.filePath("data"));
+        env.insert("XDG_CACHE_HOME", data.filePath("cache"));
+        env.remove("SESSION_MANAGER");
+        QProcess kate, konsole;
+        kate.setProcessEnvironment(env); konsole.setProcessEnvironment(env);
+        kate.start("/usr/bin/kate", {"--new", "--startanon", document.fileName()});
+        konsole.start("/usr/bin/konsole", {"--separate", "--builtin-profile", "--workdir", data.path(), "-e", "/bin/sleep", "120"});
+        QVERIFY(kate.waitForStarted()); QVERIFY(konsole.waitForStarted());
+        auto findWindow = [](qint64 pid) -> Window * {
+            for (Window *window : workspace()->windows()) {
+                if (window->pid() == pid && window->isNormalWindow()) return window;
+            }
+            return nullptr;
+        };
+        QTRY_VERIFY_WITH_TIMEOUT(findWindow(kate.processId()), 15000);
+        QTRY_VERIFY_WITH_TIMEOUT(findWindow(konsole.processId()), 15000);
+        QPointer<Window> editor = findWindow(kate.processId());
+        QPointer<Window> terminal = findWindow(konsole.processId());
+        workspace()->activateWindow(editor);
+        Test::pointerMotion(QPointF(editor->frameGeometry().center().x(), editor->y() + 10), 300);
+        Test::pointerButtonPressed(BTN_RIGHT, 301);
+        Test::pointerButtonReleased(BTN_RIGHT, 302);
+        QTRY_VERIFY(workspace()->userActionsMenu()->isShown());
+        QVERIFY(workspace()->userActionsMenu()->isMenuWindow(editor));
+        QMenu *menu = openTabMenu(editor); QVERIFY(menu);
+        QAction *target = menuAction(menu, terminal->caption().replace(QLatin1Char('&'), QStringLiteral("&&")));
+        QVERIFY(target);
+        if (qEnvironmentVariableIsSet("KWIN_TABS_MENU_PREVIEW")) {
+            QList<QMenu *> menus;
+            QRect bounds;
+            for (QWidget *widget : QApplication::topLevelWidgets()) {
+                if (auto visibleMenu = qobject_cast<QMenu *>(widget); visibleMenu && visibleMenu->isVisible()) {
+                    menus.append(visibleMenu);
+                    bounds = bounds.united(visibleMenu->geometry());
+                }
+            }
+            QImage preview(bounds.size(), QImage::Format_ARGB32_Premultiplied);
+            preview.fill(Qt::transparent);
+            QPainter painter(&preview);
+            for (QMenu *visibleMenu : menus) visibleMenu->render(&painter, visibleMenu->pos() - bounds.topLeft());
+            painter.end();
+            QVERIFY(preview.save(qEnvironmentVariable("KWIN_TABS_MENU_PREVIEW")));
+        }
+        QTest::mouseClick(menu, Qt::LeftButton, Qt::NoModifier, menu->actionGeometry(target).center());
+        QTRY_VERIFY(editor->tabGroup());
+        QCOMPARE(editor->tabGroup(), terminal->tabGroup());
+        QTRY_VERIFY(!workspace()->userActionsMenu()->hasWindow());
+        QTRY_VERIFY(qobject_cast<Decoration::TabbedDecoration *>(editor->decoration()));
+        QTRY_VERIFY(qobject_cast<Decoration::TabbedDecoration *>(terminal->decoration()));
+        QTRY_COMPARE(editor->frameGeometry(), terminal->frameGeometry());
+        terminal->moveResize(RectF(80, 90, 900, 650));
+        QTRY_COMPARE(terminal->frameGeometry(), RectF(80, 90, 900, 650));
+        QTRY_COMPARE(editor->frameGeometry(), terminal->frameGeometry());
+        for (int i = 0; i < 10; ++i) {
+            editor->tabGroup()->cycle(1);
+            QTRY_COMPARE(workspace()->activeWindow(), editor->tabGroup()->current());
+        }
+        terminal->setMinimized(true);
+        QTRY_VERIFY(editor->isMinimized());
+        workspace()->activateWindow(editor);
+        QTRY_VERIFY(!terminal->isMinimized());
+        editor->maximize(MaximizeFull);
+        QTRY_COMPARE(editor->maximizeMode(), MaximizeFull);
+        QTRY_COMPARE(terminal->maximizeMode(), MaximizeFull);
+        editor->maximize(MaximizeRestore);
+        QTRY_COMPARE(terminal->maximizeMode(), MaximizeRestore);
+        QTRY_COMPARE(editor->frameGeometry(), terminal->frameGeometry());
+        QVERIFY(editor->tabGroup());
+        if (qEnvironmentVariableIsSet("KWIN_TABS_PREVIEW")) {
+            QImage preview(QSize(qCeil(editor->width()), qCeil(editor->frameMargins().top())), QImage::Format_ARGB32_Premultiplied);
+            preview.fill(Qt::transparent);
+            QPainter painter(&preview);
+            editor->decoration()->paint(&painter, QRectF(QPointF(), preview.size()));
+            painter.end();
+            QVERIFY(preview.save(qEnvironmentVariable("KWIN_TABS_PREVIEW")));
+        }
+        editor->tabGroup()->remove(editor);
+        QVERIFY(!editor->tabGroup()); QVERIFY(!terminal->tabGroup());
+        QVERIFY(editor->isShown()); QVERIFY(terminal->isShown());
+        QVERIFY(workspace()->windowTabManager()->groupWindows(editor, terminal));
+        kate.terminate();
+        QTRY_COMPARE(kate.state(), QProcess::NotRunning);
+        QTRY_VERIFY(!terminal->tabGroup());
+        QVERIFY(terminal->isShown());
+        konsole.terminate();
+        QTRY_COMPARE(konsole.state(), QProcess::NotRunning);
+    }
+    void modalRevealsParent()
+    {
+        auto a = createClient(); auto b = createClient(); QVERIFY(a && b);
+        group(a.get(), b.get());
+        auto dialog = createClient(a->shell.get()); QVERIFY(dialog);
+        workspace()->activateWindow(dialog->window);
+        QCOMPARE(a->window->tabGroup()->current(), a->window.data());
+        QVERIFY(a->window->isShown());
+        QVERIFY(!WindowTabManager::canGroup(dialog->window));
+        a->window->tabGroup()->select(b->window);
+        QVERIFY(dialog->window->isHidden());
+        workspace()->activateWindow(dialog->window);
+        QVERIFY(!dialog->window->isHidden());
+        QCOMPARE(a->window->tabGroup()->current(), a->window.data());
+    }
