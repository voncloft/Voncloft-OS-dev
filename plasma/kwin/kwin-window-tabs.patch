+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "tabbeddecoration.h"
+#include "window.h"
+#include "windowtabgroup.h"
+
+#include <KDecoration3/DecoratedWindow>
+#include <KDecoration3/DecorationSettings>
+#include <QApplication>
+#include <QFontMetricsF>
+#include <QHoverEvent>
+#include <QMouseEvent>
+#include <QPainter>
+#include <QWheelEvent>
+#include <cmath>
+
+namespace KWin::Decoration {
+namespace {
+constexpr int MinimizeButton = -2;
+constexpr int MaximizeButton = -3;
+constexpr int CloseButton = -4;
+constexpr qreal ButtonWidth = 30;
+constexpr qreal DragHandle = 20;
+}
+TabbedDecoration::TabbedDecoration(Window *window, const QVariantList &args)
+    : KDecoration3::Decoration(window, args), m_window(window), m_group(window->tabGroup())
+{
+}
+qreal TabbedDecoration::tabHeight() const
+{
+    return std::ceil(std::max<qreal>(30, QFontMetricsF(settings()->font()).height() + 12));
+}
+bool TabbedDecoration::init()
+{
+    setOpaque(true);
+    connect(window(), &KDecoration3::DecoratedWindow::widthChanged, this, &TabbedDecoration::relayout);
+    connect(window(), &KDecoration3::DecoratedWindow::maximizedChanged, this, &TabbedDecoration::relayout);
+    connect(window(), &KDecoration3::DecoratedWindow::activeChanged, this, [this] { update(); });
+    connect(window(), &KDecoration3::DecoratedWindow::paletteChanged, this, [this] { update(); });
+    connect(settings().get(), &KDecoration3::DecorationSettings::reconfigured, this, &TabbedDecoration::relayout);
+    if (m_group) {
+        connect(m_group, &WindowTabGroup::changed, this, [this] { update(); });
+    }
+    relayout();
+    return true;
+}
+void TabbedDecoration::relayout()
+{
+    const qreal edge = window()->isMaximized() ? 0 : 3;
+    setBorders(QMarginsF(edge, tabHeight(), edge, edge));
+    setResizeOnlyBorders(QMarginsF(5, 0, 5, 5));
+    setTitleBar(QRectF(0, 0, size().width(), tabHeight()));
+    update();
+}
+QRectF TabbedDecoration::tabRect(int index) const
+{
+    const int count = m_group ? m_group->windows().size() : 0;
+    const qreal usable = std::max<qreal>(1, size().width() - DragHandle - 3 * ButtonWidth);
+    const qreal width = usable / std::max(1, count);
+    return QRectF(DragHandle + index * width, 0, width, tabHeight());
+}
+int TabbedDecoration::hitTest(const QPointF &point) const
+{
+    if (point.y() < 0 || point.y() >= tabHeight() || point.x() < 0 || point.x() >= size().width()) {
+        return -1;
+    }
+    if (point.x() >= size().width() - ButtonWidth) return CloseButton;
+    if (point.x() >= size().width() - 2 * ButtonWidth) return MaximizeButton;
+    if (point.x() >= size().width() - 3 * ButtonWidth) return MinimizeButton;
+    if (m_group) {
+        const auto tabs = m_group->windows();
+        for (int i = 0; i < tabs.size(); ++i) {
+            if (tabRect(i).contains(point)) return i;
+        }
+    }
+    return -1;
+}
+void TabbedDecoration::paint(QPainter *painter, const QRectF &repaintArea)
+{
+    const auto palette = window()->palette();
+    const auto colorGroup = window()->isActive() ? QPalette::Active : QPalette::Inactive;
+    painter->save();
+    painter->setClipRect(repaintArea);
+    painter->setRenderHint(QPainter::Antialiasing);
+    painter->fillRect(rect(), palette.color(colorGroup, QPalette::Window));
+    painter->setFont(settings()->font());
+    painter->setPen(palette.color(colorGroup, QPalette::Mid));
+    painter->drawRect(rect().adjusted(.5, .5, -.5, -.5));
+    if (m_group) {
+        const auto tabs = m_group->windows();
+        for (int i = 0; i < tabs.size(); ++i) {
+            const QRectF tab = tabRect(i).adjusted(1, 2, -1, -2);
+            const bool selected = tabs[i] == m_group->current();
+            QColor background = palette.color(colorGroup, selected ? QPalette::Highlight : QPalette::Button);
+            if (m_hovered == i && !selected) background = background.lighter(112);
+            painter->fillRect(tab, background);
+            painter->setPen(palette.color(colorGroup, selected ? QPalette::HighlightedText : QPalette::ButtonText));
+            const QRectF label = tab.adjusted(7, 0, -7, 0);
+            const QString caption = painter->fontMetrics().elidedText(tabs[i]->caption(), Qt::ElideRight, qMax(0, int(label.width())));
+            painter->drawText(label, Qt::AlignVCenter | Qt::AlignLeft, caption);
+        }
+    }
+    for (int button = 0; button < 3; ++button) {
+        const int id = MinimizeButton - button;
+        const QRectF area(size().width() - (3 - button) * ButtonWidth, 0, ButtonWidth, tabHeight());
+        if (m_hovered == id) {
+            painter->fillRect(area, button == 2 ? QColor(190, 45, 45) : palette.color(colorGroup, QPalette::Midlight));
+        }
+        painter->setPen(QPen(button == 2 && m_hovered == id ? Qt::white : palette.color(colorGroup, QPalette::WindowText), 1.5));
+        const QPointF center = area.center();
+        if (button == 0) {
+            painter->drawLine(center + QPointF(-5, 3), center + QPointF(5, 3));
+        } else if (button == 1) {
+            painter->drawRect(QRectF(center - QPointF(4, 4), QSizeF(8, 8)));
+        } else {
+            painter->drawLine(center + QPointF(-4, -4), center + QPointF(4, 4));
+            painter->drawLine(center + QPointF(-4, 4), center + QPointF(4, -4));
+        }
+    }
+    painter->restore();
+}
+void TabbedDecoration::mousePressEvent(QMouseEvent *event)
+{
+    const int hit = hitTest(event->position());
+    if (event->button() == Qt::LeftButton && hit <= MinimizeButton) {
+        m_pressed = hit;
+        event->accept();
+        return;
+    }
+    if (m_group && hit >= 0 && (event->button() == Qt::LeftButton || event->button() == Qt::MiddleButton)) {
+        const auto tabs = m_group->windows();
+        const QPointer<Window> target = tabs.value(hit);
+        if (event->button() == Qt::MiddleButton || target != m_group->current()) {
+            const bool close = event->button() == Qt::MiddleButton;
+            QMetaObject::invokeMethod(this, [group = m_group, target, close] {
+                if (group && target) {
+                    if (close) target->closeWindow();
+                    else group->select(target);
+                }
+            }, Qt::QueuedConnection);
+            event->accept();
+            return;
+        }
+    }
+    // The selected tab and the left grip remain a normal draggable titlebar.
+    event->ignore();
+}
+void TabbedDecoration::mouseReleaseEvent(QMouseEvent *event)
+{
+    if (event->button() == Qt::LeftButton && m_pressed <= MinimizeButton) {
+        const int action = m_pressed;
+        m_pressed = -1;
+        if (hitTest(event->position()) == action) {
+            if (action == CloseButton) requestClose();
+            else if (action == MaximizeButton) requestToggleMaximization(Qt::LeftButton);
+            else requestMinimize();
+        }
+        event->accept();
+        return;
+    }
+    event->ignore();
+}
+void TabbedDecoration::hoverMoveEvent(QHoverEvent *event)
+{
+    m_hovered = hitTest(event->position());
+    update();
+    KDecoration3::Decoration::hoverMoveEvent(event);
+}
+void TabbedDecoration::hoverLeaveEvent(QHoverEvent *event)
+{
+    m_hovered = -1;
+    update();
+    KDecoration3::Decoration::hoverLeaveEvent(event);
+}
+void TabbedDecoration::wheelEvent(QWheelEvent *event)
+{
+    if (m_group && hitTest(event->position()) >= 0 && event->angleDelta().y()) {
+        m_group->cycle(event->angleDelta().y() < 0 ? 1 : -1);
+        event->accept();
+        return;
+    }
+    event->ignore();
+}
+}
