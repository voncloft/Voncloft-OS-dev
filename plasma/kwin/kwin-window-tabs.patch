+++ b/src/windowtabgroup.cpp
@@ -0,0 +1,309 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "windowtabgroup.h"
+#include "input.h"
+#include "tiles/tile.h"
+#include "window.h"
+#include "workspace.h"
+
+#include <KDecoration3/Decoration>
+#include <QScopedValueRollback>
+
+namespace KWin {
+WindowTabGroup::WindowTabGroup(QObject *parent) : QObject(parent)
+{
+    m_geometryTimer.setSingleShot(true);
+    m_geometryTimer.setInterval(100);
+    connect(&m_geometryTimer, &QTimer::timeout, this, &WindowTabGroup::reconcileGeometry);
+}
+WindowTabGroup::~WindowTabGroup()
+{
+    m_destroying = true;
+    // Workspace destroys windows before its managers during normal shutdown.
+    // Removing a manager explicitly must not leave any of its tabs hidden.
+    const auto members = m_windows;
+    for (Window *window : members) {
+        remove(window, window->isDeleted());
+    }
+}
+QList<Window *> WindowTabGroup::windows() const { return m_windows; }
+Window *WindowTabGroup::current() const { return m_current; }
+
+void WindowTabGroup::add(Window *window)
+{
+    if (!window || m_windows.contains(window)) {
+        return;
+    }
+    m_saved.insert(window, {window->skipTaskbar(), window->skipSwitcher(), window->skipPager()});
+    m_windows.append(window);
+    if (!m_current) {
+        m_current = window;
+    }
+    window->setTabGroup(this);
+    connect(window, &Window::closed, this, [this, window] { remove(window, true); });
+    connect(window, &Window::captionChanged, this, &WindowTabGroup::changed);
+    connect(window, &Window::iconChanged, this, &WindowTabGroup::changed);
+    connect(window, &Window::frameGeometryChanged, this, [this, window] {
+        if (window == m_current) {
+            m_resizeRetries.clear();
+            synchronize(window);
+        } else if (!m_geometryTimer.isActive()) {
+            // Wayland clients can restore their own preferred size after an
+            // asynchronous unmaximize. Reconcile after the commit is complete.
+            m_geometryTimer.start();
+        }
+    });
+    connect(window, &Window::requestedTileChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::maximizeGeometryRestoreChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::fullscreenGeometryRestoreChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::maximizedChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::fullScreenChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::minimizedChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::desktopsChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::activitiesChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::keepAboveChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::keepBelowChanged, this, [this, window] { synchronize(window); });
+    connect(window, &Window::decorationChanged, this, [this, window] { synchronize(window); });
+    // A client can opt out of decorations after mapping (for example fullscreen).
+    // Keep the group reachable with its shortcuts; ordinary decoration returns
+    // automatically when the client restores its titlebar.
+    synchronize(m_current);
+    updateVisibility();
+    Q_EMIT changed();
+}
+
+void WindowTabGroup::updateVisibility()
+{
+    for (Window *window : std::as_const(m_windows)) {
+        const bool inactive = window != m_current;
+        const auto saved = m_saved.value(window);
+        window->setHiddenByTabGroup(inactive);
+        window->setTabGroupSkipFlags(inactive || saved.skipTaskbar,
+                                    inactive || saved.skipSwitcher,
+                                    inactive || saved.skipPager);
+    }
+}
+
+void WindowTabGroup::reconcileGeometry()
+{
+    bool pending = false;
+    const auto members = m_windows;
+    for (Window *window : members) {
+        if (!m_current || !m_windows.contains(window) || window->isDeleted()) continue;
+        if (window == m_current || window->frameGeometry() == m_current->frameGeometry()) {
+            m_resizeRetries.remove(window);
+            if (m_resizingWindows.remove(window)) window->unrefOffscreenRendering();
+        } else if (++m_resizeRetries[window] <= 20) {
+            // Qt clients stop drawing when an inactive tab is suspended. Use
+            // KWin's existing offscreen-rendering lease (also used by previews)
+            // only until the requested size is committed, then suspend again.
+            if (!m_resizingWindows.contains(window)) {
+                m_resizingWindows.insert(window);
+                window->refOffscreenRendering();
+            }
+            synchronize(m_current);
+            pending = true;
+        } else {
+            // A client that refuses the group's size must not cause an endless
+            // configure loop or strand an invisible tab. Give it its own frame.
+            remove(window);
+        }
+    }
+    if (pending && m_windows.size() > 1) m_geometryTimer.start();
+}
+
+void WindowTabGroup::synchronize(Window *source)
+{
+    if (m_updating || !source || source != m_current || source->isDeleted()) {
+        return;
+    }
+    QScopedValueRollback guard(m_updating, true);
+    auto geometry = source->moveResizeGeometry();
+    if (!source->isFullScreen() && source->requestedMaximizeMode() == MaximizeRestore) {
+        geometry.setSize(source->constrainFrameSize(geometry.size()));
+        if (geometry != source->moveResizeGeometry()) source->moveResize(geometry);
+    }
+    for (Window *window : std::as_const(m_windows)) {
+        if (window == source || window->isDeleted()) {
+            continue;
+        }
+        window->setDesktops(source->desktops());
+        window->setOnActivities(source->activities());
+        window->setKeepAbove(source->keepAbove());
+        window->setKeepBelow(source->keepBelow());
+        window->setMinimized(source->isMinimized());
+        window->setFullScreen(source->isFullScreen());
+        window->maximize(source->requestedMaximizeMode());
+        if (window->requestedTile() != source->requestedTile()) {
+            if (Tile *tile = source->requestedTile()) {
+                tile->manage(window);
+            } else if (Tile *previous = window->requestedTile()) {
+                previous->unmanage(window);
+            }
+        }
+        window->moveResize(geometry);
+        window->setGeometryRestore(source->geometryRestore());
+        window->setFullscreenGeometryRestore(source->fullscreenGeometryRestore());
+        if (window->frameGeometry() != source->frameGeometry() && !m_geometryTimer.isActive()) {
+            m_geometryTimer.start();
+        }
+    }
+    Q_EMIT changed();
+}
+
+void WindowTabGroup::select(Window *window, bool activate)
+{
+    if (!window || window->isDeleted() || !m_windows.contains(window) || m_updating) {
+        return;
+    }
+    if (m_current != window) {
+        synchronize(m_current);
+        m_current = window;
+        updateVisibility();
+        Q_EMIT changed();
+    }
+    if (activate) {
+        workspace()->activateWindow(window, true);
+    }
+}
+
+void WindowTabGroup::cycle(int direction)
+{
+    if (m_windows.size() > 1) {
+        select(m_windows.at((m_windows.indexOf(m_current) + direction + m_windows.size()) % m_windows.size()));
+    }
+}
+
+void WindowTabGroup::remove(Window *window, bool closing)
+{
+    if (!m_windows.contains(window)) {
+        return;
+    }
+    const bool wasCurrent = m_current == window;
+    const bool wasActive = workspace()->activeWindow() == window;
+    const auto saved = m_saved.take(window);
+    m_resizeRetries.remove(window);
+    if (m_resizingWindows.remove(window)) window->unrefOffscreenRendering();
+    m_windows.removeAll(window);
+    disconnect(window, nullptr, this, nullptr);
+    window->setTabGroupSkipFlags(saved.skipTaskbar, saved.skipSwitcher, saved.skipPager);
+    window->setTabGroup(nullptr);
+    if (!closing && !window->isDeleted()) {
+        window->setHiddenByTabGroup(false);
+    }
+    if (wasCurrent) {
+        m_current = m_windows.isEmpty() ? nullptr : m_windows.first();
+    }
+    updateVisibility();
+    Q_EMIT changed();
+    if (closing && wasActive && m_current) {
+        workspace()->activateWindow(m_current, true);
+    }
+    if (m_windows.size() == 1) {
+        remove(m_windows.first());
+    }
+    if (m_windows.isEmpty() && !m_destroying) {
+        deleteLater();
+    }
+}
+
+WindowTabManager::WindowTabManager(Workspace *workspace)
+    : QObject(workspace), m_workspace(workspace)
+{
+    connect(workspace, &Workspace::windowAdded, this, [](Window *window) {
+        if (Window *parent = window->transientFor()) {
+            window->setHiddenByTabGroup(parent->isHiddenByTabGroup());
+        }
+    });
+}
+
+bool WindowTabManager::canGroup(Window *window)
+{
+    return window && !window->isDeleted() && window->isNormalWindow()
+        && !window->isTransient() && !window->isFullScreen()
+        && window->isMovable() && window->isResizable()
+        && window->decoration() && window->decoration()->style() == KDecoration3::Style::Titled;
+}
+
+bool WindowTabManager::canGroupWith(Window *source, Window *target)
+{
+    if (source == target || !canGroup(source) || !canGroup(target)
+        || (source->tabGroup() && source->tabGroup() == target->tabGroup())) {
+        return false;
+    }
+    const auto targets = target->tabGroup() ? target->tabGroup()->windows() : QList<Window *>{target};
+    QSizeF minimum = source->minSize();
+    QSizeF maximum = source->maxSize();
+    for (Window *tab : targets) {
+        minimum = minimum.expandedTo(tab->minSize());
+        maximum = maximum.boundedTo(tab->maxSize());
+    }
+    return minimum.width() <= maximum.width() && minimum.height() <= maximum.height();
+}
+
+bool WindowTabManager::groupWindows(Window *source, Window *target)
+{
+    if (canGroup(source) && canGroup(target) && source != target
+        && source->tabGroup() && source->tabGroup() == target->tabGroup()) {
+        return true;
+    }
+    if (!canGroupWith(source, target)) {
+        return false;
+    }
+    if (source->tabGroup()) {
+        source->tabGroup()->remove(source);
+    }
+    WindowTabGroup *group = target->tabGroup();
+    if (!group) {
+        group = new WindowTabGroup(this);
+        group->add(target);
+    }
+    group->add(source);
+    group->select(target);
+    return true;
+}
+
+void WindowTabManager::pickTarget(Window *source)
+{
+    if (!canGroup(source)) {
+        return;
+    }
+    const QPointer<Window> guardedSource(source);
+    input()->startInteractiveWindowSelection([this, guardedSource](Window *target) {
+        if (guardedSource) {
+            groupWindows(guardedSource, target);
+        }
+    }, QByteArrayLiteral("crosshair"));
+}
+
+void WindowTabManager::selectForActivation(Window *window)
+{
+    // Dialogs belonging to an inactive tab must reveal their parent tab too.
+    for (Window *parent = window; parent; parent = parent->transientFor()) {
+        if (parent->tabGroup()) {
+            parent->tabGroup()->select(parent, false);
+            return;
+        }
+    }
+}
+void WindowTabManager::groupActiveWindow() { pickTarget(m_workspace->activeWindow()); }
+void WindowTabManager::detachActiveWindow()
+{
+    if (Window *window = m_workspace->activeWindow(); window && window->tabGroup()) {
+        window->tabGroup()->remove(window);
+        m_workspace->activateWindow(window, true);
+    }
+}
+void WindowTabManager::nextTab()
+{
+    if (Window *window = m_workspace->activeWindow(); window && window->tabGroup()) {
+        window->tabGroup()->cycle(1);
+    }
+}
+void WindowTabManager::previousTab()
+{
+    if (Window *window = m_workspace->activeWindow(); window && window->tabGroup()) {
+        window->tabGroup()->cycle(-1);
+    }
+}
+}
