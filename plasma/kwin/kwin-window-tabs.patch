+    void minimumSizeAndUnsupportedWindows()
+    {
+        auto a = createClient(); auto b = createClient(); QVERIFY(a && b);
+        a->shell->set_min_size(620, 340);
+        a->surface->commit(KWayland::Client::Surface::CommitFlag::None);
