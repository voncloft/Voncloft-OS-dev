+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "kwin_export.h"
+#include <QHash>
+#include <QList>
+#include <QObject>
+#include <QPointer>
+#include <QSet>
+#include <QTimer>
+
+namespace KWin {
+class Window;
+class Workspace;
+
+// A group owns no application windows. Closing/detaching the last tab restores
+// its ordinary decoration and all taskbar/switcher flags.
+class KWIN_EXPORT WindowTabGroup : public QObject
+{
+    Q_OBJECT
+public:
+    explicit WindowTabGroup(QObject *parent);
+    ~WindowTabGroup() override;
+    QList<Window *> windows() const;
+    Window *current() const;
+    void add(Window *window);
+    void remove(Window *window, bool closing = false);
+    void select(Window *window, bool activate = true);
+    void cycle(int direction);
+    void synchronize(Window *source);
+Q_SIGNALS:
+    void changed();
+private:
+    void updateVisibility();
+    void reconcileGeometry();
+    struct SavedState {
+        bool skipTaskbar;
+        bool skipSwitcher;
+        bool skipPager;
+    };
+    QList<Window *> m_windows;
+    QHash<Window *, SavedState> m_saved;
+    QHash<Window *, int> m_resizeRetries;
+    QSet<Window *> m_resizingWindows;
+    QTimer m_geometryTimer;
+    QPointer<Window> m_current;
+    bool m_updating = false;
+    bool m_destroying = false;
+};
+
+class KWIN_EXPORT WindowTabManager : public QObject
+{
+    Q_OBJECT
+public:
+    explicit WindowTabManager(Workspace *workspace);
+    static bool canGroup(Window *window);
+    static bool canGroupWith(Window *source, Window *target);
+    bool groupWindows(Window *source, Window *target);
+    void pickTarget(Window *source);
+    void selectForActivation(Window *window);
+    void groupActiveWindow();
+    void detachActiveWindow();
+    void nextTab();
+    void previousTab();
+private:
+    Workspace *m_workspace;
+};
+}
