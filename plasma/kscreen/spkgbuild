# description : Plasma display settings and service for configuring monitor layouts, resolutions, and scaling
# depends : extra-cmake-modules kauth kcmutils kcodecs kconfig kconfigwidgets kcoreaddons kcrash kdbusaddons kde-deps-installer ki18n kirigami kitemmodels kpackage kservice ksvg kwidgetsaddons kwindowsystem kxmlgui layer-shell-qt libkscreen libplasma plasma5support qt6 wayland-protocols

name=kscreen
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kscreen-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
