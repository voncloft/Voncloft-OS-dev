# description : System Settings module for configuring the SDDM login screen and its theme
# depends : extra-cmake-modules karchive kauth kcmutils kcoreaddons kde-deps-installer ki18n kio knewstuff kservice qt6

name=sddm-kcm
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "sddm-kcm-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
