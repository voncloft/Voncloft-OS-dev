# description : Oxygen application style and window decorations for KDE
# depends : extra-cmake-modules frameworkintegration kcmutils kcodecs kcompletion kconfig kconfigwidgets kcoreaddons kde-deps-installer kdecoration kguiaddons ki18n kservice kwidgetsaddons kwindowsystem libplasma qt6

name=oxygen
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/oxygen-$version.tar.xz"
options="!checksum"

build() {
    cd "oxygen-$version"
    plasma-package-installer -DBUILD_QT5=OFF
    cd build
    make DESTDIR="$PKG" install
}
