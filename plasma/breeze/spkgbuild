# description : Core components for the kde desktop
# depends : extra-cmake-modules frameworkintegration kcmutils kcolorscheme kconfig kcoreaddons kde-deps-installer kdecoration kguiaddons ki18n kiconthemes kirigami kwindowsystem qt6

name=breeze
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/breeze-$version.tar.xz"
options="!checksum"

build() {
    cd "breeze-$version"
    plasma-package-installer -DBUILD_QT5=OFF
    cd build
    make DESTDIR="$PKG" install
}
