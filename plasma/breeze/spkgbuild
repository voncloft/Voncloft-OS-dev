# description : Breeze application style, window decorations, cursors, and other Plasma theme assets
# depends : extra-cmake-modules frameworkintegration kcmutils kcolorscheme kconfig kcoreaddons kde-deps-installer kdecoration kguiaddons ki18n kiconthemes kirigami kwindowsystem qt6

name=breeze
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "breeze-$version"
    plasma-package-installer -DBUILD_QT5=OFF
    cd build
    make DESTDIR="$PKG" install
}
