# description : On-screen keyboard and input interface for the Plasma desktop
# depends : extra-cmake-modules kcmutils kconfig kcoreaddons kcrash kde-deps-installer ki18n libplasma libxkbcommon pkgconf qt6 wayland wayland-protocols

name=plasma-keyboard
version=6.8.1
release=2

source="https://download.kde.org/stable/plasma/$version/plasma-keyboard-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-keyboard-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
