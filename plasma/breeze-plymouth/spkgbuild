# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer plymouth qt6

name=breeze-plymouth
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/breeze-plymouth-$version.tar.xz"
options="!checksum"

build() {
    cd "breeze-plymouth-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
