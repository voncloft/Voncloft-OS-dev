# description : Breeze boot splash theme for Plymouth
# depends : extra-cmake-modules kde-deps-installer plymouth qt6

name=breeze-plymouth
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "breeze-plymouth-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
