# description : KDE crash reporting assistant for collecting backtraces and submitting application bug reports
# depends : extra-cmake-modules kauth kcmutils kcodecs kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kguiaddons ki18n kidletime kio kitemmodels kjobwidgets knotifications kservice kstatusnotifieritem kwallet kwidgetsaddons kwindowsystem polkit-qt qt6 solid syntax-highlighting
# platform : Requires systemd; excluded from the SysVinit desktop aggregate.

name=drkonqi
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    # Upstream requires systemd; this package is excluded from the SysVinit KDE groups.
    pkg-config --exists systemd libsystemd || {
        printf "%s\n" "drkonqi 6.8.1 requires systemd and is not supported on SysVinit." >&2
        return 1
    }
    cd "drkonqi-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
