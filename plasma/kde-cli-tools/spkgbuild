# description : Core components for the kde desktop
# depends : extra-cmake-modules kcmutils kcompletion kconfig kcoreaddons kde-deps-installer kdesu kdoctools ki18n kiconthemes kio kparts kservice kwidgetsaddons kwindowsystem qt6

name=kde-cli-tools
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/kde-cli-tools-$version.tar.xz"
options="!checksum"

build() {
    cd "kde-cli-tools-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
