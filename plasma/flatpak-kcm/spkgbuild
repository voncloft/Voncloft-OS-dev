# description : flatpak-kcm - KDE plasma component
# depends : extra-cmake-modules flatpak kcmutils kconfig kconfigwidgets kcoreaddons kde-deps-installer ki18n kitemmodels kservice pkgconf qt6

name=flatpak-kcm
version=6.8.1
release=2

source="https://download.kde.org/stable/plasma/$version/flatpak-kcm-$version.tar.xz"
options="!checksum"

build() {
    cd "flatpak-kcm-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
