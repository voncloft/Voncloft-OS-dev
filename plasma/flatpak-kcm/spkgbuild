# description : System Settings module for viewing and changing Flatpak application permissions
# depends : extra-cmake-modules flatpak kcmutils kconfig kconfigwidgets kcoreaddons kde-deps-installer ki18n kitemmodels kservice pkgconf qt6

name=flatpak-kcm
version=6.8.2
release=2

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "flatpak-kcm-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
