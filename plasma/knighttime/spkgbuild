# description : Service and client library for scheduling day and night transitions used by Plasma features
# depends : extra-cmake-modules kconfig kcoreaddons kdbusaddons kde-deps-installer kholidays ki18n qt6

name=knighttime
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "knighttime-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
