# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kcoreaddons kdbusaddons kde-deps-installer kholidays ki18n qt6

name=knighttime
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/knighttime-$version.tar.xz"
options="!checksum"

build() {
    cd "knighttime-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
