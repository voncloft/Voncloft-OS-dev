# description : Libraries and interface components for process management and system resource monitoring
# depends : extra-cmake-modules kauth kconfig kcoreaddons kde-deps-installer ki18n knewstuff kpackage kservice libdrm libnl lm-sensors qt6 solid zlib

name=libksysguard
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "libksysguard-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
