# description : System information viewer for hardware, graphics, memory, networks, and operating system details
# depends : extra-cmake-modules kauth kcmutils kcodecs kcompletion kconfig kcoreaddons kde-deps-installer kdoctools ki18n kio kjobwidgets kservice kwindowsystem libdrm mesa plasma-systemmonitor qt6 solid systemsettings udev

name=kinfocenter
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kinfocenter-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
