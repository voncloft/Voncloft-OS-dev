# description : Developer tools for creating, testing, and inspecting Plasma widgets and themes
# depends : extra-cmake-modules karchive kauth kcmutils kcodecs kcompletion kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer ki18n kiconthemes kio kitemmodels kjobwidgets kpackage kparts ksvg ktexteditor ktextwidgets kwidgetsaddons kwindowsystem kxmlgui libplasma plasma5support qt6 solid sonnet syntax-highlighting

name=plasma-sdk
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plasma-sdk-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-sdk-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
