# description : components to pipewire plasma
# depends : extra-cmake-modules ffmpeg kcoreaddons kde-deps-installer ki18n libdrm libepoxy libva mesa pipewire plasma-wayland-protocols qt6 wayland

name=kpipewire
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/kpipewire-$version.tar.xz"
options="!checksum"

build() {
    cd "kpipewire-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
