# description : Qt and QML components for displaying and recording PipeWire video streams
# depends : extra-cmake-modules ffmpeg kcoreaddons kde-deps-installer ki18n libdrm libepoxy libva mesa pipewire plasma-wayland-protocols qt6 wayland

name=kpipewire
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kpipewire-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
