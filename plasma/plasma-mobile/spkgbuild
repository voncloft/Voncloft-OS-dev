# description : Touch-oriented Plasma shell with a home screen, app launcher, and phone interface
# depends : extra-cmake-modules kauth kcmutils kconfig kcoreaddons kdbusaddons kde-deps-installer kglobalaccel ki18n kio kirigami-addons kitemmodels kjobwidgets knotifications kpackage kpipewire kservice kwayland kwin kwindowsystem layer-shell-qt libepoxy libkscreen libplasma libxcb modemmanager-qt networkmanager-qt pkgconf plasma-activities plasma-wayland-protocols plasma-workspace powerdevil qcoro qt6 udev wayland xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm

name=plasma-mobile
version=6.8.1
release=2

source="https://download.kde.org/stable/plasma/$version/plasma-mobile-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-mobile-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
