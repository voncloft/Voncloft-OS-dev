# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer ki18n kitemmodels kservice ksvg kwayland kwindowsystem libplasma qt6

name=plasma-nano
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plasma-nano-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-nano-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
