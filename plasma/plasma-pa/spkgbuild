# description : Core components for the kde desktop
# depends : extra-cmake-modules glib kcmutils kconfig kcoreaddons kdbusaddons kde-deps-installer kdeclarative kdoctools kglobalaccel ki18n kirigami-addons kitemmodels kpackage kstatusnotifieritem ksvg libcanberra libplasma pulseaudio pulseaudio-qt qt6

name=plasma-pa
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plasma-pa-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-pa-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
