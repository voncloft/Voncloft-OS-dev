# description : Qt platform integration that applies Plasma dialogs, fonts, icons, and settings to Qt applications
# depends : breeze extra-cmake-modules kcolorscheme kconfig kconfigwidgets kcoreaddons kde-deps-installer kguiaddons ki18n kiconthemes kio kjobwidgets knotifications kservice kstatusnotifieritem kwayland kwidgetsaddons kwindowsystem libx11 libxcb libxext libxfixes libxi libxrender libxtst plasma-wayland-protocols qt6 wayland xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util-wm

name=plasma-integration
version=6.8.1
release=2

source="https://download.kde.org/stable/plasma/$version/plasma-integration-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-integration-$version"
    plasma-package-installer -DBUILD_QT5=OFF -DBUILD_QT6=ON
    cd build
    make DESTDIR="$PKG" install
}
