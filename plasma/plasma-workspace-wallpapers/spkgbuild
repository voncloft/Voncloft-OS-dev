# description : Wallpaper image collection for the Plasma desktop
# depends : extra-cmake-modules kde-deps-installer qt6

name=plasma-workspace-wallpapers
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plasma-workspace-wallpapers-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-workspace-wallpapers-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
