# description : PolicyKit authentication agent that displays Plasma password prompts for privileged actions
# depends : extra-cmake-modules kcoreaddons kcrash kdbusaddons kde-deps-installer ki18n kirigami knotifications kwindowsystem polkit-qt qt6

name=polkit-kde-agent-1
version=6.8.3
release=2

# pre-upgrade.sh retires the obsolete polkit-kde-agent package name.
source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz
        pre-upgrade.sh"
options="!checksum"

build() {
    cd "polkit-kde-agent-1-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
