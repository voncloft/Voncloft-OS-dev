# description : Core components for the kde desktop
# depends : extra-cmake-modules kconfig kde-deps-installer ki18n krunner ksvg libplasma qt6

name=milou
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/milou-$version.tar.xz"
options="!checksum"

build() {
    cd "milou-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
