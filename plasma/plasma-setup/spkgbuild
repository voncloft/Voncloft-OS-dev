# description : Initial setup wizard for creating a user account and choosing language, keyboard, network, and time zone settings
# depends : extra-cmake-modules kauth kconfig kcoreaddons kde-deps-installer ki18n kpackage libkscreen pkgconf plasma-desktop plasma-workspace qt6

name=plasma-setup
version=6.8.2
release=2

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-setup-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
