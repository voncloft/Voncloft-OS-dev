# description : A plugin based system monitoring daemon
# depends : extra-cmake-modules kcoreaddons kcrash kde-deps-installer kio libksysguard libnl lm-sensors networkmanager-qt qt6 solid

name=ksystemstats
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/ksystemstats-$version.tar.xz"
options="!checksum"

build() {
    cd "ksystemstats-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
