# description : Wayland protocol definitions for communication between Plasma and desktop applications
# depends : extra-cmake-modules kde-deps-installer qt6 wayland

name=plasma-wayland-protocols
version=1.23.0
release=1

source="https://download.kde.org/stable/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-wayland-protocols-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
