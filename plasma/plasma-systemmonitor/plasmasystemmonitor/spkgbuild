# description : Graphical system monitor for viewing running processes, hardware sensors, and resource usage

name=plasma-systemmonitor
version=6.3.4
release=1

source="https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz"
options="!checksum"

build() {
   cd $name-$version
   plasma-package-installer
   cd build
   make DESTDIR=$PKG install
}
