# note : X11 component from Plasma 6.7; not part of the Wayland-only Plasma 6.8 desktop.
# depends : kde-deps-installer
# status : Final archived release; excluded from current Frameworks/Plasma/Gear package groups.
# description : System Settings module for adjusting monitor gamma and color balance on X11

name=kgamma
version=6.7.5
release=1

source="https://download.kde.org/stable/plasma/$version/kgamma-$version.tar.xz"
options="!checksum"

build() {
   cd $name-$version
   plasma-package-installer
   cd build
   make DESTDIR=$PKG install
}
