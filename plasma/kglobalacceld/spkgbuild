# description : Background service that registers global keyboard shortcuts and dispatches them to applications
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer kglobalaccel kio kjobwidgets kservice qt6

name=kglobalacceld
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kglobalacceld-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
