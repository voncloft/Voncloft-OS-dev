# description : Libraries and QML components for building Plasma desktop shells, panels, and widgets
# depends : extra-cmake-modules karchive kcolorscheme kconfig kcoreaddons kdbusaddons kde-deps-installer kglobalaccel kguiaddons ki18n kiconthemes kio kirigami knotifications kpackage kparts ksvg kwidgetsaddons kwindowsystem plasma-activities plasma-wayland-protocols qt6 wayland wayland-protocols

name=libplasma
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/libplasma-$version.tar.xz"
options="!checksum"

build() {
    cd "libplasma-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
