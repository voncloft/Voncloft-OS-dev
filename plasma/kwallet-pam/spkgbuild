# description : PAM module that unlocks the KDE password wallet when the user logs in
# depends : extra-cmake-modules kde-deps-installer kwallet libgcrypt linux-pam pkgconf qt6

name=kwallet-pam
version=6.8.1
release=2

source="https://download.kde.org/stable/plasma/$version/kwallet-pam-$version.tar.xz"
options="!checksum"

build() {
    cd "kwallet-pam-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
