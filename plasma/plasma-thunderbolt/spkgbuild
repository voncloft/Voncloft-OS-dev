# description : Plasma settings and device authorization interface for Thunderbolt hardware
# depends : extra-cmake-modules kcmutils kconfig kcoreaddons kdbusaddons kde-deps-installer ki18n knotifications kservice qt6

name=plasma-thunderbolt
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-thunderbolt-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
