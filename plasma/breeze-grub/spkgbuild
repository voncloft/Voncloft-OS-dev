# description : Breeze theme for the GRUB boot menu
# depends : grub

name=breeze-grub
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "$name-$version"
    install -d "$PKG/usr/share/grub/themes"
    cp -a breeze "$PKG/usr/share/grub/themes/"
}
