# description : Core components for the kde desktop
# depends : extra-cmake-modules freerdp kcmutils kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kguiaddons ki18n kirigami-addons kpipewire kstatusnotifieritem libei libxkbcommon linux-pam pkgconf plasma-wayland-protocols qt6 qtkeychain

name=krdp
version=6.8.1
release=2

source="https://download.kde.org/stable/plasma/$version/krdp-$version.tar.xz"
options="!checksum"

build() {
    cd "krdp-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
