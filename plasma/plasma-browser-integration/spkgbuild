# description : Native browser integration for desktop media controls, downloads, and browser tab search
# depends : extra-cmake-modules kconfig kcoreaddons kcrash kdbusaddons kde-deps-installer kfilemetadata ki18n kio kjobwidgets knotifications krunner kservice kstatusnotifieritem plasma-activities plasma-workspace purpose qt6

name=plasma-browser-integration
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plasma-browser-integration-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-browser-integration-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
