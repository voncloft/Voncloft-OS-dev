# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer ki18n qt6

name=kdecoration
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/kdecoration-$version.tar.xz"
options="!checksum"

build() {
    cd "kdecoration-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
