# description : Core components for the kde desktop
# depends : extra-cmake-modules kauth kcmutils kconfig kcoreaddons kde-deps-installer ki18n qt6

name=plasma-firewall
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plasma-firewall-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-firewall-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
