# note : X11 component from Plasma 6.7; not part of the Wayland-only Plasma 6.8 desktop.
# depends : kde-deps-installer
# status : Final archived release; excluded from current Frameworks/Plasma/Gear package groups.
# description : Legacy Plasma X11 window manager and compositor with window rules and desktop effects

name=kwin-x11
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/kwin-x11-$version.tar.xz"
options="!checksum"

build() {
   cd $name-$version
   plasma-package-installer
   cd build
   make DESTDIR=$PKG install
}
