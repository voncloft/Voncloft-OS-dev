# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer qt6

name=ocean-sound-theme
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/ocean-sound-theme-$version.tar.xz"
options="!checksum"

build() {
    cd "ocean-sound-theme-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
