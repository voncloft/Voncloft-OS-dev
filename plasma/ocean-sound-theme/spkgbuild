# description : Ocean desktop sound theme for notifications, login, and other Plasma events
# depends : extra-cmake-modules kde-deps-installer qt6

name=ocean-sound-theme
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "ocean-sound-theme-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
