# description : KWin window decoration engine for rendering configurable SVG-based window borders
# depends : extra-cmake-modules kcmutils kcolorscheme kconfig kcoreaddons kde-deps-installer kdecoration ki18n knewstuff kpackage ksvg qt6

name=aurorae
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/aurorae-$version.tar.xz"
options="!checksum"

build() {
    cd "aurorae-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
