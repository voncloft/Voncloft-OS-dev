# description : Additional Plasma widgets, desktop effects, wallpapers, and search plugins
# depends : attica corrosion extra-cmake-modules kauth kcmutils kcodecs kcompletion kconfig kconfigwidgets kcoreaddons kdbusaddons kde-deps-installer kdeclarative kglobalaccel kguiaddons kholidays ki18n kio kirigami-addons kjobwidgets knewstuff knotifications kpackage krunner kservice ksvg kunitconversion kwidgetsaddons kxmlgui libplasma plasma-workspace qt6 rust solid sonnet

name=kdeplasma-addons
version=6.8.2
release=2

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kdeplasma-addons-$version"
    # Rust is installed under /opt; sudo does not preserve that PATH entry.
    export PATH="/opt/rustc/bin:$PATH"
    rustc --version
    cargo --version
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
