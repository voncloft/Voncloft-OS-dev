# description : The plasma-activities-6
# depends : extra-cmake-modules kconfig kcoreaddons kde-deps-installer kwindowsystem qt6

name=plasma-activities
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plasma-activities-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-activities-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
