# description : Breeze theme that makes GTK applications match the Plasma desktop
# depends : breeze extra-cmake-modules kde-deps-installer python-cairo qt6 sassc

name=breeze-gtk
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "breeze-gtk-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
