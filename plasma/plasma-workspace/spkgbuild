# description : Core Plasma session services, desktop shell, panels, notifications, and workspace components

name=plasma-workspace
version=6.8.3
release=1
backup="etc/xdg/plasmanotifyrc etc/xdg/autostart/org.kde.plasma-fallback-session-restore.desktop etc/xdg/autostart/gmenudbusmenuproxy.desktop etc/xdg/autostart/org.kde.plasmashell.desktop etc/xdg/autostart/xembedsniproxy.desktop etc/xdg/menus/plasma-applications.menu"

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz
        taskmanager-tab-launchers.patch"
options="!checksum"

build() {
    cd "plasma-workspace-$version"
    patch --batch --forward --fuzz=0 -Np1 -i "$SRC/taskmanager-tab-launchers.patch"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
