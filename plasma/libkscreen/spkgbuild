# description : Library for querying and configuring connected displays, output modes, and screen layouts
# depends : extra-cmake-modules kde-deps-installer plasma-wayland-protocols qt6 wayland

name=libkscreen
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/libkscreen-$version.tar.xz"
options="!checksum"

build() {
    cd "libkscreen-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
