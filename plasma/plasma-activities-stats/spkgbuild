# description : The plasma-activities-stats-6
# depends : extra-cmake-modules kactivitymanagerd kconfig kde-deps-installer plasma-activities qt6

name=plasma-activities-stats
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plasma-activities-stats-$version.tar.xz"
options="!checksum"

build() {
    cd "plasma-activities-stats-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
