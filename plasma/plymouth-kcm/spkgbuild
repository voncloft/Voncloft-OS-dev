# description : Core components for the kde desktop
# depends : extra-cmake-modules karchive kauth kcmutils kcodecs kconfig kconfigwidgets kcoreaddons kde-deps-installer ki18n kio knewstuff kservice kwidgetsaddons kxmlgui plymouth qt6

name=plymouth-kcm
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/plymouth-kcm-$version.tar.xz"
options="!checksum"

build() {
    cd "plymouth-kcm-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
