# description : Core components for the kde desktop
# depends : extra-cmake-modules kde-deps-installer qt6

name=oxygen-sounds
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/oxygen-sounds-$version.tar.xz"
options="!checksum"

build() {
    cd "oxygen-sounds-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
