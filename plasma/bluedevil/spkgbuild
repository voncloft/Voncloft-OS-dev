# description : Plasma Bluetooth tools for pairing devices, managing connections, and transferring files
# depends : bluez-qt extra-cmake-modules kauth kcmutils kcodecs kcompletion kconfig kconfigwidgets kcoreaddons kdbusaddons kde-deps-installer kdoctools ki18n kio kitemviews kjobwidgets knotifications kservice ksvg kwidgetsaddons kwindowsystem kxmlgui libplasma plasma-workspace qt6 shared-mime-info solid

name=bluedevil
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "bluedevil-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
