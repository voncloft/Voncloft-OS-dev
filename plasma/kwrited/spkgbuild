# description : Background service that displays terminal messages from write and wall as desktop notifications
# depends : extra-cmake-modules kcoreaddons kdbusaddons kde-deps-installer ki18n knotifications kpty qt6

name=kwrited
version=6.8.2
release=1

source="https://download.kde.org/stable/plasma/$version/${name}-$version.tar.xz"
options="!checksum"

build() {
    cd "kwrited-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
