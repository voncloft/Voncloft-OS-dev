# description : Core components for the kde desktop
# depends : extra-cmake-modules kcoreaddons kdbusaddons kde-deps-installer ki18n knotifications kpty qt6

name=kwrited
version=6.8.1
release=1

source="https://download.kde.org/stable/plasma/$version/kwrited-$version.tar.xz"
options="!checksum"

build() {
    cd "kwrited-$version"
    plasma-package-installer
    cd build
    make DESTDIR="$PKG" install
}
