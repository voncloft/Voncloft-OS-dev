# note : HarfBuzz is detected when installed. For a new font stack: FreeType, Graphite2, HarfBuzz, then rebuild FreeType.
# description	: Font rasterization library
# depends : libpng which

name=freetype2
version=2.13.3
release=2
source="https://downloads.sourceforge.net/freetype/freetype-$version.tar.xz"

options="!checksum"

build() {
	cd freetype-$version

	sed -ri "s:.*(AUX_MODULES.*valid):\1:" modules.cfg

	sed -r "s:.*(#.*SUBPIXEL_RENDERING) .*:\1:" \
	    -i include/freetype/config/ftoption.h

	./configure --prefix=/usr --enable-freetype-config --disable-static
	make
	make DESTDIR=$PKG install

	#make distclean

	#CC="gcc -m32" ./configure --prefix=/usr --enable-freetype-config --disable-static 
	
		
}
