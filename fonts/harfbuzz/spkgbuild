# description	: OpenType text shaping engine
# depends	: glib freetype2 graphite2 icu

name=harfbuzz
version=15.1.0
release=3
source="https://github.com/harfbuzz/${name}/releases/download/$version/${name}-$version.tar.xz"

build() {
	cd "$name-$version"

	mkdir build &&
	cd    build &&

	meson setup ..             \
      --prefix=/usr --libdir=lib \
      --buildtype=release  \
      -D graphite2=enabled &&
	ninja -j"${NINJAJOBS:-$(nproc)}"
	DESTDIR="$PKG" ninja -j"${NINJAJOBS:-$(nproc)}" install
	
}
