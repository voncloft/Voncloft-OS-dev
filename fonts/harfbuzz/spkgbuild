# description : OpenType text shaping engine
# depends     : glib freetype2 graphite2 icu

name=harfbuzz
version=15.2.0
release=4
source="https://github.com/harfbuzz/${name}/releases/download/$version/${name}-$version.tar.xz"

build() {
    # 64-bit build.
    cd "$name-$version"

    mkdir build
    cd build
    meson setup .. \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -D graphite2=enabled
    ninja -j"${NINJAJOBS:-$(nproc)}"
    DESTDIR="$PKG" ninja -j"${NINJAJOBS:-$(nproc)}" install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dgraphite2=disabled \
        -Dintrospection=disabled \
        -Dicu=disabled \
        -Dtests=disabled \
        -Ddocs=disabled
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
