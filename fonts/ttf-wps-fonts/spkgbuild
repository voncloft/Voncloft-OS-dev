# description	: Symbol fonts required by wps-office
# depends	: fontconfig

name=ttf-wps-fonts
version=20241029073004.g8c980c24289cb08e03f72915970ce1bd6767e45a
release=2
_commit=${version##*.g}
_commit=8c980c24289cb08e03f72915970ce1bd6767e45a
source="$name-$_commit.tar.gz::https://github.com/iamdh4/${name}/archive/${_commit}.tar.gz"

build() {
	cd "$SRC"/ttf-wps-fonts*/
	install -d $PKG/usr/share/fonts/X11/TTF
	install -m644 *.ttf $PKG/usr/share/fonts/X11/TTF
	install -m644 *.TTF $PKG/usr/share/fonts/X11/TTF
}
