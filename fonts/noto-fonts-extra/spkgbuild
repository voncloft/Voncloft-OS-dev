# description	: Google Noto TTF fonts (extra)
# depends	: fontconfig noto-fonts

name=noto-fonts-extra
version=20230125134016.gffebf8c1ee449e544955a7e813c54f9b73848eac
_commit=${version##*.g}
release=1
_name=noto-fonts
_commit=ffebf8c1ee449e544955a7e813c54f9b73848eac
source="noto-fonts-$version.tar.gz::https://github.com/notofonts/${_name}/archive/${_commit}.tar.gz"

build() {
	cd "$SRC"/noto-fonts*/
	mkdir -p $PKG/usr/share/fonts/noto
	cp hinted/Noto*/*Condensed*.ttf \
	   hinted/Noto*/*SemiBold*.ttf \
	   hinted/Noto*/*Extra*.ttf \
	   $PKG/usr/share/fonts/noto
}
