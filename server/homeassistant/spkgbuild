# description : home automated system
# depends : python-build python-installer python-wheel gcc python-aiodiscover python-aiohttp python-aiohttp-cors python-astral python-async-timeout python-atomicwrites python-attrs python-awesomeversion python-bcrypt python-certifi python-ciso8601 python-cryptography python-defusedxml python-httpx python-jinja python-lru-dict python-mutagen python-pillow python-pip python-pyjwt python-pytz python-requests python-ruamel-yaml python-slugify python-sqlalchemy python-voluptuous python-voluptuous-serialize python-yaml python-yarl python-zeroconf

name=homeassistant
version=2026.10.4
release=1

_name=core
source="https://github.com/home-assistant/${_name}/archive/refs/tags/$version.tar.gz"
build() {
    cd "$SRC/core-$version"
    python -m build --wheel --no-isolation
    python -m installer --destdir="$PKG" dist/*.whl
}
