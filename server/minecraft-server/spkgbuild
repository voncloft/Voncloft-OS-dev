# description : Minecraft Server
# depends : java-headless python

name=minecraft-server
version=26.3
release=2

source="${name}-${version}-manifest.json::https://piston-meta.mojang.com/mc/game/version_manifest_v2.json
    fetch-source.py
    minecraft.sh"

build() {
    python3 "$SRC/fetch-source.py" minecraft "$version" "$SRC/${name}-${version}-manifest.json" "$SRC/${name}-${version}.jar" || return 1
	mkdir -pv $PKG/minecraft
	install -Dm644 "$SRC/${name}-${version}.jar" $PKG/minecraft/minecraft_server.$version.jar
	mkdir -pv $PKG/usr/bin
	install -Dm755 $SRC/minecraft.sh $PKG/usr/bin/minecraft-server
	sed -i -E "s|minecraft_server\.[0-9.]+\.jar|minecraft_server.$version.jar|g" "$PKG/usr/bin/minecraft-server"
}
