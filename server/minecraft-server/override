# Fetch upstream data as data; never source downloaded shell code.
source='https://piston-meta.mojang.com/mc/game/version_manifest_v2.json'
url=$source

get_generic()
{
    local detected recipe comparison edit
    local -a fields sed_args
    unset uversion update_repo_review_reason
    recipe="${ppath%/*}/spkgbuild"
    detected=$(python3 - "$recipe" "$version" <<'PYRELEASE'
from pathlib import Path
import datetime, hashlib, json, re, subprocess, sys
recipe=Path(sys.argv[1])
current=sys.argv[2]
try:
    obj=json.loads(Path('index.html').read_text())
    review='-'
    version=obj['latest']['release']
    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)+',version): raise ValueError('not a stable Minecraft version')
    entry=next(e for e in obj['versions'] if e['id']==version and e['type']=='release')
    digest=entry['sha1']
    if not re.fullmatch(r'[a-f0-9]{40}',digest): raise ValueError('invalid version-metadata digest')
    expected='https://piston-meta.mojang.com/v1/packages/'+digest+'/'+version+'.json'
    if entry['url']!=expected: raise ValueError('unexpected Minecraft metadata URL')
    metadata=subprocess.run(['curl','-fLsS','--connect-timeout','10','--max-time','25',expected],check=True,capture_output=True).stdout
    if hashlib.sha1(metadata).hexdigest()!=digest: raise ValueError('Minecraft metadata checksum mismatch')
    release=json.loads(metadata)
    if release['id']!=version or release['type']!='release': raise ValueError('release identity mismatch')
    server=release['downloads']['server'];sha=server['sha1']
    if not re.fullmatch(r'[a-f0-9]{40}',sha): raise ValueError('invalid server SHA-1')
    if server['url']!='https://piston-data.mojang.com/v1/objects/'+sha+'/server.jar':
        raise ValueError('unexpected Minecraft server URL')
    updates={'_server_sha1':sha}
    required=release['javaVersion']['majorVersion']
    if not isinstance(required,int) or required<1: raise ValueError('invalid required Java version')
    # Report a detected release without applying it against an incompatible JRE.
    java_recipe=recipe.parents[2]/'core/java-headless/spkgbuild'
    java_match=re.search(r'^version=[\"\']?([0-9]+)',java_recipe.read_text(),re.M) if java_recipe.exists() else None
    available=int(java_match[1]) if java_match else 0
    if available<required:
        review='Minecraft '+version+' requires Java '+str(required)+'; java-headless recipe provides '+(str(available) if available else 'an unknown version')+'. Update that dependency before applying.'
    text=recipe.read_text()
    for key in updates:
        if len(re.findall(r'^'+re.escape(key)+r'=.*$',text,re.M))!=1:
            raise ValueError('missing or duplicate recipe field '+key)
    print(version)
    print(review)
    for key,value in updates.items():
        if not re.fullmatch(r'[A-Za-z0-9._/-]+',value):
            raise ValueError('invalid recipe metadata')
        print('s|^'+key+'=.*$|'+key+'='+value+'|')
except (OSError,ValueError,KeyError,IndexError,StopIteration,TypeError,subprocess.SubprocessError) as error:
    sys.exit('ERROR: Invalid upstream release metadata: '+str(error))
PYRELEASE
    ) || return 1
    mapfile -t fields <<< "$detected"
    uversion=${fields[0]}
    if [ "${fields[1]}" != - ]; then
        update_repo_review_reason=${fields[1]}
        return 0
    fi
    if vercomp "$uversion" "$version" >/dev/null; then
        return 0
    else
        comparison=$?
    fi
    [ "$comparison" = 2 ] || return 0
    for edit in "${fields[@]:2}"; do sed_args+=(-e "$edit"); done
    if [ -n "${test_upgrade:-}" ]; then
        printf 'sed -i' >> test_updates.sh
        printf ' %q' "${sed_args[@]}" -- "$recipe" >> test_updates.sh
        printf '\n' >> test_updates.sh
    else
        sed -i "${sed_args[@]}" -- "$recipe" || return 1
    fi
}
