# description : block youtube ads via dns
# depends : dnsmasq

name=blacklist-youtubeads
version=1.0.git20261107170852.g58963b8ce86bd1f982a1d9ffbf29a10d924820f4
release=2

_commit=${version##*.g}
_name=youTube_ads_4_pi-hole
source="youtubelist-$version.txt::https://raw.githubusercontent.com/kboghdady/${_name}/$_commit/youtubelist.txt"

build() {
	mkdir -pv $PKG/etc/blacklist-hosts/youtube
	cp "$SRC/youtubelist-$version.txt" $PKG/etc/blacklist-hosts/youtube/youtubeadlist
	sed -i -e 's/^/0.0.0.0 /g' $PKG/etc/blacklist-hosts/youtube/youtubeadlist
}
