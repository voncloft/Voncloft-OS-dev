# description : D-Bus interface for user account query and manipulation
# depends : glib libxcrypt polkit shadow git meson

name=accountsservice
version=26.27.3
release=4
source="https://gitlab.freedesktop.org/accountsservice/accountsservice/-/archive/26.27.3/accountsservice-26.27.3.tar.gz"
options="!checksum"

build() {
	cd "$SRC"/accountsservice*/
	sed -i '/dbus_conf_dir/s/sysconfdir/datadir/g' meson.build
	mkdir build
	cd build
	meson .. \
		-D admin_group=wheel \
		-D systemd=false \
		-D docbook=false \
		-D gtk_doc=false \
		-D user_heuristics=false\
		-D systemd=false
	ninja
        DESTDIR=$PKG ninja install
}
