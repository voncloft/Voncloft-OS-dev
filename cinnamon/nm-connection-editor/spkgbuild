# description : network manager applet
# depends : gtk3 libnma libnotify libsecret glib libmm-glib polkit

name=nm-connection-editor
version=1.36.0
release=1

_name=network-manager-applet
source="https://download.gnome.org/sources/${_name}/${version%.*}/${_name}-${version}.tar.xz"
options="!checksum"

build() {
	cd NetworkManager-$version
	mkdir build
	cd build

	meson --prefix=/usr \
	-Dappindicator=no \
	-Dselinux=false \
	-Dteam=false ..

	ninja
	DESTDIR=$PKG ninja install
}
