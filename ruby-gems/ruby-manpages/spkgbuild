# description : Installs manual pages supplied by Ruby gems
# depends : ruby

_gemname=manpages
name=ruby-manpages
version=0.7.0
release=2

source="https://rubygems.org/downloads/$_gemname-$version.gem"
options="!checksum"

build() {
        _gemdir="$(gem env gemdir)"

        gem install \
                --ignore-dependencies \
                --no-user-install \
                --no-document \
                -i "$PKG/$_gemdir" \
                -n "$PKG"/usr/bin \
                $_gemname-$version.gem	
}
