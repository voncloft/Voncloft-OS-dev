# description : Ruby synchronization library used by Tins
# depends : ruby

name=ruby-sync
_gemname=sync
version=0.5.0
release=1
source="https://rubygems.org/downloads/${_gemname}-${version}.gem"
options="!checksum"

build() {
    _gemdir="$(gem env gemdir)"
    gem install --local --ignore-dependencies --no-user-install --no-document \
        -i "$PKG/$_gemdir" -n "$PKG/usr/bin" "$_gemname-$version.gem"
}
