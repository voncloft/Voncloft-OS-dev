# description : rainbow text
# depends : ruby ruby-optimist ruby-paint ruby-manpages patch

_gemname=lolcat
name=ruby-lolcat
version=100.0.1
release=4

source="https://rubygems.org/downloads/lolcat-$version.gem
        modern-gems.patch"
options="!checksum"

build() {
        _gemdir="$(gem env gemdir)"

        # Widen stale dependency pins after testing Optimist 3.2.1 and
        # Manpages 0.7.0. Regenerate the packaged spec so git is not required.
        gem unpack "$_gemname-$version.gem"
        gem specification "$_gemname-$version.gem" --ruby > "$_gemname-$version/lolcat.gemspec"
        cd "$_gemname-$version"
        patch -Np1 --fuzz=0 -i "$SRC/modern-gems.patch"
        gem build lolcat.gemspec


        gem install \
                --ignore-dependencies \
                --no-user-install \
                --no-document \
                -i "$PKG/$_gemdir" \
                -n "$PKG"/usr/bin \
                $_gemname-$version.gem
}
