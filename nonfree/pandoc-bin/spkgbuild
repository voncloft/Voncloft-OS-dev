# description	: Conversion between markup formats, "Bin"-Edition
# depends	: cmark

name=pandoc-bin
version=3.13
release=1
_name=${name%-bin}
source="https://github.com/jgm/${_name}/releases/download/$version/${_name}-$version-linux-amd64.tar.gz
	https://github.com/jgm/${_name}/archive/$version/${_name}-$version.tar.gz"

build() {
	cd pandoc-$version
	mkdir -p $PKG/usr/share/pandoc
	cp -R bin share $PKG/usr

}
