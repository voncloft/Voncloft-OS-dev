# description	: All-in-one voice and text chat for gamers that's free and secure
# depends : xdg-desktop-portal-gtk

name=discord
version=1.0.169
release=1
source="${name}-${version}.tar.gz::https://stable.dl2.discordapp.net/distro/app/stable/linux/x64/${version}/Discord.tar.gz"

build() {
	#note use GTK_USE_PORTAL=1 when running
	#also export $(dbus-launch)
	#put in .profile of usesr directory
	
	cd Discord
	  install -Dm755 $name "$PKG"/usr/bin/$name
  install -Dm755 updater_bootstrap "$PKG"/usr/share/$name/updater_bootstrap
  install -Dm644 $name.desktop "$PKG"/usr/share/applications/$name.desktop
  install -Dm644 $name.png "$PKG"/usr/share/icons/hicolor/256x256/apps/$name.png



}
