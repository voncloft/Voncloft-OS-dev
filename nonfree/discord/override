# Read the current official upstream source metadata.
source="https://discord.com/api/downloads/distributions/app/installers/latest?arch=x64&channel=stable&platform=linux&format=tar.gz"
url=$source
update_repo_fetch_kind=headers

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re
headers=pathlib.Path('index.html').read_text()
versions=re.findall(r'^location:\s*https://stable\.dl2\.discordapp\.net/distro/app/stable/linux/x64/([0-9]+(?:\.[0-9]+)+)/Discord\.tar\.gz\s*$',headers,re.I|re.M)
versions+=re.findall(r'^location:\s*https://dl\.discordapp\.net/apps/linux/([0-9]+(?:\.[0-9]+)+)/discord-[0-9.]+\.tar\.gz\s*$',headers,re.I|re.M)
if len(set(versions))!=1: raise SystemExit('No unambiguous stable Discord download version')
print(versions[-1])
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
