# description : Official firefox bin
# depends : 

name=firefox-bin
# Include the build ID so daily Nightlies are distinct package/cache versions.
version=162.0a1.20261109214446
release=2
_name=${name%-bin}
_version=${version%.*}
_buildid=${version##*.}
year=${_buildid:0:4}
month=${_buildid:4:2}
day=${_buildid:6:2}
hour=${_buildid:8:2}
min=${_buildid:10:2}
sec=${_buildid:12:2}
source="$name-$version.tar.xz::https://archive.mozilla.org/pub/${_name}/nightly/$year/$month/$year-$month-$day-$hour-$min-$sec-mozilla-central/${_name}-${_version}.en-US.linux-x86_64.tar.xz
	firefox.sh
	firefox.desktop"

build() {
	mkdir -pv $PKG/usr/bin
	mkdir -pv $PKG/usr/share/applications
	mkdir -pv $PKG/opt

	cp -rv firefox/ $PKG/opt/$name
	#version testing
	#cp -rv firefox/ $PKG/opt/$name-$month-$year
	#launchers
	install -m755 $SRC/firefox.sh "$PKG"/usr/bin/firefox
	install -m644 *.desktop $PKG/usr/share/applications/
	for i in 16x16 32x32 48x48 64x64 128x128; do
    		install -d "$PKG"/usr/share/icons/hicolor/$i/apps/
    		ln -s /opt/$name/browser/chrome/icons/default/default${i/x*}.png \
          	$PKG/usr/share/icons/hicolor/$i/apps/firefox.png
  	done
  	ln -Ts /usr/share/hunspell "$PKG"/opt/$name/dictionaries
	ln -Ts /usr/share/hyphen "$PKG"/opt/$name/hyphenation
	ln -sf /usr/lib/libnssckbi.so "$PKG"/opt/$name/libnssckbi.so
    # Package-scoped library lookup for modules loaded by the browser.
    install -dm755 "$PKG/etc/revdep.d"
    printf '/opt/%s/ /opt/%s\n' "$name" "$name" > "$PKG/etc/revdep.d/$name.paths"

}
