# description : Official Thunderbird binary
# depends : 

name=thunderbird-bin
# Include the build ID so daily Nightlies are distinct package/cache versions.
version=162.0a1.20261112100008
release=2
_name=${name%-bin}
_version=${version%.*}
_buildid=${version##*.}
year=${_buildid:0:4}
month=${_buildid:4:2}
day=${_buildid:6:2}
hour=${_buildid:8:2}
min=${_buildid:10:2}
sec=${_buildid:12:2}
source="$name-$version.tar.xz::https://archive.mozilla.org/pub/${_name}/nightly/$year/$month/$year-$month-$day-$hour-$min-$sec-comm-central/${_name}-${_version}.en-US.linux-x86_64.tar.xz
	thunderbird.sh
	thunderbird.desktop"


build() {
        mkdir -pv $PKG/usr/bin
        mkdir -pv $PKG/usr/share/applications
        mkdir -pv $PKG/opt

        cp -rv thunderbird/ $PKG/opt/$name

        #launchers
        install -m755 $SRC/thunderbird.sh "$PKG"/usr/bin/thunderbird
        install -m644 *.desktop $PKG/usr/share/applications/

        for i in 16 22 24 32 48 256; do
        install -d "$PKG"/usr/share/icons/hicolor/${i}x${i}/apps/
        ln -s /opt/$name/chrome/icons/default/default$i.png \
                  "$PKG"/usr/share/icons/hicolor/${i}x${i}/apps/$name.png
        done
        ln -Ts /usr/share/hunspell "$PKG"/opt/$name/dictionaries
        ln -Ts /usr/share/hyphen "$PKG"/opt/$name/hyphenation
        ln -sf /usr/lib/libnssckbi.so "$PKG"/opt/$name/libnssckbi.so
        
    # Package-scoped library lookup for modules loaded by the browser.
    install -dm755 "$PKG/etc/revdep.d"
    printf '/opt/%s/ /opt/%s\n' "$name" "$name" > "$PKG/etc/revdep.d/$name.paths"

}
