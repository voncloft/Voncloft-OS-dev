# description	: X11 Distributed Multihead extension library
# depends	: libdmx

name=libdmx-32
version=1.1.5
release=1
source="https://www.x.org/pub/individual/lib/libdmx-1.1.5.tar.gz"

build() {
	cd libdmx-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
