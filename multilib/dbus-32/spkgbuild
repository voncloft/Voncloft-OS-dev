# description : 32-bit D-Bus client library for interprocess communication
# depends : dbus expat-32 libx11-32 meson ninja pkgconf

name=dbus-32
version=1.16.4
release=2
_name=${name%-32}
source="https://dbus.freedesktop.org/releases/${_name}/${_name}-${version}.tar.xz"

options="!checksum"

build() {
    cd "${_name}-${version}"
    export CC="gcc -m32"
    export CXX="g++ -m32"
    export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH
    meson setup build --prefix=/usr \
        --buildtype=release --wrap-mode=nofallback \
        --libdir=lib32 -Dsystemd=disabled
    ninja -C build
    DESTDIR="$PWD/build/DESTDIR" ninja -C build install
    # The native package owns the daemon, tools, headers and service files.
    install -dm755 "$PKG/usr/lib32"
    cp -a build/DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
}
