# description : Rust standard libraries for i686-unknown-linux-gnu
# depends : rust llvm cmake python curl libssh2

name=rust-32
version=1.99.1
release=1
_name=rustc
source="https://static.rust-lang.org/dist/${_name}-${version}-src.tar.xz"
options="!checksum"

build() {
    cd "${_name}-${version}-src"
    # Rust checks the full compiler identity in crate metadata. Use the same
    # distribution description as the matching native package, including when
    # that description changes in a future native Rust recipe.
    local _description
    _description=$(python3 - "$version" "/opt/${_name}-${version}/bin/rustc" <<'PYIDENTITY'
import json, re, subprocess, sys
identity = subprocess.check_output([sys.argv[2], '--version'], text=True).strip()
match = re.fullmatch(r'rustc ' + re.escape(sys.argv[1]) + r' \([^)]+\) \(([^)]+)\)', identity)
if not match:
    raise SystemExit('The matching native Rust compiler must be installed first: ' + identity)
print(json.dumps(match[1]))
PYIDENTITY
    ) || return 1
    cat > bootstrap.toml << EOF
change-id = 140732

[llvm]
link-shared = true

[build]
description = ${_description}
docs = false
extended = false
locked-deps = true
target = ["i686-unknown-linux-gnu"]

[install]
prefix = "/opt/${_name}-${version}"
docdir = "share/doc/${_name}-${version}"

[rust]
channel = "stable"
lto = "thin"
codegen-units = 1
lld = false
llvm-bitcode-linker = false

[target.x86_64-unknown-linux-gnu]
llvm-config = "/usr/bin/llvm-config"

[target.i686-unknown-linux-gnu]
cc = "/usr/bin/gcc"
cxx = "/usr/bin/g++"
ar = "/usr/bin/gcc-ar"
ranlib = "/usr/bin/gcc-ranlib"
llvm-config = "/usr/bin/llvm-config"
EOF
    ./x.py build -j"${NINJAJOBS:-6}" --target i686-unknown-linux-gnu library/std
    DESTDIR="$SRC/rust32-dest" ./x.py install -j"${NINJAJOBS:-6}" \
        --target i686-unknown-linux-gnu library/std

    # This addon owns only its target libraries; the native package owns tools
    # and the shared Rust installer metadata.
    install -dm755 "$PKG/opt/${_name}-${version}/lib/rustlib"
    cp -a "$SRC/rust32-dest/opt/${_name}-${version}/lib/rustlib/i686-unknown-linux-gnu" \
        "$PKG/opt/${_name}-${version}/lib/rustlib/"
}
