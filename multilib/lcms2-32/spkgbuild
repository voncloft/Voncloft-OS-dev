# description	: Small-footprint color management engine, with special focus on accuracy and performance
# depends	: lcms2

name=lcms2-32
version=2.19.1
release=1
source="https://downloads.sourceforge.net/project/lcms/lcms/2.19.1/lcms2-2.19.1.tar.gz"

build() {
	cd "$SRC"/lcms2*/

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure --prefix=/usr --libdir=/usr/lib32 --disable-static
	make
	make DESTDIR=$PKG install

	rm -fr $PKG/usr/{bin,share,include}
}
