# description : Character encoding conversion runtime libraries (32-bit)
# depends :

name=libiconv-32
version=1.19.1
release=5

_name=${name%-32}
source="https://ftp.gnu.org/pub/gnu/${_name}/${_name}-${version}.tar.gz"
options="!checksum"

build()
{
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig
    export PKG_CONFIG_PATH=/usr/lib32/pkgconfig
	cd *
	CFLAGS="-m32" LDFLAGS="-m32" ./configure --prefix=/usr --libdir=/usr/lib32 --enable-static --enable-shared
	make
        make DESTDIR=$PWD/DESTDIR install
        mkdir -p $PKG/usr/lib32
        cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32

}
