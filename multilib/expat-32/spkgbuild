# description	: A stream oriented C library for parsing XML
# depends	: expat

name=expat-32
version=2.9.0
release=1
_name=${name%-32}
source="https://downloads.sourceforge.net/project/${_name}/${_name}/${version}/${_name}-${version}.tar.xz"

build() {
	cd "$SRC"/expat*/

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

	# fix a problem with the regression tests in the LFS environment
	sed -i 's|usr/bin/env |bin/|' run.sh.in

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
