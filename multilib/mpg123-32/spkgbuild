# description	: Console-based MP3 player
# depends	: mpg123 alsa-lib-32 sdl-32

name=mpg123-32
version=1.33.7
release=1
source="https://downloads.sourceforge.net/project/mpg123/mpg123/1.33.7/mpg123-1.33.7.tar.bz2"

build() {
	cd "$SRC"/mpg123*/

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure --prefix=/usr --libdir=/usr/lib32 --with-audio="alsa sdl" --with-cpu=i586
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{bin,share,include}
}
