# description : XML parsing library and utilities (32-bit)
# depends : libxml2 icu-32

name=libxml2-32
version=2.15.4
release=3
_name=${name%-32}
source="https://download.gnome.org/sources/${_name}/${version%.*}/${_name}-${version}.tar.xz"

build() {
    cd "$_name-$version"
    export CC="gcc -m32"
    export CXX="g++ -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig
    export PKG_CONFIG_PATH=/usr/lib32/pkgconfig
    ./configure --prefix=/usr --sysconfdir=/etc --disable-static \
        --with-history --with-icu --with-schematron --libdir=/usr/lib32 \
        --docdir=/usr/share/doc/$_name-$version --without-python
    make
    make DESTDIR="$SRC/stage" install
    install -dm755 "$PKG/usr/lib32"
    cp -a "$SRC/stage/usr/lib32/." "$PKG/usr/lib32/"
    rm -f "$PKG/usr/lib32/libxml2.la"
}
