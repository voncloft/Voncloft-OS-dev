# description	: Next generation of the python high-level scripting language
# depends	: libffi-32 python

name=python3-32
_upstream_name=python-32
version=3.15.2
release=1
_name=Python
source="https://www.python.org/ftp/python/${version}/${_name}-${version}.tar.xz"

build() {
	cd "$SRC"/Python*/

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

  	CXX="/usr/bin/g++"              \
	./configure --prefix=/usr       \
		    --libdir=/usr/lib32 \
	            --enable-shared     \
	            --with-system-expat \
	            --with-system-ffi   \
	            --without-ensurepip
	make
	make DESTDIR=$PKG install

	chmod -v 755 $PKG/usr/lib32/libpython${version::3}.so
	chmod -v 755 $PKG/usr/lib32/libpython.so

	mv $PKG/usr/include/python.8/pyconfig.h $PKG/
	rm -r $PKG/usr/{bin,include,lib,share/man}
	install -d $PKG/usr/include/python.8
	mv $PKG/pyconfig.h $PKG/usr/include/python.8/pyconfig-32.h
}


