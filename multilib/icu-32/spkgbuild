# description : International Components for Unicode libraries (32-bit)
# depends : icu
name=icu-32
version=79.1
release=5
_name=icu
_source_name=icu4c
source="https://github.com/unicode-org/${_name}/releases/download/release-${version}/${_source_name}-${version}-sources.tgz
        bidi-array-overflow.patch"

build() {
    export CC="gcc -m32"
    export CXX="g++ -m32"
    # Avoid x87 extended intermediates in ICU floating-point computations.
    export CFLAGS="${CFLAGS} -msse2 -mfpmath=sse"
    export CXXFLAGS="${CXXFLAGS} -msse2 -mfpmath=sse"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig
    export PKG_CONFIG_PATH=/usr/lib32/pkgconfig
    cd "$SRC/icu/source"
    patch --fuzz=0 -p1 < "$SRC/bidi-array-overflow.patch"
    ./configure --prefix=/usr --libdir=/usr/lib32 --disable-static
    make
    make DESTDIR="$SRC/stage" install
    install -dm755 "$PKG/usr/lib32"
    cp -a "$SRC/stage/usr/lib32/." "$PKG/usr/lib32/"
}
