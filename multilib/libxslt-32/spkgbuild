# description	: XSLT libraries used for extending libxml2 libraries to support XSLT files
# depends	: libxslt libgpg-error-32 libgcrypt-32 libxml2-32

name=libxslt-32
version=1.1.45
release=1
_name=${name%-32}
source="https://download.gnome.org/sources/${_name}/${version%.*}/${_name}-${version}.tar.xz"

build() {
	cd "$SRC"/libxslt*/

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	sed -i s/3000/5000/ libxslt/transform.c doc/xsltproc.{1,xml}
	
	./configure --prefix=/usr --libdir=/usr/lib32 --disable-static
	make
	make DESTDIR=$PKG install

	rm -fr $PKG/usr/{bin,share,include}
}
