# description	: A tool for generating C bindings for Rust code
# depends	: rust

name=cbindgen-32
_upstream_name=cbindgen
version=0.29.4
release=1
source="https://github.com/eqrion/${_upstream_name}/archive/v$version/${_upstream_name}-$version.tar.gz"
options="!checksum"

build() {
	cd *
	cargo build --release
	mkdir -pv $PKG/usr/bin
	install -Dm755 target/release/cbindgen $PKG/usr/bin/
}
