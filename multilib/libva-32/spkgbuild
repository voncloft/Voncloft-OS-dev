# description   : The libva package contains a library which provides access to hardware accelerated video processing, using hardware to accelerate video processing in order to offload the central processing unit (CPU) to decode and encode compressed digital video
# depends       : meson ninja pkgconf libdrm-32 libx11-32 libxext-32 libxfixes-32 libxcb-32 libglvnd-32 wayland-32 wayland

name=libva-32
version=2.24.1    
release=3
_name=${name%-32}
source="https://github.com/intel/${_name}/archive/${version}/${_name}-${version}.tar.gz"

options="!checksum"

build() {
    cd *
    export CC="gcc -m32"
    export CXX="g++ -m32"
    export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"
    export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"
    mkdir -p build
    cd build 
    meson setup --prefix=/usr --libdir=/usr/lib32 --buildtype=release 
    ninja
    DESTDIR=$PWD/DESTDIR ninja install
    mkdir -p $PKG/usr/lib32
    cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
