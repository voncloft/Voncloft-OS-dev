# description	: Programs for compressing and decompressing files
# depends	: xz

name=xz-32
version=5.8.4
release=1
_name=${name%-32}
source="https://github.com/tukaani-project/${_name}/releases/download/v${version}/${_name}-${version}.tar.gz"

build() {
	cd xz-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

	./configure --prefix=/usr    \
		    --libdir=/usr/lib32 \
	            --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
