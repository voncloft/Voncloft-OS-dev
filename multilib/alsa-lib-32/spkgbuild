# description	: ALSA library used by programs (including ALSA Utilities) requiring access to the ALSA sound interface
# depends	: alsa-lib

name=alsa-lib-32
version=1.2.16.1
release=1
source="https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.16.1.tar.bz2"

build() {
	cd "$SRC"/alsa-lib*/

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig"

  	./configure --libdir=/usr/lib32
	make
	make DESTDIR=$PKG install

	rm -fr $PKG/usr/{bin,share,include}
}
