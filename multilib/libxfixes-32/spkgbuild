# description	: X11 miscellaneous 'fixes' extension library
# depends	: libxfixes

name=libxfixes-32
version=6.0.2
release=1
_name=libXfixes
source="https://www.x.org/pub/individual/lib/${_name}-${version}.tar.gz"

build() {
	cd libXfixes-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}

