# description	: X11 Xinerama extension library
# depends	: libxinerama

name=libxinerama-32
version=1.1.6
release=1
source="https://www.x.org/pub/individual/lib/libXinerama-1.1.6.tar.gz"

build() {
	cd libXinerama-$version

	export CC="gcc -m32"
	export CXX="g++ -m32"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

	./configure \
		--prefix=/usr \
                --sysconfdir=/etc \
		--libdir=/usr/lib32 \
                --localstatedir=/var \
                --disable-static
	make
	make DESTDIR=$PWD/DESTDIR install
	mkdir -p $PKG/usr/lib32
	cp -Rv DESTDIR/usr/lib32/* $PKG/usr/lib32
}
