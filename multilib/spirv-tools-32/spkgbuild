# description : SPIRV-Tools (32-bit)
# depends : cmake spirv-headers ninja

name=spirv-tools-32
version=2026.4
release=1

_name=SPIRV-Tools
source="https://github.com/KhronosGroup/${_name}/archive/refs/tags/vulkan-sdk-$version.tar.gz"
options="!checksum"

build()
{

cd SPIRV-*
mkdir -p build

export ASFLAGS+=" --32"
export CFLAGS+=" -m32"
export CXXFLAGS+=" -m32"
export PKG_CONFIG_PATH="/usr/lib32/pkgconfig:$PKG_CONFIG_PATH"

# Run cmake *inside* source dir, generating build in 'build'
cmake -S . -B build \
      -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release \
      -D SPIRV_WERROR=OFF \
      -D BUILD_SHARED_LIBS=ON \
      -D SPIRV_TOOLS_BUILD_STATIC=OFF \
      -D SPIRV-Headers_SOURCE_DIR=/usr \
      -D CMAKE_INSTALL_LIBDIR=lib32 \
      -G Ninja

# Build inside build dir
cmake --build build

# Install
DESTDIR="$PKG" cmake --install build
}

