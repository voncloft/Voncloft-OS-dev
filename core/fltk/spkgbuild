# description	: Graphical user interface toolkit for X
# depends	: cmake libjpeg-turbo zlib libpng fontconfig libglvnd glu shared-mime-info

name=fltk
version=1.4.5
release=1

source="https://github.com/fltk/${name}/releases/download/release-${version}/${name}-${version}-source.tar.gz"
build() {
	cd $name-$version
	sed -i -e '/cat./d' documentation/Makefile 
	./configure --prefix=/usr    \
            --enable-shared

	make
	make DESTDIR=$PKG install
}
