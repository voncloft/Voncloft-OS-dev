# depends : 
# description   : Xapian is an open source search engine library

name=xapian
version=2.1.0    
release=2
_name=xapian-core
source="https://oligarchy.co.uk/xapian/${version}/${_name}-${version}.tar.xz"

options="!checksum"

build() {
        cd "$SRC"/xapian-core*/
        ./configure --prefix=/usr    \
--disable-static \
--docdir=/usr/share/doc/xapian-core-1.4.29 
make
make DESTDIR=$PKG install
}
