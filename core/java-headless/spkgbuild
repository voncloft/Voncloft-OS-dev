# description : OpenJDK Java runtime and development tools for Java applications and servers
# depends : alsa-lib cups giflib lcms2 xorg-libraries

name=java-headless
version=27.0.1.0.2
release=10

_archive=https://download.java.net/java/GA/jdk27.0.1.0.2/924dbdccfc234bb9b9355d7c6b66034b/1/GPL/openjdk-27.0.1.0.2_linux-x64_bin.tar.gz
_sha256=e69ee3937022c1caa8eaa32a586955ba13c109ad6986a6a1a7f1d5e6fa8998e3
source="$_archive"
noextract="${_archive##*/}"
options="!checksum !strip"

build() {
    local archive="$SRC/${_archive##*/}" unpack="$SRC/java-unpack" java_root
    # Official OpenJDK updates supply a SHA-256; the legacy recipe has none stored.
    if [ -n "$_sha256" ]; then
        printf '%s  %s\n' "$_sha256" "$archive" | sha256sum -c - || return 1
    fi
    install -dm755 "$unpack"
    tar -xf "$archive" -o -C "$unpack" || return 1
    local -a launchers=("$unpack"/*/bin/java)
    [ "${#launchers[@]}" = 1 ] && [ -x "${launchers[0]}" ] || return 1
    java_root=${launchers[0]%/bin/java}
    grep -Fxq "JAVA_VERSION=\"$version\"" "$java_root/release" || return 1

    install -dm755 "$PKG/opt/OpenJDK-$version-bin" "$PKG/etc/profile.d" "$PKG/etc/sudoers.d"
    cp -a "$java_root/." "$PKG/opt/OpenJDK-$version-bin/"
    ln -sfn "OpenJDK-$version-bin" "$PKG/opt/jdk"
    cat > "$PKG/etc/profile.d/openjdk.sh" <<'EOF'
# OpenJDK environment
export JAVA_HOME=/opt/jdk
if command -v pathappend >/dev/null 2>&1; then
    pathappend "$JAVA_HOME/bin"
else
    export PATH="$JAVA_HOME/bin:$PATH"
fi
EOF
    chmod 644 "$PKG/etc/profile.d/openjdk.sh"
    cat > "$PKG/etc/sudoers.d/java" <<'EOF'
Defaults env_keep += JAVA_HOME
Defaults env_keep += CLASSPATH
EOF
    chmod 440 "$PKG/etc/sudoers.d/java"
}
