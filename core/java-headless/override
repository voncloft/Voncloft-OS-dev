# Fetch upstream data as data; never source downloaded shell code.
source='https://jdk.java.net/archive/'
url=$source

get_generic()
{
    local detected recipe comparison edit
    local -a fields sed_args
    unset uversion update_repo_review_reason
    recipe="${ppath%/*}/spkgbuild"
    detected=$(python3 - "$recipe" "$version" <<'PYRELEASE'
from pathlib import Path
from html.parser import HTMLParser
from urllib.parse import urlsplit
import re, subprocess, sys
recipe=Path(sys.argv[1])
try:
    review='-'
    choices=[]
    class Links(HTMLParser):
        def handle_starttag(self,tag,attrs):
            if tag!='a':return
            url=dict(attrs).get('href','')
            match=re.fullmatch(r'https://download\.java\.net/java/GA/[^/]+/[a-f0-9]+/([0-9]+)/GPL/openjdk-([0-9]+(?:\.[0-9]+)*)_linux-x64_bin\.tar\.gz',url)
            if match:
                choices.append((tuple(map(int,match[2].split('.'))),int(match[1]),match[2],url))
    Links().feed(Path('index.html').read_text())
    if not choices:raise ValueError('no stable Linux x86_64 OpenJDK binary')
    _,_,version,url=max(choices)
    published=subprocess.run(['curl','-fLsS','--connect-timeout','10','--max-time','25',url+'.sha256'],check=True,capture_output=True,text=True).stdout.strip()
    if not re.fullmatch(r'[a-fA-F0-9]{64}',published):raise ValueError('invalid published OpenJDK SHA-256')
    updates={'_archive':url,'_sha256':published.lower()}
    text=recipe.read_text()
    for key in updates:
        if len(re.findall(r'^'+re.escape(key)+r'=.*$',text,re.M))!=1:
            raise ValueError('missing or duplicate recipe field '+key)
    print(version)
    print(review)
    for key,value in updates.items():
        if not re.fullmatch(r'[A-Za-z0-9._:/-]+',value):
            raise ValueError('invalid recipe metadata')
        print('s|^'+key+'=.*$|'+key+'='+value+'|')
except (OSError,ValueError,KeyError,IndexError,StopIteration,TypeError,subprocess.SubprocessError) as error:
    sys.exit('ERROR: Invalid upstream release metadata: '+str(error))
PYRELEASE
    ) || return 1
    mapfile -t fields <<< "$detected"
    uversion=${fields[0]}
    if [ "${fields[1]}" != - ]; then
        update_repo_review_reason=${fields[1]}
        return 0
    fi
    if vercomp "$uversion" "$version" >/dev/null; then
        return 0
    else
        comparison=$?
    fi
    [ "$comparison" = 2 ] || return 0
    for edit in "${fields[@]:2}"; do sed_args+=(-e "$edit"); done
    if [ -n "${test_upgrade:-}" ]; then
        printf 'sed -i' >> test_updates.sh
        printf ' %q' "${sed_args[@]}" -- "$recipe" >> test_updates.sh
        printf '\n' >> test_updates.sh
    else
        sed -i "${sed_args[@]}" -- "$recipe" || return 1
    fi
}
