# description	: Toolkit for image loading and pixel buffer manipulation
# depends	: glib libjpeg-turbo libpng libtiff shared-mime-info libx11 libxcb libxau jasper glib

name=gdk-pixbuf
version=2.44.8
release=1
source="https://download.gnome.org/sources/gdk-pixbuf/2.44/gdk-pixbuf-2.44.8.tar.xz"

build() {
	cd $name-$version

	mkdir build
	cd build
	
	
meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -D others=enabled   \
      --wrap-mode=nofallback
	ninja
	DESTDIR=$PKG ninja install
}
