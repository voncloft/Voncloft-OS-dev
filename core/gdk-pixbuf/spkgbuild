# description	: Toolkit for image loading and pixel buffer manipulation
# depends : glib glycin python-docutils shared-mime-info meson ninja pkgconf

name=gdk-pixbuf
version=2.44.8
release=2
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	cd $name-$version

	mkdir build
	cd build
	
	
meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -D glycin=enabled   \
      --wrap-mode=nofallback
	ninja
	DESTDIR=$PKG ninja install
}
