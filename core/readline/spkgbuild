# description : Set of libraries that offers command-line editing and history capabilities
# depends     : ncurses

name=readline
version=8.3.6
release=2
_baseversion=${version%.*}
_patchlevel=${version##*.}
_series=$(printf '%s' "$_baseversion" | tr -d .)
source="https://ftp.gnu.org/gnu/${name}/${name}-${_baseversion}.tar.gz"
for _patch in $(seq -f '%03g' 1 "$_patchlevel"); do
    source="$source https://ftp.gnu.org/gnu/${name}/${name}-${_baseversion}-patches/${name}${_series}-${_patch}"
done

build() {
    # 64-bit build.
    cd "$name-$_baseversion"
    for _patch in $(seq -f '%03g' 1 "$_patchlevel"); do
        patch --fuzz=0 -Np0 -i "$SRC/${name}${_series}-${_patch}"
    done

    sed -i '/MV.*old/d' Makefile.in
    sed -i '/{OLDSUFF}/c:' support/shlib-install

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --disable-static
    make SHLIB_LIBS="-lncursesw"
    make SHLIB_LIBS="-lncursesw" DESTDIR=$PKG install

    # Keep libraries in /usr/lib; /lib is the host usrmerge alias.

    rm -r $PKG/usr/share/info \
        $PKG/usr/share/doc

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --disable-static \
        --with-curses
    make SHLIB_LIBS="-lncursesw"
    make SHLIB_LIBS="-lncursesw" DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
