# description : C extensions for Python
# depends : python python-setuptools python-wheel

name=cython3
version=3.3.0
release=2
_name=cython
source="https://files.pythonhosted.org/packages/a9/d8/4981ef716ad0e3ff0d3ef383aefc6b03c4a88dee33b272bf8e0d833001ca/${_name}-${version}.tar.gz"
options="!checksum"

build() {
    cd "cython-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/cython-"$version"-*.whl
}
