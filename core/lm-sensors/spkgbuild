# description : hardware temp monitor
# depends : which

name=lm-sensors
version=3.6.2
release=1

_version=${version//./-}
source="${name}-${version}.tar.gz::https://github.com/hramrach/${name}/archive/refs/tags/V${_version}.tar.gz"

build()
{
	cd "$SRC"/lm-sensors*/
	make PREFIX=/usr        \
     BUILD_STATIC_LIB=0 \
     MANDIR=/usr/share/man

     make DESTDIR=$PKG PREFIX=/usr        \
     BUILD_STATIC_LIB=0 \
     MANDIR=/usr/share/man install
}
