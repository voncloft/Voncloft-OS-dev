# description	: A tool to display dialog boxes from shell scripts
# depends	: ncurses

name=dialog
version=1.3_20260721
verzion=$(echo $version | sed 's/_/-/')
release=1
_version=${version//_/-}
source="https://invisible-mirror.net/archives/${name}/${name}-${_version}.tgz"

build () {
	cd "$SRC"/dialog*/

	./configure \
		--prefix=/usr \
		--with-ncursesw \
		--with-libtool
	make
	make DESTDIR=$PKG install
}
