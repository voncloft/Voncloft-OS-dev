# description	: Lightweight GTK+ clipboard manager (fork of Parcellite)
# depends	: gtk3 intltool

name=clipit
version=1.4.5
release=1
_name=ClipIt
source="https://github.com/CristianHenzel/${_name}/archive/v$version/$name-$version.tar.gz"

build() {
	cd ClipIt-$version

	./autogen.sh
	./configure \
		--prefix=/usr \
        	--sysconfdir=/etc \
		--disable-nls \
		--with-gtk3
	make
	make DESTDIR=$PKG install
}

