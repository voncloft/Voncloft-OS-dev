# description : libraries for gslang
# depends : cmake spirv-headers

name=spirv-tools
version=2026.4
release=1

_name=SPIRV-Tools
source="${_name}-${version}.tar.gz::https://github.com/KhronosGroup/${_name}/archive/refs/tags/v${version}.tar.gz"
options="!checksum"
build()
{
	cd "${_name}-${version}"
	mkdir build &&
cd    build &&

cmake -D CMAKE_INSTALL_PREFIX=/usr     \
      -D CMAKE_BUILD_TYPE=Release      \
      -D SPIRV_SKIP_TESTS=ON \
      -D SPIRV_WERROR=OFF              \
      -D BUILD_SHARED_LIBS=ON          \
      -D SPIRV_TOOLS_BUILD_STATIC=OFF  \
      -D SPIRV-Headers_SOURCE_DIR=/usr \
      -G Ninja .. 
	ninja
      DESTDIR=$PKG ninja install
}
