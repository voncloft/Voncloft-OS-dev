# description	: Firmware files for soundcard - YOU WILL NEED THIS FOR LINUX

name=sof-firmware
version=2026.09.2
release=1
options="!strip"
_name=sof-bin
source="https://github.com/thesofproject/${_name}/releases/download/v${version}/${_name}-${version}.tar.gz"

build() {
	cd $_name-$version

	fwdir=$PKG/usr/lib/firmware/intel
	mkdir -pv $fwdir
	cp -at $fwdir sof*
	

}
