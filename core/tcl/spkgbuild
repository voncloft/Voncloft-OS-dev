# description	: The Tcl scripting language
# depends	: zlib

name=tcl
version=9.1.0
release=1
source="https://downloads.sourceforge.net/tcl/tcl$version-src.tar.gz"

build() {
	cd $name$version/unix

	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--without-tzdata
	make
	make INSTALL_ROOT=$PKG install install-private-headers

	ln -sv "tclsh${version%.*}" "$PKG/usr/bin/tclsh"

	# conflict with perl
	if [ -f "$PKG/usr/share/man/man3/Thread.3" ]; then
		mv "$PKG/usr/share/man/man3/Thread.3" "$PKG/usr/share/man/man3/Tcl_Thread.3"
	fi
}
