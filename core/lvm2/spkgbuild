# description	: Set of tools that manage logical partitions
# depends	: libaio

name=lvm2
version=2.03.43
release=1
backup="etc/lvm/lvm.conf
	etc/lvm/lvmlocal.conf"
source="https://sourceware.org/pub/lvm2/releases/LVM2.2.03.43.tgz"

build() {
	cd "$SRC"/LVM2*/

	PATH=$PATH:/sbin:/usr/sbin      \
	./configure --prefix=/usr       \
	            --exec-prefix=      \
	            --enable-cmdlib     \
	            --enable-pkgconfig  \
	            --enable-udev_sync
	make
	make DESTDIR=$PKG install
}
