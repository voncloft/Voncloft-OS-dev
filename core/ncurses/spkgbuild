# description : Libraries for terminal-independent handling of character screens
# depends     : gcc

name=ncurses
version=6.6
release=2
source="https://invisible-island.net/archives/$name/$name-$version.tar.gz"

build() {
    # 64-bit build.
    cd "$name-$version"

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --mandir=/usr/share/man \
        --with-shared \
        --without-debug \
        --without-normal \
        --with-cxx-shared \
        --enable-widec \
        --enable-pc-files \
        --with-pkg-config-libdir=/usr/lib/pkgconfig
    make
    make DESTDIR="$PKG" install

    sed -e 's/^#if.*XOPEN.*$/#if 1/' -i "$PKG/usr/include/curses.h"
    for lib in ncurses form panel menu; do
        ln -sfv "lib${lib}w.so" "$PKG/usr/lib/lib${lib}.so"
        ln -sfv "${lib}w.pc" "$PKG/usr/lib/pkgconfig/${lib}.pc"
    done
    ln -sfv libncurses.so "$PKG/usr/lib/libcurses.so"

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --with-build-cc=gcc \
        --mandir=/usr/share/man \
        --with-shared \
        --without-debug \
        --without-normal \
        --with-cxx-shared \
        --enable-widec \
        --enable-pc-files \
        --with-pkg-config-libdir=/usr/lib32/pkgconfig
    make
    make DESTDIR="$PWD/DESTDIR" install
    for _lib in ncurses form panel menu; do
        ln -sf "lib${_lib}w.so" "$PWD/DESTDIR/usr/lib32/lib${_lib}.so"
        ln -sf "${_lib}w.pc" "$PWD/DESTDIR/usr/lib32/pkgconfig/${_lib}.pc"
    done
    ln -sf libncurses.so "$PWD/DESTDIR/usr/lib32/libcurses.so"
    ln -sf libncursesw.so "$PWD/DESTDIR/usr/lib32/libcursesw.so"

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
