# description   : The cifs-utils package provides a means for mounting SMB/CIFS shares on a Linux system
# depends       : talloc

name=cifs-utils
version=7.9    
release=1
source="https://www.samba.org/ftp/linux-cifs/${name}/${name}-${version}.tar.bz2"

options="!checksum"

build() {
        cd $name-$version
        autoreconf -fiv
./configure --prefix=/usr \
--disable-pam \
--disable-systemd 
make
make DESTDIR=$PKG install
}
