# description   : The cifs-utils package provides a means for mounting SMB/CIFS shares on a Linux system
# depends       : talloc

name=cifs-utils
version=7.9    
release=1
# Debian mirrors the original upstream archive without the packaging patches.
source="${name}-${version}.tar.bz2::https://deb.debian.org/debian/pool/main/c/${name}/${name}_${version}.orig.tar.bz2"

options="!checksum"

build() {
        cd $name-$version
        autoreconf -fiv
ROOTSBINDIR=/usr/sbin ./configure --prefix=/usr \
--disable-pam \
--disable-systemd 
make
make DESTDIR=$PKG install
}
