# description	: Programs for monitoring processes
# depends	: ncurses

name=procps-ng
version=4.0.7
release=3
source="https://sourceforge.net/projects/${name}/files/Production/$name-$version.tar.xz"

# Sysvinit owns pidof on VonOS; do not install a second provider.
build() {
	cd "$name-$version"
	sed 's:<ncursesw/:<:g' -i src/watch.c
	./configure \
    	--prefix=/usr \
    	--exec-prefix=/ \
    	--sysconfdir=/etc \
    	--libdir=/usr/lib \
    	--bindir=/usr/bin \
    	--sbindir=/usr/bin \
    	--enable-watch8bit \
        --disable-kill \
        --disable-pidof
	make
	make DESTDIR=$PKG install

}
