# Query the upstream stable release instead of the old source directory.
source="https://api.github.com/repos/doxygen/doxygen/releases/latest"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import json,pathlib,re
data=json.loads(pathlib.Path('index.html').read_text())
if data.get('draft') or data.get('prerelease'): raise SystemExit('Not a stable release')
match=re.fullmatch('Release_([0-9]+(?:_[0-9]+)*)',data['tag_name'])
if not match: raise SystemExit('Unexpected upstream tag format')
print(match[1].replace('_','.'))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
