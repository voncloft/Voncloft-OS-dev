# description	: Used to set up transparent encryption of block devices using the kernel crypto API
# depends	: popt json-c lvm2

name=cryptsetup
version=2.8.8
release=1
source="https://www.kernel.org/pub/linux/utils/${name}/v${version%.*}/$name-$version.tar.xz"

build() {
	cd $name-$version

	./configure --prefix=/usr       \
            --disable-ssh-token \
            --disable-asciidoc
	make
	make DESTDIR=$PKG install
}
