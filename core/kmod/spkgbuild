# description : kernel module loader
# depends     : zlib xz zstd openssl meson ninja

name=kmod
version=34.4
release=3
source="https://www.kernel.org/pub/linux/utils/kernel/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    # 64-bit build.
    cd $name-$version
    mkdir -p build
    cd build

    meson setup .. \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -D manpages=false
    ninja
    DESTDIR=$PKG ninja install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dmanpages=false \
        -Dtools=false \
        -Dzstd=disabled \
        -Dxz=enabled \
        -Dzlib=enabled \
        -Dopenssl=disabled
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
