# description	: Interface to enumerating power devices, listening to device events and querying history and statistics
# depends	: dbus-glib libgudev libusb

name=upower
version=1.91.5
release=1
backup="etc/UPower/UPower.conf"

source="https://gitlab.freedesktop.org/${name}/${name}/-/archive/v${version}/${name}-v${version}.tar.bz2"

build() {
	cd *

	mkdir build &&
	cd    build &&

	meson setup ..                   \
      --prefix=/usr              \
      --buildtype=release        \
      -D gtk-doc=false           \
      -D man=false               \
      -D systemdsystemunitdir=no \
      -D installed_tests=false   \
      -D udevhwdbdir=/usr/lib/udev/hwdb.d \
      -D udevrulesdir=/usr/lib/udev/rules.d &&
	ninja

	DESTDIR=$PKG ninja install
}
