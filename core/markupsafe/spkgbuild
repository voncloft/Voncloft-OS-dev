name=markupsafe
version=3.0.4
release=1
source="https://files.pythonhosted.org/packages/38/9b/e422a865e1d5d57d0e509b4e0bf1c1a70a7f6382c29a5aa428df994c8bc8/${name}-${version}.tar.gz"
options="!checksum"
build() {
	cd $name-$version
	pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
	pip3 install --no-index --find-links dist Markupsafe --root=$PKG
}
