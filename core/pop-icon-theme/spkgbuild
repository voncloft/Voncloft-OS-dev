# description	: A free and open source SVG icon theme for Linux, based on Paper Icon Set and Papirus

# depends : meson ninja adwaita-icon-theme

name=pop-icon-theme
version=20241001164617
release=2
options="!strip"
_commit=1a575a8e99b4ae629b9b16543a3a04d148632ba9
source="$name-$_commit.tar.gz::https://github.com/pop-os/icon-theme/archive/1a575a8e99b4ae629b9b16543a3a04d148632ba9.tar.gz"

build() {
	cd "$SRC"/icon-theme*/
	if [ -f meson.build ]; then
	    meson setup build --prefix=/usr
	    ninja -C build
	    DESTDIR="$PKG" ninja -C build install
	else
	    make DESTDIR="$PKG" install
	fi
}
