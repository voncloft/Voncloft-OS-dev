# description	: A set of free peer-reviewed portable C++ source libraries
# depends	: icu python-numpy which

name=boost
version=1.92.0
release=2

source="https://github.com/boostorg/${name}/releases/download/${name}-$version/${name}-$version-b2-nodocs.tar.xz"
options="!checksum"

build() {
	cd "$name-$version"
	case $(uname -m) in
   i?86)
      sed -e "s/defined(__MINGW32__)/& || defined(__i386__)/" \
          -i ./libs/stacktrace/src/exception_headers.h ;;
	esac
	./bootstrap.sh --prefix=/usr --with-python=python3
	./b2 -j"${NINJAJOBS:-4}" threading=multi link=shared variant=release stage
    ./b2 -j"${NINJAJOBS:-4}" threading=multi link=shared variant=release \
        --prefix="$PKG/usr" install
}
