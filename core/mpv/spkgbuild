# description : mpv
# depends : alsa-lib ffmpeg lcms2 libarchive libass libplacebo libx11 libxext libxinerama libxkbcommon libxpresent libxrandr libxss libxv luajit meson ninja pipewire pkgconf pulseaudio python wayland wayland-protocols

name=mpv
version=0.41.0
release=2
options="!checksum"
source="${name}-${version}.tar.gz::https://github.com/mpv-player/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    cd "mpv-${version}"
    meson setup build --prefix=/usr --libdir=lib64 --buildtype=release \
        -Dlibmpv=true
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
