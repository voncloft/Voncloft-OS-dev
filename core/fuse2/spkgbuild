# description : FUSE 2 compatibility library and mount helper for applications using libfuse.so.2
# depends :

name=fuse2
version=2.9.9
release=1
source="https://github.com/libfuse/libfuse/releases/download/fuse-$version/fuse-$version.tar.gz"

build() {
    cd "fuse-$version"
    # The old helper's private function conflicts with modern glibc closefrom().
    sed -i 's/closefrom(/fuse_closefrom(/g' util/ulockmgr_server.c
    ./configure --prefix=/usr --libdir=/usr/lib --sbindir=/usr/bin \
        --disable-static --disable-example --disable-mtab --disable-util
    make
    make -C util
    make DESTDIR="$PKG" install
    # Stage helpers directly; upstream's util install hook changes host startup.
    install -Dm4755 util/fusermount "$PKG/usr/bin/fusermount"
    install -Dm755 util/ulockmgr_server "$PKG/usr/bin/ulockmgr_server"
    install -Dm755 util/mount.fuse "$PKG/usr/bin/mount.fuse"
}
