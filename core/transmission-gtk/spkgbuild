# description	: Fast, easy, and free BitTorrent client (GTK+ GUI)
# depends	: curl libevent openssl gtk3 hicolor-icon-theme desktop-file-utils intltool

name=transmission-gtk
version=4.1.4
release=1
_name=transmission
source="https://github.com/transmission/${_name}/releases/download/${version}/${_name}-${version}.tar.xz"

build() {
	cd "$SRC"/transmission*/

	export LINGUAS=" "

	./configure --prefix=/usr
	make
	make -C gtk DESTDIR=$PKG install
}
