# description : Utility and a library used for transferring files
# depends     : make-ca openssl zlib libssh2 libpsl

name=curl
version=8.23.0
release=3
source="https://curl.se/download/$name-$version.tar.xz"
options="!checksum"

build() {
    # 64-bit build.
    cd $name-$version

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --disable-static \
        --enable-threaded-resolver \
        --with-openssl \
        --with-libssh2 \
        --with-ca-bundle=/etc/pki/tls/certs/ca-bundle.crt \
        --with-ca-path=/etc/ssl/certs

    make
    make DESTDIR=$PKG install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --disable-static \
        --enable-threaded-resolver \
        --with-openssl \
        --without-libssh2 \
        --without-librtmp \
        --without-libidn2 \
        --without-nghttp2 \
        --without-nghttp3 \
        --without-ngtcp2 \
        --without-zstd \
        --without-brotli \
        --with-ca-bundle=/etc/pki/tls/certs/ca-bundle.crt \
        --with-ca-path=/etc/ssl/certs
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
