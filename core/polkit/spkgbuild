# description	: Toolkit for defining and handling authorizations
# depends	: duktape glib elogind linux-pam

name=polkit
version=0.120
release=1
source="https://github.com/polkit-org/${name}/archive/$version/${name}-$version.tar.gz"
options="!checksum"
build() {
	cd $name-$version
	mkdir build
	cd build
	meson setup ..                     \
      --prefix=/usr                \
      --buildtype=release          \
      -D man=true                  \
      -D session_tracking=elogind  \
      -D systemdsystemunitdir=/tmp \
      -D tests=false
	ninja
	DESTDIR=$PKG ninja install

	rm -v $PKG/tmp/*.service                 &&
	rm -rf $PKG/usr/lib/{sysusers,tmpfiles}.d 
}
