# description	: Toolkit for defining and handling authorizations
# depends	: duktape glib elogind linux-pam

name=polkit
version=128
release=1
backup="etc/pam.d/polkit-1"
source="https://github.com/polkit-org/${name}/archive/$version/${name}-$version.tar.gz
        polkit-1"
options="!checksum"
build() {
	cd $name-$version
	mkdir build
	cd build
	meson setup ..                     \
      --prefix=/usr                \
      --buildtype=release          \
      -D man=true                  \
      -D pam_prefix=/etc/pam.d    \
      -D session_tracking=elogind  \
      -D systemdsystemunitdir=/tmp \
      -D tests=false
	ninja
	DESTDIR=$PKG ninja install

	# These systemd units are unused on Voncloft's SysV system.
	rm -v "$PKG"/tmp/*.service "$PKG"/tmp/*.socket
	rmdir "$PKG/tmp"
	rm -rf "$PKG/usr/lib/sysusers.d" "$PKG/usr/lib/tmpfiles.d"

	# Match the Voncloft PAM stack; Scratch preserves an existing local file.
	install -Dm644 "$SRC/polkit-1" "$PKG/etc/pam.d/polkit-1"
}
