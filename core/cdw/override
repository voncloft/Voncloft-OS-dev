# Detect the upstream version from package-specific release metadata.
source='https://sourceforge.net/projects/cdw/rss?path=/'
# update-repo sources this again immediately before fetching index.html.
url=$source

get_generic()
{
    local detected next_version recipe comparison edit
    local -a detected_lines source_edits sed_args
    unset uversion
    recipe="${ppath%/*}/spkgbuild"
    detected=$(python3 - '{"mode":"rss","url":"https://sourceforge.net/projects/cdw/rss?path=/","pattern":"cdw-([0-9]+(?:\\.[0-9]+)*)\\.(?:tar\\.(?:gz|xz|bz2)|tgz|zip)","extra_edits":[["\tcd $name-$version","\tcd \"$SRC\"/cdw*/"]]}' "$recipe" "$version" <<'PYUPSTREAM'
import datetime,gzip,json,pathlib,re,subprocess,sys,urllib.parse,xml.etree.ElementTree as ET
from html.parser import HTMLParser

cfg=json.loads(sys.argv[1]); recipe=pathlib.Path(sys.argv[2]); current=sys.argv[3]
def get(url):
    # Tests can provide the same downloaded upstream data without changing recipes.
    cache=pathlib.Path(__file__).parent/'cache' if '__file__' in globals() else None
    if cfg.get('_cache'):
        import hashlib
        p=pathlib.Path(cfg['_cache'])/(hashlib.sha256(url.encode()).hexdigest()+'.data')
        if p.exists():return p.read_text(errors='replace')
    result=subprocess.run(['curl','-fLsS','--max-time','20',url],capture_output=True,text=True,check=True).stdout
    if cfg.get('_cache'):p.write_text(result)
    return result
def ordered(values):
    if not values:return []
    return subprocess.run(['sort','-V'],input='\n'.join(values)+'\n',capture_output=True,text=True,check=True).stdout.splitlines()
def version(value):
    value=value.strip()
    for pattern,replacement in cfg.get('transforms',[]):value=re.sub(pattern,replacement,value)
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._+-]*',value):raise ValueError('invalid version')
    return value
def expand(template,v,raw='',sha='',stamp=''):
    return template.replace('@VERSION@',v).replace('@RAW@',raw).replace('@TAG@',urllib.parse.quote(raw,safe='/')).replace('@SHA@',sha).replace('@STAMP@',stamp).replace('@MAJOR@',v.split('.')[0]).replace('@MINOR@','.'.join(v.split('.')[:2]))
def links(text,url):
    found=[]
    class Links(HTMLParser):
        def handle_starttag(self,tag,attrs):
            if tag.lower()=='a':
                for k,v in attrs:
                    if k=='href' and v:found.append(urllib.parse.urljoin(url,v))
    Links().feed(text);return found
def add(raw,archive='',sha=''):
    v=version(raw)
    if cfg.get('series') and not re.match(cfg['series'],v):return
    if cfg.get('exclude') and re.search(cfg['exclude'],v,re.I):return
    if cfg.get('archive'):archive=expand(cfg['archive'],v,raw,sha)
    choices.append((v,archive,sha))
def parse_listing(text,url):
    for link in links(text,url):
        path=urllib.parse.unquote(urllib.parse.urlsplit(link).path).rstrip('/')
        target=path.rsplit('/',1)[-1]
        m=re.fullmatch(cfg['pattern'],target)
        if m:add(m[1],link)

try:
    data=pathlib.Path('index.html').read_bytes()
    if cfg['mode'] not in ('tar_version','deb_control') and data.startswith(b'\x1f\x8b'):data=gzip.decompress(data)
    text=data.decode('utf-8',errors='replace');choices=[];mode=cfg['mode']
    if mode=='pypi':
        obj=json.loads(text);norm=lambda x:re.sub('[-_.]+','-',x).lower()
        if norm(obj['info']['name'])!=norm(cfg['project']):raise ValueError('PyPI identity mismatch')
        for raw,files in obj['releases'].items():
            if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)*(?:(?:\.post|post)[0-9]+)?',raw):continue
            files=[f for f in files if f.get('packagetype')=='sdist' and not f.get('yanked')]
            files.sort(key=lambda f:(not f['filename'].endswith('.tar.gz'),f['filename']))
            if files:add(raw,files[0]['url'])
    elif mode in ('tags','atom_tags','git_tags'):
        if mode=='git_tags':tags=[line.split('refs/tags/',1)[1] for line in text.splitlines() if 'refs/tags/' in line and not line.endswith('^{}')]
        elif mode=='tags':tags=[r['name'] for r in json.loads(text)]
        else:
            tree=ET.fromstring(text);ns={'a':'http://www.w3.org/2005/Atom'}
            tags=[urllib.parse.unquote(e.find('a:link',ns).get('href').split('/releases/tag/',1)[-1]) for e in tree.findall('a:entry',ns)]
        for tag in tags:
            m=re.fullmatch(cfg['pattern'],tag)
            if m:
                v=version(m[1]);archive=expand(cfg.get('archive',''),v,tag)
                if cfg.get('series') and not re.match(cfg['series'],v):continue
                choices.append((v,archive,''))
    elif mode=='github_assets':
        ns={'a':'http://www.w3.org/2005/Atom'};tree=ET.fromstring(text)
        for e in tree.findall('a:entry',ns)[:cfg.get('limit',5)]:
            tag=urllib.parse.unquote(e.find('a:link',ns).get('href').split('/releases/tag/',1)[-1])
            if re.search(r'(?:alpha|beta|(?:^|[._-])rc[0-9]|pre)',tag,re.I):continue
            url=cfg['repo']+'/releases/expanded_assets/'+urllib.parse.quote(tag,safe='')
            try:parse_listing(get(url),url)
            except subprocess.CalledProcessError:continue
    elif mode=='commit':
        ns={'a':'http://www.w3.org/2005/Atom'};entry=ET.fromstring(text).find('a:entry',ns)
        identity=entry.findtext('a:id','',ns)
        sha=re.search(r'[a-f0-9]{40}',identity)[0]
        stamp=entry.findtext('a:updated','',ns)
        stamp=datetime.datetime.fromisoformat(stamp.replace('Z','+00:00')).astimezone(datetime.timezone.utc).strftime('%Y%m%d%H%M%S')
        raw=expand(cfg['version_template'],'',sha=sha,stamp=stamp)
        if cfg.get('version_file'):
            cmake=re.sub(r'#[^\n]*','',get(expand(cfg['version_file'],'',sha=sha)))
            project=re.search(r'\bproject\s*\(([^)]*)\)',cmake,re.I|re.S)
            found=re.search(r'\bVERSION\s*"?([0-9]+(?:\.[0-9]+)+)"?(?=\s|$)',project[1],re.I) if project else None
            if not found:raise ValueError('upstream CMake project version missing')
            raw=found[1]+'.git'+stamp
        if cfg.get('preserve_pinned'):
            pinned=re.search(r'^_commit=[\x27"]?([a-f0-9]{40})',recipe.read_text(),re.M)
            if pinned and pinned[1]==sha:raw=current
        choices.append((version(raw),expand(cfg['archive'],raw,sha=sha,stamp=stamp),sha))
    elif mode=='tar_version':
        import io,tarfile
        with tarfile.open(fileobj=io.BytesIO(data),mode='r:*') as tf:
            for member in tf:
                m=re.match(cfg['pattern'],member.name.rstrip('/')+'/')
                if m:add(m[1]);break
    elif mode=='listing':parse_listing(text,cfg['url'])
    elif mode=='tree':
        dirs=[]
        for link in links(text,cfg['url']):
            raw=urllib.parse.urlsplit(link).path.rstrip('/').rsplit('/',1)[-1]
            m=re.fullmatch(cfg['directory_pattern'],raw)
            if m:dirs.append((version(m[1]),link.rstrip('/')+'/'))
        for key in reversed(ordered([d[0] for d in dirs])[-cfg.get('limit',3):]):
            url=next(u for v,u in dirs if v==key)+cfg.get('child_path','')
            try:parse_listing(get(url),url)
            except subprocess.CalledProcessError:continue
    elif mode=='rss':
        for item in ET.fromstring(text).iter('item'):
            url=item.findtext('link') or '';path=urllib.parse.urlsplit(url).path.removesuffix('/download')
            m=re.fullmatch(cfg['pattern'],urllib.parse.unquote(path.rsplit('/',1)[-1]))
            location=re.fullmatch(r'/projects/([^/]+)/files/(.+)',path)
            if m and location:add(m[1],'https://downloads.sourceforge.net/project/'+location[1]+'/'+location[2])
    elif mode=='regex_url':
        # Decode release descriptions but never execute server-provided code.
        try: scan=json.dumps(json.loads(text),ensure_ascii=False).replace('\\/', '/')
        except ValueError:scan=text
        for match in re.finditer(cfg['pattern'],scan):add(match[1],cfg.get('archive_prefix','')+urllib.parse.urljoin(cfg.get('archive_root',''),match[0]))
    elif mode=='deb_control':
        import io,tarfile
        if not data.startswith(b'!<arch>\\n'.replace(b'\\n',b'\n')):raise ValueError('not a Debian archive')
        pos=8
        while pos+60<=len(data):
            header=data[pos:pos+60];size=int(header[48:58]);name=header[:16].decode().strip().rstrip('/');pos+=60
            block=data[pos:pos+size];pos+=size+size%2
            if name.startswith('control.tar'):
                with tarfile.open(fileobj=io.BytesIO(block),mode='r:*') as tf:
                    member=next(m for m in tf if m.name.lstrip('./')=='control')
                    fields=dict(re.findall(r'^([A-Za-z-]+): (.*)$',tf.extractfile(member).read().decode(),re.M))
                    if fields['Package']!=cfg['project']:raise ValueError('Debian package identity mismatch')
                    add(fields['Version']);break
    elif mode=='regex':
        for match in re.finditer(cfg['pattern'],text,re.M):add(match[1])
    elif mode=='json':
        obj=json.loads(text)
        for part in cfg['version_path']:obj=obj[part]
        add(str(obj))
    elif mode=='gnome':
        obj=json.loads(text)[1][cfg['project']]
        for raw,files in obj.items():
            if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)*',raw):continue
            if cfg.get('even_minor') and int(raw.split('.')[1])%2:continue
            for ext in ('tar.xz','tar.bz2','tar.gz'):
                if ext in files:add(raw,urllib.parse.urljoin(cfg['url'],files[ext]));break
    elif mode=='metacpan':
        obj=json.loads(text)
        if obj['distribution']!=cfg['project'] or obj.get('maturity')!='released':raise ValueError('CPAN identity/release mismatch')
        add(str(obj['version']).removeprefix('v'),obj['download_url'])
    elif mode=='debian':
        for block in text.split('\n\n'):
            fields=dict(re.findall(r'^([A-Za-z-]+): (.*)$',block,re.M))
            if fields.get('Package')==cfg['project']:add(fields['Version'],urllib.parse.urljoin(cfg['archive_root'],fields['Filename']))
    else:raise ValueError('unknown metadata format')
    if not choices:raise ValueError('no matching upstream version')
    latest=ordered(list({r[0] for r in choices}))[-1]
    latest,archive,sha=next(r for r in choices if r[0]==latest)
    if cfg.get('_emit_metadata'):
        print(json.dumps(dict(version=latest,archive=archive,sha=sha)));sys.exit(0)
    raw=recipe.read_text();edits=[]
    def sed(old,new):
        pat=re.sub(r'([\\.^$\[\]*|])',r'\\\1',old)
        rep=new.replace('\\','\\\\').replace('&',r'\&').replace('|',r'\|')
        return 's|'+pat+'|'+rep+'|'
    if archive and not cfg.get('version_only'):
        if not re.fullmatch(r'(?:https?://|git\+https://)[A-Za-z0-9_./:%+?=&~#@-]+',archive):raise ValueError('invalid archive URL')
        source=re.search(r'^source=(?:"([^\"]*)"|\x27([^\x27]*)\x27|([^\n]*))',raw,re.M)
        if not source:raise ValueError('missing scalar source')
        entries=next(g for g in source.groups() if g is not None).split()
        if not entries:raise ValueError('empty source list')
        first=entries[0];alias=first.split('::',1)[0]+'::' if '::' in first else ''
        if 'git+' in first and not archive.startswith('git+'):alias=''
        if alias:
            alias=alias.replace(current,'${version}')
            ext=re.search(r'(\.tar\.(?:gz|bz2|xz)|\.tgz|\.zip)$',archive)
            if ext:alias=re.sub(r'(\.tar\.(?:gz|bz2|xz)|\.tgz|\.zip)(?=::$)',ext[0],alias)
        edits.append(sed(first,alias+archive))
    if sha:
        match=re.search(r'^_commit=[\x27"]?([a-f0-9]{7,40})[\x27"]?\s*$',raw,re.M)
        if match:edits.append(sed(match[0],'_commit='+sha))
    for old,new in cfg.get('extra_edits',[]):edits.append(sed(old,expand(new,latest,sha=sha)))
    print(latest)
    for edit in edits:print(edit)
except (OSError,ValueError,KeyError,IndexError,TypeError,AttributeError,StopIteration,ET.ParseError,subprocess.CalledProcessError) as error:
    print('ERROR: Upstream version lookup failed: '+str(error),file=sys.stderr);sys.exit(1)
PYUPSTREAM
    ) || return 1
    mapfile -t detected_lines <<< "$detected"
    next_version=${detected_lines[0]:-}
    [ -n "$next_version" ] || return 1
    source_edits=("${detected_lines[@]:1}")
    vercomp "$next_version" "$version" >/dev/null
    comparison=$?
    if [ "$comparison" = 2 ] && [ -z "${update_repo_review_reason:-}" ]; then
        sed_args=()
        for edit in "${source_edits[@]}"; do
            [ -z "$edit" ] || sed_args+=(-e "$edit")
        done
        if [ "${#sed_args[@]}" -gt 0 ]; then
            if [ -n "${test_upgrade:-}" ]; then
                { printf 'sed -i'; printf ' %q' "${sed_args[@]}" "$recipe"; printf '\n'; } >> test_updates.sh || return 1
            else
                sed -i "${sed_args[@]}" "$recipe" || return 1
            fi
        fi
    fi
    uversion=$next_version
    [ -z "${update_repo_review_reason:-}" ] || printf '%s\n' "$update_repo_review_reason"
}
