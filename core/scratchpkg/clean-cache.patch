+lock_caches() {
+	# Coordinate with `scratch clean`, including download-only and install modes.
+	# Lock directories themselves, so no writable lock file is needed in the cache.
+	command -v flock >/dev/null 2>&1 || {
+		msgerr "'flock' from util-linux is required for package cache locking."
+		exit 1
+	}
+	exec 8< "$SOURCE_DIR" || exit 1
+	flock --shared 8 || exit 1
+	exec 9< "$PACKAGE_DIR" || exit 1
+	flock --shared 9 || exit 1
+}
