+# Prepare checked ownership handoffs from already-built package archives.
+# This does not install packages. Pass the resulting plan to install/upgrade
+# with --transaction-plan=FILE; ordinary unplanned conflicts remain errors.
+scratch_transaction() {
+    needroot "Preparing package transaction"
+    transaction_output=
+    transaction_root=/
+    transaction_config=/etc/scratchpkg.conf
+    transaction_packages=
+    while [ "$1" ]; do
+        case $1 in
+            --output=*) transaction_output=${1#*=} ;;
+            --root=*) transaction_root=${1#*=} ;;
+            --config=*) transaction_config=${1#*=} ;;
+            --*) msgerr "Invalid transaction option: $1"; return 1 ;;
+            *) transaction_packages="$transaction_packages $1" ;;
+        esac
+        shift
+    done
+    [ "$transaction_output" ] && [ "$transaction_packages" ] || {
+        msgerr "Usage: scratch transaction --output=FILE PACKAGE... [--config=FILE] [--root=DIR]"
+        return 1
+    }
+    [ ! -f "$transaction_config" ] || . "$transaction_config"
+    set --
+    for transaction_package in $transaction_packages; do
+        transaction_port=$(getportpath "$transaction_package") || return 1
+        transaction_archive=$(
+            . "$transaction_port/$BUILD_SCRIPT"
+            [ "$name" = "$transaction_package" ] || exit 1
+            printf '%s/%s-%s-%s.spkg.tar.%s' "$PACKAGE_DIR" "$name" "$version" "$release" "$COMPRESSION_MODE"
+        ) || return 1
+        set -- "$@" "$transaction_archive"
+    done
+    python3 "$(dirname "$(readlink -f "$0")")/../lib/scratchpkg/transaction.py" \
+        --root "$transaction_root" --database "$PKGDB_DIR" prepare \
+        --output "$transaction_output" "$@"
+}
