# description : A simple package manager for Linux Distribution
# depends : coreutils httpup libarchive python

name=scratchpkg
version=20230109
release=15
backup="etc/scratchpkg.conf
        etc/scratchpkg.alias
        etc/scratchpkg.repo
        etc/scratchpkg.mask
        etc/revdep.conf"
scratchpkg_url=https://github.com/voncloft/scratchpkg
source="$name-$version.tar.gz::$scratchpkg_url/archive/refs/tags/$version.tar.gz
        $name.repo
        $name.conf
        $name.alias
        $name.mask
        honor-hook-failures.patch
        vonos-tool-defaults.patch
        pkgadd-lock-ownership.patch
        preserve-shared-ownership.patch
        reject-shared-payload.patch
        upgrade-installed-dependencies.patch
        canonical-shared-ownership.patch
        verify-source-download.patch
        adopt-identical-symlinks.patch
        abort-extraction-errors.patch
        preserve-existing-directories.patch
        checked-ownership-handoffs.patch
        canonical-hwdb-trigger.patch
        preserve-failed-cleanup.patch
        transaction.py
        transactions.md
        ownership.py
        revdep
        revdep-runtime-paths.sh
        adopt-legacy-install.py
        legacy-tool-hashes.json"

build() {
    cd "$name-$version"
    patch --fuzz=0 -p1 < "$SRC/honor-hook-failures.patch"
    patch --fuzz=0 -p1 < "$SRC/vonos-tool-defaults.patch"
    patch --fuzz=0 -p1 < "$SRC/pkgadd-lock-ownership.patch"
    patch --fuzz=0 -p1 < "$SRC/preserve-shared-ownership.patch"
    patch --fuzz=0 -p1 < "$SRC/reject-shared-payload.patch"
    patch --fuzz=0 -p1 < "$SRC/upgrade-installed-dependencies.patch"
    patch --fuzz=0 -p1 < "$SRC/canonical-shared-ownership.patch"
    patch --fuzz=0 -p1 < "$SRC/verify-source-download.patch"
    patch --fuzz=0 -p1 < "$SRC/adopt-identical-symlinks.patch"
    patch --fuzz=0 -p1 < "$SRC/abort-extraction-errors.patch"
    patch --fuzz=0 -p1 < "$SRC/preserve-existing-directories.patch"
    patch --fuzz=0 -p1 < "$SRC/checked-ownership-handoffs.patch"
    patch --fuzz=0 -p1 < "$SRC/canonical-hwdb-trigger.patch"
    patch --fuzz=0 -p1 < "$SRC/preserve-failed-cleanup.patch"
    DESTDIR="$PKG" ./INSTALL.sh
    install -Dm755 "$SRC/ownership.py" "$PKG/usr/lib/scratchpkg/ownership.py"
    install -m755 "$SRC/transaction.py" "$PKG/usr/lib/scratchpkg/transaction.py"
    install -Dm644 "$SRC/transactions.md" "$PKG/usr/share/doc/scratchpkg/transactions.md"
    install -m755 "$SRC/revdep" "$PKG/usr/bin/revdep"
    install -m644 "$SRC/revdep-runtime-paths.sh" "$PKG/usr/lib/scratchpkg/revdep-runtime-paths.sh"
    install -m644 "$SRC/$name.repo" "$PKG/etc/$name.repo"
    install -m644 "$SRC/$name.conf" "$PKG/etc/$name.conf"
    install -m644 "$SRC/$name.alias" "$PKG/etc/$name.alias"
    install -m644 "$SRC/$name.mask" "$PKG/etc/$name.mask"
}
