# description	: Programs for manipulating text files
# depends	: mpfr bash

name=gawk
version=5.4.1
release=3
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.xz"

build() {
	cd $name-$version


	./configure --prefix=/usr --libexecdir=/usr/lib --sysconfdir=/etc --disable-nls
	make
	make DESTDIR=$PKG install
	# Keep shell startup unchanged; these optional path helpers are new upstream.
	rm "$PKG/etc/profile.d/gawk.sh" "$PKG/etc/profile.d/gawk.csh"
	rmdir "$PKG/etc/profile.d" "$PKG/etc"
}
