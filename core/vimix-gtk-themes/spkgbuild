# description	: Vimix is a flat Material Design theme for GTK 3, GTK 2 and Gnome-Shell
# depends	: gtk3 gtk-engine-murrine gtk-engines

name=vimix-gtk-themes
version=20250726094149
release=1
options="!strip"
_commit=c11aca86854dcf9e33892c59aef4f296d985bb60
source="$name-$_commit.tar.gz::https://github.com/vinceliuice/vimix-gtk-themes/archive/c11aca86854dcf9e33892c59aef4f296d985bb60.tar.gz
	Install.patch"

build() {
	cd "$SRC"/Vimix-gtk-themes*/
	patch Install < "$SRC/Install.patch"
	install -m755 -d "$PKG/usr/share/themes"
	DEST_DIR="$PKG/usr/share/themes" ./Install
}
