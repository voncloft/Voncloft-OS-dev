# description	: Message bus system, a simple way for applications to talk to one another
# depends	: expat libx11 libsm libice

name=dbus
version=1.16.4
release=2
source="https://dbus.freedesktop.org/releases/$name/$name-$version.tar.xz"

build() {
	local dbus_gid
	# The daemon account's primary GID is authoritative, even without a group name.
	dbus_gid=$(id -g messagebus) || return 1
	cd $name-$version

	mkdir build
	cd build
	
	meson setup --prefix=/usr          \
            --buildtype=release    \
            --wrap-mode=nofallback \
            -D systemd=disabled    \
            .. 
        ninja
        DESTDIR=$PKG ninja install
        chown -v "root:$dbus_gid" "$PKG/usr/libexec/dbus-daemon-launch-helper"
	chmod -v 4750 "$PKG/usr/libexec/dbus-daemon-launch-helper"
	
}
