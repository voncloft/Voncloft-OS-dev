# description : visual depiction of network traffic on interface
# depends : libpcap ncurses

name=iftop
version=1.0pre4
release=1

source="https://www.ex-parrot.com/pdw/${name}/download/${name}-${version}.tar.gz
	patch.patch"

build()
{
	cd "$SRC"/iftop*/
	autoreconf -ifv
	CFLAGS+=' -fcommon'
	patch -p0 -i $SRC/patch.patch
	./configure --prefix=/usr --sbindir=/usr/bin --mandir=/usr/share/man
	make
	make DESTDIR=$PKG install
}
