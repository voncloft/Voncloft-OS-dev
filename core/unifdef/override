# Track stable upstream source archives, excluding prereleases.
source="https://dotat.at/prog/unifdef/"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
from pathlib import Path
import re
versions=set(re.findall(r'href="unifdef-([0-9]+(?:[.][0-9]+)+)[.]tar[.]xz"', Path('index.html').read_text()))

if not versions: raise SystemExit('No stable upstream source release found')
print(max(versions, key=lambda value: tuple(map(int, value.split('.')))))
PYUPSTREAM
    ) || return 1
    [ -n "$detected" ] || return 1
    uversion=$detected
}
