# description	: Implementation of the Unicode Bidirectional Algorithm (BIDI)
# depends : glib meson ninja

name=fribidi
version=1.0.18
release=2
source="https://github.com/fribidi/${name}/releases/download/v$version/$name-$version.tar.xz"

build() {
	cd $name-$version

	mkdir build
	cd build

	meson setup --prefix=/usr ..
	ninja
	DESTDIR=$PKG ninja install
}
