# description	: Scalable Vector Graphics editor
# depends	: gsl boost imagemagick6 gc lcms2 poppler-glib popt libxslt gtkmm2 double-conversion potrace

name=inkscape
version=1.4.4
release=1
source="https://gitlab.com/inkscape/${name}/-/archive/INKSCAPE_${version//./_}/inkscape-INKSCAPE_${version//./_}.tar.gz"
options="!checksum"
build() {
	cd "$SRC"/inkscape-INKSCAPE*/

	mkdir build
	cd    build

	cmake -DCMAKE_INSTALL_PREFIX=/usr \
	      -DCMAKE_BUILD_TYPE=Release  \
	      -DPOPPLER_INCLUDE_DIR=/usr/include/poppler \
	      ..
	make
	make DESTDIR=$PKG install
}
