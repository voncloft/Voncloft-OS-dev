# description	: Text document format for short documents, articles, books and UNIX man pages
# depends	: docbook-xml python

name=asciidoc
version=10.2.0
release=1
source="https://github.com/asciidoc-py/asciidoc-py/releases/download/10.2.0/asciidoc-10.2.0.tar.gz"

build() {
	cd $name-$version
	./configure --prefix=/usr --sysconfdir=/etc
	make
	make DESTDIR=$PKG install
}
