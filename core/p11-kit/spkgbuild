# description : Provides a way to load and enumerate PKCS #11 (a Cryptographic Token Interface Standard) modules
# depends     : libtasn1 libffi

name=p11-kit
version=0.26.6
release=3
source="https://github.com/p11-glue/${name}/releases/download/$version/$name-$version.tar.xz"

backup="etc/pkcs11/pkcs11.conf.example"

build() {
    # 64-bit build.
    cd $name-$version

    sed '20,$ d' -i trust/trust-extract-compat
    cat <<- EOF > trust/trust-extract-compat
	# Copy existing anchor modifications to /etc/ssl/local
	/usr/libexec/make-ca/copy-trust-modifications

	# Generate a new trust store
	/usr/sbin/make-ca -f -g
	EOF
    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-trust-paths=/etc/pki/anchors

    make
    make DESTDIR=$PKG install

    ln -sfv /usr/libexec/p11-kit/trust-extract-compat \
        $PKG/usr/bin/update-ca-certificates
    # NSS owns libnssckbi.so and selects its trust-module integration.

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib32 \
        --with-trust-paths=/etc/pki/anchors
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
