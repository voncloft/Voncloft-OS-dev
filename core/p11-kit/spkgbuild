# description	: Provides a way to load and enumerate PKCS #11 (a Cryptographic Token Interface Standard) modules
# depends	: libtasn1 libffi

name=p11-kit
version=0.26.6
release=2
source="https://github.com/p11-glue/${name}/releases/download/$version/$name-$version.tar.xz"

backup="etc/pkcs11/pkcs11.conf.example"

build() {
	cd $name-$version

	sed '20,$ d' -i trust/trust-extract-compat
	cat <<-EOF > trust/trust-extract-compat
	# Copy existing anchor modifications to /etc/ssl/local
	/usr/libexec/make-ca/copy-trust-modifications

	# Generate a new trust store
	/usr/sbin/make-ca -f -g
	EOF
	./configure --prefix=/usr     \
            --sysconfdir=/etc \
            --with-trust-paths=/etc/pki/anchors

	make
	make DESTDIR=$PKG install

	ln -sfv /usr/libexec/p11-kit/trust-extract-compat \
        $PKG/usr/bin/update-ca-certificates
	# NSS owns libnssckbi.so and selects its trust-module integration.
}
