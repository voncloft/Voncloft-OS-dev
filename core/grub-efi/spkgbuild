# description	: The GRand Unified Bootloader (EFI)
# depends	: efivar efibootmgr freetype2 dosfstools

name=grub-efi
version=2.14
unifontverzion=13.0.03
release=2
backup="etc/grub.d/20_linux_xen etc/grub.d/README etc/grub.d/25_bli etc/grub.d/10_linux etc/grub.d/40_custom etc/grub.d/00_header etc/grub.d/30_os-prober etc/grub.d/41_custom etc/grub.d/30_uefi-firmware etc/bash_completion.d/grub"
_name=grub
source="https://ftp.gnu.org/gnu/${_name}/${_name}-${version}.tar.gz
	https://ftp.gnu.org/gnu/unifont/unifont-$unifontverzion/unifont-$unifontverzion.bdf.gz
	0006-BootHole.patch"

build() {
	cd grub-$version

	patch -Np1 -i $SRC/0006-BootHole.patch

	gunzip $SRC/unifont-$unifontverzion.bdf.gz
	cp $SRC/unifont-$unifontverzion.bdf unifont.bdf

	./configure --prefix=/usr  \
            --sbindir=/sbin        \
            --sysconfdir=/etc      \
            --disable-efiemu       \
            --enable-grub-mkfont   \
            --with-platform=efi    \
            --target=x86_64        \
            --program-prefix=""    \
	    --program-suffix="-efi" \
            --with-bootdir="/boot" \
            --disable-werror \
	    --disable-nls
	make
	make DESTDIR=$PKG install

	rm -r $PKG/etc/ $PKG/usr/bin $PKG/sbin
	rm $PKG/usr/share/grub/grub-mkconfig_lib
}
