# description	: The GNUstep base package
# depends	: gnustep-make libffi icu gnutls libxml2 libxslt

name=gnustep-base
version=1.31.1
verzion=${version//./_}
release=1
_name=libs-base
source="https://github.com/gnustep/${_name}/releases/download/base-${verzion}/${name}-$version.tar.gz"

build() {
	cd $name-$version
	. /usr/share/GNUstep/Makefiles/GNUstep.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
