name=smtube
version=21.10.0
release=1
source="https://sourceforge.net/projects/${name}/files/SMTube/$version/${name}-$version.tar.bz2"

build() {
	cd "$SRC"/smtube*/
	make PREFIX=/usr
	make PREFIX=/usr DESTDIR=$PKG install
}
