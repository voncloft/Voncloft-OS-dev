# description : Libraries and userspace tools which provide a secure layer over a reliable transport layer
# depends     : nettle make-ca libtasn1 p11-kit libunistring

name=gnutls
version=3.8.13
release=2
source="https://www.gnupg.org/ftp/gcrypt/${name}/v${version%.*}/$name-${version}.tar.xz"

build() {
    # 64-bit build.
    cd $name-$version

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --docdir=/usr/share/doc/gnutls-$version \
        --disable-guile \
        --disable-rpath \
        --with-default-trust-store-pkcs11="pkcs11:"
    make
    make DESTDIR=$PKG install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --disable-guile \
        --disable-rpath \
        --disable-static \
        --with-default-trust-store-pkcs11="pkcs11:" \
        --without-tpm2
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
