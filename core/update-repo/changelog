#!/bin/bash

repo_root=${UPDATE_REPO_ROOT:-/sources/Voncloft-OS-dev}

# $1=name-of-package
# $2=description

location=$1
case "$location" in
    /*) recipe=$location ;;
    *) recipe="$repo_root/$location" ;;
esac
source "$recipe" || exit 1
changelog="${recipe%/spkgbuild}/CHANGELOG"
if [ -f "$changelog" ];
then
        echo -e "\n----------------------------------------------------------------" >> "$changelog"
	echo -e "\nDate: $(date)\n\nVersion=$version\nRelease=$release\n\nSynopsis:\n$2" >> "$changelog"
	echo "Updated Changelog for $1"
else
      echo -e "Date: $(date)\n\n$name\nVersion=$version\nRelease=$release\n\nSynopsis:\nAdded Changelog to package\n$2" >> "$changelog"
	echo "Updated Changelog for $1"
fi
