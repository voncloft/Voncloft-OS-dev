# Use the same version-sort ordering as Scratch, with equality excluded.
version_is_newer()
{
    local latest
    [ -n "$1" ] && [ -n "$2" ] && [ "$1" != "$2" ] || return 1
    latest=$(printf '%s\n' "$2" "$1" | LC_ALL=C sort -Vu | tail -n1) || return 1
    [ "$latest" = "$1" ]
}

upgrade_process()
{
    local version_assignment replacement version_edit update_command change_message changes_log
    unset update_repo_not_newer
    if [ -n "${update_repo_skip:-}" ]; then
        : # Intentionally local/manual, not a failed upstream lookup.
    elif [ -z "${uversion:-}" ]; then
        ((missing=missing+1))
        log_missing
    elif [ "$uversion" = "$version" ]; then
        : # Exact match: do not edit the recipe or queue an update.
    elif [ -n "${update_repo_review_reason:-}" ]; then
        printf '%s\n' "$update_repo_review_reason"
    elif [ -n "${update_repo_newer_only:-}" ] && ! version_is_newer "$uversion" "$version"; then
        update_repo_not_newer=1
        printf 'Skipping %s: found version %s is not newer than %s (-n).\n' "$name" "$uversion" "$version"
    else
        # Without -n, a different upstream version is a change in either direction.
        # Replace only the version assignment, leaving names and URLs intact.
        printf -v version_assignment '%q' "$uversion"
        replacement=${version_assignment//\\/\\\\}
        replacement=${replacement//&/\\&}
        replacement=${replacement//|/\\|}
        version_edit="s|^[[:space:]]*version=.*$|version=$replacement|"
        printf -v update_command 'sed -i -e %q %q # update-repo-version %s %s' \
            "$version_edit" "$ppath" "$version" "$uversion"
        change_message="Changed from version $version to version $uversion"
        changes_log="$logpath/changes/repository_changes-$(date +"%m-%d-%y").html"
        if [ -z "${test_upgrade:-}" ]; then
            title="Updates for: "
            screen_upgrading "$ppath" "$version" "$uversion" "$((screen_checked+1))" "${screen_total_packages:-1}"
            sed -i -e "$version_edit" "$ppath" || return 1
            bash "$changelog_program" "$ppath" "$change_message"
        else
            title="Test updates for: "
            printf '%s\n' "$update_command" >> test_updates.sh
            printf 'bash %q %q %q\n' "$changelog_program" "$ppath" "$change_message" >> test_updates.sh
        fi
        echo "NEW"
        ((count=count+1))
        screen_record_update "$ppath" "$name" "$version" "$uversion"
        printf '%s <br>\n' "$update_command" >> "$changes_log"
        create_table "$ppath" "$version" "$uversion"
    fi
    if [ -z "${keep_index:-}" ] && [ -f index.html ]; then
        rm index.html
    fi
    if [ -f test.txt ]; then
        rm test.txt
    fi
}
