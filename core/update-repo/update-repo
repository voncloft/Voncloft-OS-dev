configure_repo_path()
{
    repo_root=$default_repo_root
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -p)
                if [ "$#" -lt 2 ] || [ -z "$2" ] || [[ $2 == -* ]]; then
                    printf '%s\n' 'ERROR: -p requires a repository directory.' >&2
                    return 2
                fi
                repo_root=$2
                shift
                ;;
            -a|-st|-t|-n|-s|-all|--all|-k|-e|-stu|-utg|-tp|-h|-l)
                ;;
            *)
                printf 'ERROR: Unknown option: %s. Use -h for help.\n' "$1" >&2
                return 2
                ;;
        esac
        shift
    done
    if [ ! -d "$repo_root" ]; then
        printf 'ERROR: Repository directory not found: %s\n' "$repo_root" >&2
        return 1
    fi
    repo_root=$(cd -- "$repo_root" && pwd -P) || return 1
    # Child helpers and saved update scripts use this same selected repository.
    export UPDATE_REPO_ROOT="$repo_root"
}

check_handles()
{
        while [ "$#" -gt 0 ]; do
                case $1 in
                        -a) apply_test_updates || exit $?
                	apply=1
