check_handles()
{
        while [ $1 ]; do
                case $1 in
                	-a) apply_test_updates
                	apply=1
                	exit;;
                        -st) skip_tar=1;;
                        -t) test_upgrade=1;;
                        -s) repos;;
                        -k) keep_index=1;;
                        -e) edit_program
                        exit;;
                        -stu) show_test_updates
                        apply=1
                        exit;;
                        -utg) update_to_github
                        exit;;
                        -tp) test_prog
                        exit;;
			-h) help
         		exit;;
         		-l) apply_test_updates
         		apply=1
         		update_to_github
         		exit;;
                esac
                shift
        done
}
