                grep "name=" index.html | cut -d ' ' -f1 >> /sources/Voncloft-OS-dev/test.txt
                grep "pkgname=" index.html | cut -d ' ' -f1 >> /sources/Voncloft-OS-dev/test.txt
                grep "url=" index.html >> /sources/Voncloft-OS-dev/test.txt
                grep "source=" index.html >> /sources/Voncloft-OS-dev/test.txt
		sed -i -e "s/\'//g" /sources/Voncloft-OS-dev/test.txt
                sed -i -e "s/(//g" /sources/Voncloft-OS-dev/test.txt
                sed -i -e "s/)//g" /sources/Voncloft-OS-dev/test.txt
		sed -i -e "s/{,.asc}//g" /sources/Voncloft-OS-dev/test.txt
                new_url=$spkg_url
                source /sources/Voncloft-OS-dev/test.txt
		spkg_src=$(echo $spkg_src | sed "s/\"//g")
                uversion="$pkgver"

	fi
}
