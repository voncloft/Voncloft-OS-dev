help()
{
	echo "-a apply test updates"
	echo "-e edit program"
	echo "-k keep index.html file for debugging"
	echo "-l too lazy to run two commands merging apply and upload to github"
	echo "-s check for specific package updates (format category/package_name)"
	echo "-st skip the repository backup (does not enable test mode)"
	echo "-t save available updates to test_updates.sh without applying them"
	echo "-stu review pending updates saved by a -t run"
	echo "-utg upload changes to github"
	echo "-h help"
}
show_test_updates()
{
	if [ ! -s test_updates.sh ];then
		echo "No pending test updates."
		echo "Use update-repo -s -st -t to save available updates for review."
		echo "-st only skips the backup; without -t, updates are applied directly."
		return 0
	fi
	nano test_updates.sh
}
main()
{
	check_handles "$@"
	if [ -z $apply ];then
		echo "Backup up test upgrade script"
		backup_test
	else
		echo "Not backing up scripts"
	fi
	if [ -z $skip_tar ];then
		echo "Backing up repo"
	else
		echo "Skipping backup of repo"
	fi
	if [ -z $test_upgrade ];then
		echo "Applying updates to repo"
	else
		echo "Checking for updates - not applying any, test run"
	fi
	if [ -z $keep_index ];then
		echo "Not keeping index.html"
	else
		echo "Keeping index.html for debugging"
	fi
	prepare_backup_and_logs || return 1
	timestamp_log
	screen_start
	checked_packages=0
	screen_total_packages=0
	for f in $repos; do
		[ "${f##*/}" != "REPO" ] && [ -f "$f/spkgbuild" ] || continue
		screen_total_packages=$((screen_total_packages+1))
	done
	for f in $repos;
	do
		[ "${f##*/}" != "REPO" ] && [ -f "$f/spkgbuild" ] || continue
		if [ "${screen_active:-}" = 1 ]; then
			screen_begin_package "$f"
			# Keep this in the current shell so counters and detected versions
			# survive, while override output cannot scroll the terminal.
			check_package "$f" > "$screen_output" 2>&1
			screen_end_package
		else
			echo "-----------------------------------------------------------------------------------"
			check_package "$f"
		fi
		checked_packages=$((checked_packages+1))
	done
	# Restore and clear the terminal; completion shows only the summary.
	screen_stop
	finish_logs	
	alerts_and_logs
}
backup_test()
{
        if [ -f test_updates.sh ];then
                mv test_updates.sh test_updates-$(date +"%m-%d-%y").sh
        fi
}
