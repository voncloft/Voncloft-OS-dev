#!/bin/bash
#Written: 09-19-21

# Default recipe repository; -p overrides this for the current run.
repo_root=/sources/Voncloft-OS-dev
default_repo_root=$repo_root
program_path=$(readlink -f -- "${BASH_SOURCE[0]}")

# Overrides are sourced into this shell. Keep their legacy egrep calls quiet
# without changing the system egrep command or requiring per-override edits.
egrep() {
        command grep -E "$@"
}

# Extract the two HTML patterns used by this updater and its overrides without
# requiring a grep build with PCRE support. Preserve grep -o output and status.
update_repo_html_matches() {
        local extraction=$1
        shift
        awk -v extraction="$extraction" '
                BEGIN {
                        pattern = extraction == "href" ? "href=\"[^\"]*" : ">[^<>]*<"
                        offset = extraction == "href" ? 6 : 1
                        trim = extraction == "href" ? 6 : 2
                        show_filename = ARGC > 2
                }
                {
                        line = $0
                        while (match(line, pattern)) {
                                found = 1
                                value = substr(line, RSTART + offset, RLENGTH - trim)
                                if (length(value)) {
                                        if (show_filename)
                                                printf "%s:", FILENAME == "-" ? "(standard input)" : FILENAME
                                        print value
                                }
                                line = substr(line, RSTART + RLENGTH)
                        }
                }
                END { exit found ? 0 : 1 }
        ' "$@"
}

# Sourced legacy overrides still use these exact grep -Po expressions.
# All other grep calls retain the system grep's behavior.
grep() {
        if [ "${1-}" = -Po ];then
                case "${2-}" in
                        '(?<=href=")[^"]*')
                                shift 2
                                update_repo_html_matches href "$@"
                                return $?
                                ;;
                        '(?<=>)[^<>]*(?=<)')
                                shift 2
                                update_repo_html_matches text "$@"
                                return $?
                                ;;
                esac
        fi
        command grep "$@"
}

# Use a fixed terminal screen for scans; redirected output keeps its normal format.
screen_start()
{
    # Retain results in every mode, including redirected output.
    screen_updates=()
    screen_update_repos=()
    screen_update_old=()
    screen_update_new=()
    # Use the same installed-package database as Scratch, without running it.
    screen_pkgdb=$(pkgadd --print-dbdir 2>/dev/null)
    screen_pkgdb=${screen_pkgdb:-/var/lib/scratchpkg/db}
    [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] || return 0
    screen_output=$(mktemp "${TMPDIR:-/tmp}/update-repo-screen.XXXXXX") || return 0
    exec {screen_fd}>&1
    screen_active=1
    screen_checked=0
    screen_phase=scan
    screen_checking=1
    screen_result_fields=()
    screen_path=
    screen_source=
    screen_new_url=
    screen_name=
    screen_version=
    screen_found='Checking...'
    screen_command=
    screen_message=
    screen_status='Starting scan'
    trap 'screen_stop' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    trap 'screen_draw' WINCH
    # The alternate screen keeps the scan out of scrollback. Disable wrapping so
    # even long URLs cannot push the display down or wrap onto another field.
    printf '\033[?1049h\033[?25l\033[?7l\033[2J' >&"$screen_fd"
    screen_draw
}

screen_stop()
{
    scan_input_stop
    [ "${screen_active:-}" = 1 ] || return 0
    screen_active=
    # Clear the restored terminal before printing the final results.
    printf '\033[0m\033[?7h\033[?25h\033[?1049l\033[H\033[2J' >&"$screen_fd"
    exec {screen_fd}>&-
    rm -f -- "$screen_output"
}

# Read scan shortcuts without echoing them over the fixed terminal display.
scan_input_start()
{
    screen_scan_stopped=
    [ "${screen_active:-}" = 1 ] || return 0
    if { exec {scan_input_fd}</dev/tty; } 2>/dev/null; then
        scan_tty_state=$(stty -g <&"$scan_input_fd") || { scan_input_stop; return 0; }
        stty -echo -icanon min 1 time 0 <&"$scan_input_fd" || scan_input_stop
    fi
}

scan_input_stop()
{
    if [ -n "${scan_input_fd:-}" ]; then
        [ -z "${scan_tty_state:-}" ] || stty "$scan_tty_state" <&"$scan_input_fd" 2>/dev/null
        exec {scan_input_fd}<&-
        unset scan_input_fd scan_tty_state
    fi
}

scan_quit_requested()
{
    local key
    [ -n "${scan_input_fd:-}" ] || return 1
    while IFS= read -r -s -n 1 -t 0.001 -u "$scan_input_fd" key; do
        case "$key" in
            q|Q) screen_scan_stopped=1; return 0 ;;
        esac
    done
    return 1
}

# Format the progress counter shown while checks are running.
check_progress()
{
    local current=${1:-0} total=${2:-0} percent=0
    if [ "$total" -gt 0 ]; then
        percent=$((current * 100 / total))
    fi
    printf '%s/%s (%s%%)' "$current" "$total" "$percent"
}

# Start long terminal reports at the top; keep every result available to scroll.
print_stats()
{
    if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
        printf '\033[0m\033[?7h\033[H\033[2J'
        if command -v less >/dev/null 2>&1; then
            if [ -n "${test_upgrade:-}" ] && [ -s "$repo_root/test_updates.sh" ]; then
                # lesskey returns the ASCII value of the action letter on exit.
                # Keep even short pending reports open so these actions are available.
                local report_action
                print_report | LESS= LESSOPEN= LESSCLOSE= less -R -X \
                    --lesskey-src=<(printf '#command\na quit a\nl quit l\n') \
                    -P 'a apply | l apply + upload | (q to exit)'
                report_action=$?
                case "$report_action" in
                    97) "$program_path" -p "$repo_root" -a ;;
                    108) "$program_path" -p "$repo_root" -l ;;
                    *) return "$report_action" ;;
                esac
                return $?
            fi
            print_report | LESS= LESSOPEN= LESSCLOSE= less -R -F -X -P '(q to exit)'
            return
        fi
    fi
    print_report
}

print_report()
{
    local mode='Apply updates' entry part
    local -a update_parts
    [ -z "${test_upgrade:-}" ] || mode='Test run'
    [ -z "${update_repo_newer_only:-}" ] || mode+=" (newer only)"
    [ "${screen_scan_stopped:-}" != 1 ] || mode+=" (stopped early)"
    printf '%bUpdate report%b\n' "${WHITE:-}" "${NC:-}"
    printf '%bUpdates: %s%b\n' "${BLUE:-}" "${count:-0}" "${NC:-}"
    printf '%bMissing: %s%b\n' "${BLUE:-}" "${missing:-0}" "${NC:-}"
    printf '%bMode: %s%b\n\n' "${YELLOW:-}" "$mode" "${NC:-}"
    printf '%bPackages to be updated:%b\n' "${WHITE:-}" "${NC:-}"
    if [ "${#screen_updates[@]}" -eq 0 ]; then
        printf 'None.\n'
    else
        for ((entry=0; entry<${#screen_updates[@]}; entry++)); do
            screen_update_parts "$entry"
            for ((part=0; part<${#update_parts[@]}; part+=2)); do
                printf '%b%s' "${update_parts[part]}" "${update_parts[part+1]}"
            done
            printf '%b\n' "${NC:-}"
        done
    fi
}

screen_record_update()
{
    local repo=${1%/spkgbuild}
    repo=${repo%/*}
    screen_updates+=("$2")
    screen_update_repos+=("${repo##*/}")
    screen_update_old+=("$3")
    screen_update_new+=("$4")
}

# Both renderers declare update_parts locally for this helper to populate.
screen_update_parts()
{
    local entry=$1 installed_marker='[ ] ' installed_color=${WHITE:-}
    if [ -s "$screen_pkgdb/${screen_updates[entry]}" ]; then
        installed_marker='[i] '
    fi
    update_parts=(
        "$installed_color" "$installed_marker"
        "${YELLOW:-}" "[${screen_update_repos[entry]}] "
        "${GREEN:-}" "${screen_updates[entry]}: "
        "${RED:-}" "${screen_update_old[entry]}"
        "${WHITE:-}" ' → '
        "${BLUE:-}" "${screen_update_new[entry]}"
    )
}

# Clip visible text before applying colors, so escape sequences do not consume
# terminal columns or get cut in half when a row contains several colors.
screen_write_parts()
{
    local row=$1 remaining=$2 color text
    shift 2
    printf '\033[%s;1H\033[2K' "$row" >&"$screen_fd"
    while [ "$#" -ge 2 ] && [ "$remaining" -gt 0 ]; do
        color=$1
        text=$2
        shift 2
        text=${text//$'\n'/ }
        text=${text//$'\r'/ }
        text=${text//$'\t'/ }
        text=${text:0:remaining}
        printf '%b%s' "$color" "$text" >&"$screen_fd"
        remaining=$((remaining - ${#text}))
    done
    printf '\033[0m' >&"$screen_fd"
}

screen_draw()
{
    [ "${screen_active:-}" = 1 ] || return 0
    [ "${screen_drawing:-}" != 1 ] || return 0
    local screen_drawing=1 rows columns row mode current progress available first entry
    local -a fields colors update_rows update_parts
    read -r rows columns < <(stty size <&"$screen_fd" 2>/dev/null)
    [[ $rows =~ ^[0-9]+$ ]] && [ "$rows" -gt 0 ] || rows=24
    [[ $columns =~ ^[0-9]+$ ]] && [ "$columns" -gt 1 ] || columns=80
    current=${screen_checked:-0}
    # While a request is in flight, show the package being checked now.
    if [ "${screen_checking:-}" = 1 ] && [ -n "${screen_path:-}" ]; then
        current=$((current + 1))
    fi
    progress=$(check_progress "$current" "${screen_total_packages:-0}")
    mode='Applying updates'
    [ -z "${test_upgrade:-}" ] || mode='Test run'
    [ -z "${update_repo_newer_only:-}" ] || mode+=" (newer only)"
    fields=(
        "PPath:     $screen_path"
        "URL:       $screen_source"
        "Filename:  $screen_name"
        "Version:   $screen_version"
        "New URL:   $screen_new_url"
        "Command:   $screen_command"
        "Upgraded:  $screen_found"
        "Status:    $screen_status"
        "Message:   $screen_message"
        ''
        "Updates: ${count:-0}"
        "Missing: ${missing:-0}"
        "Checked: $progress"
        "Mode: $mode"
    )
    colors=("${YELLOW:-}" "${YELLOW:-}" "${GREEN:-}" "${RED:-}"
        "${PINK:-}" "${PURPLE:-}" "${BLUE:-}" '' "${CYAN:-}"
        '' "${BLUE:-}" "${BLUE:-}" "${BLUE:-}" "${YELLOW:-}")
    if [[ $screen_message == *ERROR* || $screen_message == *error* ]]; then
        colors[8]=${RED:-}
    elif [[ $screen_message == 'No override'* ]]; then
        colors[8]=${FRED:-}
    fi
    # Keep a complete result visible during the next network request. Mixing
    # the previous version with the next package's name would be misleading.
    if [ "${screen_phase:-}" = scan ]; then
        if [ "${screen_checking:-}" = 1 ]; then
            if [ "${#screen_result_fields[@]}" -gt 0 ]; then
                for ((row=0; row<9; row++)); do
                    fields[row]=${screen_result_fields[row]}
                done
                colors[8]=$screen_result_message_color
            fi
        else
            screen_result_fields=("${fields[@]:0:9}")
            screen_result_message_color=${colors[8]}
        fi
    fi
    # Keep the package and totals visible in a short terminal as well.
    if [ "$rows" -lt "$((${#fields[@]} + 3))" ]; then
        fields=("${fields[0]}" "Updates: ${count:-0}  Missing: ${missing:-0}"
            "Checked: $progress"
            "${fields[3]}" "${fields[6]}"
            "${fields[7]}" "${fields[8]}" "Mode: $mode")
        colors=("${YELLOW:-}" "${BLUE:-}" "${BLUE:-}" "${RED:-}" "${BLUE:-}" '' "${CYAN:-}" "${YELLOW:-}")
    fi
    if [ "$rows" -lt "$((${#fields[@]} + 3))" ]; then
        fields=("${fields[0]}" "Updates: ${count:-0}  Missing: ${missing:-0}"
            "Checked: $progress" "Mode: $mode")
        colors=("${YELLOW:-}" "${BLUE:-}" "${BLUE:-}" "${YELLOW:-}")
    fi
    if [ "${screen_phase:-}" = apply ]; then
        fields=("Updating: $screen_updating"
            "Status: $screen_upgrade_status"
            "Package $screen_apply_index/$screen_apply_total")
        colors=("${GREEN:-}" "${BLUE:-}" "${WHITE:-}")
    else
        fields+=('' 'Packages to be updated:  [i] installed  [ ] not installed')
        colors+=('' "${WHITE:-}")
        available=$((rows - ${#fields[@]}))
        [ -z "${scan_input_fd:-}" ] || available=$((available-1))
        if [ "$available" -gt 0 ]; then
            if [ "${#screen_updates[@]}" -eq 0 ]; then
                fields+=('None found yet.')
                colors+=("${WHITE:-}")
            else
                # Keep the latest changes visible without scrolling the terminal.
                first=0
                if [ "${#screen_updates[@]}" -gt "$available" ]; then
                    if [ "$available" -gt 1 ]; then
                        first=$((${#screen_updates[@]} - available + 1))
                        fields+=("... $first earlier updates")
                        colors+=("${CYAN:-}")
                    else
                        first=$((${#screen_updates[@]} - 1))
                    fi
                fi
                for ((entry=first; entry<${#screen_updates[@]}; entry++)); do
                    update_rows[${#fields[@]}]=$entry
                    fields+=("${screen_updates[entry]}")
                    colors+=("${GREEN:-}")
                done
            fi
        fi
    fi
    for ((row=1; row<=rows && row<=${#fields[@]}; row++)); do
        if [ -n "${update_rows[row-1]+set}" ]; then
            entry=${update_rows[row-1]}
            screen_update_parts "$entry"
            screen_write_parts "$row" "$((columns-1))" "${update_parts[@]}"
        else
            screen_write_parts "$row" "$((columns-1))" "${colors[row-1]}" "${fields[row-1]}"
        fi
    done
    # Clear rows left over after a resize without issuing scrolling newlines.
    if [ "$row" -le "$rows" ]; then
        printf '\033[%s;1H\033[J' "$row" >&"$screen_fd"
    fi
    if [ -n "${scan_input_fd:-}" ] && [ "${screen_phase:-}" = scan ]; then
        screen_write_parts "$rows" "$((columns-1))" "${WHITE:-}" '(q to stop after current check)'
    fi
}

screen_begin_package()
{
    screen_phase=scan
    screen_checking=1
    screen_path=$1/spkgbuild
    screen_source=
    screen_new_url=
    screen_name=${1##*/}
    screen_version=
    screen_found='Checking...'
    screen_command=
    screen_message=
    screen_status='Reading recipe'
    screen_draw
}

screen_package_details()
{
    [ "${screen_active:-}" = 1 ] || return 0
    screen_source=$url
    screen_name=$name
    screen_version=$version
}

screen_fetch()
{
    [ "${screen_active:-}" = 1 ] || return 0
    screen_new_url=$url
    screen_command=${cmd:-}
    screen_status='Fetching version information'
    screen_draw
}

screen_end_package()
{
    screen_phase=scan
    screen_checking=
    screen_checked=$((screen_checked+1))
    screen_command=${cmd:-}
    screen_found=${uversion:-Not found}
    if [ -n "${update_repo_skip:-}" ]; then
        screen_found='Not applicable'
        screen_status=${update_repo_skip_status:-Manual update}
    elif [ -z "${uversion:-}" ]; then
        screen_status='Version not found'
    elif [ "$uversion" = "$screen_version" ]; then
        screen_status='Already current'
    elif [ -n "${update_repo_review_reason:-}" ]; then
        screen_status='Packaging review required'
    elif [ -n "${update_repo_not_newer:-}" ]; then
        screen_status='Skipped: found version is not newer (-n)'
    else
        screen_status='Updated'
        [ -z "${test_upgrade:-}" ] || screen_status='Update saved for review'
    fi
    # Overrides and external tools can print freely into this package's capture.
    # Show their latest useful message, preferring errors over routine notices.
    screen_message=$(LC_ALL=C awk '
        {
            gsub(/\033\[[0-9;]*[[:alpha:]]/, "")
            gsub(/[[:cntrl:]]/, " ")
            if ($0 ~ /^(PPath:|URL:|Filename:|Version:|New URL:|Command:|Upgraded:|NEW$|Overupdated$|---)/ || $0 == "")
                next
            message = $0
            if (tolower($0) ~ /(error|failed|cannot|can.t|no such file|not supported)/)
                error = $0
        }
        END { print error != "" ? error : message }
    ' "$screen_output")
    screen_draw
}

screen_upgrading()
{
    [ "${screen_active:-}" = 1 ] || return 0
    screen_phase=apply
    screen_updating=${1%/spkgbuild}
    screen_upgrade_status="Upgrading from $2 to $3"
    screen_apply_index=$4
    screen_apply_total=$5
    screen_draw
}

# Index generated update commands without executing them. Multiple edits to a
# recipe (source pin, version, changelog) count as one package in the display.
screen_prepare_apply()
{
    local line package repo_pattern
    repo_pattern=$(printf '%s' "$repo_root" | sed 's/[][\.^$*+?(){}|]/\\&/g')
    screen_path_pattern="(^|[[:space:]\"'])($repo_pattern/)?([[:alnum:]_.+-]+/[[:alnum:]_.+-]+)/spkgbuild([[:space:]\"']|$)"
    # Keep recognizing update scripts saved by older releases.
    screen_version_pattern='s/version=([^/]+)/version=([^/]+)/g'
    screen_version_metadata='# update-repo-version ([^[:space:]]+) ([^[:space:]]+)$'
    declare -gA screen_pending_packages=() screen_pending_old=() screen_pending_new=() screen_applied=()
    screen_pending_order=()
    while IFS= read -r line || [ -n "$line" ]; do
        [[ $line == \#* ]] && continue
        [[ $line =~ $screen_path_pattern ]] || continue
        package=${BASH_REMATCH[3]}
        if [ -z "${screen_pending_packages[$package]:-}" ]; then
            screen_pending_order+=("$package")
        fi
        screen_pending_packages["$package"]=1
        if [[ $line =~ $screen_version_metadata ]] || [[ $line =~ $screen_version_pattern ]]; then
            screen_pending_old["$package"]=${BASH_REMATCH[1]}
            screen_pending_new["$package"]=${BASH_REMATCH[2]}
        fi
    done < "$1"
    screen_apply_total=${#screen_pending_packages[@]}
    screen_apply_index=0
}

screen_apply_command()
{
    local command=$1 package
    [[ $command =~ $screen_path_pattern ]] || return 0
    package=${BASH_REMATCH[3]}
    [ -n "${screen_pending_packages[$package]:-}" ] || return 0
    [ -z "${screen_applied[$package]:-}" ] || return 0
    screen_applied["$package"]=1
    screen_phase=apply
    screen_updating=$package
    screen_apply_index=$((screen_apply_index+1))
    if [ -n "${screen_pending_old[$package]:-}" ] && [ -n "${screen_pending_new[$package]:-}" ]; then
        screen_upgrade_status="Upgrading from ${screen_pending_old[$package]} to ${screen_pending_new[$package]}"
    else
        screen_upgrade_status='Applying saved update'
    fi
    screen_draw
}

run_saved_updates()
{
    local result=0 diagnostics
    screen_prepare_apply test_updates.sh
    # Start also initializes the retained list for redirected or dumb output.
    screen_start
    if [ "${screen_active:-}" != 1 ]; then
        bash test_updates.sh
        return $?
    fi
    screen_phase=apply
    screen_updating='Preparing saved updates'
    screen_upgrade_status='Starting'
    screen_draw
    # The child keeps the script's original shell isolation. DEBUG observes its
    # commands before execution; it does not split, rewrite, or eval their text.
    # Let that child handle resizes with its current package, not the parent.
    trap '' WINCH
    (
        trap - EXIT
        trap 'screen_draw' WINCH
        set -T
        trap 'screen_apply_command "$BASH_COMMAND"' DEBUG
        source ./test_updates.sh
    ) > "$screen_output" 2>&1 || result=$?
    trap 'screen_draw' WINCH
    diagnostics=$(cat "$screen_output")
    screen_stop
    # Preserve diagnostics from failed commands without a scrolling scan.
    if [ "$result" -ne 0 ]; then
        printf '%s\n' "$diagnostics" >&2
    fi
    return "$result"
}

check_package()
{
    get_url "$1/spkgbuild"
    check_override="$1/override"
    if [ -f "$check_override" ]; then
        perform_override
    else
        upgrade_normally
    fi
    upgrade_process
}

print_progress() {
        echo -ne " $@\033[0K\r"
}
get_url()
{
	local source_entry remaining_sources
	# Override settings belong to one package only.
	unset update_repo_skip update_repo_skip_status update_repo_fetch_kind update_repo_review_reason
	source "$1"
	ppath=$1
	unset uversion
	source_version_dirs=
	# Scratchpkg accepts local-filename::URL as well as an ordinary URL.
	# Keep the first source, including scalar lists split over multiple lines.
	source_entry="${source[0]}"
	read -r url remaining_sources <<< "${source_entry//$'\n'/ }"
	case "$url" in
		*::*) url="${url#*::}" ;;
	esac
	url="${url%%\?*}"
	url="${url%%\#*}"
	url="${url%/*}/"
	case "$url" in
		*/"$version"/) source_version_dirs=1 ;;
	esac
}
fetch() {
	screen_fetch
	# Never reuse an earlier package's listing after a failed fetch.
	rm -f index.html
	local fetch_status=0
	case "${update_repo_fetch_kind:-http}" in
		git-tags)
			GIT_TERMINAL_PROMPT=0 timeout 30 git ls-remote --tags --refs "$url" > index.html || fetch_status=$?
			;;
		deb-control)
			python3 - "$url" <<'PYCONTROL' || fetch_status=$?
import pathlib,sys,urllib.request
with urllib.request.urlopen(urllib.request.Request(sys.argv[1],headers={'Range':'bytes=0-1048575'}),timeout=20) as response:
    pathlib.Path('index.html').write_bytes(response.read(1048576))
PYCONTROL
			;;
		headers)
			curl -fLsS -I --max-time 20 "$url" -o index.html || fetch_status=$?
			;;
		*) curl -fLsS --max-time 20 "$url" -o index.html || fetch_status=$? ;;
	esac
	if [ "$fetch_status" != 0 ]; then
		rm -f index.html
		unset uversion
		printf 'ERROR: Unable to download listing: %s\n' "$url" >&2
		return 1
	fi
}
alter_per_url() {
        case $url in
                *github.com*)
                        url=https://github.com/$(echo $url | cut -d / -f4,5)/tags;;
                *downloads.sourceforge.net*)
                        url="https://sourceforge.net/projects/$(echo $url | cut -d / -f4)/rss?path=/";;
                *sourceforge.net*)
                        url="https://sourceforge.net/projects/$(echo $url | cut -d / -f5)/rss?path=/";;
                *gitlab.com*)
                        url=$(echo $url | cut -d/ -f1-5)/tags;;
                *python.org*|*pypi.org*|*pythonhosted.org*|*pypi.io*|*pypi.org*)
			url=https://pypi.org;;
		*cpan.*)
			url=https://cpan.org;;
                *rubygems.org*)
                        url=https://rubygems.org/gems/${name/ruby-/};;
                *launchpad.net*)
                        url=https://launchpad.net/$(echo $url | cut -d / -f4)/;;
                *ftp.gnome.org*)
                        url=https://ftp.gnome.org/pub/gnome/sources/$filename/cache.json;;
                *archive.xfce.org*)
                        url=http://archive.xfce.org/src/$(echo $url | cut -d / -f5)/$name/
                        url=$(echo $url | sed "s/http/https/g");;
		*/plasma/*)
			url="$(echo $url | cut -d / -f1-5)/"
			;;
                */frameworks/*)
                        url="$(echo $url | cut -d / -f1-5)/"
                        ;;
		*.kde.*/*/release-service/*)
			url="$(echo $url | cut -d / -f1-5)/"
			;;
		*..subsonic.*)
			url="http://www.subsonic.org/pages/download.jsp"
			;;
		*://x.org/*|*://*.x.org/*|*://xcb.freedesktop.org/*|*://xorg.freedesktop.org/*)
			url=$(echo $url | sed "s/pub/archive/g" | sed "s/ftp/www/g")
			if [[ "$url" == *"http://"* ]]; then
				url=$(echo $url | sed "s/http/https/g")
			fi
			;;
               *qt.io*)
               		url="$(echo $url | cut -d / -f1-6)/"
               		;;
                *)
			# A .../2.0.0/archive.tar.xz source needs the parent release list.
			if [ "$source_version_dirs" = 1 ];then
				url="${url%"$version"/}"
			fi
        esac
}
get_source_listing_version()
{
	[ -r index.html ] || return 1
	{
		grep -Eio "$name[_-][0-9a-z.]+[.]tar[.][bgx]z2?" index.html \
			| sed "s/$name[-_]//;s/\.tar.*//" \
			| grep -Evi '(alpha|beta|rc|pre|latest)' \
			| grep -Eo '([0-9]+\.)+[0-9]+'
		if [ "$source_version_dirs" = 1 ];then
			# Match release directory links, not dates or unrelated page text.
			grep -Eio "href=['\"][0-9]+([.][0-9]+)+/['\"]" index.html \
				| grep -Eo '([0-9]+\.)+[0-9]+'
		fi
	} | sort -V -r | uniq | head -n1
}
