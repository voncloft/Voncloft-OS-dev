			else
				echo -e "${FRED}No override for $name; checking the source listing${NC}"
				if ! fetch;then
					retry_index || return 1
					grep_retry
				else
				uversion=$(get_source_listing_version)
				#####more robust maybe idk
				#uversion=$(update_repo_html_matches text index.html \
				#| grep -v : \
				#| tr '[:upper:]' '[:lower:]' \
				#| grep $name \
				#| grep -E -o "([0-9]{1,}\.)+[0-9]{1,}" \
				#| uniq \
				#| sort -V -r \
				#| head -n1)
        			fi
			fi
                	;;
        esac
}
retry_index()
{
	local fallback_url
	spkg_src=$(grep "source=" "$ppath" | sed "s/source=//g")
	for fallback_url in \
		"https://raw.githubusercontent.com/archlinux/svntogit-community/packages/$name/trunk/PKGBUILD" \
		"https://raw.githubusercontent.com/archlinux/svntogit-packages/packages/$name/trunk/PKGBUILD"
	do
		url=$fallback_url
		fetch && return 0
	done
	return 1
}
grep_retry()
{
	unset uversion url_lazy new_url
	if [ -f test.txt ];then
        	rm test.txt
	fi
	if [ -f /sources/Voncloft-OS-dev/index.html ];then
		grep "pkg=" index.html > /sources/Voncloft-OS-dev/test.txt
