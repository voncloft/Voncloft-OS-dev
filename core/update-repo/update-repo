                        -st) skip_tar=1;;
                        -t) test_upgrade=1;;
                        -n) update_repo_newer_only=1;;
                        -s) repos;;
                        -all|--all) repos="*/*";;
                        -p) shift;; # Path was validated before entering the repository.
                        -k) keep_index=1;;
                        -e) edit_program
                        exit;;
                        -stu) show_test_updates
                        apply=1
                        exit;;
                        -utg) update_to_github
                        exit;;
                        -tp) test_prog
                        exit;;
			-h) help
         		exit;;
                        -l) apply_test_updates || exit $?
         		apply=1
