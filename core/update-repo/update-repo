	for f in $repos; do
		[ "${f##*/}" != "REPO" ] && [ -f "$f/spkgbuild" ] || continue
		screen_total_packages=$((screen_total_packages+1))
	done
	screen_start
	scan_input_start
	for f in $repos;
	do
		[ "${f##*/}" != "REPO" ] && [ -f "$f/spkgbuild" ] || continue
		scan_quit_requested && break
		if [ "${screen_active:-}" = 1 ]; then
			screen_begin_package "$f"
			# Keep this in the current shell so counters and detected versions
			# survive, while override output cannot scroll the terminal.
			check_package "$f" </dev/null > "$screen_output" 2>&1
			screen_end_package
		else
			echo "-----------------------------------------------------------------------------------"
			check_package "$f"
		fi
		checked_packages=$((checked_packages+1))
		scan_quit_requested && break
	done
	# Restore and clear the terminal; completion shows only the summary.
	screen_stop
	finish_logs	
	alerts_and_logs
}
