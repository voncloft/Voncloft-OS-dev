    screen_draw
}

screen_end_package()
{
    screen_phase=scan
    screen_checking=
    screen_checked=$((screen_checked+1))
    screen_command=${cmd:-}
    screen_found=${uversion:-Not found}
    if [ -n "${update_repo_skip:-}" ]; then
        screen_found='Not applicable'
        screen_status=${update_repo_skip_status:-Manual update}
    elif [ -z "${uversion:-}" ]; then
        screen_status='Version not found'
    elif [ "$uversion" = "$screen_version" ]; then
        screen_status='Already current'
    elif [ -n "${update_repo_review_reason:-}" ]; then
        screen_status='Packaging review required'
    else
        screen_status='Updated'
        [ -z "${test_upgrade:-}" ] || screen_status='Update saved for review'
    fi
    # Overrides and external tools can print freely into this package's capture.
    # Show their latest useful message, preferring errors over routine notices.
    screen_message=$(LC_ALL=C awk '
        {
            gsub(/\033\[[0-9;]*[[:alpha:]]/, "")
            gsub(/[[:cntrl:]]/, " ")
            if ($0 ~ /^(PPath:|URL:|Filename:|Version:|New URL:|Command:|Upgraded:|NEW$|Overupdated$|---)/ || $0 == "")
                next
            message = $0
            if (tolower($0) ~ /(error|failed|cannot|can.t|no such file|not supported)/)
                error = $0
        }
        END { print error != "" ? error : message }
    ' "$screen_output")
    screen_draw
}

screen_upgrading()
{
    [ "${screen_active:-}" = 1 ] || return 0
    screen_phase=apply
    screen_updating=${1%/spkgbuild}
    screen_upgrade_status="Upgrading from $2 to $3"
    screen_apply_index=$4
    screen_apply_total=$5
    screen_draw
}

# Index generated update commands without executing them. Multiple edits to a
# recipe (source pin, version, changelog) count as one package in the display.
screen_prepare_apply()
{
    local line package
    screen_path_pattern="(^|[[:space:]\"'])(/sources/Voncloft-OS-dev/)?([[:alnum:]_.+-]+/[[:alnum:]_.+-]+)/spkgbuild([[:space:]\"']|$)"
    # Keep recognizing update scripts saved by older releases.
    screen_version_pattern='s/version=([^/]+)/version=([^/]+)/g'
    screen_version_metadata='# update-repo-version ([^[:space:]]+) ([^[:space:]]+)$'
    declare -gA screen_pending_packages=() screen_pending_old=() screen_pending_new=() screen_applied=()
    while IFS= read -r line || [ -n "$line" ]; do
        [[ $line == \#* ]] && continue
        [[ $line =~ $screen_path_pattern ]] || continue
        package=${BASH_REMATCH[3]}
        screen_pending_packages["$package"]=1
        if [[ $line =~ $screen_version_metadata ]] || [[ $line =~ $screen_version_pattern ]]; then
            screen_pending_old["$package"]=${BASH_REMATCH[1]}
            screen_pending_new["$package"]=${BASH_REMATCH[2]}
        fi
    done < "$1"
    screen_apply_total=${#screen_pending_packages[@]}
    screen_apply_index=0
}

screen_apply_command()
{
    local command=$1 package
    [[ $command =~ $screen_path_pattern ]] || return 0
    package=${BASH_REMATCH[3]}
    [ -n "${screen_pending_packages[$package]:-}" ] || return 0
    [ -z "${screen_applied[$package]:-}" ] || return 0
    screen_applied["$package"]=1
    screen_phase=apply
    screen_updating=$package
    screen_apply_index=$((screen_apply_index+1))
    if [ -n "${screen_pending_old[$package]:-}" ] && [ -n "${screen_pending_new[$package]:-}" ]; then
        screen_upgrade_status="Upgrading from ${screen_pending_old[$package]} to ${screen_pending_new[$package]}"
    else
        screen_upgrade_status='Applying saved update'
    fi
    screen_draw
}

run_saved_updates()
{
    local result=0 diagnostics
    screen_prepare_apply test_updates.sh
    # Keep the existing plain output when redirected or on a dumb terminal.
    if [ ! -t 1 ] || [ "${TERM:-dumb}" = dumb ]; then
        bash test_updates.sh
        return $?
    fi
    screen_start
    if [ "${screen_active:-}" != 1 ]; then
        bash test_updates.sh
        return $?
    fi
    screen_phase=apply
    screen_updating='Preparing saved updates'
    screen_upgrade_status='Starting'
    screen_draw
    # The child keeps the script's original shell isolation. DEBUG observes its
    # commands before execution; it does not split, rewrite, or eval their text.
    # Let that child handle resizes with its current package, not the parent.
    trap '' WINCH
    (
        trap - EXIT
        trap 'screen_draw' WINCH
        set -T
        trap 'screen_apply_command "$BASH_COMMAND"' DEBUG
        source ./test_updates.sh
    ) > "$screen_output" 2>&1 || result=$?
    trap 'screen_draw' WINCH
    diagnostics=$(cat "$screen_output")
    screen_stop
    # Preserve diagnostics from failed commands without a scrolling scan.
    if [ "$result" -ne 0 ]; then
        printf '%s\n' "$diagnostics" >&2
    fi
    return "$result"
}

