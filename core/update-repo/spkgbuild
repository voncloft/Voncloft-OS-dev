# description : Checks Scratchpkg recipe versions with a live terminal display and records or applies repository updates
# depends : bash coreutils curl findutils git foltotar grep gzip less nano python sed tar

name=update-repo
version=20261029
release=15
source="update-repo changelog update-rep"

build() {
    install -Dm755 "$SRC/update-repo" "$PKG/usr/bin/update-repo"
    install -Dm755 "$SRC/changelog" "$PKG/usr/libexec/update-repo/changelog"
    install -Dm755 "$SRC/update-rep" "$PKG/usr/bin/update-rep"
    
    # Runtime log directories are created by update-repo for the active repository.
}
