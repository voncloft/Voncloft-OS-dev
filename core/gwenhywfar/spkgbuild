# description : OS abstraction functions
# depends : gnutls libgcrypt openssl qt6

name=gwenhywfar
version=5.14.1
release=1

source="https://www.aquamaniac.de/rdm/attachments/download/630/${name}-${version}.tar.gz"
options="!checksum"

build() {
	cd "$SRC"/gwenhywfar*/
	./configure --prefix=/usr --sysconfdir=/etc --enable-system-certs --with-guis="gtk3 qt6"
	sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
	make
	make DESTDIR=$PKG install
}
