# description : Sources for time zone and daylight saving time data

name=tzdata
version=2026f
release=3
source="https://data.iana.org/time-zones/releases/tzdata${version}.tar.gz
        https://data.iana.org/time-zones/releases/tzcode${version}.tar.gz"

build() {
    # Build a matching compiler locally; glibc owns the installed zic and zdump.
    make CC=gcc zic tzdata.zi
    ZONEINFO="$PKG/usr/share/zoneinfo"
    mkdir -p "$ZONEINFO/posix" "$ZONEINFO/right"
    ./zic -b fat -d "$ZONEINFO" tzdata.zi
    ./zic -b fat -d "$ZONEINFO/posix" tzdata.zi
    ./zic -b fat -L leapseconds -d "$ZONEINFO/right" tzdata.zi
    ./zic -b fat -d "$ZONEINFO" -p America/New_York
    cp zone.tab zone1970.tab zonenow.tab iso3166.tab leapseconds leap-seconds.list tzdata.zi "$ZONEINFO/"
    # Package data only, preserving /etc/localtime and the current timezone choice.
}
