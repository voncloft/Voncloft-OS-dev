# description : Intel CPU microcode updates loaded early during boot through GRUB
# depends : iucode-tool

name=intel-ucode
version=20261110
release=2
_name=Intel-Linux-Processor-Microcode-Data-Files
source="${name}-${version}.tar.gz::https://github.com/intel/${_name}/archive/refs/tags/microcode-${version}.tar.gz
        update-grub
        42_intel_ucode_fallback"

build() {
    cd "$SRC/${_name}-microcode-${version}"

    # Use the release's regular microcode without historical replacements or
    # the separately documented updates requiring special platform handling.
    rm -f intel-ucode/list
    iucode_tool --write-earlyfw=intel-ucode.img intel-ucode/

    install -Dm644 intel-ucode.img "$PKG/boot/intel-ucode.img"
    install -Dm644 license "$PKG/usr/share/licenses/$name/LICENSE"
    install -Dm755 "$SRC/update-grub" "$PKG/usr/libexec/$name/update-grub"
    install -Dm755 "$SRC/42_intel_ucode_fallback" \
        "$PKG/etc/grub.d/42_intel_ucode_fallback"
}
