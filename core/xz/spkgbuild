# description : Programs for compressing and decompressing files
# depends     : bash

name=xz
version=5.8.4
release=3
source="https://github.com/tukaani-project/xz/releases/download/v$version/xz-$version.tar.xz"

build() {
    # 64-bit build.
    cd $name-$version

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --disable-static \
        --disable-nls
    make
    make DESTDIR=$PKG install

    rm -r $PKG/usr/share/doc

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --host=i686-pc-linux-gnu \
        --disable-static \
        --disable-nls
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
