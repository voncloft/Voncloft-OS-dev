# description   : The Tk package contains a TCL GUI Toolkit
# depends       : tcl xorg-libraries

name=tk
version=9.1.0
release=1
source=" https://downloads.sourceforge.net/tcl/${name}${version}-src.tar.gz"
options="!checksum"

build() {
        cd "$name$version"
        cd unix 
	./configure --prefix=/usr \
            --mandir=/usr/share/man \
            $([ $(uname -m) = x86_64 ] && echo --enable-64bit) 

	make
	sed -e "s@^\(TK_SRC_DIR='\).*@\1/usr/include'@" \
    -e "/TK_B/s@='\(-L\)\?.*unix@='\1/usr/lib@" \
    -i tkConfig.sh

    make DESTDIR=$PKG install 
    make DESTDIR=$PKG install-private-headers 
ln -v -sf "wish${version%.*}" "$PKG/usr/bin/wish"
chmod -v 755 "$PKG/usr/lib/libtk${version%.*}.so"
}
