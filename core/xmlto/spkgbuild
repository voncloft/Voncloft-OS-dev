# description   : The xmlto package is a front-end to a XSL toolchain
# depends       : docbook-xml docbook-xsl-nons libxslt

name=xmlto
version=0.0.29
release=1
source=" https://pagure.io/${name}/archive/${version}/${name}-${version}.tar.gz"
options="!checksum"

build() {
        cd $name-$version
        autoreconf -fiv                                  
LINKS="/usr/bin/links" ./configure --prefix=/usr 
make
make DESTDIR=$PKG install
}
