# Verify final releases using the actual upstream project.
source="https://pagure.io/xmlto"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import re,subprocess
result=subprocess.run(['git','ls-remote','--tags','https://pagure.io/xmlto.git'],capture_output=True,text=True,check=True,timeout=60)
versions=re.findall(r'refs/tags/([0-9]+(?:\.[0-9]+)*)$',result.stdout,re.M)
if not versions:raise SystemExit('No final xmlto tags found')
print(max(versions,key=lambda v:tuple(map(int,v.split('.')))))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
