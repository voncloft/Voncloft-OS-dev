# description	: Configuration database system used by many GNOME applications
# depends	: dbus-glib libxml2 gtk3 polkit glib

name=gconf
version=3.2.6
release=2
_name=GConf
source="https://ftp.gnome.org/pub/gnome/sources/${_name}/${version%.*}/${_name}-$version.tar.xz"

build() {
	cd GConf-$version
	./configure --prefix=/usr \
	            --sysconfdir=/etc \
		    --libexecdir=/usr/lib/$name \
	            --disable-orbit \
	            --disable-static
	make
	make DESTDIR=$PKG install

	ln -s gconf.xml.defaults \
	      $PKG/etc/gconf/gconf.xml.system
}
