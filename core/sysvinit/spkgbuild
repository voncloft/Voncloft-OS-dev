# description : System V init and shutdown utilities

name=sysvinit
version=3.15
release=1
source="${name}-${version}.tar.gz::https://github.com/slicer69/${name}/archive/refs/tags/${version}.tar.gz
        ${name}-consolidated.patch"

build() {
	cd $name-$version
	patch --fuzz=0 -Np1 -i "$SRC/${name}-consolidated.patch"
	make
	make DESTDIR=$PKG install	
}
