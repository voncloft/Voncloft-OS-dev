# description	: Programs to find files
# depends	: bash

name=findutils
version=4.11.0
release=2
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.xz"
options="!checksum"
build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/$name \
		--localstatedir=/var/lib/locate \
		--disable-nls
	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share/info
}
