# description	: The GNUstep make package

name=gnustep-make
version=2.9.0
verzion=${version//./_}
release=1
backup="etc/GNUstep/GNUstep.conf"
_name=tools-make
source="https://github.com/gnustep/${_name}/archive/make-${verzion}.tar.gz"

build() {
	cd tools-make-make-${verzion}
	./configure \
		--prefix=/usr \
		--enable-native-objc-exceptions
	make
	make DESTDIR=$PKG install
}
