# description : gooogle test c++ utility
# depends : gcc 

name=gtest
version=1.18.0
release=3

_name=googletest
source="https://github.com/google/${_name}/archive/release-${version}.tar.gz"
	
options="!checksum"

build() {
	cd googletest-release-$version
	#sed "s|__GOOGLETEST_VERSION__|${version}|g" -i $SRC/gtest-1.10.0-libversion.patch
	#patch -Np1 -i $SRC/gtest-1.10.0-libversion.patch

	#sed -E "s|(GOOGLETEST_VERSION) [0-9\\.]+|\\1 ${version}|" -i CMakeLists.txt
	
	mkdir build
	cd build
	cmake .. \
	-DCMAKE_INSTALL_PREFIX=/usr \
    	-DCMAKE_INSTALL_LIBDIR=lib \
    	-DBUILD_SHARED_LIBS=ON \
    	-Dgtest_build_tests=ON	

	make
	make DESTDIR=$PKG install
}
