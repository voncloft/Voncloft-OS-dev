# description	: Keytable files
# depends : bzip2 zlib xz zstd autoconf automake libtool

name=kbd
version=2.10.0
release=4
source="https://www.kernel.org/pub/linux/utils/${name}/${name}-$version.tar.xz
	https://www.linuxfromscratch.org/patches/downloads/${name}/${name}-$version-backspace-1.patch
        vonos-library-and-test-portability.patch"
options="!checksum"
build() {
	cd $name-$version
    patch --fuzz=0 -p1 < "$SRC/vonos-library-and-test-portability.patch"
	patch -Np1 -i $SRC/kbd-$version-backspace-1.patch

	sed -i '/RESIZECONS_PROGS=/s/yes/no/' configure
	sed -i 's/resizecons.8 //' docs/man/man8/Makefile.in
	./configure --prefix=/usr --disable-vlock
	make
	make DESTDIR=$PKG install
}
