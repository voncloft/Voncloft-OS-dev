# description : Simple text editor which aims to replace Pico, the default editor in the Pine package
# depends : file ncurses

name=nano
version=9.3
release=2
source="https://www.nano-editor.org/dist/v${version%%.*}/$name-$version.tar.xz
        .nanorc"
options="!checksum"

build() {
    cd "$name-$version"

    ./configure --prefix=/usr \
                --sysconfdir=/etc \
                --enable-utf8 \
                --docdir="/usr/share/doc/$name-$version" \
                --disable-nls
    make
    make DESTDIR="$PKG" install

    install -Dm644 "$SRC/.nanorc" "$PKG/etc/skel/.nanorc"
    install -Dm644 doc/sample.nanorc "$PKG/etc/nanorc"
    install -dm755 "$PKG/usr/share/doc/$name-$version"
    install -vm644 doc/nano.html doc/sample.nanorc \
        "$PKG/usr/share/doc/$name-$version"
}
