# description	: Base icon theme from the Numix project (circle)
# depends	: gtk3

name=numix-icon-theme-circle
version=20260221200336.g6d4a4aad60994e688ab9dc8f021cb4ec86e9e532
release=1
options="!strip"
_commit=${version##*.g}
source="$name-$_commit.tar.gz::https://github.com/numixproject/${name}/archive/$_commit.tar.gz"

build() {
	cd $name-$_commit
	install -dm 755 $PKG/usr/share/icons
	cp -dr --no-preserve='ownership' Numix-Circle Numix-Circle-Light $PKG/usr/share/icons/
}

