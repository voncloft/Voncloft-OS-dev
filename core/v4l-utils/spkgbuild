# description : v4l-utils provides a series of utilities for media devices, allowing the ability to handle the proprietary formats available from most webcams (libv4l), and providing tools to test V4L devices
# depends     : alsa-lib glu libjpeg-turbo eudev meson ninja pkgconf

name=v4l-utils
version=1.32.0
release=3
backup="etc/rc_maps.cfg"
source=" https://www.linuxtv.org/downloads/${name}/${name}-$version.tar.xz"
options="!checksum"

build() {
    # 64-bit build.
    cd $name-$version
    mkdir build
    cd build
    meson setup .. \
        --prefix=/usr \
        --buildtype=release \
        -D udevdir=/usr/lib/udev \
        -D bpf=disabled \
        -D gconv=disabled \
        -D doxygen-doc=disabled
    ninja
    DESTDIR=$PKG ninja install
    mkdir -pv $PKG/usr/bin
    for prog in v4l2gl v4l2grab; do
        cp -v contrib/test/$prog $PKG/usr/bin
    done

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    meson setup .. \
        --prefix=/usr \
        --libdir=lib32 \
        --libexecdir=lib32 \
        --buildtype=release \
        --wrap-mode=nofallback \
        -Dudevdir=/usr/lib/udev \
        -Dbpf=disabled \
        -Dgconv=disabled \
        -Ddoxygen-doc=disabled \
        -Dv4l-utils=false \
        -Dqv4l2=disabled \
        -Dqvidcap=disabled \
        -Dv4l2-tracer=disabled
    ninja
    DESTDIR="$PWD/DESTDIR" ninja install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    rm -rf DESTDIR
}
