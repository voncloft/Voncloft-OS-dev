name=openssh-boot
version=20251220
release=2

_name=blfs-bootscripts
source="https://anduin.linuxfromscratch.org/BLFS/${_name}/${_name}-${version}.tar.xz"
options="!checksum"

backup="etc/rc.d/init.d/sshd"

build() {
        cd blfs-bootscripts-$version
        make DESTDIR=$PKG install-sshd

}
