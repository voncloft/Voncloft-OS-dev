# description	: shellcheck, without the 130MB haskell dependencies
# depends	: gmp

name=shellcheck-static
version=0.11.0
release=1
_name=shellcheck
source="$name-$version.tar.xz::https://github.com/koalaman/${_name}/releases/download/v${version}/${_name}-v${version}.linux.x86_64.tar.xz"

build() {
	cd "$SRC"/shellcheck*/
	install -Dt $PKG/usr/bin shellcheck
}
