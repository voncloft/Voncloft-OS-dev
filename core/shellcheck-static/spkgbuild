# description	: shellcheck, without the 130MB haskell dependencies
# depends	: gmp

name=shellcheck-static
version=0.11.0
release=1
source="$name-$version.tar.xz::https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz"

build() {
	cd "$SRC"/shellcheck*/
	install -Dt $PKG/usr/bin shellcheck
}
