# Track stable upstream source archives, excluding prereleases.
source="https://webkitgtk.org/releases/"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
from pathlib import Path
import re
versions=set(re.findall(r'href="webkitgtk-([0-9]+(?:[.][0-9]+)+)[.]tar[.]xz"', Path('index.html').read_text()))
versions={v for v in versions if int(v.split('.')[1]) % 2 == 0}
if not versions: raise SystemExit('No stable upstream source release found')
print(max(versions, key=lambda value: tuple(map(int, value.split('.')))))
PYUPSTREAM
    ) || return 1
    [ -n "$detected" ] || return 1
    uversion=$detected
}
