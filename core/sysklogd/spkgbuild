# description : Logging system messages, such as those given by the kernel

name=sysklogd
version=2.8.0
release=1
backup="etc/syslog.conf"
source="https://github.com/troglobit/${name}/releases/download/v${version}/${name}-${version}.tar.gz
        syslog.conf"

build() {
    cd "$name-$version"
    ./configure --prefix=/usr \
        --sysconfdir=/etc \
        --runstatedir=/run \
        --without-logger \
        --without-systemd \
        --disable-static \
        --docdir=/usr/share/doc/$name-$version
    make
    make DESTDIR="$PKG" install
    install -Dm644 "$SRC/syslog.conf" "$PKG/etc/syslog.conf"
}
