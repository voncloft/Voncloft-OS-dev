#!/bin/sh
# Report the provider's upstream release; update-repo owns version= changes.
uversion=$(curl -fsSL --connect-timeout 10 --max-time 60 https://poppler.freedesktop.org/ |
    sed -n 's/.*href="poppler-\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)\.tar\.xz".*/\1/p' |
    sort -Vu | tail -n 1)
export uversion
