# description   : MIT Kerberos V5 is a free implementation of Kerberos 5
# depends       : 

name=mitkrb
version=1.22.2    
release=1
_name=krb5
_source2_version=1.21.3
source="https://kerberos.org/dist/${_name}/${version%.*}/${_name}-${version}.tar.gz
https://www.linuxfromscratch.org/patches/blfs/svn/${name}-${_source2_version}-gcc15_fixes-1.patch"

options="!checksum"

build() {
        cd "$SRC"/krb5*/
patch -Np1 -i $SRC/mitkrb-1.21.3-gcc15_fixes-1.patch
cd src 
sed -i -e '/eq 0/{N;s/12 //}' plugins/kdb/db2/libdb2/test/run.test 
./configure --prefix=/usr            \
--sysconfdir=/etc        \
--localstatedir=/var/lib \
--runstatedir=/run       \
--with-system-et         \
--with-system-ss         \
--with-system-verto=no   \
--enable-dns-for-realm   \
--disable-rpath          
make
make DESTDIR=$PKG install 
}
