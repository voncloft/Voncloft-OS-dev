# description : validato for opengl
# depends : cmake spirv-tools

name=gslang
version=16.6.0
release=1

_name=glslang
source="https://github.com/KhronosGroup/${_name}/archive/$version/${_name}-$version.tar.gz"
options="!checksum"
build()
{
	cd *
	mkdir build &&
	cd    build &&

	cmake -D CMAKE_INSTALL_PREFIX=/usr     \
      -D CMAKE_BUILD_TYPE=Release      \
      -D ALLOW_EXTERNAL_SPIRV_TOOLS=ON \
      -D BUILD_SHARED_LIBS=ON          \
      -D GLSLANG_TESTS=ON              \
      -G Ninja ..

	ninja
	DESTDIR=$PKG ninja install
	
}
