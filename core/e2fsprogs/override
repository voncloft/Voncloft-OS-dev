# Read the upstream release archive instead of a version-specific directory.
source="https://www.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re,subprocess
name='e2fsprogs'
url='https://www.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/'
versions=set(re.findall('href="v([0-9]+(?:\\.[0-9]+)*)/',pathlib.Path('index.html').read_text()))
versions=sorted(versions,key=lambda v:tuple(map(int,re.findall(r'[0-9]+',v))),reverse=True)
if not versions:raise SystemExit('No stable source releases found')
print(versions[0])
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
