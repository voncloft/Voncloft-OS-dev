# description	: utilities for handling the ext2, ext3 and ext4 file system
# depends	: bash bc

name=e2fsprogs
version=1.47.4
release=1
backup="etc/mke2fs.conf etc/e2scrub.conf"
source="https://www.kernel.org/pub/linux/kernel/people/tytso/${name}/v${version}/${name}-${version}.tar.xz"
options="!checksum"
build() {
	cd $name-$version

	mkdir -v build
	cd build

	../configure --prefix=/usr           \
	             --sysconfdir=/etc       \
	             --with-udev-rules-dir=/usr/lib/udev/rules.d \
	             --enable-elf-shlibs     \
	             --disable-libblkid      \
	             --disable-libuuid       \
	             --disable-uuidd         \
	             --disable-fsck          \
		     --disable-nls
	make
	make DESTDIR=$PKG install
	make DESTDIR=$PKG install-libs

	# SysVinit owns logsave in this repository; avoid duplicate file ownership.
	rm -v -- "$PKG/usr/sbin/logsave" "$PKG/usr/share/man/man8/logsave.8"

	for i in libcom_err libe2p libext2fs libss; do
		chmod -v u+w $PKG/usr/lib/${i}.a
	done
}
