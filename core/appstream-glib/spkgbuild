# description	: Objects and methods for reading and writing AppStream metadata
# depends	: gcab yaml json-glib  meson libsoup gtk3

name=appstream-glib
version=0.8.4
verzion=$(echo $version | sed 's/\./_/g')
release=1
source="https://github.com/hughsie/${name}/archive/refs/tags/appstream_glib_${version//./_}.tar.gz"

build() {
	cd "$SRC"/appstream-glib-appstream_glib*/

	meson \
	  --prefix=/usr \
	  --sysconfdir=/etc \
	  -Drpm=false \
	build
	ninja -C build
	DESTDIR=$PKG ninja -C build install
}
