# description : implementation of http/2 and header compression algorithm
# depends libxml2

name=nghttp2
version=1.70.0
release=1

source="https://github.com/nghttp2/${name}/releases/download/v$version/${name}-$version.tar.xz"

build()
{
	cd $name-$version
	./configure --prefix=/usr     \
            --disable-static  \
            --enable-lib-only \
            --docdir=/usr/share/doc/nghttp2-$version
       make
       make DESTDIR=$PKG install
}
