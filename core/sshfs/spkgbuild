# description   : The Sshfs package contains a filesystem client based on the SSH File Transfer Protocol
# depends       : fuse3 glib meson ninja openssh pkgconf

name=sshfs
version=3.7.7
release=2
source="https://github.com/libfuse/${name}/releases/download/${name}-${version}/${name}-${version}.tar.xz"

options="!checksum"

build() {
        cd $name-$version
        mkdir build 
cd    build 
meson setup --prefix=/usr --buildtype=release .. 
ninja
#sshfs example.com:/home/userid ~/examplepath
#fusermount3 -u ~/example
DESTDIR=$PKG ninja install
}
