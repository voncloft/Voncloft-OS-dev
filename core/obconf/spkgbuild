# description	: A GTK2 based configuration tool for the Openbox windowmanager
# depends	: libglade openbox startup-notification desktop-file-utils gtk2 libsm

name=obconf
version=2.0.4+git20150213
release=1
source="https://deb.debian.org/debian/pool/main/o/obconf/obconf_2.0.4+git20150213.orig.tar.xz"

build() {
	cd "$SRC"/obconf*/

	./configure --prefix=/usr --disable-nls
	make
	make DESTDIR=$PKG install
}
