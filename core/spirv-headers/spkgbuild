# description : headers for spirv
# depends : cmake

name=spirv-headers
version=1.4.363.0
release=1

#source="https://github.com/KhronosGroup/SPIRV-Headers/archive/vulkan-sdk-$version/SPIRV-Headers-vulkan-sdk-$version.tar.gz"
_name=SPIRV-Headers
source="https://github.com/KhronosGroup/${_name}/archive/refs/tags/vulkan-sdk-${version}.tar.gz"
options="!checksum"

build()
{
	cd *
	mkdir build 
	cd    build 

	        cmake \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_SYSCONFDIR=/etc \
    -D CMAKE_SKIP_INSTALL_RPATH=ON \
	-G Ninja ..

	ninja
	DESTDIR=$PKG ninja install
}
