# description   : Check is a unit testing framework for C
# depends       : 

name=check
version=0.15.2    
release=1
source="https://github.com/libcheck/check/releases/download/$version/check-$version.tar.gz"

options="!checksum"

build() {
    cd $name-$version
    
    ./configure --prefix=/usr --disable-static 
    make
    make DESTDIR=$PKG install
}
