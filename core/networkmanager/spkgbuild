# description : networkmanager - KDE dependency
# depends : bash-completion curl dbus elogind gettext glib jansson libndp libnvme libpsl meson mobile-broadband-provider-info modemmanager ninja nss perl polkit python readline udev util-linux
# note : No service is started or enabled by this recipe.

name=networkmanager
version=1.58.1
release=2

source="$name-$version.tar.gz::https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/archive/$version/NetworkManager-$version.tar.gz"
options="!checksum"

build() {
    cd "NetworkManager-$version"
    # Match the host's SysVinit/elogind setup and available optional integrations.
    meson setup build \
        --prefix=/usr --libdir=lib64 --sysconfdir=/etc --localstatedir=/var \
        --buildtype=release \
        -Dsystemdsystemunitdir=no -Dsystemdsystemgeneratordir=no \
        -Dsystemd_journal=false -Dsession_tracking=elogind \
        -Dsuspend_resume=elogind -Dsession_tracking_consolekit=false \
        -Dselinux=false -Dlibaudit=no -Dclat=false \
        -Dppp=false -Dovs=false -Dnmtui=false -Dintrospection=false \
        -Ddocs=false -Dman=false -Dtests=no
    ninja -C build
    DESTDIR="$PKG" ninja -C build install
}
