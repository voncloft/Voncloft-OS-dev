# description	: The Bourne-Again SHell
# depends	: ncurses readline

name=bash
version=5.3.20
release=1
_baseversion=${version%.*}
_patchlevel=${version##*.}
_series=$(printf '%s' "$_baseversion" | tr -d .)
source="https://ftp.gnu.org/gnu/${name}/${name}-${_baseversion}.tar.gz"
for _patch in $(seq -f '%03g' 1 "$_patchlevel"); do
        source="$source https://ftp.gnu.org/gnu/${name}/${name}-${_baseversion}-patches/${name}${_series}-${_patch}"
done
options="!checksum"

build() {
	cd "$name-$_baseversion"
	for _patch in $(seq -f '%03g' 1 "$_patchlevel"); do
		patch --fuzz=0 -Np0 -i "$SRC/${name}${_series}-${_patch}"
	done

	./configure --prefix=/usr \
	            --without-bash-malloc \
	            --with-installed-readline \
		    --disable-nls
	make
	make DESTDIR=$PKG install

	# /bin is an existing symlink to /usr/bin on VonOS.
	ln -s bash "$PKG/usr/bin/sh"

}
