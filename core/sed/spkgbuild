# description	: GNU stream editor
# depends	: acl attr gettext

name=sed
version=4.10
release=2
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.xz"

build() {
	cd $name-$version

	./configure --prefix=/usr --disable-nls
	make
	make html
	make DESTDIR=$PKG install

	rm -r $PKG/usr/share/info
}
