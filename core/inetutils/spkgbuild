# description	: Programs for basic networking

name=inetutils
version=2.8
release=3
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.gz"

build() {
	cd $name-$version

	# LFS: configure misses the termcap declaration with current ncurses.
	sed -i 's/def HAVE_TERMCAP_TGETENT/ 1/' telnet/telnet.c

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/sbin \
		--localstatedir=/var \
		--disable-logger \
		--disable-whois \
		--disable-rcp \
		--disable-rexec \
		--disable-rlogin \
		--disable-rsh \
		--disable-servers
	make
	make DESTDIR=$PKG install

	# VonOS uses /bin and /sbin symlinks into /usr.
	install -d "$PKG/usr/sbin"
	mv "$PKG/usr/bin/ifconfig" "$PKG/usr/sbin/"

	rm -r $PKG/usr/share/info
}
