# description	: Used to describe the program APIs and collect them in a uniform, machine readable format
# depends	: glib python which meson

name=gobject-introspection
version=1.86.0
release=2
source="https://download.gnome.org/sources/gobject-introspection/1.86/gobject-introspection-1.86.0.tar.xz"

build() {
	cd "$SRC"/gobject-introspection*/

	mkdir build
	cd build

	meson --prefix=/usr 
	ninja
	DESTDIR=$PKG ninja install
}
