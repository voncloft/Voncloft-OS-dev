# description	: Base icon theme from the Numix project
# depends	: gtk3

name=numix-icon-theme
version=20260111174057.gc876b63326530034e3ac3f9cc66a13b445aca230
release=1
options="!strip"
_commit=${version##*.g}
source="$name-$_commit.tar.gz::https://github.com/numixproject/${name}/archive/$_commit.tar.gz"

build() {
	cd $name-$_commit
	install -dm 755 $PKG/usr/share/icons
	cp -dr --no-preserve='ownership' Numix Numix-Light $PKG/usr/share/icons/
}

