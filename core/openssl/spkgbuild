# description : TLS and cryptographic libraries
# depends : zlib

name=openssl
version=4.1.0
release=2
source="https://github.com/openssl/$name/releases/download/$name-$version/$name-$version.tar.gz"
backup="etc/ssl/openssl.cnf
        etc/ssl/ct_log_list.cnf"

build() {
    cd "$name-$version"
    ./Configure linux-x86_64 --prefix=/usr --openssldir=/etc/ssl --libdir=lib shared zlib-dynamic
    make
    make DESTDIR="$PKG" MANSUFFIX=ssl install
    rm -f "$PKG/usr/lib/libcrypto.a" "$PKG/usr/lib/libssl.a"
    if [ -d "$PKG/usr/share/doc/openssl" ]; then
        mv "$PKG/usr/share/doc/openssl" "$PKG/usr/share/doc/$name-$version"
    fi

    make distclean
    CC="gcc -m32" CXX="g++ -m32" \
        PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
        ./Configure linux-x86 --prefix=/usr --openssldir=/etc/ssl --libdir=lib32 shared zlib-dynamic
    make
    make DESTDIR="$SRC/stage32" install_sw
    install -dm755 "$PKG/usr/lib32"
    cp -a "$SRC/stage32/usr/lib32/." "$PKG/usr/lib32/"
    rm -f "$PKG/usr/lib32/libcrypto.a" "$PKG/usr/lib32/libssl.a"
}
