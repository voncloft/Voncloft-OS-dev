# description	: Minimalistic plugin API for video effects
# depends	: gavl

name=frei0r-plugins
version=3.6.0
release=1
source="https://github.com/dyne/frei0r/archive/refs/tags/v3.6.0.tar.gz"

build() {
	cd "$SRC"/frei0r*/
	
	mkdir -vp build
	cd        build
	
	cmake -DCMAKE_INSTALL_PREFIX=/usr    \
	      -DCMAKE_BUILD_TYPE=Release     \
	      -DOpenCV_DIR=/usr/share/OpenCV \
	      -Wno-dev ..
	make
	make DESTDIR=$PKG install
}
