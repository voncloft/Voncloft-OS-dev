# description	: Generate scripting interfaces to C/C++ code
# depends	: pcre

name=swig
version=4.5.1
release=1
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.gz"

build() {
	cd *
	./configure \
		--prefix=/usr                      \
 		--without-maximum-compile-warnings
	make
	make DESTDIR=$PKG install
}
