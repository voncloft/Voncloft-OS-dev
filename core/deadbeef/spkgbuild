# description	: A GTK+ audio player for GNU/Linux
# depends	: alsa-lib desktop-file-utils jansson libmad gtk3

name=deadbeef
version=1.10.3
release=1
source="https://downloads.sourceforge.net/project/${name}/Builds/${version}/linux/${name}-${version}.tar.bz2"

build() {
	cd "$SRC"/deadbeef*/
	./configure --prefix=/usr \
		    --disable-nls
	make
	make DESTDIR=$PKG install
}
