# description : Tools and libraries for reading, writing, and manipulating images
# depends : bzip2 fontconfig freetype2 graphviz lcms2 libjpeg-turbo libpng libraw librsvg libtiff libtool libwebp libxext libxml2 libxt openjpeg pango perl pkgconf xz zlib zstd

name=imagemagick7
version=7.1.2.34
release=1
options="libtool !checksum"
source="https://download.imagemagick.org/releases/ImageMagick-${version%.*}-${version##*.}.tar.xz"

build() {
    cd "ImageMagick-${version%.*}-${version##*.}"

    ./configure --prefix=/usr \
                --libdir=/usr/lib64 \
                --sysconfdir=/etc \
                --enable-hdri \
                --with-modules \
                --with-perl \
                --with-perl-options="INSTALLDIRS=vendor" \
                --disable-static \
                --without-openexr
    make
    make DESTDIR="$PKG" install
}
