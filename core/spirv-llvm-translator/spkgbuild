# description : llvm translator
# depends : cmake ninja git libxml2 llvm spirv-tools

name=spirv-llvm-translator
version=23.1.3
release=1

_name=SPIRV-LLVM-Translator
source="https://github.com/KhronosGroup/${_name}/archive/v$version/${_name}-$version.tar.gz"
options="!checksum"

build()
{
    # Use the release's spirv-headers-tag.conf pin; headers are build-only.
    # The SDK headers in /usr may not yet include translator-required extensions.
	cd "${_name}-${version}"
	mkdir build &&
	cd    build &&

	cmake -D CMAKE_INSTALL_PREFIX=/usr                   \
      -D CMAKE_BUILD_TYPE=Release                    \
      -D BUILD_SHARED_LIBS=ON                        \
      -D CMAKE_SKIP_INSTALL_RPATH=ON                 \
      -D SPIRV_HEADERS_ENABLE_INSTALL=OFF            \
      -D SPIRV_HEADERS_ENABLE_TESTS=OFF              \
      -G Ninja ..                                    &&
	ninja

	DESTDIR=$PKG ninja install
}
