name=wifite
version=20180406193534.g876289c3a4846461bca9978cc0880d09d5d1e469
release=1
source="${name}-${version}.py::https://raw.githubusercontent.com/derv82/${name}/${version##*.g}/${name}.py"

build() {
	chmod +x "$SRC/${name}-${version}.py"
	mkdir -p $PKG/usr/bin
	install -D -m755 "$SRC/${name}-${version}.py" $PKG/usr/bin/wifite
}
