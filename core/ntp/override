# Read the upstream release archive instead of a version-specific directory.
source="https://downloads.nwtime.org/ntp/4.2.8/"
url=$source
get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re,subprocess
name='ntp'
url='https://downloads.nwtime.org/ntp/4.2.8/'
versions=set(re.findall('ntp-([0-9]+\\.[0-9]+\\.[0-9]+p[0-9]+)\\.tar\\.',pathlib.Path('index.html').read_text()))
versions=sorted(versions,key=lambda v:tuple(map(int,re.findall(r'[0-9]+',v))),reverse=True)
if not versions:raise SystemExit('No stable source releases found')
print(versions[0])
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
