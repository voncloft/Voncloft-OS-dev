# description : Lightweight scripting language and embeddable runtime for extending applications

name=lua
version=5.5.1
_majorver=${version%.*}
release=2
source="https://www.lua.org/ftp/$name-$version.tar.gz
        shared-library.patch
        lua.pc"
options="!checksum"

build() {
    cd "$name-$version"
    patch -Np1 -i "$SRC/shared-library.patch"

    sed -e "s/%VER%/$_majorver/g" \
        -e "s/%REL%/$version/g" "$SRC/lua.pc" > lua.pc

    make linux MYCFLAGS="$CFLAGS -fPIC" MYLDFLAGS="$LDFLAGS"
    make test
    make INSTALL_TOP="$PKG/usr" \
         INSTALL_MAN="$PKG/usr/share/man/man1" \
         INSTALL_DATA="cp -d" \
         TO_LIB="liblua.so liblua.so.$_majorver liblua.so.$version" \
         install
    install -Dm644 lua.pc "$PKG/usr/lib/pkgconfig/lua.pc"
}
