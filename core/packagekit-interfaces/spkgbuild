# description : PackageKit D-Bus interface definitions for building client bindings
# depends :
# note : Interface XML only; this package does not provide a PackageKit daemon or backend.

name=packagekit-interfaces
version=1.4.0
release=1
_name=PackageKit
source="PackageKit-$version.tar.gz::https://github.com/PackageKit/${_name}/archive/refs/tags/v$version.tar.gz"
options="!checksum"

build() {
    cd "PackageKit-$version"
    install -Dm644 src/org.freedesktop.PackageKit.xml \
        "$PKG/usr/share/dbus-1/interfaces/org.freedesktop.PackageKit.xml"
    install -Dm644 src/org.freedesktop.PackageKit.Transaction.xml \
        "$PKG/usr/share/dbus-1/interfaces/org.freedesktop.PackageKit.Transaction.xml"
    install -Dm644 COPYING "$PKG/usr/share/licenses/$name/COPYING"
}
