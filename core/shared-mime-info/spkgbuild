# description	: A MIME database
# depends	: glib libxml2

name=shared-mime-info
version=2.5.1
release=5
options="!makeflags"
source="https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/2.5.1/shared-mime-info-2.5.1.tar.gz"

build() {
	cd $name-$version

	# https://bugs.freedesktop.org/show_bug.cgi?id=70366
	mkdir build
	cd build
	meson setup --prefix=/usr --buildtype=release -D update-mimedb=true ..
	ninja
	DESTDIR=$PKG ninja install
}
