# description	: Fast, compact, key-value embedded data store

name=lmdb
version=1.0.3
release=1
source="${name}-${version}.tar.bz2::https://git.openldap.org/openldap/openldap/-/archive/LMDB_${version}/openldap-LMDB_${version}.tar.bz2"

build() {
	cd *
	cd libraries/liblmdb 
	make                 
	sed -i 's| liblmdb.a||' Makefile
	make DESTDIR=$PKG prefix=/usr install
}
