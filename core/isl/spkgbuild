# description : Integer set library for polyhedral compilation and optimization
# depends	: 

name=isl
version=0.28
release=3
source="https://libisl.sourceforge.io/${name}-$version.tar.xz"
options="!checksum"
build() {
	cd $name-$version
	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/isl-$version
	make
	make DESTDIR=$PKG install
	mkdir -pv $PKG/usr/share/gdb/auto-load/usr/lib	
	mv -v $PKG/usr/lib/libisl*gdb.py $PKG/usr/share/gdb/auto-load/usr/lib
}
