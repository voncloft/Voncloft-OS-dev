# note : GEGL can use Graphviz output; it is not a Graphviz build dependency.
# description	: Graph visualization software
# depends : pango cairo xorg-libraries fontconfig libpng cmake

name=graphviz
version=16.1.0
release=2
source="https://gitlab.com/graphviz/graphviz/-/archive/$version/graphviz-$version.tar.bz2"

options="!checksum"

build() {
	cd $name-$version
	mkdir build &&
	cd    build &&

	cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      ..                           &&

	sed -i '/GZIP/s/:.*$/=/' CMakeCache.txt &&

	make
	make DESTDIR=$PKG install
}
