# description	: ZIP extraction utilities

name=unzip
version=6.0
release=1
source="https://downloads.sourceforge.net/infozip/${name}${version//./}.tar.gz"

build() {
    cd "$SRC/${name}${version//./}"
    make -f unix/Makefile CC=gcc linux
    make -f unix/Makefile prefix=/usr MANDIR=/usr/share/man/man1 DESTDIR="$PKG" install
}
