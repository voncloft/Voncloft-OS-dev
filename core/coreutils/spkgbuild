# description	: Utilities for showing and setting the basic system characteristics
# depends	: acl attr gmp

name=coreutils
version=9.12
release=2
source="https://ftp.gnu.org/gnu/$name/$name-$version.tar.xz
	$name-i18n-1.patch
	$name-progress.patch"

build() {
	cd $name-$version

	# fixes POSIX requires that programs from Coreutils recognize
	# character boundaries correctly even in multibyte locales
	#patch -Np1 -i ../$name-i18n-1.patch
	patch --fuzz=0 -p1 -i "$SRC/$name-progress.patch"

	# Use the release tarball configure script; the progress patch changes C/doc files only.
	FORCE_UNSAFE_CONFIGURE=1 \
	./configure \
		--prefix=/usr \
		--libexecdir=/usr/libexec \
		--enable-no-install-program=kill,uptime \
		--disable-nls
	FORCE_UNSAFE_CONFIGURE=1 make
	make DESTDIR=$PKG install

}
