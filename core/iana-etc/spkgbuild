# description	: Provides data for network services and protocols

name=iana-etc
version=20261106
release=1
source="https://github.com/Mic92/${name}/releases/download/${version}/${name}-${version}.tar.gz"

# Preserve local service and protocol mappings on upgrade.
backup="etc/services etc/protocols"

build() {
	cd "$SRC"/iana-etc*/
	install -d -m 755 $PKG/etc
	install -m 644 services $PKG/etc
	install -m 644 protocols $PKG/etc
}
