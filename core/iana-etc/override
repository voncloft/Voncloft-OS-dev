# IANA snapshot releases use YYYYMMDD tags.
source="https://api.github.com/repos/Mic92/iana-etc/releases/latest"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import datetime,json,pathlib,re
release=json.loads(pathlib.Path('index.html').read_text())
version=release.get('tag_name','')
if release.get('draft') or release.get('prerelease') or not re.fullmatch(r'[0-9]{8}',version): raise SystemExit('No stable IANA snapshot')
datetime.datetime.strptime(version,'%Y%m%d')
print(version)
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
