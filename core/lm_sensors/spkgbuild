# description	: User-space support for the hardware monitoring drivers in the Linux kernel
# depends	: which

name=lm_sensors
version=3.6.2
release=1
_name=lm-sensors
source="https://github.com/lm-sensors/${_name}/archive/refs/tags/V${version//./-}.tar.gz
	run"

build() {
	cd "$SRC"/lm-sensors*/
	make PREFIX=/usr        \
	     BUILD_STATIC_LIB=0 \
	     MANDIR=/usr/share/man

	make PREFIX=/usr        \
	     BUILD_STATIC_LIB=0 \
	     MANDIR=/usr/share/man \
	     DESTDIR=$PKG install

	# runit service
        install -Dm755 $SRC/run $PKG/etc/sv/fancontrol/run
        ln -s /run/runit/supervise.fancontrol $PKG/etc/sv/fancontrol/supervise
}
