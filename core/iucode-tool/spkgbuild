# description   : Tool to manipulate intel IA-32/X86-64 microcode bundles

name=iucode-tool
version=2.3.1
release=1
_name=releases
source="https://gitlab.com/iucode-tool/${_name}/raw/master/${name}_${version}.tar.xz"

build() {
	cd "$SRC"/iucode-tool*/

        ./configure \
                --prefix=/usr   \
                --sbindir=/usr/sbin

        make
        make DESTDIR=$PKG install 
}
