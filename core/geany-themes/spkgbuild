# description	: Themes for geany
# depends	: geany

name=geany-themes
version=20190622215339.gb77a43c9c496dec9f36bf225b47198fdc036a2e8
release=1
options="!strip"
_commit=${version##*.g}
source="$name-$_commit.tar.gz::https://github.com/codebrainz/${name}/archive/$_commit.tar.gz"

build() {
	cd $name-$_commit

	mkdir -pv $PKG/usr/share/geany/colorschemes/
	cp -v colorschemes/*.conf $PKG/usr/share/geany/colorschemes/
}
