# description : Contains math libraries that useful functions for arbitrary precision arithmetic
# depends     : gcc bash

name=gmp
version=6.3.0
release=2
source="https://ftp.gnu.org/gnu/${name}/$name-$version.tar.xz"

build() {
    # 64-bit build.
    cd $name-$version

    mkdir -p build
    cd build

    ../configure \
        --prefix=/usr \
        --enable-cxx \
        --build=${XHOST:-x86_64-unknown-linux-gnu} \
        --disable-static
    make
    make DESTDIR=$PKG install

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --includedir=/usr/include/m32/gmp \
        --host=i686-pc-linux-gnu \
        ABI=32 \
        --enable-cxx \
        --disable-static
    sed -i 's@$(exec_prefix)/include@$(includedir)@' Makefile
    make
    make DESTDIR="$PWD/DESTDIR" install

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    mkdir -p "$PKG/usr/include/m32"
    cp -a DESTDIR/usr/include/m32/. "$PKG/usr/include/m32/"
    # Select the matching ABI even when a consumer does not use pkg-config.
    mv "$PKG/usr/include/gmp.h" "$PKG/usr/include/gmp-64.h"
    printf '%s\n' \
        '#if defined(__i386__)' \
        '#include "m32/gmp/gmp.h"' \
        '#else' \
        '#include "gmp-64.h"' \
        '#endif' > "$PKG/usr/include/gmp.h"
    rm -rf DESTDIR
}
