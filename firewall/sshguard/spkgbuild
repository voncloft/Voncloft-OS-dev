# description : iptables sshguard addon blocks ssh attacks
# depends : sshguard-boot iptables

name=sshguard
version=2.6.0
release=1
options="!checksum"

source="https://downloads.sourceforge.net/sourceforge/sshguard/${name}-${version}.tar.gz
	sshguard.conf"

build()
{
	cd $name-$version
	./configure --prefix=/usr
	make

	make DESTDIR=$PKG install
	mkdir -pv $PKG/etc
	
	install $SRC/sshguard.conf $PKG/etc/sshguard.conf
	
}

