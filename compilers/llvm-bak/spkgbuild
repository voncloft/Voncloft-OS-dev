# description	: Collection of modular and reusable compiler and toolchain technologies
# depends	: cmake libffi python ninja libxml2

name=llvm-bak
_upstream_name=llvm
version=23.1.4
release=1
_name=llvm-project
source="https://github.com/llvm/${_name}/releases/download/llvmorg-$version/${_upstream_name}-$version.src.tar.xz
	llvm-config.h"
options="!checksum"
build() {
	cd ${_upstream_name}-$version.src

	export CC=gcc
	export CXX=g++	

	mkdir -v build
	cd       build
	
	cmake .. -G Ninja \
	      -DCMAKE_INSTALL_PREFIX=/usr           \
	      -DLLVM_ENABLE_FFI=ON                  \
	      -DCMAKE_BUILD_TYPE=Release            \
	      -DLLVM_BUILD_LLVM_DYLIB=ON            \
      	      -DLLVM_LINK_LLVM_DYLIB=ON             \
	      -DLLVM_ENABLE_RTTI=ON                 \
	      -DLLVM_TARGETS_TO_BUILD="X86;AMDGPU;BPF" \
	      -Wno-dev
	ninja
	DESTDIR=$PKG ninja install

	# multilib stub
	mv $PKG/usr/include/llvm/Config/llvm-config.h \
	   $PKG/usr/include/llvm/Config/llvm-config-64.h
	cp $SRC/llvm-config.h \
	   $PKG/usr/include/llvm/Config/llvm-config.h	
}
