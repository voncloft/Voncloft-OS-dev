# depends     : cmake libffi libxml2 ninja python
# description : Collection of modular and reusable compiler and toolchain technologies

name=llvm
version=23.1.6
release=3
options="!checksum"
backup="etc/clang/clang.cfg etc/clang/clang++.cfg"
_name=llvm-project
source="https://github.com/llvm/${_name}/releases/download/llvmorg-${version}/${_name}-${version}.src.tar.xz"

build() {
    # 64-bit build.
    cd "$SRC/${_name}-${version}.src/llvm"

    # Fix Python scripts which use /usr/bin/env python to access the system Python:
    grep -rl '#!.*python' | xargs sed -i '1s/python$/python3/'
    sed 's/utility/tool/' -i utils/FileCheck/CMakeLists.txt
    mkdir build
    cd build

    CC=gcc CXX=g++ \
        cmake .. \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_SKIP_INSTALL_RPATH=ON \
        -D LLVM_ENABLE_PROJECTS=clang \
        -D LLVM_ENABLE_FFI=ON \
        -D CMAKE_BUILD_TYPE=Release \
        -D LLVM_BUILD_LLVM_DYLIB=ON \
        -D LLVM_LINK_LLVM_DYLIB=ON \
        -D LLVM_ENABLE_RTTI=ON \
        -D LLVM_TARGETS_TO_BUILD="host;AMDGPU;NVPTX;SPIRV" \
        -D LLVM_BINUTILS_INCDIR=/usr/include \
        -D LLVM_PARALLEL_LINK_JOBS=1 \
        -D LLVM_INCLUDE_BENCHMARKS=OFF \
        -D CLANG_DEFAULT_PIE_ON_LINUX=ON \
        -D CLANG_CONFIG_FILE_SYSTEM_DIR=/etc/clang \
        -W no-dev \
        -G Ninja
    ninja -j"${NINJAJOBS:-6}"
    DESTDIR=$PKG ninja -j"${NINJAJOBS:-6}" install
    mkdir -pv $PKG/etc/clang
    for i in clang clang++; do
        echo -fstack-protector-strong > $PKG/etc/clang/$i.cfg
    done

    # 32-bit build.
    cd ..
    mkdir -p build32
    cd build32

    export CC="gcc -m32"
    export CXX="g++ -m32"
    export CFLAGS="$CFLAGS -m32"
    export CXXFLAGS="$CXXFLAGS -m32"
    export LDFLAGS="$LDFLAGS -m32"
    export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig
    export PKG_CONFIG_PATH="$PKG_CONFIG_LIBDIR"
    unset LIBRARY_PATH CMAKE_PREFIX_PATH

    cmake .. \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib32 \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_LIBRARY_PATH=/usr/lib32 \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DLLVM_ENABLE_PROJECTS=clang \
        -DLLVM_ENABLE_FFI=ON \
        -DLLVM_PARALLEL_LINK_JOBS=1 \
        -DLLVM_BUILD_LLVM_DYLIB=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_TARGETS_TO_BUILD='X86;AMDGPU;BPF;NVPTX;SPIRV' \
        -DLLVM_LIBDIR_SUFFIX=32 \
        -DLLVM_TARGET_ARCH=i686 \
        -DLLVM_DEFAULT_TARGET_TRIPLE=i686-pc-linux-gnu \
        -DLLVM_INCLUDE_BENCHMARKS=OFF
    cmake --build .
    DESTDIR="$PWD/DESTDIR" cmake --install .

    mkdir -p "$PKG/usr/lib32"
    cp -a DESTDIR/usr/lib32/. "$PKG/usr/lib32/"
    install -Dm755 DESTDIR/usr/bin/llvm-config "$PKG/usr/bin/llvm-config-32"
    # Keep the generated configuration for each ABI.
    mv "$PKG/usr/include/llvm/Config/llvm-config.h" "$PKG/usr/include/llvm/Config/llvm-config-64.h"
    install -m644 "DESTDIR/usr/include/llvm/Config/llvm-config.h" "$PKG/usr/include/llvm/Config/llvm-config-32.h"
    printf '%s\n' \
        '#if defined(__i386__)' \
        '#include "llvm-config-32.h"' \
        '#else' \
        '#include "llvm-config-64.h"' \
        '#endif' > "$PKG/usr/include/llvm/Config/llvm-config.h"
    rm -rf DESTDIR
}
