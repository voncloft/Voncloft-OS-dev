# description : Meson build system
# depends : python ninja python-setuptools python-wheel

name=meson
version=1.8.2
release=2
source="https://files.pythonhosted.org/packages/source/m/${name}/${name}-$version.tar.gz"
options="!checksum"

build() {
    cd "meson-$version"
    export PYTHONNOUSERSITE=1
    python3 -m pip wheel --no-cache-dir --no-index --no-deps \
        --no-build-isolation --wheel-dir dist .
    # Always stage the wheel, even when this distribution is installed already.
    python3 -m pip install --no-cache-dir --no-index --no-deps --no-user \
        --ignore-installed --root="$PKG" --prefix=/usr dist/meson-"$version"-*.whl
}
