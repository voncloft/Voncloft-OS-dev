# description : Compiler cache for faster repeat C and C++ builds
# depends : cmake ninja zstd xxhash

name=ccache
version=4.14.2
release=1
source="https://github.com/ccache/${name}/releases/download/v$version/$name-$version.tar.xz
        ccache.conf"
options="!checksum"
backup="etc/ccache.conf"

build() {
    cd "$name-$version"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DDEPS=LOCAL -DDEP_BLAKE3=BUNDLED -DDEP_FMT=BUNDLED \
        -DDEP_TLEXPECTED=BUNDLED \
        -DHTTP_STORAGE_BACKEND=OFF -DREDIS_STORAGE_BACKEND=OFF \
        -DENABLE_TESTING=OFF -DENABLE_DOCUMENTATION=OFF
    cmake --build build --parallel "${NINJAJOBS:-$(nproc)}"
    DESTDIR="$PKG" cmake --install build
    install -d "$PKG/usr/lib/ccache"
    for compiler in gcc g++ cc c++; do
        ln -s /usr/bin/ccache "$PKG/usr/lib/ccache/$compiler"
    done
    install -Dm644 "$SRC/ccache.conf" "$PKG/etc/ccache.conf"
}
