# description : Just-in-time compiler and drop-in replacement for Lua 5.1.

name=luajit
version=20261029115715.g8ca762976ebc85ad9bde3e15f147a7e326e0dd01
release=2
_name=LuaJIT
_commit=${version##*.g}
source="${name}-${version}.tar.gz::https://github.com/LuaJIT/${_name}/archive/${_commit}.tar.gz"

build() {
	cd "${_name}-${_commit}"

	make PREFIX=/usr CFLAGS+=' -fPIC' amalg
	make PREFIX=/usr DESTDIR="$PKG" install

	ln -s luajit-2.1 "$PKG/usr/include/luajit"
}
