# Read the current official upstream source metadata.
source="https://api.github.com/repos/LuaJIT/LuaJIT/commits/v2.1"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import datetime,json,pathlib,re
commit=json.loads(pathlib.Path('index.html').read_text())
sha=commit['sha']
if not re.fullmatch(r'[0-9a-f]{40}',sha): raise SystemExit('Invalid LuaJIT source commit')
stamp=datetime.datetime.fromisoformat(commit['commit']['committer']['date'].replace('Z','+00:00')).astimezone(datetime.timezone.utc).strftime('%Y%m%d%H%M%S')
print(stamp+'.g'+sha)
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
