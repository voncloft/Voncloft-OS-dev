# description   : The Apache Ant package is a Java-based build tool
# depends       : java-headless glib

name=apache-ant
version=1.10.18
release=3
source="https://archive.apache.org/dist/ant/source/${name}-${version}-src.tar.xz"

options="!checksum"

backup="etc/profile.d/ant.sh"

build() {
        cd $name-$version

        # Login profiles can call shell functions that are unavailable in a
        # package build. Use the selected JDK without executing those profiles.
        if [ -z "${JAVA_HOME:-}" ] || [ ! -x "$JAVA_HOME/bin/javac" ]; then
                _javac="$(command -v javac)" || return 1
                JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$_javac")")")"
        fi
        export JAVA_HOME
        export PATH="$JAVA_HOME/bin:$PATH"
        # Keep unrelated application jars out of the package build.
        unset CLASSPATH
        ./bootstrap.sh
        # Keep resolver downloads and temporary files inside package work.
        mkdir -p "$SRC/maven-cache" "$SRC/fetch-cache"
        bootstrap/bin/ant -f fetch.xml -Ddest=optional \
                -Dmaven.repo.local="$SRC/maven-cache" \
                -Dtemp.dir="$SRC/fetch-cache"
./build.sh -Ddist.dir=$PWD/ant-$version dist
mkdir -pv $PKG/opt
cp -rv ant-$version $PKG/opt/
chown -R root:root $PKG/opt/ant-$version
ln -sfv ant-$version $PKG/opt/ant
mkdir -pv $PKG/etc/profile.d
cat > $PKG/etc/profile.d/ant.sh << EOF
# Begin /etc/profile.d/ant.sh
pathappend /opt/ant/bin
export ANT_HOME=/opt/ant
# End /etc/profile.d/ant.sh
EOF
}
