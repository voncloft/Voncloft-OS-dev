# description : creates cargo subcommand to build and install c-abi libraries
# depends : rust libssh2 sqlite

name=cargo-c
version=0.10.26
release=3

source="https://github.com/lu-zero/${name}/archive/v$version/${name}-$version.tar.gz"

build()
{
    # Scratch builds do not source the interactive Rust profile.
    export PATH="/opt/rustc/bin:$PATH"
    export CARGO_BUILD_JOBS="${NINJAJOBS:-6}"
    export CARGO_HOME="$SRC/cargo-home"
	cd $name-$version
	curl -fLO https://github.com/lu-zero/${name}/releases/download/v${version}/Cargo.lock
	[ ! -e /usr/include/libssh2.h ] || export LIBSSH2_SYS_USE_PKG_CONFIG=1    &&
	[ ! -e /usr/include/sqlite3.h ] || export LIBSQLITE3_SYS_USE_PKG_CONFIG=1 &&

	cargo build --locked --release
	mkdir -pv $PKG/usr/bin
	install -vm755 target/release/cargo-{capi,cbuild,cinstall,ctest} $PKG/usr/bin/
}
