# description	: Ruby development environment
# depends	: gdbm readline ncurses openssl libffi zlib yaml gmp yaml

name=ruby
version=4.0.9
rverz=$(echo $version | sed "s/\./\_/g")
release=1
source="https://cache.ruby-lang.org/pub/${name}/${version%.*}/${name}-${version}.tar.xz"
options="!checksum"
build() {
	cd *
	./configure --prefix=/usr         \
            --disable-rpath       \
            --enable-shared       \
            --without-valgrind    \
            --without-baseruby    \
            ac_cv_func_qsort_r=no \
            --docdir=/usr/share/doc/ruby-$version
	make
	make DESTDIR=$PKG install

        # Bundler and Rake have their own Scratch packages. Keep their command
        # wrappers and gems under one owner when upgrading Ruby's ABI.
        rm -f "$PKG/usr/bin/bundle" "$PKG/usr/bin/bundler" "$PKG/usr/bin/rake"
        rm -rf "$PKG"/usr/lib/ruby/*/bundler
        rm -f "$PKG"/usr/lib/ruby/*/bundler.rb
        for _gem in bundler rake; do
                rm -rf "$PKG"/usr/lib/ruby/gems/*/gems/"$_gem"-*
                rm -f "$PKG"/usr/lib/ruby/gems/*/specifications/"$_gem"-*.gemspec \
                      "$PKG"/usr/lib/ruby/gems/*/specifications/default/"$_gem"-*.gemspec \
                      "$PKG"/usr/lib/ruby/gems/*/cache/"$_gem"-*.gem
        done
}
