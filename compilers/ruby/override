# Follow the newest stable release published by Ruby upstream.
source="https://www.ruby-lang.org/en/downloads/releases/"
url=$source

get_generic()
{
    local detected
    unset uversion
    detected=$(python3 - <<'PYUPSTREAM'
import pathlib,re
versions=re.findall(r'ruby-([0-9]+\.[0-9]+\.[0-9]+)\.tar\.',pathlib.Path('index.html').read_text())
if not versions: raise SystemExit('No stable Ruby source release found')
print(max(versions,key=lambda v:tuple(map(int,v.split('.')))))
PYUPSTREAM
    ) || return 1
    uversion=$detected
    [ -n "$uversion" ]
}
