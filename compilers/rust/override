source="https://static.rust-lang.org/dist/channel-rust-stable.toml"
# update-repo sources the override again before fetching its version data.
url=$source

get_generic()
{
    local latest
    unset uversion
    # Read the stable Rust version, not Cargo's separate version or a target URL.
    latest=$(awk '
        /^\[pkg\.rust\][[:space:]]*$/ { rust = 1; next }
        /^\[/ { rust = 0 }
        rust && /^[[:space:]]*version[[:space:]]*=/ {
            split($0, quoted, "\"")
            split(quoted[2], fields, /[[:space:]]+/)
            print fields[1]
            exit
        }
    ' index.html) || return 1
    if [[ ! $latest =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo 'ERROR: Unable to read the stable Rust version from its channel manifest' >&2
        return 1
    fi
    # Leave all recipe changes to update-repo so -t remains a test run.
    uversion=$latest
}
