# description	: Print an X window dump from xwd
# depends	: libxmu libx11 

name=xpr
version=1.2.1
release=1
source="https://www.x.org/pub/individual/app/xpr-1.2.1.tar.gz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

