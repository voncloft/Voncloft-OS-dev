# description	: Utility library registering global X keyboard shortcuts
# depends	: gtk3 glib

name=keybinder3
version=0.3.2
release=1
_name=keybinder
source="https://github.com/kupferlauncher/${_name}/releases/download/${_name}-3.0-v$version/${_name}-3.0-$version.tar.gz"

options="!checksums"
build() {
	cd keybinder-3.0-$version
	./configure --prefix=/usr --disable-lua
	make
	make DESTDIR=$PKG install
}
