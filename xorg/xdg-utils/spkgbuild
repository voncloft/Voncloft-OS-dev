# depends : links lynx xmlto xorg
# description   : xdg-utils is a set of command line tools that assist applications with a variety of desktop integration tasks

name=xdg-utils
version=1.2.1
release=2
source=" https://gitlab.freedesktop.org/xdg/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"
options="!checksum"

build() {
        cd *
        ./configure --prefix=/usr 
make
make DESTDIR=$PKG install
}
