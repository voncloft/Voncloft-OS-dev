# description   : The Xorg Server is the core of the X Window system
# depends       : libxcvt pixman xorg-fonts xkeyboard-config dbus elogind libepoxy libtirpc lfs-bootscripts

name=xorg-server
version=21.1.26
release=1
source=" https://www.x.org/pub/individual/xserver/${name}-$version.tar.xz"
options="!checksum"

build() {
        cd $name-$version
mkdir build 
cd    build 
meson setup ..               \
--prefix=$XORG_PREFIX  \
--localstatedir=/var   \
-D glamor=true         \
-D systemd_logind=true \
-D xkb_output_dir=/var/lib/xkb 
ninja
DESTDIR=$PKG ninja install 
mkdir -pv $PKG/etc/X11/xorg.conf.d 
# Keep the temporary parent sticky, including on a fresh installation.
install -v -d -m1777 "$PKG/tmp"
install -v -d -m1777 $PKG/tmp/.{ICE,X11}-unix 
# lfs-bootscripts owns createfiles and its X/ICE socket-directory rules.
}
