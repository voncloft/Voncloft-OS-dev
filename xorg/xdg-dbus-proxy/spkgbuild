# description : D-Bus proxy
# depends : dbus docbook-xml docbook-xsl glib libxslt meson ninja pkgconf

name=xdg-dbus-proxy
version=0.1.9
release=2
source="https://github.com/flatpak/xdg-dbus-proxy/releases/download/$version/xdg-dbus-proxy-$version.tar.xz"

build() {
    cd "$name-$version"

    meson setup build \
        --prefix=/usr \
        --libdir=lib64 \
        --buildtype=release \
        -Dman=enabled \
        -Dtests=true \
        -Dinstalled_tests=false
    ninja -C build
    meson test -C build --print-errorlogs
    DESTDIR="$PKG" meson install -C build
}
