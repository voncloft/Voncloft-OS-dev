# description   : Xdg-user-dirs is a tool to help manage “well known” user directories like the desktop folder and the music folder
# depends       : none

name=xdg-user-dirs
version=0.20    
release=1
source="https://user-dirs.freedesktop.org/releases/${name}-${version}.tar.xz"

options="!checksum"

build() {
        cd $name-$version
LDFLAGS="-L/usr/lib -liconv" ./configure --prefix=/usr           \
--sysconfdir=/etc       \
--disable-documentation 
make
make DESTDIR=$PKG install
}
