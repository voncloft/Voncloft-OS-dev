# description	: ICE authority file utility
# depends	: libice 

name=iceauth
version=1.0.11
release=2
source="https://www.x.org/pub/individual/app/${name}-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

