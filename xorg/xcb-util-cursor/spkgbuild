# description	: XCB cursor library
# depends	: xcb-util-renderutil libxcb xcb-util-image 

name=xcb-util-cursor
version=0.1.6
release=3
source="https://xcb.freedesktop.org/dist/${name}-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

