# description : a service to launch OS remotely for iPxe
# depends : ansible git httpd

name=netboot
version=3.0.3
release=1

_name=netboot.xyz
source="https://github.com/netbootxyz/${_name}/archive/refs/tags/$version.tar.gz"
noextract="$version.tar.gz"
\
build() {
	mkdir -pv $PKG/opt/netboot.xyz
	tar -xf "$SRC/$version.tar.gz" -C $PKG/opt/netboot.xyz
}
