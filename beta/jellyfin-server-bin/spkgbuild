# description : Jellyfin server component
# depends : ffmpeg

name=jellyfin-server-bin
version=12.4
release=2
_pkgver="${version}-1"

source="jellyfin-server_${version}_amd64.deb::https://repo.jellyfin.org/files/server/debian/latest-stable/amd64/jellyfin-server_${version}%2Bdeb12_amd64.deb
	jellyfin.sysusers
	jellyfin.tmpfiles
	jellyfin.conf
	jellyfin.service"

noextract="jellyfin-server_${version}_amd64.deb"

build() {
	mkdir -pv "jellyfin-server"
	bsdtar -xf "jellyfin-server_${version}_amd64.deb" -C "jellyfin-server"
	tar -xvf "jellyfin-server"/data.tar.* -C "jellyfin-server"
	cp -r "$SRC/jellyfin-server/usr" "$PKG/usr"
	rm -r "$PKG/usr/share"
	install -Dm 644 "jellyfin.sysusers" "$PKG/usr/lib/sysusers.d/jellyfin.conf"
	install -Dm 644 "jellyfin.tmpfiles" "$PKG/usr/lib/tmpfiles.d/jellyfin.conf"
	install -Dm 644 "jellyfin.conf" "$PKG/etc/default/jellyfin"
	install -Dm 644 "jellyfin.service" "$PKG/etc/init.d/jellyfin"
}
