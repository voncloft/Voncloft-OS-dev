# description : jellyfin client
# depends : 

name=jellyfin-web-bin
version=12.4
release=2
_pkgver="${version}-1"
source="jellyfin-web_${version}_all.deb::https://repo.jellyfin.org/files/server/debian/latest-stable/amd64/jellyfin-web_12.4%2Bdeb12_all.deb"
noextract="jellyfin-web_${version}_all.deb"
build() {
	mkdir -pv "jellyfin-web"
	bsdtar -xf "jellyfin-web_${version}_all.deb" -C "jellyfin-web"
	tar -xf "jellyfin-web"/data.tar.* -C "jellyfin-web"
	cp -r "$SRC/jellyfin-web/usr" "$PKG/"
}
